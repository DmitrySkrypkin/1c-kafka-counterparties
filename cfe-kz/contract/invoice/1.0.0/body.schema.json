{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invoice-exchange/1.0.0/body.schema.json",
  "title": "Тело снимка счёта на оплату покупателю",
  "description": "Полный снимок счёта 1С. Входящий снимок портала проверяется по body.portal.schema.json.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "uid",
    "number",
    "released_at",
    "sum",
    "is_marked_delete",
    "contragent",
    "organization",
    "currency",
    "storehouse",
    "products"
  ],
  "properties": {
    "id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "released_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?.*)?$"
    },
    "sum": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        }
      ]
    },
    "is_marked_delete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "enum": [
            0,
            1
          ]
        }
      ]
    },
    "contragent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "uid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "anyOf": [
        {
          "required": [
            "uid"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "organization": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "uid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "anyOf": [
        {
          "required": [
            "uid"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "contract": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "uid": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "anyOf": [
            {
              "required": [
                "uid"
              ]
            },
            {
              "required": [
                "id"
              ]
            }
          ]
        }
      ]
    },
    "storehouse": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "uid"
      ],
      "properties": {
        "uid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "bank_account": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "uid"
          ],
          "properties": {
            "uid": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        }
      ]
    },
    "currency": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "rcc"
      ],
      "properties": {
        "rcc": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "uid",
          "quantity",
          "price",
          "sum",
          "sum_vat"
        ],
        "properties": {
          "id": {
            "description": "id строки портала, 1С не использует"
          },
          "uid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "uid товара"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              }
            ]
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              }
            ]
          },
          "sum": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              }
            ]
          },
          "sum_vat": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              }
            ]
          },
          "vat_percent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ставка продажи; null - без НДС. 1С не подбирает ставку сама (решение 18.11.2026)."
          }
        }
      }
    }
  }
}
