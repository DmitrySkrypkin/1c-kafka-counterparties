#Область ОбработчикиСобытийФормы

&НаСервере
&Перед("ПриСозданииНаСервере")
Процедура KFK_ПередПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	KFK_ПодготовитьФорму();
КонецПроцедуры

&НаСервере
&Перед("ПриЧтенииНаСервере")
Процедура KFK_ПередПриЧтенииНаСервере(ТекущийОбъект)
	KFK_ПодготовитьФорму();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура KFK_ПодготовитьФорму()

	Если KFK_РедакторФорм.ФормаПодготовлена(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	СвойстваПоля = Новый Структура;
	СвойстваПоля.Вставить("Заголовок", "UID менеджера портала");
	СвойстваПоля.Вставить("ТолькоПросмотр", Не Пользователи.ЭтоПолноправныйПользователь(, , Ложь));
	КонтекстПоля = KFK_РедакторФорм.НовыйКонтекстЭлемента(ЭтотОбъект, , , СвойстваПоля);
	KFK_РедакторФорм.НовоеПолеФормыРеквизитОбъекта(КонтекстПоля, "KFK_UIDМенеджераПортала");
	KFK_РедакторФорм.ОтметитьФормуПодготовленной(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти
