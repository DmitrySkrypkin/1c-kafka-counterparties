#Область ПрограммныйИнтерфейс

// Ставит смещение в очередь раздела со состоянием ready.
//
Функция ЗарегистрироватьСмещение(ГруппаПотребителя, Топик, Раздел, Смещение, ИдентификаторСообщения = "") Экспорт
	
	ПроверитьКлючОчереди(ГруппаПотребителя, Топик, Раздел, Смещение);
	МенеджерЗаписи = МенеджерСмещения(ГруппаПотребителя, Топик, Раздел, Смещение);
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат ОписаниеСмещения(МенеджерЗаписи, Истина);
	КонецЕсли;
	
	МенеджерЗаписи.ГруппаПотребителя = ГруппаПотребителя;
	МенеджерЗаписи.Топик = Топик;
	МенеджерЗаписи.Раздел = Раздел;
	МенеджерЗаписи.Смещение = Смещение;
	МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияВходящего.ready;
	МенеджерЗаписи.ВладелецАренды = "";
	МенеджерЗаписи.АрендаДо = Дата(1, 1, 1);
	МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
	МенеджерЗаписи.Записать();
	
	ОбновитьГоловуРаздела(ГруппаПотребителя, Топик, Раздел);
	Возврат ОписаниеСмещения(МенеджерЗаписи, Ложь);
	
КонецФункции

// Берёт минимальное незавершённое смещение раздела в аренду до terminal.
// waiting_retry/leased на меньшем offset блокирует более поздние той же partition.
//
Функция ВзятьВРаботу(ГруппаПотребителя, Топик, Раздел, ВладелецАренды, СрокАрендыСекунд = 300) Экспорт
	
	Если Не ЗначениеЗаполнено(ВладелецАренды) Тогда
		ВызватьИсключение "Не заполнен владелец аренды";
	КонецЕсли;
	Если СрокАрендыСекунд < 1 Тогда
		ВызватьИсключение "Срок аренды должен быть положительным";
	КонецЕсли;
	
	ПроверитьКлючРаздела(ГруппаПотребителя, Топик, Раздел);
	Кандидат = МинимальноеНезавершённое(ГруппаПотребителя, Топик, Раздел);
	Если Кандидат = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если Кандидат.Состояние = Перечисления.KFK_СостоянияВходящего.waiting_retry Тогда
		Возврат "blocked=" + Формат(Кандидат.Смещение, "ЧН=0; ЧГ=0")
			+ Символы.ПС + "reason=waiting_retry";
	КонецЕсли;
	Если Кандидат.Состояние = Перечисления.KFK_СостоянияВходящего.leased
		И Кандидат.ВладелецАренды <> ВладелецАренды
		И Кандидат.АрендаДо > ТекущаяДатаСеанса() Тогда
		Возврат "blocked=" + Формат(Кандидат.Смещение, "ЧН=0; ЧГ=0")
			+ Символы.ПС + "reason=leased";
	КонецЕсли;
	
	МенеджерЗаписи = МенеджерСмещения(ГруппаПотребителя, Топик, Раздел, Кандидат.Смещение);
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияВходящего.leased;
	МенеджерЗаписи.ВладелецАренды = ВладелецАренды;
	МенеджерЗаписи.АрендаДо = ТекущаяДатаСеанса() + СрокАрендыСекунд;
	МенеджерЗаписи.Записать();
	ОбновитьГоловуРаздела(ГруппаПотребителя, Топик, Раздел);
	
	Возврат "offset=" + Формат(Кандидат.Смещение, "ЧН=0; ЧГ=0")
		+ Символы.ПС + "state=leased"
		+ Символы.ПС + "owner=" + ВладелецАренды;
	
КонецФункции

// Голова раздела в waiting_retry: поздние offset той же partition не берутся.
//
Функция ПоставитьОжиданиеПовтора(ГруппаПотребителя, Топик, Раздел, Смещение) Экспорт
	
	УстановитьСостояниеСмещения(
		ГруппаПотребителя, Топик, Раздел, Смещение,
		Перечисления.KFK_СостоянияВходящего.waiting_retry, "", Дата(1, 1, 1));
	Возврат "offset=" + Формат(Смещение, "ЧН=0; ЧГ=0") + Символы.ПС + "state=waiting_retry";
	
КонецФункции

// Terminal completed/failed снимает блокировку головы и позволяет следующее смещение раздела.
//
Функция ЗавершитьСмещение(ГруппаПотребителя, Топик, Раздел, Смещение, Успех = Истина) Экспорт
	
	Состояние = ?(Успех,
		Перечисления.KFK_СостоянияВходящего.completed,
		Перечисления.KFK_СостоянияВходящего.failed);
	УстановитьСостояниеСмещения(
		ГруппаПотребителя, Топик, Раздел, Смещение, Состояние, "", Дата(1, 1, 1));
	Возврат "offset=" + Формат(Смещение, "ЧН=0; ЧГ=0")
		+ Символы.ПС + "state=" + ?(Успех, "completed", "failed");
	
КонецФункции

// True, если смещение можно брать: нет более раннего unfinished waiting_retry/leased в том же разделе.
//
Функция МожноОбработать(ГруппаПотребителя, Топик, Раздел, Смещение) Экспорт
	
	ПроверитьКлючОчереди(ГруппаПотребителя, Топик, Раздел, Смещение);
	Голова = МинимальноеНезавершённое(ГруппаПотребителя, Топик, Раздел);
	Если Голова = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Голова.Смещение < Смещение Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Голова.Смещение > Смещение Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Голова.Состояние = Перечисления.KFK_СостоянияВходящего.ready
		Или (Голова.Состояние = Перечисления.KFK_СостоянияВходящего.leased
			И Голова.АрендаДо <= ТекущаяДатаСеанса());
	
КонецФункции

// Удаляет тестовые строки смещения и головы раздела.
//
Процедура ОчиститьРаздел(ГруппаПотребителя, Топик, Раздел) Экспорт
	
	ПроверитьКлючРаздела(ГруппаПотребителя, Топик, Раздел);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Состояния.Смещение КАК Смещение
	|ИЗ
	|	РегистрСведений.KFK_СостоянияСмещений КАК Состояния
	|ГДЕ
	|	Состояния.ГруппаПотребителя = &ГруппаПотребителя
	|	И Состояния.Топик = &Топик
	|	И Состояния.Раздел = &Раздел";
	Запрос.УстановитьПараметр("ГруппаПотребителя", ГруппаПотребителя);
	Запрос.УстановитьПараметр("Топик", Топик);
	Запрос.УстановитьПараметр("Раздел", Раздел);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = МенеджерСмещения(ГруппаПотребителя, Топик, Раздел, Выборка.Смещение);
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	КонецЦикла;
	
	МенеджерГоловы = МенеджерГоловы(ГруппаПотребителя, Топик, Раздел);
	МенеджерГоловы.Прочитать();
	Если МенеджерГоловы.Выбран() Тогда
		МенеджерГоловы.Удалить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МинимальноеНезавершённое(ГруппаПотребителя, Топик, Раздел)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Состояния.Смещение КАК Смещение,
	|	Состояния.Состояние КАК Состояние,
	|	Состояния.ВладелецАренды КАК ВладелецАренды,
	|	Состояния.АрендаДо КАК АрендаДо,
	|	Состояния.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.KFK_СостоянияСмещений КАК Состояния
	|ГДЕ
	|	Состояния.ГруппаПотребителя = &ГруппаПотребителя
	|	И Состояния.Топик = &Топик
	|	И Состояния.Раздел = &Раздел
	|	И Состояния.Состояние В (&Незавершённые)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Смещение";
	Незавершённые = Новый Массив;
	Незавершённые.Добавить(Перечисления.KFK_СостоянияВходящего.ready);
	Незавершённые.Добавить(Перечисления.KFK_СостоянияВходящего.leased);
	Незавершённые.Добавить(Перечисления.KFK_СостоянияВходящего.waiting_retry);
	Запрос.УстановитьПараметр("ГруппаПотребителя", ГруппаПотребителя);
	Запрос.УстановитьПараметр("Топик", Топик);
	Запрос.УстановитьПараметр("Раздел", Раздел);
	Запрос.УстановитьПараметр("Незавершённые", Незавершённые);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Результат = Новый Структура;
	Результат.Вставить("Смещение", Выборка.Смещение);
	Результат.Вставить("Состояние", Выборка.Состояние);
	Результат.Вставить("ВладелецАренды", Выборка.ВладелецАренды);
	Результат.Вставить("АрендаДо", Выборка.АрендаДо);
	Результат.Вставить("ИдентификаторСообщения", Выборка.ИдентификаторСообщения);
	Возврат Результат;
	
КонецФункции

Процедура УстановитьСостояниеСмещения(ГруппаПотребителя, Топик, Раздел, Смещение, Состояние, ВладелецАренды, АрендаДо)
	
	ПроверитьКлючОчереди(ГруппаПотребителя, Топик, Раздел, Смещение);
	МенеджерЗаписи = МенеджерСмещения(ГруппаПотребителя, Топик, Раздел, Смещение);
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		ВызватьИсключение "Смещение не зарегистрировано: " + Формат(Смещение, "ЧН=0; ЧГ=0");
	КонецЕсли;
	
	МенеджерЗаписи.Состояние = Состояние;
	МенеджерЗаписи.ВладелецАренды = ВладелецАренды;
	МенеджерЗаписи.АрендаДо = АрендаДо;
	МенеджерЗаписи.Записать();
	ОбновитьГоловуРаздела(ГруппаПотребителя, Топик, Раздел);
	
КонецПроцедуры

Процедура ОбновитьГоловуРаздела(ГруппаПотребителя, Топик, Раздел)
	
	Голова = МинимальноеНезавершённое(ГруппаПотребителя, Топик, Раздел);
	МенеджерГоловы = МенеджерГоловы(ГруппаПотребителя, Топик, Раздел);
	МенеджерГоловы.Прочитать();
	Если Голова = Неопределено Тогда
		Если МенеджерГоловы.Выбран() Тогда
			МенеджерГоловы.Удалить();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Не МенеджерГоловы.Выбран() Тогда
		МенеджерГоловы.ГруппаПотребителя = ГруппаПотребителя;
		МенеджерГоловы.Топик = Топик;
		МенеджерГоловы.Раздел = Раздел;
	КонецЕсли;
	МенеджерГоловы.СмещениеГоловы = Голова.Смещение;
	МенеджерГоловы.СостояниеГоловы = Голова.Состояние;
	МенеджерГоловы.ВладелецАренды = Голова.ВладелецАренды;
	МенеджерГоловы.АрендаДо = Голова.АрендаДо;
	МенеджерГоловы.ИдентификаторСообщения = Голова.ИдентификаторСообщения;
	МенеджерГоловы.Записать();
	
КонецПроцедуры

Функция МенеджерСмещения(ГруппаПотребителя, Топик, Раздел, Смещение)
	
	МенеджерЗаписи = РегистрыСведений.KFK_СостоянияСмещений.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ГруппаПотребителя = ГруппаПотребителя;
	МенеджерЗаписи.Топик = Топик;
	МенеджерЗаписи.Раздел = Раздел;
	МенеджерЗаписи.Смещение = Смещение;
	Возврат МенеджерЗаписи;
	
КонецФункции

Функция МенеджерГоловы(ГруппаПотребителя, Топик, Раздел)
	
	МенеджерЗаписи = РегистрыСведений.KFK_ОчередьРазделов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ГруппаПотребителя = ГруппаПотребителя;
	МенеджерЗаписи.Топик = Топик;
	МенеджерЗаписи.Раздел = Раздел;
	Возврат МенеджерЗаписи;
	
КонецФункции

Функция ОписаниеСмещения(МенеджерЗаписи, ЭтоДубль)
	
	Результат = Новый Структура;
	Результат.Вставить("ГруппаПотребителя", МенеджерЗаписи.ГруппаПотребителя);
	Результат.Вставить("Топик", МенеджерЗаписи.Топик);
	Результат.Вставить("Раздел", МенеджерЗаписи.Раздел);
	Результат.Вставить("Смещение", МенеджерЗаписи.Смещение);
	Результат.Вставить("Состояние", МенеджерЗаписи.Состояние);
	Результат.Вставить("ЭтоДубль", ЭтоДубль);
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьКлючОчереди(ГруппаПотребителя, Топик, Раздел, Смещение)
	
	ПроверитьКлючРаздела(ГруппаПотребителя, Топик, Раздел);
	Если Смещение < 0 Тогда
		ВызватьИсключение "Смещение не может быть отрицательным";
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьКлючРаздела(ГруппаПотребителя, Топик, Раздел)
	
	Если Не ЗначениеЗаполнено(ГруппаПотребителя) Тогда
		ВызватьИсключение "Не заполнена группа потребителя";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Топик) Тогда
		ВызватьИсключение "Не заполнен топик";
	КонецЕсли;
	Если Раздел < 0 Тогда
		ВызватьИсключение "Раздел не может быть отрицательным";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
