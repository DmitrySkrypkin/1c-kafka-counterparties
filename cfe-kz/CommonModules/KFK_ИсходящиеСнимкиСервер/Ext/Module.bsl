Функция ВыборкаОжидающихСнимков(КодКонтура, Лимит, ТипыОбъектов)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + "
	|	Снимки.ИдентификаторСообщения КАК ИдентификаторСообщения
