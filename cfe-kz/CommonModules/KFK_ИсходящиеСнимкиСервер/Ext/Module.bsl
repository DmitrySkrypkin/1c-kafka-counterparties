// Проверяет исходящие записи контрагента и номенклатуры счёта (design, решение 6).
// Последняя запись объекта completed или записи нет - объект готов; failed - отказ; иначе - ожидание.
//
// Параметры:
//  КодКонтура - ПеречислениеСсылка.KFK_КодыКонтуров - контур поставки.
//  Счет - ДокументСсылка.СчетНаОплатуПокупателю - счёт исходящей записи.
//
// Возвращаемое значение:
//  Структура - Ожидание (Строка, пути через запятую), Отказ (Строка «код|путь|текст»).
//
Функция ПроверитьЗависимостиСчета(КодКонтура, Счет)

	Результат = Новый Структура("Ожидание, Отказ", "", "");
	Зависимости = KFK_АдаптерСчетовСервер.ЗависимостиИсходящегоСчета(Счет);
	Если Зависимости.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Объекты = Новый Массив;
	Для Каждого Зависимость Из Зависимости Цикл
		Объекты.Добавить(Зависимость.Объект);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Снимки.Объект КАК Объект,
	|	МАКСИМУМ(Снимки.ДатаЗаписи) КАК ДатаЗаписи
	|ПОМЕСТИТЬ Последние
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСнимки КАК Снимки
	|ГДЕ
	|	Снимки.КодКонтура = &КодКонтура
	|	И Снимки.Объект В (&Объекты)
	|
	|СГРУППИРОВАТЬ ПО
	|	Снимки.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Снимки.Объект КАК Объект,
	|	Снимки.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСнимки КАК Снимки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Последние КАК Последние
	|		ПО Снимки.Объект = Последние.Объект
	|			И Снимки.ДатаЗаписи = Последние.ДатаЗаписи
	|ГДЕ
	|	Снимки.КодКонтура = &КодКонтура";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("Объекты", Объекты);

	Состояния = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = ИмяСостоянияИсходящегоСнимка(Выборка.Состояние);
		// При равной дате записи незавершённая запись важнее завершённой.
		Если Имя <> "completed" Или Состояния.Получить(Выборка.Объект) = Неопределено Тогда
			Состояния.Вставить(Выборка.Объект, Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаемые = Новый Массив;
	Для Каждого Зависимость Из Зависимости Цикл
		Имя = Состояния.Получить(Зависимость.Объект);
		Если Имя = Неопределено Или Имя = "completed" Тогда
			Продолжить;
		КонецЕсли;
		Если Имя = "failed" Тогда
			Результат.Отказ = "DEPENDENCY_FAILED|" + Зависимость.Путь + "|Портал отклонил или не принял объект "
				+ Строка(Зависимость.Объект);
			Возврат Результат;
		КонецЕсли;
		Если Ожидаемые.Найти(Зависимость.Путь) = Неопределено Тогда
			Ожидаемые.Добавить(Зависимость.Путь);
		КонецЕсли;
	КонецЦикла;
	Результат.Ожидание = СтрСоединить(Ожидаемые, ",");

	Возврат Результат;

КонецФункции

