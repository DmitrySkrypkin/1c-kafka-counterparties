#Область ПрограммныйИнтерфейс

// Сохраняет сырое транспортное сообщение в Inbox до Kafka commit.
// Ключ записи: группа потребителя, топик, раздел, смещение.
// Повторная доставка с тем же ключом вторую строку не создаёт и существующую не меняет.
//
// Параметры:
//  ГруппаПотребителя - Строка - consumer group контура.
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  Топик - Строка - имя топика.
//  Раздел - Число - partition.
//  Смещение - Число - offset сообщения.
//  КлючСообщения - Строка - Kafka key.
//  Заголовки - Строка - JSON headers без секретов подключения.
//  Тело - Строка - сырой payload.
//  ВременнаяМеткаБрокера - Число - broker timestamp, обычно миллисекунды Unix.
//  ИдентификаторБрокера - Строка - id брокера, если компонент его вернул.
//  ДатаЗаписи - Дата, Неопределено - момент записи; пустое значение заменяется текущей датой сеанса.
//
// Возвращаемое значение:
//  Структура - ключ Inbox, код контура и признак ЭтоДубль.
//
Функция ЗаписатьВходящее(ГруппаПотребителя, КодКонтура, Топик, Раздел, Смещение, КлючСообщения = "", Заголовки = "", Тело = "", ВременнаяМеткаБрокера = 0, ИдентификаторБрокера = "", ДатаЗаписи = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ГруппаПотребителя) Тогда
		ВызватьИсключение "Не заполнена группа потребителя";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Топик) Тогда
		ВызватьИсключение "Не заполнен топик";
	КонецЕсли;
	Если Раздел < 0 Тогда
		ВызватьИсключение "Раздел не может быть отрицательным";
	КонецЕсли;
	Если Смещение < 0 Тогда
		ВызватьИсключение "Смещение не может быть отрицательным";
	КонецЕсли;
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	МенеджерЗаписи = МенеджерЗаписиВходящего(ГруппаПотребителя, Топик, Раздел, Смещение);
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат ОписаниеЗаписи(
			МенеджерЗаписи.ГруппаПотребителя,
			МенеджерЗаписи.Топик,
			МенеджерЗаписи.Раздел,
			МенеджерЗаписи.Смещение,
			МенеджерЗаписи.КодКонтура,
			МенеджерЗаписи.ДатаЗаписи,
			Истина);
	КонецЕсли;
	
	Момент = МоментЗаписи(ДатаЗаписи);
	МенеджерЗаписи.ГруппаПотребителя = ГруппаПотребителя;
	МенеджерЗаписи.Топик = Топик;
	МенеджерЗаписи.Раздел = Раздел;
	МенеджерЗаписи.Смещение = Смещение;
	МенеджерЗаписи.КодКонтура = ЗначениеКонтура;
	МенеджерЗаписи.КлючСообщения = КлючСообщения;
	МенеджерЗаписи.Заголовки = Заголовки;
	МенеджерЗаписи.Тело = Тело;
	МенеджерЗаписи.ВременнаяМеткаБрокера = ВременнаяМеткаБрокера;
	МенеджерЗаписи.ИдентификаторБрокера = ИдентификаторБрокера;
	МенеджерЗаписи.ДатаЗаписи = Момент;
	МенеджерЗаписи.Записать();
	
	Возврат ОписаниеЗаписи(ГруппаПотребителя, Топик, Раздел, Смещение, ЗначениеКонтура, Момент, Ложь);
	
КонецФункции

// Читает транспортную запись Inbox по ключу consumer group/topic/partition/offset.
//
// Параметры:
//  ГруппаПотребителя - Строка - consumer group.
//  Топик - Строка - имя топика.
//  Раздел - Число - partition.
//  Смещение - Число - offset.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля записи либо Неопределено, если строки нет.
//
Функция ПрочитатьВходящее(ГруппаПотребителя, Топик, Раздел, Смещение) Экспорт
	
	МенеджерЗаписи = МенеджерЗаписиВходящего(ГруппаПотребителя, Топик, Раздел, Смещение);
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = ОписаниеЗаписи(
		МенеджерЗаписи.ГруппаПотребителя,
		МенеджерЗаписи.Топик,
		МенеджерЗаписи.Раздел,
		МенеджерЗаписи.Смещение,
		МенеджерЗаписи.КодКонтура,
		МенеджерЗаписи.ДатаЗаписи,
		Ложь);
	Результат.Вставить("КлючСообщения", МенеджерЗаписи.КлючСообщения);
	Результат.Вставить("Заголовки", МенеджерЗаписи.Заголовки);
	Результат.Вставить("Тело", МенеджерЗаписи.Тело);
	Результат.Вставить("ВременнаяМеткаБрокера", МенеджерЗаписи.ВременнаяМеткаБрокера);
	Результат.Вставить("ИдентификаторБрокера", МенеджерЗаписи.ИдентификаторБрокера);
	
	Возврат Результат;
	
КонецФункции

// Удаляет транспортную запись Inbox. Нужна для тестов и административной очистки.
//
// Параметры:
//  ГруппаПотребителя - Строка - consumer group.
//  Топик - Строка - имя топика.
//  Раздел - Число - partition.
//  Смещение - Число - offset.
//
// Возвращаемое значение:
//  Булево - Истина, если запись была и удалена.
//
Функция УдалитьВходящее(ГруппаПотребителя, Топик, Раздел, Смещение) Экспорт
	
	МенеджерЗаписи = МенеджерЗаписиВходящего(ГруппаПотребителя, Топик, Раздел, Смещение);
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерЗаписи.Удалить();
	Возврат Истина;
	
КонецФункции

// Удаляет сырые входящие сообщения контура старше границы retention.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  Граница - Дата - записи с ДатаЗаписи строго раньше границы удаляются.
//
// Возвращаемое значение:
//  Число - сколько записей удалено.
//
Функция ОчиститьУстаревшие(КодКонтура, Граница) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Входящие.ГруппаПотребителя КАК ГруппаПотребителя,
	|	Входящие.Топик КАК Топик,
	|	Входящие.Раздел КАК Раздел,
	|	Входящие.Смещение КАК Смещение
	|ИЗ
	|	РегистрСведений.KFK_ВходящиеСообщения КАК Входящие
	|ГДЕ
	|	Входящие.КодКонтура = &КодКонтура
	|	И Входящие.ДатаЗаписи < &Граница";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Запрос.УстановитьПараметр("Граница", Граница);
	
	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если УдалитьВходящее(Выборка.ГруппаПотребителя, Выборка.Топик, Выборка.Раздел, Выборка.Смещение) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МенеджерЗаписиВходящего(ГруппаПотребителя, Топик, Раздел, Смещение)
	
	МенеджерЗаписи = РегистрыСведений.KFK_ВходящиеСообщения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ГруппаПотребителя = ГруппаПотребителя;
	МенеджерЗаписи.Топик = Топик;
	МенеджерЗаписи.Раздел = Раздел;
	МенеджерЗаписи.Смещение = Смещение;
	
	Возврат МенеджерЗаписи;
	
КонецФункции

Функция ОписаниеЗаписи(ГруппаПотребителя, Топик, Раздел, Смещение, КодКонтура, ДатаЗаписи, ЭтоДубль = Ложь)
	
	Результат = Новый Структура;
	Результат.Вставить("ГруппаПотребителя", ГруппаПотребителя);
	Результат.Вставить("Топик", Топик);
	Результат.Вставить("Раздел", Раздел);
	Результат.Вставить("Смещение", Смещение);
	Результат.Вставить("КодКонтура", КодКонтура);
	Результат.Вставить("ДатаЗаписи", ДатаЗаписи);
	Результат.Вставить("ЭтоДубль", ЭтоДубль);
	
	Возврат Результат;
	
КонецФункции

Функция МоментЗаписи(ДатаЗаписи)
	
	Если ДатаЗаписи = Неопределено Или Не ЗначениеЗаполнено(ДатаЗаписи) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;
	
	Возврат ДатаЗаписи;
	
КонецФункции

Функция ЗначениеКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

#КонецОбласти
