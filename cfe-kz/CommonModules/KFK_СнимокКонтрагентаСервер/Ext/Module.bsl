#Область ПрограммныйИнтерфейс

// Безопасный разбор JSON body в нормализованный отчёт DTO без записи бизнес-данных.
// oversized — длина строки больше МаксДлина; malformed — JSON не читается или не объект.
//
// Возвращаемое значение:
//  Строка - ok=1|0;error=...;id=...;name=...;uid=...;contracts=N;bank_accounts=N;emails=N;phones=N;addresses=N
//
Функция РазобратьТелоВDTO(ТелоJSON, МаксДлина = 1048576) Экспорт
	
	Если МаксДлина < 1 Тогда
		ВызватьИсключение "МаксДлина должна быть положительной";
	КонецЕсли;
	Если СтрДлина(Строка(ТелоJSON)) > МаксДлина Тогда
		Возврат ОтчетDTO(Ложь, "oversized", Неопределено);
	КонецЕсли;
	
	Попытка
		Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Исключение
		Возврат ОтчетDTO(Ложь, "malformed", Неопределено);
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат ОтчетDTO(Ложь, "malformed", Неопределено);
	КонецЕсли;
	
	Возврат ОтчетDTO(Истина, "", Данные);
	
КонецФункции

// Агрегирует все независимо обнаруживаемые ошибки базовых полей, bank_accounts и contracts.
// Не останавливается на первой ошибке. Коды ограничиваются каталогом ТЗ (fallback INTERNAL_ERROR).
//
// Возвращаемое значение:
//  Строка - ok=1|0;count=N;errors=code|path|message;...
//
Функция СобратьОшибкиВалидации(ТелоJSON) Экспорт
	
	Ошибки = Новый Массив;
	Ключи = Новый Соответствие;
	ДобавитьОшибкиИзОтчета(Ошибки, Ключи, ПроверитьБазовыеПоля(ТелоJSON));
	ДобавитьОшибкиИзОтчета(Ошибки, Ключи, ПроверитьБанковскиеСчета(ТелоJSON));
	ДобавитьОшибкиИзОтчета(Ошибки, Ключи, ПроверитьДоговоры(ТелоJSON));
	
	Если Ошибки.Количество() = 0 Тогда
		Возврат "ok=1" + Символы.ПС
			+ "count=0" + Символы.ПС
			+ "errors=";
	КонецЕсли;
	
	Возврат "ok=0" + Символы.ПС
		+ "count=" + Формат(Ошибки.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "errors=" + СтрСоединить(Ошибки, ";");
	
КонецФункции

// Каталог семи согласованных кодов ошибок ТЗ через запятую.
//
Функция КаталогКодовОшибок() Экспорт
	
	Возврат "REQUIRED_FIELD_MISSING,INVALID_FORMAT,UNSUPPORTED_VERSION,REFERENCE_NOT_FOUND,HEAD_CONTRAGENT_NOT_FOUND,DUPLICATE_CONFLICT,INTERNAL_ERROR";
	
КонецФункции

// Неизвестный код → INTERNAL_ERROR. Разрешённые коды возвращаются без изменений.
//
Функция НормализоватьКодОшибки(Код) Экспорт
	
	Если Не ЗначениеЗаполнено(Код) Тогда
		Возврат "INTERNAL_ERROR";
	КонецЕсли;
	
	Каталог = Новый Соответствие;
	Для Каждого Элемент Из СтрРазделить(КаталогКодовОшибок(), ",", Ложь) Цикл
		Каталог.Вставить(СокрЛП(Элемент), Истина);
	КонецЦикла;
	
	Если Каталог.Получить(Строка(Код)) = Истина Тогда
		Возврат Строка(Код);
	КонецЕсли;
	
	Возврат "INTERNAL_ERROR";
	
КонецФункции

// Человекочитаемый русский текст messages[].message по каталогу ТЗ §5.1.
// Уточнение — конкретное значение (uid, ИНН, версия и т.п.), без стека и внутренних id 1С.
//
Функция ЧеловекочитаемоеСообщениеОшибки(Код, Путь = "", Уточнение = "") Экспорт
	
	КодНорм = НормализоватьКодОшибки(Код);
	ПутьТекст = СокрЛП(Строка(Путь));
	Если ПутьТекст = "null" Тогда
		ПутьТекст = "";
	КонецЕсли;
	Значение = СокрЛП(Строка(Уточнение));
	
	Если КодНорм = "REQUIRED_FIELD_MISSING" Тогда
		Если ЗначениеЗаполнено(ПутьТекст) Тогда
			Возврат "Не указано обязательное поле " + ПутьТекст;
		КонецЕсли;
		Возврат "Не указано обязательное поле";
	КонецЕсли;
	
	Если КодНорм = "INVALID_FORMAT" Тогда
		Если ЗначениеЗаполнено(ПутьТекст) И ЗначениеЗаполнено(Значение) Тогда
			Возврат "Некорректный формат поля " + ПутьТекст + ": " + Значение;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПутьТекст) Тогда
			Возврат "Некорректный формат поля " + ПутьТекст;
		КонецЕсли;
		Возврат "Значение поля не соответствует ожидаемому формату";
	КонецЕсли;
	
	Если КодНорм = "UNSUPPORTED_VERSION" Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат "Версия схемы " + Значение + " не поддерживается";
		КонецЕсли;
		Возврат "Версия схемы не поддерживается";
	КонецЕсли;
	
	Если КодНорм = "REFERENCE_NOT_FOUND" Тогда
		Если СтрНайти(НРег(ПутьТекст), "organization") > 0 Тогда
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат "Не найдена организация с uid " + Значение;
			КонецЕсли;
			Если ЗначениеЗаполнено(ПутьТекст) Тогда
				Возврат "Не найдена организация по ссылке " + ПутьТекст;
			КонецЕсли;
			Возврат "Не найдена организация по ссылке";
		КонецЕсли;
		Если ЗначениеЗаполнено(Значение) И ЗначениеЗаполнено(ПутьТекст) Тогда
			Возврат "Не найден элемент справочника по ссылке " + ПутьТекст + " (" + Значение + ")";
		КонецЕсли;
		Если ЗначениеЗаполнено(ПутьТекст) Тогда
			Возврат "Не найден элемент справочника по ссылке " + ПутьТекст;
		КонецЕсли;
		Возврат "Не найден элемент справочника по ссылке";
	КонецЕсли;
	
	Если КодНорм = "HEAD_CONTRAGENT_NOT_FOUND" Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат "Головной контрагент (" + Значение + ") не найден после 3 попыток";
		КонецЕсли;
		Возврат "Головной контрагент не найден после исчерпания попыток";
	КонецЕсли;
	
	Если КодНорм = "DUPLICATE_CONFLICT" Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат "Найдено более одного контрагента по ключу " + Значение;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПутьТекст) Тогда
			Возврат "Конфликт сопоставления по полю " + ПутьТекст + ": невозможно однозначно определить целевой элемент";
		КонецЕсли;
		Возврат "Найдено несколько контрагентов-кандидатов, невозможно однозначно определить целевой элемент";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат "Ошибка записи объекта: " + Значение;
	КонецЕсли;
	Возврат "Ошибка записи объекта";
	
КонецФункции

// Если Текст пустой, равен коду или технический/английский stub — подставляет формулировку ТЗ.
//
Функция ОбеспечитьЧеловекочитаемоеСообщение(Код, Путь = "", Текст = "", Уточнение = "") Экспорт
	
	КодНорм = НормализоватьКодОшибки(Код);
	Исходный = СокрЛП(Строка(Текст));
	
	Если СтрНайти(Исходный, "|") > 0 Тогда
		Части = СтрРазделить(Исходный, "|", Ложь);
		Если Части.Количество() >= 3 Тогда
			Исходный = СокрЛП(Части[2]);
		КонецЕсли;
	КонецЕсли;
	
	НуженКаталог = Не ЗначениеЗаполнено(Исходный)
		Или Исходный = КодНорм
		Или ВРег(Исходный) = ВРег(Строка(Код))
		Или НРег(Исходный) = "organization resolve failed"
		Или СтрНачинаетсяС(НРег(Исходный), "organization resolve");
	
	Если Не НуженКаталог И Не ТекстСодержитКириллицу(Исходный) Тогда
		НуженКаталог = Истина;
	КонецЕсли;
	
	Если НуженКаталог Тогда
		Возврат ЧеловекочитаемоеСообщениеОшибки(КодНорм, Путь, Уточнение);
	КонецЕсли;
	
	Возврат Исходный;
	
КонецФункции

Функция ТекстСодержитКириллицу(Текст)
	
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Сред(Текст, Индекс, 1));
		Если (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Статическая проверка: возвращает незарегистрированные коды из CSV через ';'.
// Пустая строка — все коды входят в каталог.
//
Функция НайтиНезарегистрированныеКоды(КодыCSV) Экспорт
	
	Каталог = Новый Соответствие;
	Для Каждого Элемент Из СтрРазделить(КаталогКодовОшибок(), ",", Ложь) Цикл
		Каталог.Вставить(СокрЛП(Элемент), Истина);
	КонецЦикла;
	
	Неизвестные = Новый Массив;
	Для Каждого Элемент Из СтрРазделить(Строка(КодыCSV), ",", Ложь) Цикл
		Код = СокрЛП(Элемент);
		Если Не ЗначениеЗаполнено(Код) Тогда
			Продолжить;
		КонецЕсли;
		Если Каталог.Получить(Код) <> Истина Тогда
			Неизвестные.Добавить(Код);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Неизвестные, ";");
	
КонецФункции

// Проверка contracts: ключ id либо uid, type realization/purchase, organization.id+uid при наличии.
//
Функция ПроверитьДоговоры(ТелоJSON) Экспорт
	
	Разбор = РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		Возврат "ok=0" + Символы.ПС
			+ "errors=INVALID_FORMAT|body|body not a JSON object";
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Ошибки = Новый Массив;
	Договоры = Данные.Получить("contracts");
	Если Договоры = Неопределено Или Договоры = Null Тогда
		Возврат "ok=1" + Символы.ПС + "errors=";
	КонецЕсли;
	Если ТипЗнч(Договоры) <> Тип("Массив") Тогда
		ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", "contracts", "contracts должен быть массивом");
		Возврат "ok=0" + Символы.ПС + "errors=" + СтрСоединить(Ошибки, ";");
	КонецЕсли;
	
	Индекс = 0;
	Для Каждого Элемент Из Договоры Цикл
		Префикс = "contracts[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]";
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", Префикс, "Элемент contracts должен быть объектом");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		ЗначениеИд = Элемент.Получить("id");
		ЗначениеУид = Элемент.Получить("uid");
		ЕстьИд = ЗначениеИд <> Неопределено И ЗначениеИд <> Null;
		ЕстьУид = ЗначениеУид <> Неопределено И ЗначениеУид <> Null И ЗначениеЗаполнено(Строка(ЗначениеУид));
		Если Не ЕстьИд И Не ЕстьУид Тогда
			ДобавитьОшибкуВалидации(Ошибки, "REQUIRED_FIELD_MISSING", Префикс, "Нужен id или uid договора");
		КонецЕсли;
		Если ЕстьИд И (ТипЗнч(ЗначениеИд) <> Тип("Число") Или ЗначениеИд < 1 Или ЗначениеИд <> Цел(ЗначениеИд)) Тогда
			ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", Префикс + ".id", "id договора должен быть положительным целым");
		КонецЕсли;
		Если ЕстьУид И (ТипЗнч(ЗначениеУид) <> Тип("Строка") Или Не ЭтоUUID(ЗначениеУид)) Тогда
			ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", Префикс + ".uid", "uid договора должен быть UUID");
		КонецЕсли;
		
		ЗначениеТипа = Элемент.Получить("type");
		Если ЗначениеТипа <> Неопределено И ЗначениеТипа <> Null Тогда
			Если ТипЗнч(ЗначениеТипа) <> Тип("Строка")
				Или (ЗначениеТипа <> "realization" И ЗначениеТипа <> "purchase") Тогда
				ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", Префикс + ".type", "type договора realization или purchase");
			КонецЕсли;
		КонецЕсли;
		
		ПроверитьNullableСтроку(Ошибки, Элемент, "number", Префикс);
		ПроверитьNullableСтроку(Ошибки, Элемент, "name", Префикс);
		ПроверитьNullableСтроку(Ошибки, Элемент, "date", Префикс);
		
		Организация = Элемент.Получить("organization");
		Если Организация <> Неопределено И Организация <> Null Тогда
			ПутьОрг = Префикс + ".organization";
			Если ТипЗнч(Организация) <> Тип("Соответствие") Тогда
				ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", ПутьОрг, "organization должен быть объектом");
			Иначе
				ОргИд = Организация.Получить("id");
				ОргУид = Организация.Получить("uid");
				Если ОргИд = Неопределено Тогда
					ДобавитьОшибкуВалидации(Ошибки, "REQUIRED_FIELD_MISSING", ПутьОрг + ".id", "organization.id обязателен");
				ИначеЕсли ТипЗнч(ОргИд) <> Тип("Число") Тогда
					ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", ПутьОрг + ".id", "organization.id должен быть числом");
				КонецЕсли;
				Если ОргУид = Неопределено Или Не ЗначениеЗаполнено(Строка(ОргУид)) Тогда
					ДобавитьОшибкуВалидации(Ошибки, "REQUIRED_FIELD_MISSING", ПутьОрг + ".uid", "organization.uid обязателен");
				ИначеЕсли ТипЗнч(ОргУид) <> Тип("Строка") Или Не ЭтоUUID(ОргУид) Тогда
					ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", ПутьОрг + ".uid", "organization.uid должен быть UUID");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Если Ошибки.Количество() = 0 Тогда
		Возврат "ok=1" + Символы.ПС + "errors=";
	КонецЕсли;
	
	Возврат "ok=0" + Символы.ПС + "errors=" + СтрСоединить(Ошибки, ";");
	
КонецФункции

Функция ПроверитьБанковскиеСчета(ТелоJSON) Экспорт
	
	Разбор = РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		Возврат "ok=0" + Символы.ПС
			+ "errors=INVALID_FORMAT|body|body not a JSON object";
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Ошибки = Новый Массив;
	Счета = Данные.Получить("bank_accounts");
	Если Счета = Неопределено Или Счета = Null Тогда
		Возврат "ok=1" + Символы.ПС + "errors=";
	КонецЕсли;
	Если ТипЗнч(Счета) <> Тип("Массив") Тогда
		ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", "bank_accounts", "bank_accounts должен быть массивом");
		Возврат "ok=0" + Символы.ПС + "errors=" + СтрСоединить(Ошибки, ";");
	КонецЕсли;
	
	Индекс = 0;
	Для Каждого Элемент Из Счета Цикл
		Префикс = "bank_accounts[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]";
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", Префикс, "Элемент bank_accounts должен быть объектом");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		ЗначениеИд = Элемент.Получить("id");
		Если ЗначениеИд = Неопределено Тогда
			ДобавитьОшибкуВалидации(Ошибки, "REQUIRED_FIELD_MISSING", Префикс + ".id", "id счёта обязателен");
		ИначеЕсли ТипЗнч(ЗначениеИд) <> Тип("Число") Или ЗначениеИд < 1 Или ЗначениеИд <> Цел(ЗначениеИд) Тогда
			ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", Префикс + ".id", "id счёта должен быть положительным целым");
		КонецЕсли;
		
		ПроверитьNullableСтроку(Ошибки, Элемент, "number", Префикс);
		ПроверитьNullableСтроку(Ошибки, Элемент, "bic", Префикс);
		ПроверитьNullableСтроку(Ошибки, Элемент, "name", Префикс);
		ПроверитьNullableБулево(Ошибки, Элемент, "is_default", Префикс);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Если Ошибки.Количество() = 0 Тогда
		Возврат "ok=1" + Символы.ПС + "errors=";
	КонецЕсли;
	
	Возврат "ok=0" + Символы.ПС + "errors=" + СтрСоединить(Ошибки, ";");
	
КонецФункции

Функция НормализоватьОпциональныеПоля(ТелоJSON) Экспорт
	
	Разбор = РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		ВызватьИсключение "Нельзя нормализовать неразборный JSON";
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Имя = НормализоватьСтроку(Данные.Получить("name"));
	Почты = НормализоватьСтроковыйМассив(Данные.Получить("emails"));
	Телефоны = НормализоватьСтроковыйМассив(Данные.Получить("phones"));
	Договоры = НормализоватьМассивОбъектов(Данные.Получить("contracts"));
	Счета = НормализоватьМассивОбъектов(Данные.Получить("bank_accounts"));
	Адреса = НормализоватьМассивОбъектов(Данные.Получить("addresses"));
	
	Возврат "name=" + Имя + Символы.ПС
		+ "emails=" + Формат(Почты.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "phones=" + Формат(Телефоны.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "contracts=" + Формат(Договоры.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "bank_accounts=" + Формат(Счета.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "addresses=" + Формат(Адреса.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "emails_csv=" + СтрСоединить(Почты, ",") + Символы.ПС
		+ "phones_csv=" + СтрСоединить(Телефоны, ",");
	
КонецФункции

Функция ПроверитьБазовыеПоля(ТелоJSON) Экспорт
	
	Разбор = РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		Возврат "ok=0" + Символы.ПС
			+ "errors=INVALID_FORMAT|body|body not a JSON object";
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Ошибки = Новый Массив;
	
	ЗначениеИд = Данные.Получить("id");
	Если ЗначениеИд = Неопределено Тогда
		ДобавитьОшибкуВалидации(Ошибки, "REQUIRED_FIELD_MISSING", "id", "Поле id обязательно");
	ИначеЕсли ТипЗнч(ЗначениеИд) <> Тип("Число") Или ЗначениеИд < 1 Или ЗначениеИд <> Цел(ЗначениеИд) Тогда
		ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", "id", "id должен быть положительным целым");
	КонецЕсли;
	
	ЗначениеИмя = Данные.Получить("name");
	Если ЗначениеИмя = Неопределено Тогда
		ДобавитьОшибкуВалидации(Ошибки, "REQUIRED_FIELD_MISSING", "name", "Поле name обязательно");
	ИначеЕсли ТипЗнч(ЗначениеИмя) <> Тип("Строка") Или Не ЗначениеЗаполнено(СокрЛП(ЗначениеИмя)) Тогда
		ДобавитьОшибкуВалидации(Ошибки, "REQUIRED_FIELD_MISSING", "name", "Поле name не может быть пустым");
	КонецЕсли;
	
	ЗначениеУид = Данные.Получить("uid");
	Если ЗначениеУид <> Неопределено И ЗначениеУид <> Null Тогда
		Если ТипЗнч(ЗначениеУид) <> Тип("Строка") Или Не ЭтоUUID(ЗначениеУид) Тогда
			ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", "uid", "uid должен быть UUID");
		КонецЕсли;
	КонецЕсли;
	
	ЗначениеТипа = Данные.Получить("type_entity");
	Если ЗначениеТипа <> Неопределено И ЗначениеТипа <> Null Тогда
		Если ТипЗнч(ЗначениеТипа) <> Тип("Строка") Или Не ЭтоДопустимыйТипЛица(ЗначениеТипа) Тогда
			ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", "type_entity", "Недопустимый type_entity");
		КонецЕсли;
	КонецЕсли;
	
	Если Ошибки.Количество() = 0 Тогда
		Возврат "ok=1" + Символы.ПС + "errors=";
	КонецЕсли;
	
	Возврат "ok=0" + Символы.ПС
		+ "errors=" + СтрСоединить(Ошибки, ";");
	
КонецФункции

// Возвращает контракт топиков контура: дочерние коллекции без собственных топиков/consumer.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF или KZ.
//
// Возвращаемое значение:
//  Строка - incoming/status/forbidden.
//
Функция КонфигурацияТопиков(КодКонтура) Экспорт
	
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	Возврат "incoming=" + Настройки.ТопикВходящий + Символы.ПС
		+ "status=" + Настройки.ТопикСтатусов + Символы.ПС
		+ "forbidden=contracts,bank_accounts" + Символы.ПС
		+ "children=parent-snapshot";
	
КонецФункции

// Разбирает JSON тела снимка и считает дочерние коллекции как часть того же процесса.
//
// Параметры:
//  ТелоJSON - Строка - body сообщения.
//  ИдентификаторСообщения - Строка - message id родителя.
//
// Возвращаемое значение:
//  Строка - отчёт по коллекциям.
//
Функция ОписатьДочерниеКоллекции(ТелоJSON, ИдентификаторСообщения) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ВызватьИсключение "Не заполнен идентификатор сообщения родителя";
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Тело снимка должно быть JSON-объектом";
	КонецЕсли;
	
	Договоры = КоличествоЭлементовКоллекции(Данные.Получить("contracts"));
	Счета = КоличествоЭлементовКоллекции(Данные.Получить("bank_accounts"));
	
	Возврат "message=" + ИдентификаторСообщения + Символы.ПС
		+ "contracts=" + Формат(Договоры, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "bank_accounts=" + Формат(Счета, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "separate_topics=0" + Символы.ПС
		+ "same_process=1";
	
КонецФункции

// Проверяет атомарность: при сбое родителя дочерние коллекции не считаются применёнными.
// Имитация одной транзакции без записи в ИБ.
//
// Параметры:
//  ТелоJSON - Строка - body.
//  ИдентификаторСообщения - Строка - message id.
//  СбойРодителя - Булево - если Истина, транзакция откатывается.
//
// Возвращаемое значение:
//  Строка - applied/rolled_back отчёт.
//
Функция ПроверитьАтомарностьКоллекций(ТелоJSON, ИдентификаторСообщения, СбойРодителя = Ложь) Экспорт
	
	Описание = ОписатьДочерниеКоллекции(ТелоJSON, ИдентификаторСообщения);
	Если СбойРодителя Тогда
		Возврат Описание + Символы.ПС
			+ "parent=failed" + Символы.ПС
			+ "children_applied=0" + Символы.ПС
			+ "rolled_back=1";
	КонецЕсли;
	
	Возврат Описание + Символы.ПС
		+ "parent=ok" + Символы.ПС
		+ "children_applied=1" + Символы.ПС
		+ "rolled_back=0";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализоватьСтроку(Значение)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

Функция НормализоватьСтроковыйМассив(Значение)
	
	Результат = Новый Массив;
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Элемент Из Значение Цикл
		Если Элемент = Неопределено Или Элемент = Null Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЭлемента = СокрЛП(Строка(Элемент));
		Если ЗначениеЗаполнено(СтрокаЭлемента) Тогда
			Результат.Добавить(СтрокаЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НормализоватьМассивОбъектов(Значение)
	
	Результат = Новый Массив;
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Элемент Из Значение Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьNullableСтроку(Ошибки, Объект, ИмяПоля, Префикс)
	
	Значение = Объект.Получить(ИмяПоля);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", Префикс + "." + ИмяПоля, ИмяПоля + " должен быть строкой или null");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьNullableБулево(Ошибки, Объект, ИмяПоля, Префикс)
	
	Значение = Объект.Получить(ИмяПоля);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Булево") Тогда
		ДобавитьОшибкуВалидации(Ошибки, "INVALID_FORMAT", Префикс + "." + ИмяПоля, ИмяПоля + " должен быть булевым или null");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОшибкуВалидации(Ошибки, Код, Путь, Сообщение)
	
	Ошибки.Добавить(НормализоватьКодОшибки(Код) + "|" + Путь + "|" + Сообщение);
	
КонецПроцедуры

Процедура ДобавитьОшибкиИзОтчета(Ошибки, Ключи, Отчет)
	
	ТекстОшибок = "";
	Для Каждого СтрокаОтчета Из СтрРазделить(Строка(Отчет), Символы.ПС, Ложь) Цикл
		Если СтрНачинаетсяС(СтрокаОтчета, "errors=") Тогда
			ТекстОшибок = Сред(СтрокаОтчета, 8);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТекстОшибок) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из СтрРазделить(ТекстОшибок, ";", Ложь) Цикл
		Запись = СокрЛП(Элемент);
		Если Не ЗначениеЗаполнено(Запись) Тогда
			Продолжить;
		КонецЕсли;
		
		Части = СтрРазделить(Запись, "|", Ложь);
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		
		Код = НормализоватьКодОшибки(СокрЛП(Части[0]));
		Путь = СокрЛП(Части[1]);
		Сообщение = "";
		Если Части.Количество() > 2 Тогда
			Сообщение = СокрЛП(Части[2]);
		КонецЕсли;
		
		Ключ = Код + "|" + Путь;
		Если Ключи.Получить(Ключ) = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Ключи.Вставить(Ключ, Истина);
		Ошибки.Добавить(Код + "|" + Путь + "|" + Сообщение);
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоUUID(Значение)
	
	Шаблон = "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$";
	Возврат СтрДлина(Значение) = 36 И СтрПодобнаПоРегулярномуВыражению(Значение, Шаблон);
	
КонецФункции

Функция ЭтоДопустимыйТипЛица(Значение)
	
	Возврат Значение = "legal"
		Или Значение = "physical_person"
		Или Значение = "legal_outside"
		Или Значение = "sole_proprietor";
	
КонецФункции

Функция ОтчетDTO(Успех, КодОшибки, Данные)
	
	Ид = "";
	Имя = "";
	Уид = "";
	Договоры = 0;
	Счета = 0;
	Почты = 0;
	Телефоны = 0;
	Адреса = 0;
	
	Если Данные <> Неопределено Тогда
		ЗначениеИд = Данные.Получить("id");
		Если ЗначениеИд <> Неопределено Тогда
			Ид = Формат(ЗначениеИд, "ЧН=0; ЧГ=");
		КонецЕсли;
		ЗначениеИмя = Данные.Получить("name");
		Если ЗначениеИмя <> Неопределено Тогда
			Имя = Строка(ЗначениеИмя);
		КонецЕсли;
		ЗначениеУид = Данные.Получить("uid");
		Если ЗначениеУид <> Неопределено Тогда
			Уид = Строка(ЗначениеУид);
		КонецЕсли;
		Договоры = БезопасноеКоличество(Данные.Получить("contracts"));
		Счета = БезопасноеКоличество(Данные.Получить("bank_accounts"));
		Почты = БезопасноеКоличество(Данные.Получить("emails"));
		Телефоны = БезопасноеКоличество(Данные.Получить("phones"));
		Адреса = БезопасноеКоличество(Данные.Получить("addresses"));
	КонецЕсли;
	
	Возврат "ok=" + ?(Успех, "1", "0") + Символы.ПС
		+ "error=" + КодОшибки + Символы.ПС
		+ "id=" + Ид + Символы.ПС
		+ "name=" + Имя + Символы.ПС
		+ "uid=" + Уид + Символы.ПС
		+ "contracts=" + Формат(Договоры, "ЧН=0; ЧГ=") + Символы.ПС
		+ "bank_accounts=" + Формат(Счета, "ЧН=0; ЧГ=") + Символы.ПС
		+ "emails=" + Формат(Почты, "ЧН=0; ЧГ=") + Символы.ПС
		+ "phones=" + Формат(Телефоны, "ЧН=0; ЧГ=") + Символы.ПС
		+ "addresses=" + Формат(Адреса, "ЧН=0; ЧГ=");
	
КонецФункции

Функция БезопасноеКоличество(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Значение.Количество();
	
КонецФункции

Функция КоличествоЭлементовКоллекции(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ВызватьИсключение "Коллекция снимка должна быть массивом";
	КонецЕсли;
	
	Возврат Значение.Количество();
	
КонецФункции

