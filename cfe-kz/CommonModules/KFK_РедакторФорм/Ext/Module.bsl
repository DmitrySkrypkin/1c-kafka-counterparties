// (https://github.com/huxuxuya/1cFormEditor) для расширения ИнтеграцияApacheKafka.
// Префикс элементов: KFK_. Маркер подготовки формы: KFK_ФормаПодготовлена.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет, выполнялась ли уже подготовка формы (есть маркер KFK_ФормаПодготовлена).
// Маркер не создаёт — см. ОтметитьФормуПодготовленной (только после успешной подготовки).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
// Возвращаемое значение:
//  Булево - Истина, если форма уже была подготовлена.
//
Функция ФормаПодготовлена(Форма) Экспорт

	Возврат Форма.Элементы.Найти("KFK_ФормаПодготовлена") <> Неопределено;

КонецФункции

// Ставит скрытую декорацию-маркер успешной подготовки формы.
//
Процедура ОтметитьФормуПодготовленной(Форма) Экспорт

	Если Форма.Элементы.Найти("KFK_ФормаПодготовлена") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Маркер = Форма.Элементы.Добавить("KFK_ФормаПодготовлена", Тип("ДекорацияФормы"));
	Маркер.Видимость = Ложь;
	Маркер.Доступность = Ложь;

КонецПроцедуры

// Создаёт контекст элемента, в рамках которого будет создан элемент формы.
//
Функция НовыйКонтекстЭлемента(Форма, Родитель = Неопределено,
	РасположитьПередЭлементом = Неопределено, СвойстваЭлемента = Неопределено) Экспорт

	СтруктураКонтекст = Новый Структура;
	СтруктураКонтекст.Вставить("Форма", Форма);
	СтруктураКонтекст.Вставить("Родитель", Родитель);
	СтруктураКонтекст.Вставить("РасположитьПередЭлементом", РасположитьПередЭлементом);
	Если СвойстваЭлемента = Неопределено Тогда
		СтруктураКонтекст.Вставить("Свойства", Новый Структура);
	Иначе
		СтруктураКонтекст.Вставить("Свойства", СвойстваЭлемента);
	КонецЕсли;

	Возврат СтруктураКонтекст;

КонецФункции

// Добавляет поле формы. В свойствах обычно задают ПутьКДанным и при необходимости Вид.
//
Функция НовоеПолеФормы(КонтекстЭлемента, ИмяПоля) Экспорт

	Форма = КонтекстЭлемента.Форма;
	Родитель = КонтекстЭлемента.Родитель;
	Свойства = КонтекстЭлемента.Свойства;

	ПолеФормы = Форма.Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), Родитель);

	Если ТипЗнч(Свойства) = Тип("Структура") И Свойства.Свойство("Вид") Тогда
		ПолеФормы.Вид = Свойства.Вид;
	Иначе
		ПолеФормы.Вид = ВидПоляФормы.ПолеВвода;
	КонецЕсли;

	ПутьКДанным = Неопределено;
	Если ТипЗнч(Свойства) = Тип("Структура") Тогда
		Свойства.Свойство("ПутьКДанным", ПутьКДанным);
		СвойстваБезПути = Новый Структура;
		Для Каждого КлючИЗначение Из Свойства Цикл
			Если КлючИЗначение.Ключ <> "ПутьКДанным" Тогда
				СвойстваБезПути.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(ПолеФормы, СвойстваБезПути);
	КонецЕсли;

	Если ПутьКДанным <> Неопределено Тогда
		ПолеФормы.ПутьКДанным = ПутьКДанным;
	КонецЕсли;

	РасположитьПередЭлементом(КонтекстЭлемента, ПолеФормы);

	Возврат ПолеФормы;

КонецФункции

// Добавляет группу формы.
//
Функция НоваяГруппаФормы(КонтекстЭлемента, ИмяГруппы, Заголовок = "") Экспорт

	Форма = КонтекстЭлемента.Форма;
	Родитель = КонтекстЭлемента.Родитель;
	Свойства = КонтекстЭлемента.Свойства;

	ГруппаФормы = Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Родитель);
	Если ЗначениеЗаполнено(Заголовок) Тогда
		ГруппаФормы.Заголовок = Заголовок;
	КонецЕсли;
	Если ТипЗнч(Свойства) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ГруппаФормы, Свойства);
	КонецЕсли;
	РасположитьПередЭлементом(КонтекстЭлемента, ГруппаФормы);

	Возврат ГруппаФормы;

КонецФункции

// Обычная группа: вертикальная, без рамки; заголовок показывается только если передан.
//
Функция НоваяГруппаОбычная(КонтекстЭлемента, ИмяЭлемента, Заголовок = "") Экспорт

	Форма = КонтекстЭлемента.Форма;
	Родитель = КонтекстЭлемента.Родитель;
	Свойства = КонтекстЭлемента.Свойства;

	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), Родитель);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	Если ЗначениеЗаполнено(Заголовок) Тогда
		НовыйЭлемент.Заголовок = Заголовок;
		НовыйЭлемент.ОтображатьЗаголовок = Истина;
	Иначе
		НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	КонецЕсли;

	РасположитьПередЭлементом(КонтекстЭлемента, НовыйЭлемент);
	Если ТипЗнч(Свойства) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, Свойства);
	КонецЕсли;

	Возврат НовыйЭлемент;

КонецФункции

// Поле ввода реквизита объекта: ПутьКДанным = Объект.<ИмяРеквизита>, имя элемента = ИмяРеквизита.
//
Функция НовоеПолеФормыРеквизитОбъекта(КонтекстЭлемента, ИмяРеквизита) Экспорт

	Форма = КонтекстЭлемента.Форма;
	Родитель = КонтекстЭлемента.Родитель;
	Свойства = КонтекстЭлемента.Свойства;

	Если ТипЗнч(Свойства) = Тип("Структура") Тогда
		Если Не Свойства.Свойство("ПутьКДанным") Тогда
			Свойства.Вставить("ПутьКДанным", "Объект." + ИмяРеквизита);
		КонецЕсли;
	Иначе
		Свойства = Новый Структура;
		Свойства.Вставить("ПутьКДанным", "Объект." + ИмяРеквизита);
	КонецЕсли;

	ПолеФормы = Форма.Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Родитель);
	ПолеФормы.Вид = ВидПоляФормы.ПолеВвода;
	ЗаполнитьЗначенияСвойств(ПолеФормы, Свойства);
	РасположитьПередЭлементом(КонтекстЭлемента, ПолеФормы);
	Свойства.Удалить("ПутьКДанным");

	Возврат ПолеФормы;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПереместитьЭлемент(ПолеФормы, РасположитьПеред, Родитель, Форма)

	Если Родитель = Неопределено Тогда
		Родитель = Форма;
	КонецЕсли;

	Если РасположитьПеред <> Неопределено Тогда
		Форма.Элементы.Переместить(ПолеФормы, Родитель, РасположитьПеред);
	КонецЕсли;

КонецПроцедуры

Процедура РасположитьПередЭлементом(КонтекстЭлемента, Элемент)

	Форма = КонтекстЭлемента.Форма;
	Родитель = Неопределено;
	РасположитьПеред = Неопределено;
	КонтекстЭлемента.Свойство("Родитель", Родитель);
	КонтекстЭлемента.Свойство("РасположитьПередЭлементом", РасположитьПеред);

	Если РасположитьПеред <> Неопределено Тогда
		ПереместитьЭлемент(Элемент, РасположитьПеред, Родитель, Форма);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
