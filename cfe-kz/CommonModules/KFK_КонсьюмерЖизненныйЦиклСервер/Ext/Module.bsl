#Область ПрограммныйИнтерфейс

// Собирает уникальный ключ фонового consumer: контур + consumer group + индекс воркера.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF или KZ.
//  ГруппаПотребителя - Строка - Kafka consumer group.
//  ИндексВоркера - Число - ноль и больше.
//
// Возвращаемое значение:
//  Строка - ключ фонового задания.
//
Функция КлючЗадания(КодКонтура, ГруппаПотребителя, ИндексВоркера = 0) Экспорт
	
	ИмяКонтура = ИмяКодаКонтура(КодКонтура);
	Если Не ЗначениеЗаполнено(ГруппаПотребителя) Тогда
		ВызватьИсключение "Не заполнена группа потребителя";
	КонецЕсли;
	Если ИндексВоркера < 0 Тогда
		ВызватьИсключение "Индекс воркера не может быть отрицательным";
	КонецЕсли;
	
	Возврат СтрШаблон("СлушатьСообщения_%1_%2_%3", ИмяКонтура, ГруппаПотребителя, Формат(ИндексВоркера, "ЧН=0; ЧГ=0"));
	
КонецФункции

// Идемпотентно запускает фоновый consumer. Повтор при уже активном ключе не создаёт второе задание.
//
// Параметры:
//  ДанныеКонсьюмера - Структура - параметры справочника консьюмера для СлушатьСообщения.
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур поставки.
//  ИндексВоркера - Число - индекс worker.
//
// Возвращаемое значение:
//  Строка - отчёт: started=1|0;already=1|0;key=...;active=...
//
Функция Запустить(ДанныеКонсьюмера, КодКонтура, ИндексВоркера = 0) Экспорт
	
	Идентичность = KFK_НастройкиКонтуровСервер.ИдентичностьКонтура(КодКонтура);
	Ключ = КлючЗадания(Идентичность.КодКонтура, Идентичность.ГруппаПотребителя, ИндексВоркера);
	Активные = АктивныеЗаданияПоКлючу(Ключ);
	
	Если Активные.Количество() > 0 Тогда
		Возврат "started=0" + Символы.ПС
			+ "already=1" + Символы.ПС
			+ "key=" + Ключ + Символы.ПС
			+ "active=" + Формат(Активные.Количество(), "ЧН=0; ЧГ=0");
	КонецЕсли;
	
	Параметры = KFK_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеКонсьюмера);
	ИмяКонтура = ИмяКодаКонтура(Идентичность.КодКонтура);
	ФоновыеЗадания.Выполнить(
		"KFK_Интеграция.СлушатьСообщения",
		Параметры,
		Ключ,
		СтрШаблон("Consumer Kafka [%1/%2/%3]", ИмяКонтура, Идентичность.ГруппаПотребителя, Формат(ИндексВоркера, "ЧН=0; ЧГ=0")));
	
	АктивныеПосле = АктивныеЗаданияПоКлючу(Ключ);
	Возврат "started=1" + Символы.ПС
		+ "already=0" + Символы.ПС
		+ "key=" + Ключ + Символы.ПС
		+ "active=" + Формат(АктивныеПосле.Количество(), "ЧН=0; ЧГ=0");
	
КонецФункции

// Останавливает активные фоновые задания consumer с данным ключом.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  ИндексВоркера - Число - индекс worker.
//
// Возвращаемое значение:
//  Строка - отчёт: cancelled=N;key=...
//
Функция Остановить(КодКонтура, ИндексВоркера = 0) Экспорт
	
	Идентичность = KFK_НастройкиКонтуровСервер.ИдентичностьКонтура(КодКонтура);
	Ключ = КлючЗадания(Идентичность.КодКонтура, Идентичность.ГруппаПотребителя, ИндексВоркера);
	Активные = АктивныеЗаданияПоКлючу(Ключ);
	Отменено = 0;
	Для Каждого Задание Из Активные Цикл
		Задание.Отменить();
		Отменено = Отменено + 1;
	КонецЦикла;
	
	Возврат "cancelled=" + Формат(Отменено, "ЧН=0; ЧГ=0") + Символы.ПС + "key=" + Ключ;
	
КонецФункции

// Возвращает наблюдаемое состояние consumer по ключу.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  ИндексВоркера - Число - индекс worker.
//
// Возвращаемое значение:
//  Строка - отчёт: active=N;key=...;transport=direct-component
//
Функция Состояние(КодКонтура, ИндексВоркера = 0) Экспорт
	
	Идентичность = KFK_НастройкиКонтуровСервер.ИдентичностьКонтура(КодКонтура);
	Ключ = КлючЗадания(Идентичность.КодКонтура, Идентичность.ГруппаПотребителя, ИндексВоркера);
	Активные = АктивныеЗаданияПоКлючу(Ключ);
	
	Возврат "active=" + Формат(Активные.Количество(), "ЧН=0; ЧГ=0") + Символы.ПС
		+ "key=" + Ключ + Символы.ПС
		+ "transport=direct-component";
	
КонецФункции

// Строит план запуска worker по настройкам и фактическому числу partition.
// Полезных worker не больше числа partition; расхождения дают предупреждение, но не блокируют старт.
//
// Параметры:
//  КоличествоВоркеров - Число - WorkerCount из настроек.
//  ОжидаемоеЧислоРазделов - Число - ExpectedPartitionCount.
//  ФактическоеЧислоРазделов - Число - partition топика contragents у брокера.
//
// Возвращаемое значение:
//  Строка - отчёт: workers=N;useful=M;actual=A;expected=E;warn=...;keys=0,1,...
//
Функция ПланЗапускаВоркеров(КоличествоВоркеров, ОжидаемоеЧислоРазделов, ФактическоеЧислоРазделов) Экспорт
	
	Если КоличествоВоркеров < 1 Тогда
		ВызватьИсключение "WorkerCount должен быть не меньше 1";
	КонецЕсли;
	Если ОжидаемоеЧислоРазделов < 1 Тогда
		ВызватьИсключение "ExpectedPartitionCount должен быть не меньше 1";
	КонецЕсли;
	Если ФактическоеЧислоРазделов < 0 Тогда
		ВызватьИсключение "Фактическое число partition не может быть отрицательным";
	КонецЕсли;
	
	Полезных = КоличествоВоркеров;
	Если ФактическоеЧислоРазделов > 0 И КоличествоВоркеров > ФактическоеЧислоРазделов Тогда
		Полезных = ФактическоеЧислоРазделов;
	КонецЕсли;
	Если ФактическоеЧислоРазделов = 0 Тогда
		Полезных = 0;
	КонецЕсли;
	
	Предупреждения = Новый Массив;
	Если ФактическоеЧислоРазделов > 0 И ФактическоеЧислоРазделов <> ОжидаемоеЧислоРазделов Тогда
		Предупреждения.Добавить("partition-mismatch");
	КонецЕсли;
	Если ФактическоеЧислоРазделов > 0 И КоличествоВоркеров > ФактическоеЧислоРазделов Тогда
		Предупреждения.Добавить("workers-exceed-partitions");
	КонецЕсли;
	Если ФактическоеЧислоРазделов = 0 Тогда
		Предупреждения.Добавить("no-partitions");
	КонецЕсли;
	
	Индексы = Новый Массив;
	Для Индекс = 0 По Полезных - 1 Цикл
		Индексы.Добавить(Формат(Индекс, "ЧН=0; ЧГ=0"));
	КонецЦикла;
	
	Возврат "workers=" + Формат(КоличествоВоркеров, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "useful=" + Формат(Полезных, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "actual=" + Формат(ФактическоеЧислоРазделов, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "expected=" + Формат(ОжидаемоеЧислоРазделов, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "warn=" + СтрСоединить(Предупреждения, "|") + Символы.ПС
		+ "keys=" + СтрСоединить(Индексы, ",");
	
КонецФункции

// Запускает полезные worker контура по плану WorkerCount и фактических partition.
//
// Параметры:
//  ДанныеКонсьюмера - Структура - параметры для СлушатьСообщения.
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  ФактическоеЧислоРазделов - Число - фактические partition входящего топика.
//
// Возвращаемое значение:
//  Строка - сводный отчёт плана и запусков.
//
Функция ЗапуститьКонтур(ДанныеКонсьюмера, КодКонтура, ФактическоеЧислоРазделов) Экспорт
	
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	План = ПланЗапускаВоркеров(
		Настройки.КоличествоВоркеров,
		Настройки.ОжидаемоеЧислоРазделов,
		ФактическоеЧислоРазделов);
	
	Полезных = ЧислоИзОтчёта(План, "useful");
	СтрокиЗапусков = Новый Массив;
	Для Индекс = 0 По Полезных - 1 Цикл
		СтрокиЗапусков.Добавить(Запустить(ДанныеКонсьюмера, КодКонтура, Индекс));
	КонецЦикла;
	
	Возврат План + Символы.ПС + "launches=" + Формат(СтрокиЗапусков.Количество(), "ЧН=0; ЧГ=0");
	
КонецФункции

// Фиксирует transport-ошибку до получения сообщения: без бизнес-процесса и без изменения данных.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  Результат - Строка - краткий код/текст без секретов, не длиннее 150.
//
// Возвращаемое значение:
//  Строка - идентификатор записи журнала этапов.
//
Функция ЗаписатьОшибкуТранспортаДоСообщения(КодКонтура, Результат) Экспорт
	
	Описание = KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
		КодКонтура,
		"error",
		"transport",
		"",
		"",
		"",
		0,
		0,
		0,
		0,
		Результат);
	Возврат Описание.ИдентификаторЗаписи;
	
КонецФункции

// Routing уже принят снаружи. В том же poll-цикле: процесс → Started Outbox → реальная
// публикация Started → бизнес-снимок (после started_sent) → публикация terminal.
// Без Sleep / ПаузаИсполнения / регламентной паузы. Измеряет latency receive→Started.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  ИдентификаторСообщения - Строка - message id.
//  ИдентификаторКорреляции - Строка - correlation-id.
//  ХешPayload - Строка - SHA-256 тела.
//  СыройPayload - Строка - сырое тело.
//  КлючKafka - Строка - ключ Kafka.
//  Топик - Строка - имя топика.
//  Раздел - Число - partition.
//  Смещение - Число - offset.
//
// Возвращаемое значение:
//  Строка - ok=1;started=1;latency_ms=N;forced_sleep=0;state=...;status_uuid=...;duplicate=...;business=...;publish=...
//
Функция ВыполнитьRoutingИStartedВТомЖеЦикле(КодКонтура, ИдентификаторСообщения, ИдентификаторКорреляции, ХешPayload, СыройPayload, КлючKafka, Топик = "contragents", Раздел = 0, Смещение = 0) Экспорт
	
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ИдентичностьТела = ИзвлечьИдентичностьИзТела(СыройPayload);
	Регистрация = KFK_ПроцессыОбменаСервер.ЗарегистрироватьПроцесс(
		КодКонтура,
		ИдентификаторСообщения,
		ХешPayload,
		СыройPayload,
		ИдентификаторКорреляции,
		ИдентичностьТела.ВнешнийID,
		ИдентичностьТела.ВнешнийUID);
	
	ТелоStarted = "{}";
	Если ИдентичностьТела.ВнешнийID > 0 Тогда
		ТелоStarted = KFK_ИсходящиеСтатусыСервер.СобратьТелоStartedИлиCompleted(
			ИдентичностьТела.ВнешнийID,
			ИдентичностьТела.ВнешнийUID);
	КонецЕсли;
	
	ОтчётStarted = KFK_ИсходящиеСтатусыСервер.ПодготовитьStarted(
		КодКонтура,
		ИдентификаторСообщения,
		Строка(КлючKafka),
		ТелоStarted);
	
	ОтчётПубликацииStarted = KFK_ИсходящиеСтатусыСервер.ОпубликоватьОжидающие(
		КодКонтура,
		20,
		Истина,
		Истина);
	
	ЗадержкаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Если ЗадержкаМс < 0 Тогда
		ЗадержкаМс = 0;
	КонецЕсли;
	
	KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
		КодКонтура,
		"received",
		"business",
		ИдентификаторСообщения,
		ИдентификаторКорреляции,
		Топик,
		Раздел,
		Смещение,
		0,
		ЗадержкаМс,
		"same_cycle_started");
	
	ОтчётБизнеса = "skipped=1";
	ПроцессПослеStarted = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если ПроцессПослеStarted <> Неопределено Тогда
		ИмяСостоянияПосле = ИмяСостоянияПроцессаЗначение(ПроцессПослеStarted.Состояние);
		Если ИмяСостоянияПосле = "started_sent" Или ИмяСостоянияПосле = "waiting_retry" Тогда
			ОтчётБизнеса = ОбработатьСнимокПослеStarted(КодКонтура, ИдентификаторСообщения);
			KFK_ИсходящиеСтатусыСервер.ОпубликоватьОжидающие(КодКонтура, 20, Истина, Истина);
		КонецЕсли;
	КонецЕсли;
	
	ПроцессИтог = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Состояние = "";
	Если ПроцессИтог <> Неопределено Тогда
		Состояние = ИмяСостоянияПроцессаЗначение(ПроцессИтог.Состояние);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Состояние) Тогда
		Состояние = ИзвлечьПолеОтчёта(ОтчётStarted, "state");
	КонецЕсли;
	
	СтатусUUID = ИзвлечьПолеОтчёта(ОтчётStarted, "status_uuid");
	Дубль = ИзвлечьПолеОтчёта(ОтчётStarted, "duplicate");
	Если Не ЗначениеЗаполнено(Дубль) Тогда
		Дубль = ?(Регистрация.ЭтоДубль, "1", "0");
	КонецЕсли;
	
	Возврат "ok=1" + Символы.ПС
		+ "started=1" + Символы.ПС
		+ "latency_ms=" + Формат(ЗадержкаМс, "ЧН=0; ЧГ=") + Символы.ПС
		+ "forced_sleep=0" + Символы.ПС
		+ "state=" + Состояние + Символы.ПС
		+ "status_uuid=" + СтатусUUID + Символы.ПС
		+ "duplicate=" + Дубль + Символы.ПС
		+ "publish_started=" + СтрЗаменить(ОтчётПубликацииStarted, Символы.ПС, ";") + Символы.ПС
		+ "business=" + СтрЗаменить(ОтчётБизнеса, Символы.ПС, ";");
	
КонецФункции

// Бизнес после подтверждённого Started: валидация → идентичность → снимок РФ → Completed/Failed.
// Вызывается только при РазрешенаВалидацияТела (started_sent / processing / waiting_retry).
//
// Возвращаемое значение:
//  Строка - ok=1|0;action=...;code=...;state=...
//
Функция ОбработатьСнимокПослеStarted(КодКонтура, ИдентификаторСообщения) Экспорт
	
	Разрешение = KFK_ИсходящиеСтатусыСервер.РазрешенаВалидацияТела(КодКонтура, ИдентификаторСообщения);
	Если ИзвлечьПолеОтчёта(Разрешение, "allowed") <> "1" Тогда
		Возврат "ok=0" + Символы.ПС
			+ "action=skip" + Символы.ПС
			+ "reason=validation_not_allowed" + Символы.ПС
			+ "state=" + ИзвлечьПолеОтчёта(Разрешение, "state");
	КонецЕсли;
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		Возврат "ok=0" + Символы.ПС + "action=skip" + Символы.ПС + "reason=process_missing" + Символы.ПС + "state=";
	КонецЕсли;
	
	ИмяСостояния = ИмяСостоянияПроцессаЗначение(Процесс.Состояние);
	Если ИмяСостояния = "completed" Или ИмяСостояния = "failed" Тогда
		Возврат "ok=1" + Символы.ПС
			+ "action=short_circuit" + Символы.ПС
			+ "reason=already_terminal" + Символы.ПС
			+ "state=" + ИмяСостояния;
	КонецЕсли;
	
	ПопыткаОбработки = KFK_ПроцессыОбменаСервер.НачатьПопыткуОбработки(КодКонтура, ИдентификаторСообщения);
	Если ИзвлечьПолеОтчёта(ПопыткаОбработки, "ok") <> "1" Тогда
		Возврат "ok=0" + Символы.ПС
			+ "action=skip" + Символы.ПС
			+ "reason=" + ИзвлечьПолеОтчёта(ПопыткаОбработки, "reason") + Символы.ПС
			+ "state=" + ИзвлечьПолеОтчёта(ПопыткаОбработки, "state");
	КонецЕсли;
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	ТелоJSON = Строка(Процесс.СыройPayload);
	КлючKafka = КлючKafkaПроцесса(КодКонтура, ИдентификаторСообщения, Процесс);
	ВнешнийID = Процесс.ВнешнийIDКонтрагента;
	ВнешнийUID = Строка(Процесс.ВнешнийUIDКонтрагента);
	
	Если ВнешнийID < 1 Тогда
		ИдентичностьТела = ИзвлечьИдентичностьИзТела(ТелоJSON);
		ВнешнийID = ИдентичностьТела.ВнешнийID;
		Если Не ЗначениеЗаполнено(ВнешнийUID) Тогда
			ВнешнийUID = ИдентичностьТела.ВнешнийUID;
		КонецЕсли;
	КонецЕсли;
	
	ОшибкиВалидации = KFK_СнимокКонтрагентаСервер.СобратьОшибкиВалидации(ТелоJSON);
	Если СтрНачинаетсяС(ОшибкиВалидации, "ok=0") Тогда
		Возврат ЗафиксироватьТерминальныйFailed(
			КодКонтура,
			ИдентификаторСообщения,
			КлючKafka,
			ВнешнийID,
			ВнешнийUID,
			ИзвлечьПолеОтчёта(ОшибкиВалидации, "errors"),
			"validation");
	КонецЕсли;
	
	ПроверкаКЗ = KFK_АдаптерКонтрагентовКЗСервер.ПроверитьТипИРегистрациюКЗ(ТелоJSON);
	Если СтрНачинаетсяС(ПроверкаКЗ, "ok=0") Тогда
		ОшибкиРФ = ИзвлечьПолеОтчёта(ПроверкаКЗ, "errors");
		Если Не ЗначениеЗаполнено(ОшибкиРФ) Тогда
			ОшибкиРФ = "INVALID_FORMAT|body|" + СтрЗаменить(ПроверкаКЗ, Символы.ПС, " ");
		КонецЕсли;
		Возврат ЗафиксироватьТерминальныйFailed(
			КодКонтура,
			ИдентификаторСообщения,
			КлючKafka,
			ВнешнийID,
			ВнешнийUID,
			ОшибкиРФ,
			"validation_rf");
	КонецЕсли;
	
	Если ВнешнийID < 1 Тогда
		Возврат ЗафиксироватьТерминальныйFailed(
			КодКонтура,
			ИдентификаторСообщения,
			КлючKafka,
			1,
			ВнешнийUID,
			"REQUIRED_FIELD_MISSING|id|id контрагента обязателен",
			"missing_id");
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	РегНомер = Неопределено;
	КПП = Неопределено;
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		РегНомер = Данные.Получить("reg_number");
		КПП = Данные.Получить("kpp");
	КонецЕсли;
	
	РазрешениеИд = KFK_ИдентичностьКонтрагентаСервер.РазрешитьКонтрагента(
		ВнешнийID,
		?(ЗначениеЗаполнено(ВнешнийUID), ВнешнийUID, Неопределено),
		РегНомер,
		КПП);
	РезультатИд = ИзвлечьПолеОтчёта(РазрешениеИд, "result");
	Если РезультатИд = "conflict" Тогда
		Возврат ЗафиксироватьТерминальныйFailed(
			КодКонтура,
			ИдентификаторСообщения,
			КлючKafka,
			ВнешнийID,
			ВнешнийUID,
			"DUPLICATE_CONFLICT|contragent|Найдено несколько карточек",
			"duplicate_conflict");
	КонецЕсли;
	
	КодЭлемента = "";
	Если РезультатИд <> "create" Тогда
		СсылкаСтрокой = ИзвлечьПолеОтчёта(РазрешениеИд, "ref");
		Если ЗначениеЗаполнено(СсылкаСтрокой) Тогда
			Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(СсылкаСтрокой));
			КодЭлемента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Код");
		КонецЕсли;
	КонецЕсли;
	
	Привязка = KFK_ИдентичностьКонтрагентаСервер.ПривязатьВнешниеКлючи(
		ВнешнийID,
		?(ЗначениеЗаполнено(ВнешнийUID), ВнешнийUID, Неопределено),
		РегНомер,
		КПП,
		"");
	Если ИзвлечьПолеОтчёта(Привязка, "ok") <> "1" Тогда
		КодОшибки = ИзвлечьПолеОтчёта(Привязка, "error");
		Если Не ЗначениеЗаполнено(КодОшибки) Тогда
			КодОшибки = "DUPLICATE_CONFLICT";
		КонецЕсли;
		Возврат ЗафиксироватьТерминальныйFailed(
			КодКонтура,
			ИдентификаторСообщения,
			КлючKafka,
			ВнешнийID,
			ВнешнийUID,
			КодОшибки + "|contragent|Ошибка привязки внешних ключей",
			"bind_failed");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КодЭлемента) Тогда
		КодЭлемента = ИзвлечьПолеОтчёта(Привязка, "code");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КодЭлемента) Тогда
		СсылкаСтрокой = ИзвлечьПолеОтчёта(Привязка, "ref");
		Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(СсылкаСтрокой));
		КодЭлемента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Код");
	КонецЕсли;
	
	СнимокДо = KFK_АдаптерКонтрагентовКЗСервер.СериализоватьСостояниеКЗ(КодЭлемента);
	ОтчётСнимка = KFK_АдаптерКонтрагентовКЗСервер.ПрименитьСнимокКЗ(ТелоJSON, КодЭлемента, Ложь, Ложь);
	Если СтрНачинаетсяС(ОтчётСнимка, "ok=1") Тогда
		ТелоCompleted = KFK_ИсходящиеСтатусыСервер.СобратьТелоStartedИлиCompleted(ВнешнийID, ВнешнийUID);
		ОтчётCompleted = KFK_ИсходящиеСтатусыСервер.ЗафиксироватьCompletedСБизнесЗаписью(
			КодКонтура,
			ИдентификаторСообщения,
			КлючKafka,
			ТелоCompleted,
			СнимокДо,
			Ложь);
		Возврат "ok=1" + Символы.ПС
			+ "action=completed" + Символы.ПС
			+ "code=" + КодЭлемента + Символы.ПС
			+ "state=completed" + Символы.ПС
			+ "detail=" + СтрЗаменить(ОтчётCompleted, Символы.ПС, ";");
	КонецЕсли;
	
	Возврат ОбработатьСбойСнимка(
		КодКонтура,
		ИдентификаторСообщения,
		КлючKafka,
		ВнешнийID,
		ВнешнийUID,
		ОтчётСнимка);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИзвлечьИдентичностьИзТела(СыройPayload)
	
	Результат = Новый Структура("ВнешнийID, ВнешнийUID", 0, "");
	Если Не ЗначениеЗаполнено(СыройPayload) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Данные = KFK_ОбщегоНазначения.JSONВЗначение(СыройPayload, , Истина);
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначениеID = Данные.Получить("id");
	Если ТипЗнч(ЗначениеID) = Тип("Число") И ЗначениеID > 0 Тогда
		Результат.ВнешнийID = ЗначениеID;
	КонецЕсли;
	
	ЗначениеUID = Данные.Получить("uid");
	Если ЗначениеUID <> Неопределено И ЗначениеUID <> Null Тогда
		Результат.ВнешнийUID = СокрЛП(Строка(ЗначениеUID));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючKafkaПроцесса(КодКонтура, ИдентификаторСообщения, Процесс)
	
	Статус = KFK_ИсходящиеСтатусыСервер.ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, 10);
	Если Статус <> Неопределено И ЗначениеЗаполнено(Статус.КлючKafka) Тогда
		Возврат Строка(Статус.КлючKafka);
	КонецЕсли;
	Если ЗначениеЗаполнено(Процесс.ВнешнийUIDКонтрагента) Тогда
		Возврат Строка(Процесс.ВнешнийUIDКонтрагента);
	КонецЕсли;
	
	Возврат ИдентификаторСообщения;
	
КонецФункции

Функция ЗафиксироватьТерминальныйFailed(КодКонтура, ИдентификаторСообщения, КлючKafka, ВнешнийID, ВнешнийUID, СообщенияЧерезПайп, Действие)
	
	IDДляТела = ВнешнийID;
	Если IDДляТела < 1 Тогда
		IDДляТела = 1;
	КонецЕсли;
	
	ТелоFailed = KFK_ИсходящиеСтатусыСервер.СобратьТелоFailedСтрокой(
		IDДляТела,
		СообщенияЧерезПайп,
		ВнешнийUID);
	Отчёт = KFK_ИсходящиеСтатусыСервер.ЗафиксироватьFailedСТерминалом(
		КодКонтура,
		ИдентификаторСообщения,
		КлючKafka,
		ТелоFailed,
		Ложь);
	
	Возврат "ok=0" + Символы.ПС
		+ "action=" + Действие + Символы.ПС
		+ "state=failed" + Символы.ПС
		+ "detail=" + СтрЗаменить(Отчёт, Символы.ПС, ";");
	
КонецФункции

Функция ОбработатьСбойСнимка(КодКонтура, ИдентификаторСообщения, КлючKafka, ВнешнийID, ВнешнийUID, ОтчётСнимка)
	
	КодОшибки = ИзвлечьПолеОтчёта(ОтчётСнимка, "error");
	Если Не ЗначениеЗаполнено(КодОшибки) Тогда
		КодОшибки = "INTERNAL_ERROR";
	КонецЕсли;
	КодОшибки = KFK_СнимокКонтрагентаСервер.НормализоватьКодОшибки(КодОшибки);
	Путь = ИзвлечьПолеОтчёта(ОтчётСнимка, "path");
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Путь = "null";
	КонецЕсли;
	Уточнение = ИзвлечьПолеОтчёта(ОтчётСнимка, "value");
	Если Не ЗначениеЗаполнено(Уточнение) Тогда
		Уточнение = ИзвлечьПолеОтчёта(ОтчётСнимка, "uid");
	КонецЕсли;
	Текст = KFK_СнимокКонтрагентаСервер.ОбеспечитьЧеловекочитаемоеСообщение(
		КодОшибки,
		Путь,
		ИзвлечьПолеОтчёта(ОтчётСнимка, "detail"),
		Уточнение);
	
	Классификация = KFK_ПроцессыОбменаСервер.КлассифицироватьОшибку(КодОшибки);
	Если ИзвлечьПолеОтчёта(Классификация, "retryable") = "1" Тогда
		
		Повтор = KFK_ПроцессыОбменаСервер.ЗапланироватьПовтор(
			КодКонтура,
			ИдентификаторСообщения,
			КодОшибки + "|" + Путь + "|" + Текст);
		Если ИзвлечьПолеОтчёта(Повтор, "exhausted") = "1" Тогда
			Вид = ?(КодОшибки = "HEAD_MISSING" Или КодОшибки = "HEAD_CONTRAGENT_NOT_FOUND", "head", "technical");
			ОтчётИсчерпания = KFK_ПроцессыОбменаСервер.ЗавершитьПослеИсчерпанияПопыток(
				КодКонтура,
				ИдентификаторСообщения,
				Вид,
				ВнешнийID,
				КлючKafka,
				"",
				ВнешнийUID);
			Возврат "ok=0" + Символы.ПС
				+ "action=exhausted" + Символы.ПС
				+ "state=failed" + Символы.ПС
				+ "detail=" + СтрЗаменить(ОтчётИсчерпания, Символы.ПС, ";");
		КонецЕсли;
		
		Возврат "ok=0" + Символы.ПС
			+ "action=retry" + Символы.ПС
			+ "state=waiting_retry" + Символы.ПС
			+ "code=" + КодОшибки + Символы.ПС
			+ "detail=" + СтрЗаменить(Повтор, Символы.ПС, ";");
		
	КонецЕсли;
	
	Возврат ЗафиксироватьТерминальныйFailed(
		КодКонтура,
		ИдентификаторСообщения,
		КлючKafka,
		ВнешнийID,
		ВнешнийUID,
		КодОшибки + "|" + Путь + "|" + Текст,
		"terminal_apply");
	
КонецФункции

Функция ИмяСостоянияПроцессаЗначение(Состояние)
	
	Если Состояние = Перечисления.KFK_СостоянияПроцесса.received Тогда
		Возврат "received";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.started_pending Тогда
		Возврат "started_pending";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.started_sent Тогда
		Возврат "started_sent";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.processing Тогда
		Возврат "processing";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.waiting_retry Тогда
		Возврат "waiting_retry";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.completed Тогда
		Возврат "completed";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.failed Тогда
		Возврат "failed";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция АктивныеЗаданияПоКлючу(Ключ)
	
	ОтборЗаданий = Новый Структура;
	ОтборЗаданий.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	ОтборЗаданий.Вставить("Ключ", Ключ);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборЗаданий);
	
КонецФункции

Функция ИмяКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если КодКонтура = Перечисления.KFK_КодыКонтуров.RF Тогда
			Возврат "RF";
		ИначеЕсли КодКонтура = Перечисления.KFK_КодыКонтуров.KZ Тогда
			Возврат "KZ";
		КонецЕсли;
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
	Если КодКонтура = "RF" Или КодКонтура = "KZ" Тогда
		Возврат КодКонтура;
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	
КонецФункции

Функция ЧислоИзОтчёта(Отчёт, ИмяПоля)
	
	Текст = ИзвлечьПолеОтчёта(Отчёт, ИмяПоля);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		ВызватьИсключение "В отчёте нет поля " + ИмяПоля;
	КонецЕсли;
	
	Возврат Число(Текст);
	
КонецФункции

Функция ИзвлечьПолеОтчёта(Отчёт, ИмяПоля)
	
	Префикс = ИмяПоля + "=";
	Для Каждого СтрокаОтчёта Из СтрРазделить(Отчёт, Символы.ПС, Ложь) Цикл
		Если СтрНачинаетсяС(СтрокаОтчёта, Префикс) Тогда
			Возврат Сред(СтрокаОтчёта, СтрДлина(Префикс) + 1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
