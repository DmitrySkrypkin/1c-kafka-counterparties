#Область ПрограммныйИнтерфейс

// Записывает один этап обработки сообщения. Секреты и тело сообщения сюда не передаются.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  Этап - Строка, ПеречислениеСсылка.KFK_ЭтапыОбмена - received, filtered_out, started, completed, failed, error.
//  Категория - Строка, ПеречислениеСсылка.KFK_КатегорииЭтапа - transport либо business.
//  ИдентификаторСообщения - Строка - message id. Пустой допустим только для transport-ошибки до сообщения.
//  ИдентификаторКорреляции - Строка - correlation-id. Пустой допустим только для transport-ошибки до сообщения.
//  Топик - Строка - имя топика. Пустое допустимо только для transport-ошибки до сообщения.
//  Раздел - Число - partition, ноль и больше.
//  Смещение - Число - offset, ноль и больше.
//  НомерПопытки - Число - номер попытки, ноль и больше.
//  ДлительностьМс - Число - длительность этапа в миллисекундах, ноль и больше.
//  Результат - Строка - короткий итог без секретов, не длиннее 150 символов.
//  ДатаЗаписи - Дата, Неопределено - момент этапа; пустое значение заменяется текущей датой сеанса.
//
// Возвращаемое значение:
//  Структура - идентификатор записи, контур, этап, категория и дата.
//
Функция ЗаписатьЭтап(КодКонтура, Этап, Категория, ИдентификаторСообщения = "", ИдентификаторКорреляции = "", Топик = "", Раздел = 0, Смещение = 0, НомерПопытки = 0, ДлительностьМс = 0, Результат = "", ДатаЗаписи = Неопределено) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ЗначениеЭтапа = ЗначениеЭтапа(Этап);
	ЗначениеКатегории = ЗначениеКатегории(Категория);
	ОшибкаДоСообщения = ЗначениеЭтапа = Перечисления.KFK_ЭтапыОбмена.error
		И ЗначениеКатегории = Перечисления.KFK_КатегорииЭтапа.transport;
	
	Если Не ОшибкаДоСообщения И Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ВызватьИсключение "Не заполнен идентификатор сообщения";
	КонецЕсли;
	Если Не ОшибкаДоСообщения И Не ЗначениеЗаполнено(ИдентификаторКорреляции) Тогда
		ВызватьИсключение "Не заполнен идентификатор корреляции";
	КонецЕсли;
	Если Не ОшибкаДоСообщения И Не ЗначениеЗаполнено(Топик) Тогда
		ВызватьИсключение "Не заполнен топик";
	КонецЕсли;
	
	ПроверитьНеотрицательное(Раздел, "Раздел");
	ПроверитьНеотрицательное(Смещение, "Смещение");
	ПроверитьНеотрицательное(НомерПопытки, "Номер попытки");
	ПроверитьНеотрицательное(ДлительностьМс, "Длительность");
	
	ТекстРезультата = МаскироватьСекретыВРезультате(Строка(Результат));
	МаксимальнаяДлинаРезультата = 150;
	Если СтрДлина(ТекстРезультата) > МаксимальнаяДлинаРезультата Тогда
		ТекстРезультата = Лев(ТекстРезультата, МаксимальнаяДлинаРезультата);
	КонецЕсли;
	
	Момент = МоментЗаписи(ДатаЗаписи);
	ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор());
	
	МенеджерЗаписи = РегистрыСведений.KFK_ЖурналЭтапов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗаписи = ИдентификаторЗаписи;
	МенеджерЗаписи.КодКонтура = ЗначениеКонтура;
	МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
	МенеджерЗаписи.ИдентификаторКорреляции = ИдентификаторКорреляции;
	МенеджерЗаписи.Топик = Топик;
	МенеджерЗаписи.Раздел = Раздел;
	МенеджерЗаписи.Смещение = Смещение;
	МенеджерЗаписи.НомерПопытки = НомерПопытки;
	МенеджерЗаписи.ДатаЗаписи = Момент;
	МенеджерЗаписи.ДлительностьМс = ДлительностьМс;
	МенеджерЗаписи.Этап = ЗначениеЭтапа;
	МенеджерЗаписи.Категория = ЗначениеКатегории;
	МенеджерЗаписи.Результат = ТекстРезультата;
	МенеджерЗаписи.Записать();
	
	Возврат ОписаниеЗаписи(ИдентификаторЗаписи, ЗначениеКонтура, ЗначениеЭтапа, ЗначениеКатегории, Момент);
	
КонецФункции

// Пишет received и filtered_out для тихого пропуска чужого/неизвестного/неактивного контура.
// Бизнес-статус и Inbox не создаются. Payload и секреты сюда не передаются.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id.
//  ИдентификаторКорреляции - Строка - correlation-id.
//  Топик - Строка - имя топика.
//  Раздел - Число - partition.
//  Смещение - Число - offset.
//  Причина - Строка - foreign, unknown либо inactive.
//
// Возвращаемое значение:
//  Структура - поля Received и FilteredOut с описаниями этапов.
//
Функция ЗаписатьПропускКонтура(КодКонтура, ИдентификаторСообщения, ИдентификаторКорреляции, Топик, Раздел, Смещение, Причина) Экспорт
	
	Если Не ЗначениеЗаполнено(Причина) Тогда
		ВызватьИсключение "Не заполнена причина пропуска";
	КонецЕсли;
	
	Момент = ТекущаяДатаСеанса();
	Received = ЗаписатьЭтап(
		КодКонтура,
		"received",
		"business",
		ИдентификаторСообщения,
		ИдентификаторКорреляции,
		Топик,
		Раздел,
		Смещение,
		0,
		0,
		"",
		Момент);
	FilteredOut = ЗаписатьЭтап(
		КодКонтура,
		"filtered_out",
		"business",
		ИдентификаторСообщения,
		ИдентификаторКорреляции,
		Топик,
		Раздел,
		Смещение,
		0,
		0,
		Причина,
		Момент + 1);
	
	Результат = Новый Структура;
	Результат.Вставить("Received", Received);
	Результат.Вставить("FilteredOut", FilteredOut);
	
	Возврат Результат;
	
КонецФункции

// Возвращает этапы одного сообщения в порядке даты записи.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки регистра, упорядоченные по дате и идентификатору записи.
//
Функция ПрочитатьЭтапы(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	Журнал.КодКонтура КАК КодКонтура,
	|	Журнал.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	Журнал.ИдентификаторКорреляции КАК ИдентификаторКорреляции,
	|	Журнал.Топик КАК Топик,
	|	Журнал.Раздел КАК Раздел,
	|	Журнал.Смещение КАК Смещение,
	|	Журнал.НомерПопытки КАК НомерПопытки,
	|	Журнал.ДатаЗаписи КАК ДатаЗаписи,
	|	Журнал.ДлительностьМс КАК ДлительностьМс,
	|	Журнал.Этап КАК Этап,
	|	Журнал.Категория КАК Категория,
	|	Журнал.Результат КАК Результат
	|ИЗ
	|	РегистрСведений.KFK_ЖурналЭтапов КАК Журнал
	|ГДЕ
	|	Журнал.КодКонтура = &КодКонтура
	|	И Журнал.ИдентификаторСообщения = &ИдентификаторСообщения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаписи,
	|	ИдентификаторЗаписи";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

// Компактный отчет этапов для внешних проверок: этап:категория:результат через |.
//
Функция ОтчетЭтаповСтрокой(КодКонтура, ИдентификаторСообщения) Экспорт
	
	Таблица = ПрочитатьЭтапы(КодКонтура, ИдентификаторСообщения);
	Части = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИмяЭтапа = ИмяЭтапа(СтрокаТаблицы.Этап);
		ИмяКатегории = ИмяКатегории(СтрокаТаблицы.Категория);
		Части.Добавить(ИмяЭтапа + ":" + ИмяКатегории + ":" + СтрокаТаблицы.Результат);
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "|");
	
КонецФункции

// Пишет received → started → completed|failed и отдельно error/transport|business; маскирует secrets в результате.
//
Функция ЗаписатьЦепочкуУспеха(КодКонтура, ИдентификаторСообщения, ИдентификаторКорреляции, Топик, Раздел, Смещение) Экспорт
	
	ЗаписатьЭтап(КодКонтура, "received", "business", ИдентификаторСообщения, ИдентификаторКорреляции, Топик, Раздел, Смещение, 0, 0, "accepted");
	ЗаписатьЭтап(КодКонтура, "started", "business", ИдентификаторСообщения, ИдентификаторКорреляции, Топик, Раздел, Смещение, 1, 0, "started");
	ЗаписатьЭтап(КодКонтура, "completed", "business", ИдентификаторСообщения, ИдентификаторКорреляции, Топик, Раздел, Смещение, 1, 10, "done");
	
	Возврат "ok=1" + Символы.ПС + "seq=" + ОтчетЭтаповСтрокой(КодКонтура, ИдентификаторСообщения);
	
КонецФункции

Функция ЗаписатьОшибкиТранспортИБизнес(КодКонтура, ИдентификаторСообщения, ИдентификаторКорреляции, Топик, Раздел, Смещение) Экспорт
	
	ЗаписатьЭтап(КодКонтура, "error", "transport", ИдентификаторСообщения, ИдентификаторКорреляции, Топик, Раздел, Смещение, 0, 0, "password=secret kafka_unavailable");
	ЗаписатьЭтап(КодКонтура, "failed", "business", ИдентификаторСообщения, ИдентификаторКорреляции, Топик, Раздел, Смещение, 1, 0, "validation");
	
	Возврат "ok=1" + Символы.ПС + "seq=" + ОтчетЭтаповСтрокой(КодКонтура, ИдентификаторСообщения);
	
КонецФункции

Процедура УдалитьЭтапыСообщения(КодКонтура, ИдентификаторСообщения) Экспорт
	
	Таблица = ПрочитатьЭтапы(КодКонтура, ИдентификаторСообщения);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		МенеджерЗаписи = РегистрыСведений.KFK_ЖурналЭтапов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗаписи = СтрокаТаблицы.ИдентификаторЗаписи;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МаскироватьСекретыВРезультате(Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "password=", "password=***");
	Результат = СтрЗаменить(Результат, "Password=", "Password=***");
	Результат = СтрЗаменить(Результат, "sasl.password=", "sasl.password=***");
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьНеотрицательное(Значение, ИмяПоля)
	
	Если ТипЗнч(Значение) <> Тип("Число") Или Значение < 0 Тогда
		ВызватьИсключение "Поле " + ИмяПоля + " должно быть числом ноль или больше";
	КонецЕсли;
	
КонецПроцедуры

Функция МоментЗаписи(ДатаЗаписи)
	
	Если ЗначениеЗаполнено(ДатаЗаписи) Тогда
		Возврат ДатаЗаписи;
	КонецЕсли;
	
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

Функция ОписаниеЗаписи(ИдентификаторЗаписи, КодКонтура, Этап, Категория, ДатаЗаписи)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗаписи", ИдентификаторЗаписи);
	Результат.Вставить("КодКонтура", КодКонтура);
	Результат.Вставить("Этап", Этап);
	Результат.Вставить("Категория", Категория);
	Результат.Вставить("ДатаЗаписи", ДатаЗаписи);
	Возврат Результат;
	
КонецФункции

Функция ЗначениеКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

Функция ЗначениеЭтапа(Этап)
	
	Если ТипЗнч(Этап) = Тип("ПеречислениеСсылка.KFK_ЭтапыОбмена") Тогда
		Если Не ЗначениеЗаполнено(Этап) Тогда
			ВызватьИсключение "Не заполнен этап";
		КонецЕсли;
		Возврат Этап;
	КонецЕсли;
	
	Если Этап = "received" Тогда
		Возврат Перечисления.KFK_ЭтапыОбмена.received;
	ИначеЕсли Этап = "filtered_out" Тогда
		Возврат Перечисления.KFK_ЭтапыОбмена.filtered_out;
	ИначеЕсли Этап = "started" Тогда
		Возврат Перечисления.KFK_ЭтапыОбмена.started;
	ИначеЕсли Этап = "completed" Тогда
		Возврат Перечисления.KFK_ЭтапыОбмена.completed;
	ИначеЕсли Этап = "failed" Тогда
		Возврат Перечисления.KFK_ЭтапыОбмена.failed;
	ИначеЕсли Этап = "error" Тогда
		Возврат Перечисления.KFK_ЭтапыОбмена.error;
	Иначе
		ВызватьИсключение "Неизвестный этап: " + Строка(Этап);
	КонецЕсли;
	
КонецФункции

Функция ЗначениеКатегории(Категория)
	
	Если ТипЗнч(Категория) = Тип("ПеречислениеСсылка.KFK_КатегорииЭтапа") Тогда
		Если Не ЗначениеЗаполнено(Категория) Тогда
			ВызватьИсключение "Не заполнена категория этапа";
		КонецЕсли;
		Возврат Категория;
	КонецЕсли;
	
	Если Категория = "transport" Тогда
		Возврат Перечисления.KFK_КатегорииЭтапа.transport;
	ИначеЕсли Категория = "business" Тогда
		Возврат Перечисления.KFK_КатегорииЭтапа.business;
	Иначе
		ВызватьИсключение "Неизвестная категория этапа: " + Строка(Категория);
	КонецЕсли;
	
КонецФункции

Функция ИмяЭтапа(Этап)
	
	Если Этап = Перечисления.KFK_ЭтапыОбмена.received Тогда
		Возврат "received";
	ИначеЕсли Этап = Перечисления.KFK_ЭтапыОбмена.filtered_out Тогда
		Возврат "filtered_out";
	ИначеЕсли Этап = Перечисления.KFK_ЭтапыОбмена.started Тогда
		Возврат "started";
	ИначеЕсли Этап = Перечисления.KFK_ЭтапыОбмена.completed Тогда
		Возврат "completed";
	ИначеЕсли Этап = Перечисления.KFK_ЭтапыОбмена.failed Тогда
		Возврат "failed";
	ИначеЕсли Этап = Перечисления.KFK_ЭтапыОбмена.error Тогда
		Возврат "error";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ИмяКатегории(Категория)
	
	Если Категория = Перечисления.KFK_КатегорииЭтапа.transport Тогда
		Возврат "transport";
	ИначеЕсли Категория = Перечисления.KFK_КатегорииЭтапа.business Тогда
		Возврат "business";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
