#Область ПрограммныйИнтерфейс

// Обрабатывает входящий снимок номенклатуры после подтверждённого started (design, решения 7a и 7b).
// Товар ищется только по uid: реквизит KFK_ВнешнийUID, затем ссылка с GUID = uid. Новый товар создаётся
// с GUID = uid и умолчаниями контура. Итог - статус completed или failed в products.exchange.
//
// Параметры:
//  КодКонтура - ПеречислениеСсылка.KFK_КодыКонтуров - контур поставки.
//  ИдентификаторСообщения - Строка - message id процесса обмена.
//
// Возвращаемое значение:
//  Строка - ok=1|0;action=...;state=...
//
Функция ОбработатьТоварПослеStarted(КодКонтура, ИдентификаторСообщения) Экспорт

	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		Возврат "ok=0" + Символы.ПС + "action=skip" + Символы.ПС + "reason=process_missing";
	КонецЕсли;

	ПопыткаОбработки = KFK_ПроцессыОбменаСервер.НачатьПопыткуОбработки(КодКонтура, ИдентификаторСообщения);
	Если Не СтрНачинаетсяС(ПопыткаОбработки, "ok=1") Тогда
		Возврат "ok=0" + Символы.ПС + "action=skip" + Символы.ПС + "reason=attempt_not_started";
	КонецЕсли;

	Данные = ДанныеТела(Строка(Процесс.СыройPayload));
	ВнешнийID = 0;
	ВнешнийUID = "";
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		ЗначениеID = Данные.Получить("id");
		Если ТипЗнч(ЗначениеID) = Тип("Число") Тогда
			ВнешнийID = ЗначениеID;
		КонецЕсли;
		ЗначениеUID = Данные.Получить("uid");
		Если ТипЗнч(ЗначениеUID) = Тип("Строка") Тогда
			ВнешнийUID = СокрЛП(ЗначениеUID);
		КонецЕсли;
	КонецЕсли;
	КлючKafka = Строка(Процесс.КлючСообщенияKafka);
	Если Не ЗначениеЗаполнено(КлючKafka) Тогда
		КлючKafka = ВнешнийUID;
	КонецЕсли;

	Ошибки = ОшибкиТела(Данные);
	Если Ошибки.Количество() > 0 Тогда
		Возврат ЗафиксироватьFailed(КодКонтура, ИдентификаторСообщения, КлючKafka, ВнешнийID, ВнешнийUID, Ошибки, "validation");
	КонецЕсли;

	// Технический сбой записи не должен терять сообщение: попытка планируется повторно, после третьей - failed.
	Попытка
		Результат = ПрименитьСнимок(КодКонтура, Данные, ВнешнийUID);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Повтор = KFK_ПроцессыОбменаСервер.ЗапланироватьПовтор(
			КодКонтура, ИдентификаторСообщения, "INTERNAL_ERROR|product|" + ТекстОшибки);
		Если СтрНайти(Повтор, "exhausted=1") > 0 Тогда
			Ошибки.Добавить("INTERNAL_ERROR|product|" + СтрЗаменить(ТекстОшибки, "|", "/"));
			Возврат ЗафиксироватьFailed(КодКонтура, ИдентификаторСообщения, КлючKafka, ВнешнийID, ВнешнийUID, Ошибки, "exhausted");
		КонецЕсли;
		Возврат "ok=0" + Символы.ПС + "action=retry" + Символы.ПС + "state=waiting_retry";
	КонецПопытки;

	Если Не Результат.Успех Тогда
		Возврат ЗафиксироватьFailed(КодКонтура, ИдентификаторСообщения, КлючKafka, ВнешнийID, ВнешнийUID, Результат.Ошибки, "apply");
	КонецЕсли;

	ТелоCompleted = KFK_ИсходящиеСтатусыСервер.СобратьТелоСтатусаТовара(ВнешнийID, ВнешнийUID);
	ОтчётCompleted = KFK_ИсходящиеСтатусыСервер.ЗафиксироватьCompletedСБизнесЗаписью(
		КодКонтура, ИдентификаторСообщения, КлючKafka, ТелоCompleted, Результат.СнимокДо, Ложь);

	Возврат "ok=1" + Символы.ПС
		+ "action=" + Результат.Действие + Символы.ПС
		+ "state=completed" + Символы.ПС
		+ "detail=" + СтрЗаменить(ОтчётCompleted, Символы.ПС, ";");

КонецФункции

// Ищет товар по uid портала без групп (design, решение 7a).
//
// Параметры:
//  UID - Строка - uid товара.
//
// Возвращаемое значение:
//  Структура - поля:
//   * Ссылка - СправочникСсылка.Номенклатура - найденный товар или пустая ссылка.
//   * Конфликт - Булево - uid указывает на разные элементы или на группу.
//
Функция НайтиТовар(UID) Экспорт

	Результат = Новый Структура("Ссылка, Конфликт", Справочники.Номенклатура.ПустаяСсылка(), Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.KFK_ВнешнийUID = &UID
	|	И НЕ Номенклатура.ЭтоГруппа";
	Запрос.УстановитьПараметр("UID", UID);
	ПоРеквизиту = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	ПоСсылке = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(UID));
	СсылкаЕсть = ОбщегоНазначения.СсылкаСуществует(ПоСсылке);
	СсылкаГруппа = СсылкаЕсть И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоСсылке, "ЭтоГруппа") = Истина;

	Если ПоРеквизиту.Количество() > 1 Или СсылкаГруппа Тогда
		Результат.Конфликт = Истина;
	ИначеЕсли ПоРеквизиту.Количество() = 1 Тогда
		Если СсылкаЕсть И ПоСсылке <> ПоРеквизиту[0] Тогда
			Результат.Конфликт = Истина;
		Иначе
			Результат.Ссылка = ПоРеквизиту[0];
		КонецЕсли;
	ИначеЕсли СсылкаЕсть Тогда
		Результат.Ссылка = ПоСсылке;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Собирает тело исходящего product.created (design, решение 7; контракт product/1.0.0): без id,
// uid = KFK_ВнешнийUID, единица кодом ОКЕИ из 3 цифр или null, без ставки НДС.
//
// Параметры:
//  Ссылка - СправочникСсылка.Номенклатура - товар.
//
// Возвращаемое значение:
//  Строка - JSON тела.
//
Функция СобратьИсходящийСнимок(Ссылка) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
		"KFK_ВнешнийUID, Наименование, Артикул, ВесНетто, Услуга, БазоваяЕдиницаИзмерения.Код");

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("uid");
	Запись.ЗаписатьЗначение(СокрЛП(Реквизиты.KFK_ВнешнийUID));
	Запись.ЗаписатьИмяСвойства("name");
	Запись.ЗаписатьЗначение(СокрЛП(Реквизиты.Наименование));
	Запись.ЗаписатьИмяСвойства("article");
	ЗаписатьСтрокуИлиNull(Запись, СокрЛП(Реквизиты.Артикул));
	Запись.ЗаписатьИмяСвойства("weight");
	Если Реквизиты.ВесНетто > 0 Тогда
		Запись.ЗаписатьЗначение(Реквизиты.ВесНетто);
	Иначе
		Запись.ЗаписатьЗначение(Неопределено);
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("country");
	// У номенклатуры КЗ нет страны происхождения.
	Запись.ЗаписатьЗначение(Неопределено);
	Запись.ЗаписатьИмяСвойства("unit");
	КодОКЕИ = СокрЛП(Реквизиты.БазоваяЕдиницаИзмеренияКод);
	Если ЭтоКодИзТрёхЦифр(КодОКЕИ) Тогда
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("okei");
		Запись.ЗаписатьЗначение(КодОКЕИ);
		Запись.ЗаписатьКонецОбъекта();
	Иначе
		Запись.ЗаписатьЗначение(Неопределено);
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("is_service");
	Запись.ЗаписатьЗначение(Реквизиты.Услуга = Истина);
	Запись.ЗаписатьКонецОбъекта();

	Возврат Запись.Закрыть();

КонецФункции

// Разовая привязка старых товаров к uid портала (design, решение 7a; задача 5.3a).
// Пары «GUID ссылки товара → uid портала» собираются из квитанций старого файлового обмена.
// Записывает только KFK_ВнешнийUID, ссылки не меняет. Отсутствующие товары, группы и конфликты пропускает.
//
// Параметры:
//  Пары - Соответствие, Строка - ключ: GUID ссылки товара строкой; значение: uid портала;
//   строка - JSON-объект с теми же парами (удобно для внешнего соединения).
//  ТолькоПроверка - Булево - Истина: ничего не записывать, только посчитать.
//
// Возвращаемое значение:
//  Строка - linked=N;already=N;missing=N;group=N;conflict=N;conflicts=<GUID через запятую, до 50>
//
Функция ПривязатьUIDПортала(Пары, ТолькоПроверка = Истина) Экспорт

	Если ТипЗнч(Пары) = Тип("Строка") Тогда
		Пары = KFK_ОбщегоНазначения.JSONВЗначение(Пары, , Истина);
	КонецЕсли;
	
	Привязано = 0;
	УжеПривязано = 0;
	Отсутствует = 0;
	Групп = 0;
	Конфликтов = 0;
	СписокКонфликтов = Новый Массив;

	// Пар из квитанций намного больше, чем товаров в базе: существующие товары читаются одним запросом.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	Номенклатура.KFK_ВнешнийUID КАК KFK_ВнешнийUID
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура";
	Существующие = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Существующие.Вставить(Строка(Выборка.Ссылка.УникальныйИдентификатор()),
			Новый Структура("Ссылка, ЭтоГруппа, KFK_ВнешнийUID", Выборка.Ссылка, Выборка.ЭтоГруппа, Выборка.KFK_ВнешнийUID));
	КонецЦикла;

	Для Каждого Пара Из Пары Цикл
		UID = НРег(СокрЛП(Пара.Значение));
		Реквизиты = Существующие.Получить(НРег(СокрЛП(Пара.Ключ)));
		Если Реквизиты = Неопределено Тогда
			Отсутствует = Отсутствует + 1;
			Продолжить;
		КонецЕсли;
		Если Реквизиты.ЭтоГруппа Тогда
			Групп = Групп + 1;
			Продолжить;
		КонецЕсли;
		Если НРег(СокрЛП(Реквизиты.KFK_ВнешнийUID)) = UID Тогда
			УжеПривязано = УжеПривязано + 1;
			Продолжить;
		КонецЕсли;

		Поиск = НайтиТовар(UID);
		Если ЗначениеЗаполнено(Реквизиты.KFK_ВнешнийUID)
			Или Поиск.Конфликт
			Или ЗначениеЗаполнено(Поиск.Ссылка) И Поиск.Ссылка <> Реквизиты.Ссылка Тогда
			Конфликтов = Конфликтов + 1;
			Если СписокКонфликтов.Количество() < 50 Тогда
				СписокКонфликтов.Добавить(Пара.Ключ);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Не ТолькоПроверка Тогда
			Объект = Реквизиты.Ссылка.ПолучитьОбъект();
			Объект.KFK_ВнешнийUID = UID;
			// Меняется только ключ обмена: бизнес-обработчики записи и регистрация исходящего не нужны.
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
		КонецЕсли;
		Привязано = Привязано + 1;
	КонецЦикла;

	Возврат "linked=" + Формат(Привязано, "ЧН=0; ЧГ=")
		+ ";already=" + Формат(УжеПривязано, "ЧН=0; ЧГ=")
		+ ";missing=" + Формат(Отсутствует, "ЧН=0; ЧГ=")
		+ ";group=" + Формат(Групп, "ЧН=0; ЧГ=")
		+ ";conflict=" + Формат(Конфликтов, "ЧН=0; ЧГ=")
		+ ";conflicts=" + СтрСоединить(СписокКонфликтов, ",");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеТела(Тело)
	
	// Невалидный JSON - ошибка формата сообщения, а не технический сбой: ответ failed INVALID_FORMAT по body.
	Попытка
		Возврат KFK_ОбщегоНазначения.JSONВЗначение(Тело, , Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура ЗаписатьСтрокуИлиNull(Запись, Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		Запись.ЗаписатьЗначение(Значение);
	Иначе
		Запись.ЗаписатьЗначение(Неопределено);
	КонецЕсли;

КонецПроцедуры

Функция ПрименитьСнимок(КодКонтура, Данные, UID)

	Результат = Новый Структура("Успех, Ошибки, Действие, СнимокДо", Ложь, Новый Массив, "", "");

	Поиск = НайтиТовар(UID);
	Если Поиск.Конфликт Тогда
		Результат.Ошибки.Добавить("DUPLICATE_CONFLICT|uid|uid " + UID + " указывает на разные элементы номенклатуры");
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		Если ЗначениеЗаполнено(Поиск.Ссылка) Тогда
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Поиск.Ссылка);
			Блокировка.Заблокировать();
			Объект = Поиск.Ссылка.ПолучитьОбъект();
			Результат.СнимокДо = СостояниеТовара(Объект);
			Результат.Действие = "updated";
		Иначе
			Объект = НовыйТовар(КодКонтура, Данные, UID, Результат.Ошибки);
			Результат.СнимокДо = "{""new"":true}";
			Результат.Действие = "created";
		КонецЕсли;

		Если Объект <> Неопределено Тогда
			ЗаполнитьРеквизитыТовара(Объект, Данные, Результат.Ошибки);
		КонецЕсли;

		Если Результат.Ошибки.Количество() > 0 Тогда
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;

		Объект.KFK_ВнешнийUID = UID;
		// Запись обменом не регистрирует исходящий снимок (design, решение 7).
		Объект.ДополнительныеСвойства.Вставить("KFK_ЗаписьОбменом", Истина);
		Объект.Записать();

		ЗафиксироватьТранзакцию();

	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

Функция НовыйТовар(КодКонтура, Данные, UID, Ошибки)

	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	ПроверитьУмолчание(Настройки.ГруппаНоменклатурыПортала, "ГруппаНоменклатурыПортала", Ошибки);
	ПроверитьУмолчание(Настройки.ВидНоменклатурыПоУмолчанию, "ВидНоменклатурыПоУмолчанию", Ошибки);
	ПроверитьУмолчание(Настройки.СтавкаНДСНоменклатурыПоУмолчанию, "СтавкаНДСНоменклатурыПоУмолчанию", Ошибки);

	Единица = Настройки.ЕдиницаИзмеренияПоУмолчанию;
	ЕдиницаТовара = Данные.Получить("unit");
	Если ТипЗнч(ЕдиницаТовара) = Тип("Соответствие") Тогда
		КодОКЕИ = ЕдиницаТовара.Получить("okei");
		// Без наименования функция только ищет код в справочнике и во встроенном классификаторе ОКЕИ.
		Единица = Справочники.КлассификаторЕдиницИзмерения.ЕдиницаИзмеренияПоКоду(КодОКЕИ);
		Если Не ЗначениеЗаполнено(Единица) Тогда
			Ошибки.Добавить("REFERENCE_NOT_FOUND|unit.okei|Код " + КодОКЕИ + " не найден в классификаторе ОКЕИ");
		КонецЕсли;
	Иначе
		ПроверитьУмолчание(Единица, "ЕдиницаИзмеренияПоУмолчанию", Ошибки);
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.УстановитьСсылкуНового(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(UID)));
	Объект.Родитель = Настройки.ГруппаНоменклатурыПортала;
	Объект.ВидНоменклатуры = Настройки.ВидНоменклатурыПоУмолчанию;
	Объект.БазоваяЕдиницаИзмерения = Единица;
	Объект.СтавкаНДС = Настройки.СтавкаНДСНоменклатурыПоУмолчанию;
	Объект.Услуга = Данные.Получить("is_service") = Истина;

	Возврат Объект;

КонецФункции

Процедура ЗаполнитьРеквизитыТовара(Объект, Данные, Ошибки)

	Наименование = СокрЛП(Данные.Получить("name"));
	Объект.Наименование = Лев(Наименование, Метаданные.Справочники.Номенклатура.ДлинаНаименования);
	Объект.НаименованиеПолное = ОбрезатьПоДлинеРеквизита(Наименование, "НаименованиеПолное");

	Артикул = Данные.Получить("article");
	Если ТипЗнч(Артикул) = Тип("Строка") Тогда
		Объект.Артикул = ОбрезатьПоДлинеРеквизита(СокрЛП(Артикул), "Артикул");
	Иначе
		Объект.Артикул = "";
	КонецЕсли;

	Вес = Данные.Получить("weight");
	Если ТипЗнч(Вес) = Тип("Число") Тогда
		Объект.ВесНетто = Вес;
	Иначе
		Объект.ВесНетто = 0;
	КонецЕсли;

	// У номенклатуры КЗ нет страны происхождения: country не пишется (спецификация, Product field mapping).

КонецПроцедуры

Функция ОшибкиТела(Данные)

	Ошибки = Новый Массив;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Ошибки.Добавить("INVALID_FORMAT|body|Тело сообщения не является JSON-объектом");
		Возврат Ошибки;
	КонецЕсли;

	UID = Данные.Получить("uid");
	Если Не ЗначениеЗаполнено(UID) Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|uid|Не заполнен uid товара");
	ИначеЕсли ТипЗнч(UID) <> Тип("Строка") Или Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(СокрЛП(UID)) Тогда
		Ошибки.Добавить("INVALID_FORMAT|uid|uid товара должен быть GUID");
	КонецЕсли;

	Наименование = Данные.Получить("name");
	Если ТипЗнч(Наименование) <> Тип("Строка") Или Не ЗначениеЗаполнено(СокрЛП(Наименование)) Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|name|Не заполнено наименование товара");
	КонецЕсли;

	Артикул = Данные.Получить("article");
	Если Артикул <> Неопределено И ТипЗнч(Артикул) <> Тип("Строка") Тогда
		Ошибки.Добавить("INVALID_FORMAT|article|Артикул должен быть строкой");
	КонецЕсли;

	Вес = Данные.Получить("weight");
	Если Вес <> Неопределено И (ТипЗнч(Вес) <> Тип("Число") Или Вес < 0) Тогда
		Ошибки.Добавить("INVALID_FORMAT|weight|Вес должен быть неотрицательным числом");
	КонецЕсли;

	Страна = Данные.Получить("country");
	Если Страна <> Неопределено Тогда
		Если ТипЗнч(Страна) <> Тип("Соответствие") Тогда
			Ошибки.Добавить("INVALID_FORMAT|country|country должен быть объектом");
		ИначеЕсли Страна.Получить("oksm") <> Неопределено И Не ЭтоКодИзТрёхЦифр(Страна.Получить("oksm")) Тогда
			Ошибки.Добавить("INVALID_FORMAT|country.oksm|Код ОКСМ должен состоять из 3 цифр");
		КонецЕсли;
	КонецЕсли;

	Единица = Данные.Получить("unit");
	Если Единица <> Неопределено Тогда
		Если ТипЗнч(Единица) <> Тип("Соответствие") Тогда
			Ошибки.Добавить("INVALID_FORMAT|unit|unit должен быть объектом");
		ИначеЕсли Единица.Получить("okei") = Неопределено Тогда
			Ошибки.Добавить("REQUIRED_FIELD_MISSING|unit.okei|Не заполнен код ОКЕИ");
		ИначеЕсли Не ЭтоКодИзТрёхЦифр(Единица.Получить("okei")) Тогда
			Ошибки.Добавить("INVALID_FORMAT|unit.okei|Код ОКЕИ должен быть строкой из 3 цифр");
		КонецЕсли;
	КонецЕсли;

	Услуга = Данные.Получить("is_service");
	Если Услуга <> Неопределено И ТипЗнч(Услуга) <> Тип("Булево") Тогда
		Ошибки.Добавить("INVALID_FORMAT|is_service|is_service должен быть true или false");
	КонецЕсли;

	Возврат Ошибки;

КонецФункции

Функция ЭтоКодИзТрёхЦифр(Значение)

	Возврат ТипЗнч(Значение) = Тип("Строка")
		И СтрДлина(Значение) = 3
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Значение);

КонецФункции

Процедура ПроверитьУмолчание(Значение, ИмяНастройки, Ошибки)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Ошибки.Добавить("INTERNAL_ERROR|settings." + ИмяНастройки
			+ "|Не задано умолчание номенклатуры " + ИмяНастройки + " в настройках контура");
	КонецЕсли;

КонецПроцедуры

Функция ОбрезатьПоДлинеРеквизита(Значение, ИмяРеквизита)

	Реквизит = Метаданные.Справочники.Номенклатура.Реквизиты.Найти(ИмяРеквизита);
	Если Реквизит = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Длина = Реквизит.Тип.КвалификаторыСтроки.Длина;
	Если Длина = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Лев(Значение, Длина);

КонецФункции

Функция СостояниеТовара(Объект)

	Состояние = Новый Структура;
	Состояние.Вставить("ref", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Состояние.Вставить("name", Объект.Наименование);
	Состояние.Вставить("full_name", Объект.НаименованиеПолное);
	Состояние.Вставить("article", Объект.Артикул);
	Состояние.Вставить("weight", Объект.ВесНетто);
	Состояние.Вставить("uid", Объект.KFK_ВнешнийUID);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Состояние);
	Возврат Запись.Закрыть();

КонецФункции

Функция ЗафиксироватьFailed(КодКонтура, ИдентификаторСообщения, КлючKafka, ВнешнийID, ВнешнийUID, Ошибки, Действие)

	ТелоFailed = KFK_ИсходящиеСтатусыСервер.СобратьТелоСтатусаТовара(ВнешнийID, ВнешнийUID, Ошибки);
	Отчёт = KFK_ИсходящиеСтатусыСервер.ЗафиксироватьFailedСТерминалом(
		КодКонтура, ИдентификаторСообщения, КлючKafka, ТелоFailed, Ложь);

	Возврат "ok=0" + Символы.ПС
		+ "action=" + Действие + Символы.ПС
		+ "state=failed" + Символы.ПС
		+ "detail=" + СтрЗаменить(Отчёт, Символы.ПС, ";");

КонецФункции

#КонецОбласти
