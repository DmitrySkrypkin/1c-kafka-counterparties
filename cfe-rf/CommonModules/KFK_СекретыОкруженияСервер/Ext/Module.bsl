#Область ПрограммныйИнтерфейс

// Читает пароль Kafka из защищённой конфигурации окружения (не из репозитория).
// Приоритет: KAFKA_PASSWORD → файл KAFKA_PASSWORD_FILE → безопасное хранилище БСП.
//
// Возвращаемое значение:
//  Строка - отчёт ok/error без значения пароля.
//
Функция ПрочитатьПарольKafka() Экспорт
	
	ПарольИзСреды = ЗначениеПеременнойСреды("KAFKA_PASSWORD");
	Если ЗначениеЗаполнено(ПарольИзСреды) Тогда
		Возврат ОтчетУспешногоЧтения(ПарольИзСреды, "env_var");
	КонецЕсли;
	
	Путь = ПутьКФайлуПароляKafka();
	Если ЗначениеЗаполнено(Путь) Тогда
		Сырой = ПрочитатьТекстСекретаИзФайла(Путь);
		Если Сырой <> Неопределено Тогда
			ПарольИзФайла = ИзвлечьПарольИзФайла(Сырой);
			Если ЗначениеЗаполнено(ПарольИзФайла) Тогда
				Возврат ОтчетУспешногоЧтения(ПарольИзФайла, "env_file");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПарольИзХранилища = ПрочитатьПарольИзБезопасногоХранилища();
	Если ЗначениеЗаполнено(ПарольИзХранилища) Тогда
		Возврат ОтчетУспешногоЧтения(ПарольИзХранилища, "secure_store");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат "ok=0" + Символы.ПС + "error=PATH_EMPTY" + Символы.ПС + "configured=0";
	КонецЕсли;
	
	Возврат "ok=0" + Символы.ПС
		+ "error=SECRET_NOT_FOUND" + Символы.ПС
		+ "configured=1" + Символы.ПС
		+ "path_set=1" + Символы.ПС
		+ "path=" + Путь;
	
КонецФункции

// Проверка готовности секрета к подключению (без записи секрета в лог/отчёт).
//
// Возвращаемое значение:
//  Строка - отчёт ready без значения пароля.
//
Функция ПроверитьГотовностьПодключенияKafka() Экспорт
	
	Отчет = ПрочитатьПарольKafka();
	Если СтрНачинаетсяС(Отчет, "ok=1") Тогда
		Возврат "ok=1" + Символы.ПС
			+ "ready=1" + Символы.ПС
			+ "secret_in_report=0";
	КонецЕсли;
	
	Возврат "ok=0" + Символы.ПС
		+ "ready=0" + Символы.ПС
		+ "secret_in_report=0" + Символы.ПС
		+ "detail=" + СтрЗаменить(Отчет, Символы.ПС, ";");
	
КонецФункции

// Пароль Kafka для runtime-подключения (sasl.password). Не писать в журнал и отчёты.
// Источники те же, что у ПрочитатьПарольKafka: среда → файл → безопасное хранилище.
//
// Возвращаемое значение:
//  Строка - пароль либо пустая строка, если секрет не найден.
//
Функция ПарольKafkaДляПодключения() Экспорт
	
	ПарольИзСреды = ЗначениеПеременнойСреды("KAFKA_PASSWORD");
	Если ЗначениеЗаполнено(ПарольИзСреды) Тогда
		Возврат ПарольИзСреды;
	КонецЕсли;
	
	Путь = ПутьКФайлуПароляKafka();
	Если ЗначениеЗаполнено(Путь) Тогда
		Сырой = ПрочитатьТекстСекретаИзФайла(Путь);
		Если Сырой <> Неопределено Тогда
			ПарольИзФайла = ИзвлечьПарольИзФайла(Сырой);
			Если ЗначениеЗаполнено(ПарольИзФайла) Тогда
				Возврат ПарольИзФайла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПрочитатьПарольИзБезопасногоХранилища();
	
КонецФункции

// Загружает пароль во внутреннее безопасное хранилище из внешнего источника (не из git).
// В безопасном режиме расширения запись может быть запрещена — тогда сидирование
// выполняется кодом основной конфигурации (ОбщегоНазначения) вне расширения.
// Значение пароля в возвращаемый отчёт не включается.
//
// Параметры:
//  Пароль - Строка - секрет из окружения/файла вне репозитория.
//
// Возвращаемое значение:
//  Строка - отчёт ok/error.
//
Функция ЗагрузитьПарольKafkaВХранилище(Пароль) Экспорт
	
	Если Не ЗначениеЗаполнено(Пароль) Тогда
		Возврат "ok=0" + Символы.ПС + "error=EMPTY_SECRET";
	КонецЕсли;
	
	Попытка
		УстановитьОтключениеБезопасногоРежима(Истина);
		УстановитьПривилегированныйРежим(Истина);
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецСекретаKafka(), Строка(Пароль), "Пароль");
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Возврат "ok=0" + Символы.ПС
			+ "error=SAFE_MODE_WRITE_BLOCKED" + Символы.ПС
			+ "secret_in_report=0";
	КонецПопытки;
	
	Возврат "ok=1" + Символы.ПС
		+ "stored=1" + Символы.ПС
		+ "len=" + Формат(СтрДлина(Строка(Пароль)), "ЧН=0; ЧГ=") + Символы.ПС
		+ "secret_in_report=0";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВладелецСекретаKafka()
	
	Возврат "KFK_KafkaBroker";
	
КонецФункции

Функция ОтчетУспешногоЧтения(Пароль, Источник)
	
	Возврат "ok=1" + Символы.ПС
		+ "configured=1" + Символы.ПС
		+ "loaded=1" + Символы.ПС
		+ "len=" + Формат(СтрДлина(Пароль), "ЧН=0; ЧГ=") + Символы.ПС
		+ "source=" + Источник;
	
КонецФункции

Функция ПрочитатьПарольИзБезопасногоХранилища()
	
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Значение = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецСекретаKafka(), "Пароль");
		УстановитьПривилегированныйРежим(Ложь);
		Возврат СокрЛП(Строка(Значение));
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ПутьКФайлуПароляKafka()
	
	ИзСреды = ЗначениеПеременнойСреды("KAFKA_PASSWORD_FILE");
	Если ЗначениеЗаполнено(ИзСреды) Тогда
		Возврат ИзСреды;
	КонецЕсли;
	
	// Внешний файл вне git. Предпочтительно KAFKA_PASSWORD / хранилище БСП.
	Возврат "C:\Temp\kafka-pass.txt";
	
КонецФункции

Функция ЗначениеПеременнойСреды(Имя)
	
	Попытка
		Оболочка = Новый COMОбъект("WScript.Shell");
		Развернуто = Оболочка.ExpandEnvironmentStrings("%" + Имя + "%");
		Если ЗначениеЗаполнено(Развернуто) И Развернуто <> ("%" + Имя + "%") Тогда
			Возврат СокрЛП(Строка(Развернуто));
		КонецЕсли;
	Исключение
		Развернуто = ""; // fallback: Environment("PROCESS")
	КонецПопытки;
	
	Попытка
		Оболочка = Новый COMОбъект("WScript.Shell");
		Значение = Оболочка.Environment("PROCESS").Item(Имя);
		Возврат СокрЛП(Строка(Значение));
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ПрочитатьТекстСекретаИзФайла(Путь)
	
	// Расширение не привилегировано; в безопасном режиме файловый API часто недоступен.
	УстановитьОтключениеБезопасногоРежима(Истина);
	
	Текст = ПрочитатьТекстЧерезЧтениеТекста(Путь);
	Если Текст <> Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	
	Возврат ПрочитатьТекстЧерезCOM_FSO(Путь);
	
КонецФункции

Функция ПрочитатьТекстЧерезЧтениеТекста(Путь)
	
	Попытка
		ФайлНаДиске = Новый Файл(Путь);
		Если Не ФайлНаДиске.Существует() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Возврат Текст;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПрочитатьТекстЧерезCOM_FSO(Путь)
	
	Попытка
		FSO = Новый COMОбъект("Scripting.FileSystemObject");
		Если Не FSO.FileExists(Путь) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Поток = FSO.OpenTextFile(Путь, 1, Ложь, -2);
		Текст = Поток.ReadAll();
		Поток.Close();
		Возврат Текст;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ИзвлечьПарольИзФайла(СыройТекст)
	
	ДлинаПрефиксаPass = 6; // "pass: "
	ДлинаПрефиксаPassword = 10; // "password="
	
	Для Каждого СтрокаФайла Из СтрРазделить(Строка(СыройТекст), Символы.ПС, Ложь) Цикл
		СтрокаФайла = СокрЛП(СтрЗаменить(СтрокаФайла, Символы.ВК, ""));
		Если СтрНачинаетсяС(НРег(СтрокаФайла), "pass:") Тогда
			Возврат СокрЛП(Сред(СтрокаФайла, ДлинаПрефиксаPass));
		КонецЕсли;
		Если СтрНачинаетсяС(НРег(СтрокаФайла), "password=") Тогда
			Возврат СокрЛП(Сред(СтрокаФайла, ДлинаПрефиксаPassword));
		КонецЕсли;
	КонецЦикла;
	
	// Файл из одной строки — весь текст как пароль.
	ОднаСтрока = СокрЛП(СтрЗаменить(Строка(СыройТекст), Символы.ПС, ""));
	ОднаСтрока = СокрЛП(СтрЗаменить(ОднаСтрока, Символы.ВК, ""));
	Если СтрНайти(НРег(ОднаСтрока), "admin") = 0 Тогда
		Возврат ОднаСтрока;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
