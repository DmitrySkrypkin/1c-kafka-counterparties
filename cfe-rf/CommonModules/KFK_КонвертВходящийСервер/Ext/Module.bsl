#Область ПрограммныйИнтерфейс

// Собирает карту заголовков из JSON компоненты (объект с массивом headers[{key,value}]).
// Исходные значения сохраняются строками без нормализации регистра и без отбрасывания неизвестных ключей.
//
// Параметры:
//  ЗаголовкиJSON - Строка - JSON заголовков сообщения Kafka.
//
// Возвращаемое значение:
//  Соответствие - ключ заголовка → исходное строковое значение.
//
Функция КартаЗаголовковИзJSON(ЗаголовкиJSON) Экспорт
	
	Карта = Новый Соответствие;
	Если Не ЗначениеЗаполнено(ЗаголовкиJSON) Тогда
		Возврат Карта;
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ЗаголовкиJSON);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Карта;
	КонецЕсли;
	
	ЗаголовкиМассив = Данные.Получить("headers");
	
	Если ТипЗнч(ЗаголовкиМассив) <> Тип("Массив") Тогда
		Возврат Карта;
	КонецЕсли;
	
	Для Каждого ДанныеЗаголовка Из ЗаголовкиМассив Цикл
		КлючЗаголовка = ЗначениеПоляЗаголовка(ДанныеЗаголовка, "key");
		ЗначениеЗаголовка = ЗначениеПоляЗаголовка(ДанныеЗаголовка, "value");
		Если Не ЗначениеЗаполнено(КлючЗаголовка) Тогда
			Продолжить;
		КонецЕсли;
		Карта.Вставить(Строка(КлючЗаголовка), ИсходноеЗначениеЗаголовка(ЗначениеЗаголовка));
	КонецЦикла;
	
	Возврат Карта;
	
КонецФункции

// Разбирает JSON компоненты и сразу возвращает маскированный текст для журнала.
//
// Параметры:
//  ЗаголовкиJSON - Строка - JSON заголовков сообщения Kafka.
//
// Возвращаемое значение:
//  Строка - ТекстЗаголовковДляЖурнала.
//
Функция ТекстЗаголовковИзJSONКомпоненты(ЗаголовкиJSON) Экспорт
	
	Возврат ТекстЗаголовковДляЖурнала(КартаЗаголовковИзJSON(ЗаголовкиJSON));
	
КонецФункции

// Разбирает плоский JSON-объект заголовков фикстуры и проверяет его.
//
// Параметры:
//  ЗаголовкиJSON - Строка - JSON вида {"sender":"corp","id":"..."}.
//  ДопустимыеВерсии - Строка - маска вроде "1.0.*".
//
// Возвращаемое значение:
//  Структура - результат ПроверитьЗаголовки.
//
Функция ПроверитьЗаголовкиJSON(ЗаголовкиJSON, ДопустимыеВерсии = "1.0.*") Экспорт
	
	Карта = Новый Соответствие;
	Если ЗначениеЗаполнено(ЗаголовкиJSON) Тогда
		Данные = KFK_ОбщегоНазначения.JSONВЗначение(ЗаголовкиJSON);
		Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
			Для Каждого Пара Из Данные Цикл
				Карта.Вставить(Строка(Пара.Ключ), ИсходноеЗначениеЗаголовка(Пара.Значение));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Проверка = ПроверитьЗаголовки(Карта, ДопустимыеВерсии);
	
	// COM/внешнее соединение плохо маршалит Структура с массивами и Булево — отдаём одну строку.
	ЧастиОшибок = Новый Массив;
	Для Каждого Ошибка Из Проверка.Ошибки Цикл
		ЧастиОшибок.Добавить(Ошибка.Код + ":" + Ошибка.Путь);
	КонецЦикла;
	
	Возврат "accepted=" + ?(Проверка.Принят, "1", "0")
		+ Символы.ПС + "sender=" + Строка(Карта.Получить("sender"))
		+ Символы.ПС + "version=" + Строка(Карта.Получить("version"))
		+ Символы.ПС + "errors=" + СтрСоединить(ЧастиОшибок, "|")
		+ Символы.ПС + "journal=" + Проверка.ТекстДляЖурнала;
	
КонецФункции

// Проверяет обязательные заголовки конверта, UUID, timestamp-ms и major-версию по allow-list.
// Исходные значения в результате не переписываются. Credentials в ТекстДляЖурнала маскируются.
//
// Параметры:
//  КартаЗаголовков - Соответствие, Структура - ключ → исходное значение.
//  ДопустимыеВерсии - Строка - маска вроде "1.0.*" из настроек контура.
//
// Возвращаемое значение:
//  Структура - Принят, Заголовки, Ошибки (массив Код/Путь), ТекстДляЖурнала.
//
Функция ПроверитьЗаголовки(КартаЗаголовков, ДопустимыеВерсии = "1.0.*") Экспорт
	
	Исходные = НормализоватьКарту(КартаЗаголовков);
	Ошибки = Новый Массив;
	
	Обязательные = Новый Массив;
	Обязательные.Добавить("sender");
	Обязательные.Добавить("correlation-id");
	Обязательные.Добавить("timestamp-ms");
	Обязательные.Добавить("id");
	Обязательные.Добавить("type");
	Обязательные.Добавить("version");
	
	Для Каждого ИмяЗаголовка Из Обязательные Цикл
		Если Не ЗаголовокЗаполнен(Исходные, ИмяЗаголовка) Тогда
			ДобавитьОшибку(Ошибки, "REQUIRED_FIELD_MISSING", ИмяЗаголовка);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗаголовокЗаполнен(Исходные, "id") И Не ЭтоUUID(Исходные.Получить("id")) Тогда
		ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "id");
	КонецЕсли;
	Если ЗаголовокЗаполнен(Исходные, "correlation-id") И Не ЭтоUUID(Исходные.Получить("correlation-id")) Тогда
		ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "correlation-id");
	КонецЕсли;
	
	Если ЗаголовокЗаполнен(Исходные, "timestamp-ms") Тогда
		Метка = СокрЛП(Исходные.Получить("timestamp-ms"));
		Если Не ЭтоМеткаUnixСекунд(Метка) Тогда
			ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "timestamp-ms");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаголовокЗаполнен(Исходные, "type") Тогда
		ТипСообщения = СокрЛП(Исходные.Получить("type"));
		Если ТипСообщения <> "contragent_created" И ТипСообщения <> "contragent_updated" Тогда
			ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "type");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаголовокЗаполнен(Исходные, "version") Тогда
		Версия = СокрЛП(Исходные.Получить("version"));
		Если Не ВерсияДопустима(Версия, ДопустимыеВерсии) Тогда
			Если ЭтоВерсияСхемы(Версия) И Не МажорДопустим(Версия, ДопустимыеВерсии) Тогда
				ДобавитьОшибку(Ошибки, "UNSUPPORTED_VERSION", "version");
			Иначе
				ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "version");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Принят", Ошибки.Количество() = 0);
	Результат.Вставить("Заголовки", Исходные);
	Результат.Вставить("Ошибки", Ошибки);
	Результат.Вставить("ТекстДляЖурнала", ТекстЗаголовковДляЖурнала(Исходные));
	Возврат Результат;
	
КонецФункции

// Возвращает краткий текст заголовков для журнала без credentials и секретов.
//
// Параметры:
//  КартаЗаголовков - Соответствие, Структура - ключ → значение.
//
// Возвращаемое значение:
//  Строка - пары key=value через ";", секреты заменены на ***.
//
Функция ТекстЗаголовковДляЖурнала(КартаЗаголовков) Экспорт
	
	Исходные = НормализоватьКарту(КартаЗаголовков);
	Части = Новый Массив;
	Для Каждого Пара Из Исходные Цикл
		Ключ = Строка(Пара.Ключ);
		Значение = Строка(Пара.Значение);
		Если КлючСекретный(Ключ) Тогда
			Значение = "***";
		КонецЕсли;
		Части.Добавить(Ключ + "=" + Значение);
	КонецЦикла;
	
	Возврат СтрСоединить(Части, ";");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализоватьКарту(КартаЗаголовков)
	
	Результат = Новый Соответствие;
	Если КартаЗаголовков = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(КартаЗаголовков) = Тип("Соответствие") Тогда
		Для Каждого Пара Из КартаЗаголовков Цикл
			Результат.Вставить(Строка(Пара.Ключ), ИсходноеЗначениеЗаголовка(Пара.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(КартаЗаголовков) = Тип("Структура") Тогда
		Для Каждого Пара Из КартаЗаголовков Цикл
			Результат.Вставить(Строка(Пара.Ключ), ИсходноеЗначениеЗаголовка(Пара.Значение));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеПоляЗаголовка(ДанныеЗаголовка, ИмяПоля)
	
	Если ТипЗнч(ДанныеЗаголовка) = Тип("Структура") Тогда
		Если ДанныеЗаголовка.Свойство(ИмяПоля) Тогда
			Возврат ДанныеЗаголовка[ИмяПоля];
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаголовка) = Тип("Соответствие") Тогда
		Возврат ДанныеЗаголовка.Получить(ИмяПоля);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ИсходноеЗначениеЗаголовка(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

Функция ЗаголовокЗаполнен(Карта, ИмяЗаголовка)
	
	Значение = Карта.Получить(ИмяЗаголовка);
	Возврат ЗначениеЗаполнено(СокрЛП(Строка(Значение)));
	
КонецФункции

Процедура ДобавитьОшибку(Ошибки, Код, Путь)
	
	Для Каждого Существующая Из Ошибки Цикл
		Если Существующая.Код = Код И Существующая.Путь = Путь Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Ошибка = Новый Структура;
	Ошибка.Вставить("Код", Код);
	Ошибка.Вставить("Путь", Путь);
	Ошибки.Добавить(Ошибка);
	
КонецПроцедуры

Функция ЭтоUUID(Значение)
	
	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Возврат Строка(Новый УникальныйИдентификатор(Текст)) <> "";
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// По ТЗ: unix-время в секундах, ровно 10 цифр (имя заголовка timestamp-ms сохранено).
Функция ЭтоМеткаUnixСекунд(Метка)
	
	Если СтрДлина(Метка) <> 10 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(Метка) Цикл
		Символ = Сред(Метка, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЭтоВерсияСхемы(Версия)
	
	Части = СтрРазделить(Версия, ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Часть Из Части Цикл
		Если Не ЗначениеЗаполнено(Часть) Или Не ЭтоЦелоеЧислоСтрокой(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЭтоЦелоеЧислоСтрокой(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция ВерсияДопустима(Версия, ДопустимыеВерсии)
	
	Если Не ЭтоВерсияСхемы(Версия) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Шаблоны = СтрРазделить(Строка(ДопустимыеВерсии), ";", Ложь);
	ЧастиВерсии = СтрРазделить(Версия, ".", Ложь);
	
	Для Каждого Шаблон Из Шаблоны Цикл
		Маска = СокрЛП(Шаблон);
		Если Не ЗначениеЗаполнено(Маска) Тогда
			Продолжить;
		КонецЕсли;
		ЧастиМаски = СтрРазделить(Маска, ".", Ложь);
		Если ЧастиМаски.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Пока ЧастиМаски.Количество() < 3 Цикл
			ЧастиМаски.Добавить("*");
		КонецЦикла;
		Если ЧастьМаскиСовпадает(ЧастиМаски[0], ЧастиВерсии[0])
			И ЧастьМаскиСовпадает(ЧастиМаски[1], ЧастиВерсии[1])
			И ЧастьМаскиСовпадает(ЧастиМаски[2], ЧастиВерсии[2]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция МажорДопустим(Версия, ДопустимыеВерсии)
	
	ЧастиВерсии = СтрРазделить(Версия, ".", Ложь);
	Мажор = ЧастиВерсии[0];
	Шаблоны = СтрРазделить(Строка(ДопустимыеВерсии), ";", Ложь);
	Для Каждого Шаблон Из Шаблоны Цикл
		Маска = СокрЛП(Шаблон);
		Если Не ЗначениеЗаполнено(Маска) Тогда
			Продолжить;
		КонецЕсли;
		ЧастиМаски = СтрРазделить(Маска, ".", Ложь);
		Если ЧастиМаски.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЧастьМаскиСовпадает(ЧастиМаски[0], Мажор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЧастьМаскиСовпадает(ЧастьМаски, ЧастьВерсии)
	
	Если ЧастьМаски = "*" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ЧастьМаски = ЧастьВерсии;
	
КонецФункции

Функция КлючСекретный(Ключ)
	
	Нижний = НРег(Ключ);
	Маркеры = Новый Массив;
	Маркеры.Добавить("password");
	Маркеры.Добавить("passwd");
	Маркеры.Добавить("secret");
	Маркеры.Добавить("token");
	Маркеры.Добавить("credential");
	Маркеры.Добавить("api-key");
	Маркеры.Добавить("apikey");
	Маркеры.Добавить("authorization");
	Маркеры.Добавить("пароль");
	Маркеры.Добавить("секрет");
	
	Для Каждого Маркер Из Маркеры Цикл
		Если СтрНайти(Нижний, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
