#Область ПрограммныйИнтерфейс

// Обрабатывает входящий снимок счёта на оплату покупателю после подтверждённого started (design, решения 5, 5a, 5b).
// Разрешает ссылки (контрагента, договор и товары ждёт в пределах окна), проверяет дату запрета,
// полностью заменяет строки, записывает с сохранением проведения и публикует completed или failed.
//
// Параметры:
//  КодКонтура - ПеречислениеСсылка.KFK_КодыКонтуров - контур поставки.
//  ИдентификаторСообщения - Строка - message id процесса обмена.
//
// Возвращаемое значение:
//  Строка - ok=1|0;action=...;state=...
//
Функция ОбработатьСчетПослеStarted(КодКонтура, ИдентификаторСообщения) Экспорт

	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		Возврат Отчёт(0, "skip", "process_missing");
	КонецЕсли;

	ПопыткаОбработки = KFK_ПроцессыОбменаСервер.НачатьПопыткуОбработки(КодКонтура, ИдентификаторСообщения);
	Если Не СтрНачинаетсяС(ПопыткаОбработки, "ok=1") Тогда
		Возврат Отчёт(0, "skip", "attempt_not_started");
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("КодКонтура", КодКонтура);
	Контекст.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
	Контекст.Вставить("Процесс", Процесс);
	Контекст.Вставить("Данные", ДанныеТела(Строка(Процесс.СыройPayload)));
	Контекст.Вставить("ВнешнийID", 0);
	Контекст.Вставить("ВнешнийUID", "");
	Если ТипЗнч(Контекст.Данные) = Тип("Соответствие") Тогда
		Если ТипЗнч(Контекст.Данные.Получить("id")) = Тип("Число") Тогда
			Контекст.ВнешнийID = Контекст.Данные.Получить("id");
		КонецЕсли;
		Если ТипЗнч(Контекст.Данные.Получить("uid")) = Тип("Строка") Тогда
			Контекст.ВнешнийUID = НРег(СокрЛП(Контекст.Данные.Получить("uid")));
		КонецЕсли;
	КонецЕсли;
	Контекст.Вставить("КлючKafka", Строка(Процесс.КлючСообщенияKafka));
	Если Не ЗначениеЗаполнено(Контекст.КлючKafka) Тогда
		Контекст.КлючKafka = Контекст.ВнешнийUID;
	КонецЕсли;

	Заголовки = ЗаголовкиВходящего(КодКонтура, Процесс);
	Ошибки = Новый Массив;
	Если Не ЗначениеЗаполнено(Заголовки.Получить("organization-id")) Тогда
		Ошибки.Добавить("REQUIRED_HEADER_MISSING|organization-id|Не передан заголовок organization-id: счёт не загружен ни в одну базу");
		Возврат ЗафиксироватьFailed(Контекст, Ошибки, "header");
	КонецЕсли;

	ТипСообщения = KFK_НастройкиКонтуровСервер.КаноническийТипСообщения(Заголовки.Получить("type"));

	// Технический сбой не должен терять сообщение: попытка планируется повторно, после третьей - failed.
	Попытка
		Если ТипСообщения = "invoice.soft_delete" Тогда
			Результат = ПрименитьУдаление(Контекст);
		Иначе
			Результат = ПрименитьСнимок(Контекст);
		КонецЕсли;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Повтор = KFK_ПроцессыОбменаСервер.ЗапланироватьПовтор(
			КодКонтура, ИдентификаторСообщения, "INTERNAL_ERROR|invoice|" + ТекстОшибки);
		Если СтрНайти(Повтор, "exhausted=1") > 0 Тогда
			Ошибки.Добавить("INTERNAL_ERROR|invoice|" + СтрЗаменить(ТекстОшибки, "|", "/"));
			Возврат ЗафиксироватьFailed(Контекст, Ошибки, "exhausted");
		КонецЕсли;
		Возврат Отчёт(0, "retry", "waiting_retry");
	КонецПопытки;

	Если Результат.Ожидание Тогда
		Возврат Отчёт(0, "wait_references", "waiting_retry");
	КонецЕсли;
	Если Результат.Ошибки.Количество() > 0 Тогда
		Возврат ЗафиксироватьFailed(Контекст, Результат.Ошибки, Результат.Действие);
	КонецЕсли;

	ТелоCompleted = KFK_ИсходящиеСтатусыСервер.СобратьТелоСтатусаТовара(
		Контекст.ВнешнийID, Контекст.ВнешнийUID, Неопределено, Результат.НомерУчета);
	ОтчётCompleted = KFK_ИсходящиеСтатусыСервер.ЗафиксироватьCompletedСБизнесЗаписью(
		КодКонтура, ИдентификаторСообщения, Контекст.КлючKafka, ТелоCompleted, Результат.СнимокДо, Ложь);

	Возврат "ok=1" + Символы.ПС
		+ "action=" + Результат.Действие + Символы.ПС
		+ "state=completed" + Символы.ПС
		+ "number=" + Результат.НомерУчета + Символы.ПС
		+ "detail=" + СтрЗаменить(ОтчётCompleted, Символы.ПС, ";");

КонецФункции

// Ищет счёт по ключам портала (спецификация, Deterministic invoice lookup):
// KFK_ВнешнийID = id, затем KFK_ВнешнийUID = uid, затем ссылка с GUID = uid.
//
// Параметры:
//  ВнешнийID - Число - id портала или 0.
//  ВнешнийUID - Строка - uid счёта.
//
// Возвращаемое значение:
//  Структура - поля Ссылка (ДокументСсылка.СчетНаОплатуПокупателю или пустая) и Конфликт (Булево).
//
Функция НайтиСчет(ВнешнийID, ВнешнийUID) Экспорт

	Результат = Новый Структура("Ссылка, Конфликт", Документы.СчетНаОплатуПокупателю.ПустаяСсылка(), Ложь);

	Если ВнешнийID > 0 Тогда
		Найденные = СчетаПоРеквизиту("KFK_ВнешнийID", ВнешнийID);
		Если Найденные.Количество() > 1 Тогда
			Результат.Конфликт = Истина;
			Возврат Результат;
		ИначеЕсли Найденные.Количество() = 1 Тогда
			Результат.Ссылка = Найденные[0];
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВнешнийUID) Тогда
		Возврат Результат;
	КонецЕсли;
	Найденные = СчетаПоРеквизиту("KFK_ВнешнийUID", ВнешнийUID);
	Если Найденные.Количество() > 1 Тогда
		Результат.Конфликт = Истина;
	ИначеЕсли Найденные.Количество() = 1 Тогда
		Результат.Ссылка = Найденные[0];
	Иначе
		ПоСсылке = Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(Новый УникальныйИдентификатор(ВнешнийUID));
		Если ОбщегоНазначения.СсылкаСуществует(ПоСсылке) Тогда
			Результат.Ссылка = ПоСсылке;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Зависимости исходящего счёта (design, решение 6): контрагент шапки и номенклатура строк
// в порядке массива products[] исходящего тела.
//
// Параметры:
//  Ссылка - ДокументСсылка.СчетНаОплатуПокупателю - счёт.
//
// Возвращаемое значение:
//  Массив из Структура - Объект (ссылка), Путь (Строка - путь в теле: contragent, products[i].uid).
//
Функция ЗависимостиИсходящегоСчета(Ссылка) Экспорт

	Результат = Новый Массив;
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Контрагент");
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Результат.Добавить(Новый Структура("Объект, Путь", Контрагент, "contragent"));
	КонецЕсли;
	Строки = СтрокиИсходящегоСчета(Ссылка);
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		Если ЗначениеЗаполнено(Строки[Индекс].Номенклатура) Тогда
			Результат.Добавить(Новый Структура("Объект, Путь", Строки[Индекс].Номенклатура,
				"products[" + Формат(Индекс, "ЧН=0; ЧГ=") + "].uid"));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собирает тело invoice.created 1.0.0 для счёта, созданного в 1С (спецификация, Outbound invoice message contract).
// Без id портала; number - номер 1С; каждая строка - по uid товара.
//
// Параметры:
//  Ссылка - ДокументСсылка.СчетНаОплатуПокупателю - счёт.
//  КодКонтура - ПеречислениеСсылка.KFK_КодыКонтуров - контур (таблица ставок НДС).
//
// Возвращаемое значение:
//  Строка - JSON тела. Ошибка данных - исключение «код|путь|текст».
//
Функция СобратьИсходящийСнимок(Ссылка, КодКонтура) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
		"KFK_ВнешнийUID, Номер, Дата, СуммаДокумента, ПометкаУдаления,
		| Контрагент, Организация, ДоговорКонтрагента, Склад, СтруктурнаяЕдиница, ВалютаДокумента");
	Если Не ЗначениеЗаполнено(Реквизиты.Склад) Тогда
		ВызватьИсключение "REQUIRED_FIELD_MISSING|storehouse|В счёте не заполнен склад";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
		ВызватьИсключение "REQUIRED_FIELD_MISSING|contragent|В счёте не заполнен контрагент";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Реквизиты.ВалютаДокумента) Тогда
		ВызватьИсключение "REQUIRED_FIELD_MISSING|currency|В счёте не заполнена валюта";
	КонецЕсли;
	Строки = СтрокиИсходящегоСчета(Ссылка);
	Если Строки.Количество() = 0 Тогда
		ВызватьИсключение "REQUIRED_FIELD_MISSING|products|В счёте нет строк";
	КонецЕсли;

	UID = СокрЛП(Реквизиты.KFK_ВнешнийUID);
	Если Не ЗначениеЗаполнено(UID) Тогда
		UID = Строка(Ссылка.УникальныйИдентификатор());
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("uid");
	Запись.ЗаписатьЗначение(UID);
	Запись.ЗаписатьИмяСвойства("number");
	Запись.ЗаписатьЗначение(СокрЛП(Реквизиты.Номер));
	Запись.ЗаписатьИмяСвойства("released_at");
	Запись.ЗаписатьЗначение(Формат(Реквизиты.Дата, "ДФ=yyyy-MM-dd") + "T"
		+ Формат(Реквизиты.Дата, "ДФ=HH:mm:ss; ДП=00:00:00"));
	Запись.ЗаписатьИмяСвойства("sum");
	Запись.ЗаписатьЗначение(Реквизиты.СуммаДокумента);
	Запись.ЗаписатьИмяСвойства("is_marked_delete");
	Запись.ЗаписатьЗначение(Реквизиты.ПометкаУдаления = Истина);

	Запись.ЗаписатьИмяСвойства("contragent");
	ЗаписатьВнешниеКлючи(Запись, Реквизиты.Контрагент);
	Запись.ЗаписатьИмяСвойства("organization");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("id");
	КодОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.Организация, "KFK_ВнешнийID");
	Запись.ЗаписатьЗначение(?(ЗначениеЗаполнено(КодОрганизации), КодОрганизации, Неопределено));
	Запись.ЗаписатьИмяСвойства("uid");
	Запись.ЗаписатьЗначение(Строка(Реквизиты.Организация.УникальныйИдентификатор()));
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьИмяСвойства("contract");
	Если ЗначениеЗаполнено(Реквизиты.ДоговорКонтрагента) Тогда
		ЗаписатьВнешниеКлючи(Запись, Реквизиты.ДоговорКонтрагента);
	Иначе
		Запись.ЗаписатьЗначение(Неопределено);
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("storehouse");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("uid");
	Запись.ЗаписатьЗначение(Строка(Реквизиты.Склад.УникальныйИдентификатор()));
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьИмяСвойства("bank_account");
	Если ТипЗнч(Реквизиты.СтруктурнаяЕдиница) = Тип("СправочникСсылка.БанковскиеСчета")
		И ЗначениеЗаполнено(Реквизиты.СтруктурнаяЕдиница) Тогда
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("uid");
		Запись.ЗаписатьЗначение(Строка(Реквизиты.СтруктурнаяЕдиница.УникальныйИдентификатор()));
		Запись.ЗаписатьКонецОбъекта();
	Иначе
		Запись.ЗаписатьЗначение(Неопределено);
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("currency");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("rcc");
	Запись.ЗаписатьЗначение(Число(СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.ВалютаДокумента, "Код"))));
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("products");
	Запись.ЗаписатьНачалоМассива();
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		СтрокаСчета = Строки[Индекс];
		Путь = "products[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]";
		Если Не ЗначениеЗаполнено(СтрокаСчета.Номенклатура) Тогда
			ВызватьИсключение "REQUIRED_FIELD_MISSING|" + Путь + ".uid|В строке счёта не заполнена номенклатура";
		КонецЕсли;
		UIDТовара = СокрЛП(СтрокаСчета.UIDТовара);
		Если Не ЗначениеЗаполнено(UIDТовара) Тогда
			UIDТовара = Строка(СтрокаСчета.Номенклатура.УникальныйИдентификатор());
		КонецЕсли;
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("uid");
		Запись.ЗаписатьЗначение(UIDТовара);
		Запись.ЗаписатьИмяСвойства("quantity");
		Запись.ЗаписатьЗначение(СтрокаСчета.Количество);
		Запись.ЗаписатьИмяСвойства("price");
		Запись.ЗаписатьЗначение(СтрокаСчета.Цена);
		Запись.ЗаписатьИмяСвойства("sum");
		Запись.ЗаписатьЗначение(СтрокаСчета.Сумма);
		Запись.ЗаписатьИмяСвойства("sum_vat");
		Запись.ЗаписатьЗначение(СтрокаСчета.СуммаНДС);
		Запись.ЗаписатьИмяСвойства("vat_percent");
		Запись.ЗаписатьЗначение(ПроцентНДСИсходящий(КодКонтура, СтрокаСчета.СтавкаНДС, Путь));
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();

	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеТела(Тело)

	// Невалидный JSON - ошибка формата сообщения, а не технический сбой: ответ failed INVALID_FORMAT по body.
	Попытка
		Возврат KFK_ОбщегоНазначения.JSONВЗначение(Тело, , Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПрименитьСнимок(Контекст)

	Результат = НовыйРезультат();
	Данные = Контекст.Данные;

	ОшибкиТелаСчета(Данные, Результат.Ошибки);
	Если Результат.Ошибки.Количество() > 0 Тогда
		Результат.Действие = "validation";
		Возврат Результат;
	КонецЕсли;

	Ссылки = РазрешитьСсылки(Контекст, Результат);
	Если Результат.Ожидание Или Результат.Ошибки.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Поиск = НайтиСчет(Контекст.ВнешнийID, Контекст.ВнешнийUID);
	Если Поиск.Конфликт Тогда
		Результат.Ошибки.Добавить("DUPLICATE_CONFLICT|uid|По ключам портала найдено несколько счетов");
		Результат.Действие = "duplicate_conflict";
		Возврат Результат;
	КонецЕсли;

	ПометкаУдаления = ЭтоИстина(Данные.Получить("is_marked_delete"));
	Если Не ЗначениеЗаполнено(Поиск.Ссылка) И ПометкаУдаления Тогда
		// Новый счёт, уже удалённый на портале, не создаётся (спецификация, Deletion mark from portal).
		Результат.Действие = "skipped_deleted";
		Результат.СнимокДо = "{""skipped"":""deleted""}";
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		Если ЗначениеЗаполнено(Поиск.Ссылка) Тогда
			ЗаблокироватьСчет(Поиск.Ссылка);
			Объект = Поиск.Ссылка.ПолучитьОбъект();
			Результат.СнимокДо = СостояниеСчета(Объект);
			Результат.Действие = "updated";
			БылПроведен = Объект.Проведен;
		Иначе
			Объект = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
			Объект.УстановитьСсылкуНового(Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Контекст.ВнешнийUID)));
			Объект.Заполнить(Неопределено);
			Результат.СнимокДо = "{""new"":true}";
			Результат.Действие = "created";
			БылПроведен = Истина;
		КонецЕсли;

		ЗаполнитьШапку(Объект, Данные, Ссылки);
		ЗаполнитьСтроки(Объект, Данные, Ссылки, Результат.Ошибки);
		Если Результат.Ошибки.Количество() > 0 Тогда
			ОтменитьТранзакцию();
			Результат.Действие = "rows";
			Возврат Результат;
		КонецЕсли;

		// Проверка БСП видит и прежнюю дату (из базы), и новую (из объекта).
		ОписаниеОшибки = "";
		Если Объект.ЭтоНовый() Тогда
			Запрещено = ДатыЗапретаИзменения.ИзменениеЗапрещено(Объект, , ОписаниеОшибки);
		Иначе
			Запрещено = ДатыЗапретаИзменения.ИзменениеЗапрещено(Объект, Объект.Ссылка, ОписаниеОшибки);
		КонецЕсли;
		Если Запрещено Тогда
			ОтменитьТранзакцию();
			Результат.Ошибки.Добавить("PERIOD_CLOSED|released_at|" + СтрЗаменить(ТекстОписания(ОписаниеОшибки), "|", "/"));
			Результат.Действие = "period_closed";
			Возврат Результат;
		КонецЕсли;

		Объект.KFK_ВнешнийID = Контекст.ВнешнийID;
		Объект.KFK_ВнешнийUID = Контекст.ВнешнийUID;
		Объект.KFK_НомерПортала = СокрЛП(Данные.Получить("number"));
		// Запись обменом не регистрирует исходящий счёт (design, решение 6).
		Объект.ДополнительныеСвойства.Вставить("KFK_ЗаписьОбменом", Истина);

		ОшибкаЗаписи = ЗаписатьСчет(Объект, БылПроведен, ПометкаУдаления);
		Если ЗначениеЗаполнено(ОшибкаЗаписи) Тогда
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			Результат.Ошибки.Добавить("INTERNAL_ERROR|posting|" + СтрЗаменить(ОшибкаЗаписи, "|", "/"));
			Результат.Действие = "posting_failed";
			Возврат Результат;
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Результат.НомерУчета = СокрЛП(Объект.Номер);
	Возврат Результат;

КонецФункции

Функция ПрименитьУдаление(Контекст)

	Результат = НовыйРезультат();
	Если Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Контекст.ВнешнийUID) Тогда
		Результат.Ошибки.Добавить("REQUIRED_FIELD_MISSING|uid|Не заполнен uid счёта");
		Результат.Действие = "validation";
		Возврат Результат;
	КонецЕсли;

	Поиск = НайтиСчет(Контекст.ВнешнийID, Контекст.ВнешнийUID);
	Если Поиск.Конфликт Тогда
		Результат.Ошибки.Добавить("DUPLICATE_CONFLICT|uid|По ключам портала найдено несколько счетов");
		Результат.Действие = "duplicate_conflict";
		Возврат Результат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Поиск.Ссылка) Тогда
		// Неизвестный счёт: удалять нечего (решение 5b).
		Результат.Действие = "soft_delete_unknown";
		Результат.СнимокДо = "{""skipped"":""unknown""}";
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСчет(Поиск.Ссылка);
		Объект = Поиск.Ссылка.ПолучитьОбъект();
		Результат.СнимокДо = СостояниеСчета(Объект);
		ОписаниеОшибки = "";
		Если ДатыЗапретаИзменения.ИзменениеЗапрещено(Объект, Объект.Ссылка, ОписаниеОшибки) Тогда
			ОтменитьТранзакцию();
			Результат.Ошибки.Добавить("PERIOD_CLOSED|uid|" + СтрЗаменить(ТекстОписания(ОписаниеОшибки), "|", "/"));
			Результат.Действие = "period_closed";
			Возврат Результат;
		КонецЕсли;
		Если Не Объект.ПометкаУдаления Тогда
			Объект.ДополнительныеСвойства.Вставить("KFK_ЗаписьОбменом", Истина);
			Объект.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Результат.Действие = "soft_deleted";
	Результат.НомерУчета = СокрЛП(Объект.Номер);
	Возврат Результат;

КонецФункции

Функция РазрешитьСсылки(Контекст, Результат)

	Данные = Контекст.Данные;
	Ссылки = Новый Структура;
	Ожидаемые = Новый Массив;
	Ссылки.Вставить("Ответственный", НайтиОтветственного(
		Данные.Получить("responsible").Получить("uid"), Результат.Ошибки));

	Организация = Данные.Получить("organization");
	ОтчётОрганизации = KFK_АдаптерКонтрагентовРФСервер.РазрешитьОрганизациюДоговораРФ(
		Организация.Получить("id"), Организация.Получить("uid"));
	Если Не СтрНачинаетсяС(ОтчётОрганизации, "ok=1") Тогда
		Результат.Ошибки.Добавить("REFERENCE_NOT_FOUND|organization|Организация счёта не найдена в контуре: "
			+ СтрЗаменить(СтрЗаменить(ОтчётОрганизации, Символы.ПС, ";"), "|", "/"));
	Иначе
		Ссылки.Вставить("Организация", Справочники.Организации.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ПолеОтчёта(ОтчётОрганизации, "ref"))));
	КонецЕсли;

	Контрагент = Данные.Получить("contragent");
	ОтчётКонтрагента = KFK_ИдентичностьКонтрагентаСервер.РазрешитьКонтрагента(
		ЧислоИлиНеопределено(Контрагент.Получить("id")), СтрокаИлиНеопределено(Контрагент.Получить("uid")));
	РезультатКонтрагента = ПолеОтчёта(ОтчётКонтрагента, "result");
	КонтрагентПоGUID = Неопределено;
	Если РезультатКонтрагента = "create" Тогда
		КонтрагентПоGUID = КонтрагентПоGUIDСсылки(Контрагент.Получить("uid"));
	КонецЕсли;
	Если КонтрагентПоGUID <> Неопределено Тогда
		// Старая карточка РФ без uid портала: uid портала равен GUID ссылки (вопрос Q13).
		Ссылки.Вставить("Контрагент", КонтрагентПоGUID);
	ИначеЕсли РезультатКонтрагента = "conflict" Тогда
		Результат.Ошибки.Добавить("DUPLICATE_CONFLICT|contragent|По ключам найдено несколько контрагентов");
	ИначеЕсли РезультатКонтрагента = "create" Тогда
		Ожидаемые.Добавить("contragent");
	Иначе
		Ссылки.Вставить("Контрагент", Справочники.Контрагенты.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ПолеОтчёта(ОтчётКонтрагента, "ref"))));
	КонецЕсли;

	Договор = Данные.Получить("contract");
	Ссылки.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Если ТипЗнч(Договор) = Тип("Соответствие") Тогда
		НайденныйДоговор = НайтиДоговор(Договор, Ссылки, Результат.Ошибки);
		Если НайденныйДоговор = Неопределено Тогда
			Ожидаемые.Добавить("contract");
		Иначе
			Ссылки.Договор = НайденныйДоговор;
		КонецЕсли;
	КонецЕсли;

	UIDСклада = Данные.Получить("storehouse").Получить("uid");
	Если ЭтоUUID(UIDСклада) Тогда
		Склад = Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(UIDСклада));
		Если Не ОбщегоНазначения.СсылкаСуществует(Склад) Тогда
			Результат.Ошибки.Добавить("REFERENCE_NOT_FOUND|storehouse.uid|Склад не найден");
		КонецЕсли;
	Иначе
		// Портал не передал uid склада: склад по умолчанию из настроек контура (вопрос Q14).
		Склад = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(Контекст.КодКонтура).СкладПоУмолчанию;
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Результат.Ошибки.Добавить("REQUIRED_FIELD_MISSING|storehouse.uid|uid склада не передан, а склад по умолчанию в настройках контура не задан");
		КонецЕсли;
	КонецЕсли;
	Ссылки.Вставить("Склад", Склад);

	Ссылки.Вставить("БанковскийСчет", Справочники.БанковскиеСчета.ПустаяСсылка());
	БанковскийСчет = Данные.Получить("bank_account");
	Если ТипЗнч(БанковскийСчет) = Тип("Соответствие") Тогда
		Счет = Справочники.БанковскиеСчета.ПолучитьСсылку(Новый УникальныйИдентификатор(БанковскийСчет.Получить("uid")));
		Если Не ОбщегоНазначения.СсылкаСуществует(Счет) Тогда
			Результат.Ошибки.Добавить("REFERENCE_NOT_FOUND|bank_account.uid|Банковский счёт не найден");
		Иначе
			Ссылки.БанковскийСчет = Счет;
		КонецЕсли;
	КонецЕсли;

	КодВалюты = Формат(Данные.Получить("currency").Получить("rcc"), "ЧЦ=3; ЧВН=; ЧГ=0");
	Валюта = Справочники.Валюты.НайтиПоКоду(КодВалюты);
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Результат.Ошибки.Добавить("REFERENCE_NOT_FOUND|currency.rcc|Валюта с кодом " + КодВалюты + " не найдена");
	КонецЕсли;
	Ссылки.Вставить("Валюта", Валюта);

	Товары = Новый Массив;
	Ставки = Новый Массив;
	Строки = Данные.Получить("products");
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		СтрокаПортала = Строки[Индекс];
		ПоискТовара = KFK_АдаптерНоменклатурыСервер.НайтиТовар(НРег(СокрЛП(СтрокаПортала.Получить("uid"))));
		Если ПоискТовара.Конфликт Тогда
			Результат.Ошибки.Добавить("DUPLICATE_CONFLICT|products[" + Формат(Индекс, "ЧН=0; ЧГ=") + "].uid|uid товара указывает на разные элементы");
		ИначеЕсли Не ЗначениеЗаполнено(ПоискТовара.Ссылка) Тогда
			Ожидаемые.Добавить("products[" + Формат(Индекс, "ЧН=0; ЧГ=") + "].uid");
		КонецЕсли;
		Товары.Добавить(ПоискТовара.Ссылка);
		Ставка = СтавкаНДСПортала(Контекст.КодКонтура, СтрокаПортала.Получить("vat_percent"));
		Если Ставка = Неопределено Тогда
			Результат.Ошибки.Добавить("REFERENCE_NOT_FOUND|products[" + Формат(Индекс, "ЧН=0; ЧГ=") + "].vat_percent|Ставка "
				+ Строка(СтрокаПортала.Получить("vat_percent")) + " не найдена в таблице ставок НДС портала");
		КонецЕсли;
		Ставки.Добавить(Ставка);
	КонецЦикла;
	Ссылки.Вставить("Товары", Товары);
	Ссылки.Вставить("Ставки", Ставки);

	Если Результат.Ошибки.Количество() > 0 Или Ожидаемые.Количество() = 0 Тогда
		Возврат Ссылки;
	КонецЕсли;

	// Контрагент, договор и товары публикует портал в другие топики: они могут прийти позже счёта (решение 5a).
	НастройкиВида = KFK_НастройкиКонтуровСервер.ПрочитатьНастройкиВида(
		Контекст.КодКонтура, Перечисления.KFK_ВидыОбъектовОбмена.СчетНаОплатуПокупателю);
	ОкноСекунд = НастройкиВида.ОкноОжиданияСсылокМинут * 60;
	Прошло = ТекущаяДатаСеанса() - Контекст.Процесс.ДатаЗаписи;
	Если Прошло < ОкноСекунд Тогда
		Задержка = Мин(Макс(60, Цел(Прошло / 2)), 300);
		KFK_ПроцессыОбменаСервер.ОтложитьДоПоявленияСсылок(
			Контекст.КодКонтура, Контекст.ИдентификаторСообщения, Задержка, "waiting:" + СтрСоединить(Ожидаемые, ","));
		Результат.Ожидание = Истина;
		Возврат Ссылки;
	КонецЕсли;

	Для Каждого Путь Из Ожидаемые Цикл
		Результат.Ошибки.Добавить("REFERENCE_NOT_FOUND|" + Путь + "|Объект не появился за окно ожидания "
			+ Формат(НастройкиВида.ОкноОжиданияСсылокМинут, "ЧН=0; ЧГ=") + " мин");
	КонецЦикла;
	Результат.Действие = "references";
	Возврат Ссылки;

КонецФункции

Функция НайтиОтветственного(UIDМенеджера, Ошибки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.KFK_UIDМенеджераПортала = &UIDМенеджера";
	Запрос.УстановитьПараметр("UIDМенеджера", НРег(СокрЛП(UIDМенеджера)));
	РезультатЗапроса = Запрос.Выполнить();
	Найденные = РезультатЗапроса.Выгрузить();
	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0].Ссылка;
	КонецЕсли;
	Если Найденные.Количество() = 0 Тогда
		Ошибки.Добавить("REFERENCE_NOT_FOUND|responsible.uid|Не настроено соответствие менеджера пользователю 1С");
	Иначе
		Ошибки.Добавить("DUPLICATE_CONFLICT|responsible.uid|UID менеджера указан у нескольких пользователей 1С");
	КонецЕсли;
	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

Функция НайтиДоговор(Договор, Ссылки, Ошибки)

	Если Не Ссылки.Свойство("Контрагент") Или Не Ссылки.Свойство("Организация") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Договоры.Ссылка КАК Ссылка,
	|	Договоры.Организация КАК Организация
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Владелец = &Контрагент
	|	И (Договоры.KFK_ВнешнийID = &ВнешнийID И &ЕстьID
	|			ИЛИ Договоры.KFK_ВнешнийUID = &ВнешнийUID И &ЕстьUID)";
	ВнешнийID = ЧислоИлиНеопределено(Договор.Получить("id"));
	ВнешнийUID = СтрокаИлиНеопределено(Договор.Получить("uid"));
	Запрос.УстановитьПараметр("Контрагент", Ссылки.Контрагент);
	ЕстьID = ВнешнийID <> Неопределено;
	ЕстьUID = ВнешнийUID <> Неопределено;
	Если Не ЕстьID Тогда
		ВнешнийID = 0;
	КонецЕсли;
	Если Не ЕстьUID Тогда
		ВнешнийUID = "";
	КонецЕсли;
	Запрос.УстановитьПараметр("ВнешнийID", ВнешнийID);
	Запрос.УстановитьПараметр("ЕстьID", ЕстьID);
	Запрос.УстановитьПараметр("ВнешнийUID", ВнешнийUID);
	Запрос.УстановитьПараметр("ЕстьUID", ЕстьUID);
	РезультатЗапроса = Запрос.Выполнить();
	Найденные = РезультатЗапроса.Выгрузить();
	Если Найденные.Количество() = 1 Тогда
		Если Найденные[0].Организация <> Ссылки.Организация Тогда
			Ошибки.Добавить("REFERENCE_NOT_FOUND|contract|Договор относится к другой организации");
			Возврат Неопределено;
		КонецЕсли;
		Возврат Найденные[0].Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Процедура ЗаполнитьШапку(Объект, Данные, Ссылки)

	Объект.Дата = ДатаИзСтроки(Данные.Получить("released_at"));
	Объект.Организация = Ссылки.Организация;
	Объект.Контрагент = Ссылки.Контрагент;
	Объект.Ответственный = Ссылки.Ответственный;
	Объект.Склад = Ссылки.Склад;
	Объект.ВалютаДокумента = Ссылки.Валюта;
	Объект.СтруктурнаяЕдиница = Ссылки.БанковскийСчет;

	Курс = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Ссылки.Валюта, Объект.Дата);
	Объект.КурсВзаиморасчетов = 1;
	Объект.КратностьВзаиморасчетов = 1;
	Если ТипЗнч(Курс) = Тип("Структура") И Курс.Курс > 0 Тогда
		Объект.КурсВзаиморасчетов = Курс.Курс;
		Объект.КратностьВзаиморасчетов = Макс(Курс.Кратность, 1);
	КонецЕсли;

	Объект.ДоговорКонтрагента = Ссылки.Договор;

	// Признак «сумма включает НДС» вычисляется по суммам (спецификация, Invoice rows and VAT).
	СуммаСтрок = 0;
	Для Каждого СтрокаПортала Из Данные.Получить("products") Цикл
		СуммаСтрок = СуммаСтрок + Число(СтрокаПортала.Получить("sum"));
	КонецЦикла;
	Объект.СуммаВключаетНДС = Окр(Число(Данные.Получить("sum")) - СуммаСтрок, 2) = 0;

КонецПроцедуры

Процедура ЗаполнитьСтроки(Объект, Данные, Ссылки, Ошибки)

	Объект.Товары.Очистить();

	Строки = Данные.Получить("products");
	Итого = 0;
	ИтогоНДС = 0;
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		СтрокаПортала = Строки[Индекс];
		Товар = Ссылки.Товары[Индекс];
		СтрокаСчета = Объект.Товары.Добавить();
		СтрокаСчета.Номенклатура = Товар;
		СтрокаСчета.Количество = Число(СтрокаПортала.Получить("quantity"));
		СтрокаСчета.Цена = Число(СтрокаПортала.Получить("price"));
		СтрокаСчета.СтавкаНДС = Ссылки.Ставки[Индекс];
		ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(СтрокаСчета);
		ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаСчета, Объект.СуммаВключаетНДС);
		Путь = "products[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]";
		Если Макс(СтрокаСчета.Сумма - Число(СтрокаПортала.Получить("sum")), Число(СтрокаПортала.Получить("sum")) - СтрокаСчета.Сумма) > 0.01 Тогда
			Ошибки.Добавить("INVALID_FORMAT|" + Путь + ".sum|Сумма строки " + Формат(СтрокаСчета.Сумма, "ЧГ=0")
				+ " не совпадает с количеством и ценой портала");
		КонецЕсли;
		Если Макс(СтрокаСчета.СуммаНДС - Число(СтрокаПортала.Получить("sum_vat")), Число(СтрокаПортала.Получить("sum_vat")) - СтрокаСчета.СуммаНДС) > 0.01 Тогда
			Ошибки.Добавить("INVALID_FORMAT|" + Путь + ".sum_vat|НДС строки " + Формат(СтрокаСчета.СуммаНДС, "ЧГ=0")
				+ " не совпадает со ставкой и суммой портала");
		КонецЕсли;
		Итого = Итого + СтрокаСчета.Сумма;
		ИтогоНДС = ИтогоНДС + СтрокаСчета.СуммаНДС;
	КонецЦикла;

	Если Объект.СуммаВключаетНДС Тогда
		Объект.СуммаДокумента = Итого;
	Иначе
		Объект.СуммаДокумента = Итого + ИтогоНДС;
	КонецЕсли;

КонецПроцедуры

Функция ЗаписатьСчет(Объект, БылПроведен, ПометкаУдаления)

	// Одна запись: повторная запись того же объекта даёт ошибку «данные объекта модифицированы».
	Попытка
		Объект.ПометкаУдаления = ПометкаУдаления;
		Если ПометкаУдаления И Объект.Проведен Тогда
			// Помеченный на удаление счёт не может оставаться проведённым (спецификация, Deletion mark from portal).
			Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли ПометкаУдаления Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
		Иначе
			// Документы обмена проводятся сразу (ответ заказчика, вопрос 8 от октября 2026; Q8): в том числе
			// после снятия пометки удаления, которая отменила проведение.
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "";

КонецФункции

Процедура ОшибкиТелаСчета(Данные, Ошибки)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Ошибки.Добавить("INVALID_FORMAT|body|Тело сообщения не является JSON-объектом");
		Возврат;
	КонецЕсли;

	Если Не ЭтоUUID(Данные.Получить("uid")) Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|uid|Не заполнен или некорректен uid счёта");
	КонецЕсли;
	Если ТипЗнч(Данные.Получить("id")) <> Тип("Число") Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|id|Не заполнен id счёта портала");
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить("number,released_at", ",") Цикл
		Если Не ЗначениеЗаполнено(СокрЛП(Строка(Данные.Получить(Поле)))) Тогда
			Ошибки.Добавить("REQUIRED_FIELD_MISSING|" + Поле + "|Не заполнено поле " + Поле);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Данные.Получить("released_at")) И ДатаИзСтроки(Данные.Получить("released_at")) = Дата(1, 1, 1) Тогда
		Ошибки.Добавить("INVALID_FORMAT|released_at|Дата счёта не распознана");
	КонецЕсли;
	Если Не ЭтоЧисло(Данные.Получить("sum")) Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|sum|Не заполнена сумма счёта");
	КонецЕсли;
	Пометка = Данные.Получить("is_marked_delete");
	Если ТипЗнч(Пометка) <> Тип("Булево") И Пометка <> 0 И Пометка <> 1 Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|is_marked_delete|is_marked_delete должен быть true/false или 1/0");
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить("contragent,organization", ",") Цикл
		Значение = Данные.Получить(Поле);
		Если ТипЗнч(Значение) <> Тип("Соответствие")
			Или (Не ЭтоUUID(Значение.Получить("uid")) И ТипЗнч(Значение.Получить("id")) <> Тип("Число")) Тогда
			Ошибки.Добавить("REQUIRED_FIELD_MISSING|" + Поле + "|Не заполнены ключи " + Поле);
		КонецЕсли;
	КонецЦикла;
	Договор = Данные.Получить("contract");
	Если ТипЗнч(Договор) <> Тип("Соответствие") Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|contract|Не указан договор счёта");
	Иначе
		IDДоговора = ЧислоИлиНеопределено(Договор.Получить("id"));
		Если (IDДоговора = Неопределено Или IDДоговора <> Цел(IDДоговора))
			И Не ЭтоUUID(Договор.Получить("uid")) Тогда
			Ошибки.Добавить("REQUIRED_FIELD_MISSING|contract|Не заполнен id или uid договора");
		КонецЕсли;
	КонецЕсли;
	Ответственный = Данные.Получить("responsible");
	Если ТипЗнч(Ответственный) <> Тип("Соответствие") Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|responsible.uid|Не указан UID менеджера портала");
	ИначеЕсли Не ЗначениеЗаполнено(СтрокаИлиНеопределено(Ответственный.Получить("uid"))) Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|responsible.uid|Не указан UID менеджера портала");
	ИначеЕсли Не ЭтоUUID(Ответственный.Получить("uid")) Тогда
		Ошибки.Добавить("INVALID_FORMAT|responsible.uid|UID менеджера должен быть UUID");
	КонецЕсли;

	Склад = Данные.Получить("storehouse");
	Если ТипЗнч(Склад) <> Тип("Соответствие") Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|storehouse|Не заполнен склад");
	ИначеЕсли Склад.Получить("uid") <> Неопределено И Не ЭтоUUID(Склад.Получить("uid")) Тогда
		Ошибки.Добавить("INVALID_FORMAT|storehouse.uid|uid склада должен быть UUID или null");
	КонецЕсли;
	БанковскийСчет = Данные.Получить("bank_account");
	Если БанковскийСчет <> Неопределено И (ТипЗнч(БанковскийСчет) <> Тип("Соответствие") Или Не ЭтоUUID(БанковскийСчет.Получить("uid"))) Тогда
		Ошибки.Добавить("INVALID_FORMAT|bank_account.uid|bank_account должен быть null или объектом с uid");
	КонецЕсли;
	Валюта = Данные.Получить("currency");
	Если ТипЗнч(Валюта) <> Тип("Соответствие") Или ТипЗнч(Валюта.Получить("rcc")) <> Тип("Число") Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|currency.rcc|Не заполнен цифровой код валюты");
	КонецЕсли;

	Строки = Данные.Получить("products");
	Если ТипЗнч(Строки) <> Тип("Массив") Или Строки.Количество() = 0 Тогда
		Ошибки.Добавить("REQUIRED_FIELD_MISSING|products|Нет строк счёта");
		Возврат;
	КонецЕсли;
	СуммаСтрок = 0;
	СуммаНДС = 0;
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		СтрокаПортала = Строки[Индекс];
		Путь = "products[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]";
		Если ТипЗнч(СтрокаПортала) <> Тип("Соответствие") Тогда
			Ошибки.Добавить("INVALID_FORMAT|" + Путь + "|Строка счёта должна быть объектом");
			Продолжить;
		КонецЕсли;
		Если Не ЭтоUUID(СтрокаПортала.Получить("uid")) Тогда
			Ошибки.Добавить("REQUIRED_FIELD_MISSING|" + Путь + ".uid|Не заполнен uid товара");
		КонецЕсли;
		Для Каждого Поле Из СтрРазделить("quantity,price,sum,sum_vat", ",") Цикл
			Если Не ЭтоЧисло(СтрокаПортала.Получить(Поле)) Тогда
				Ошибки.Добавить("REQUIRED_FIELD_MISSING|" + Путь + "." + Поле + "|Не заполнено поле " + Поле);
			КонецЕсли;
		КонецЦикла;
		Если СтрокаПортала.Получить("vat_percent") <> Неопределено И Не ЭтоЧисло(СтрокаПортала.Получить("vat_percent")) Тогда
			Ошибки.Добавить("INVALID_FORMAT|" + Путь + ".vat_percent|vat_percent должен быть числом или null");
		КонецЕсли;
		Если ЭтоЧисло(СтрокаПортала.Получить("sum")) И ЭтоЧисло(СтрокаПортала.Получить("sum_vat")) Тогда
			СуммаСтрок = СуммаСтрок + Число(СтрокаПортала.Получить("sum"));
			СуммаНДС = СуммаНДС + Число(СтрокаПортала.Получить("sum_vat"));
		КонецЕсли;
	КонецЦикла;

	Если Ошибки.Количество() = 0 Тогда
		Сумма = Число(Данные.Получить("sum"));
		Если Макс(Сумма - СуммаСтрок, СуммаСтрок - Сумма) > 0.01
			И Макс(Сумма - СуммаСтрок - СуммаНДС, СуммаСтрок + СуммаНДС - Сумма) > 0.01 Тогда
			Ошибки.Добавить("INVALID_FORMAT|sum|Сумма счёта не равна ни сумме строк, ни сумме строк с НДС");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция СтавкаНДСПортала(КодКонтура, Процент)

	Если Процент = Неопределено Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.KFK_СтавкиНДСПортала.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.ПроцентНДС = Число(Процент);
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Или Не ЗначениеЗаполнено(МенеджерЗаписи.СтавкаНДС) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат МенеджерЗаписи.СтавкаНДС;

КонецФункции

Функция ЗаголовкиВходящего(КодКонтура, Процесс)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Входящие.Заголовки КАК Заголовки
	|ИЗ
	|	РегистрСведений.KFK_ВходящиеСообщения КАК Входящие
	|ГДЕ
	|	Входящие.КодКонтура = &КодКонтура
	|	И Входящие.Топик = &Топик
	|	И Входящие.Раздел = &Раздел
	|	И Входящие.Смещение = &Смещение";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("Топик", Процесс.ТопикСообщения);
	Запрос.УстановитьПараметр("Раздел", Процесс.РазделСообщения);
	Запрос.УстановитьПараметр("Смещение", Процесс.СмещениеСообщения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат KFK_КонвертВходящийСервер.КартаЗаголовковИзJSON(Выборка.Заголовки);
	КонецЕсли;

	Возврат Новый Соответствие;

КонецФункции

Функция СчетаПоРеквизиту(ИмяРеквизита, Значение)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	Счета.#Реквизит = &Значение";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#Реквизит", ИмяРеквизита);
	Запрос.УстановитьПараметр("Значение", Значение);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

