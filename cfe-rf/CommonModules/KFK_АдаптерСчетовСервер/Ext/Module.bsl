Функция СостояниеСчета(Объект)

	Состояние = Новый Структура;
	Состояние.Вставить("ref", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Состояние.Вставить("number", Объект.Номер);
	Состояние.Вставить("date", XMLСтрока(Объект.Дата));
	Состояние.Вставить("sum", Объект.СуммаДокумента);
	Состояние.Вставить("posted", Объект.Проведен);
	Состояние.Вставить("deleted", Объект.ПометкаУдаления);
	Состояние.Вставить("rows", Объект.Товары.Количество());
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Состояние);
	Возврат Запись.Закрыть();

