// Запасной поиск контрагента счёта: карточка, у которой GUID ссылки равен uid портала.
// Используется, только если по id и uid портала карточка не найдена (вопрос Q13).
//
// Параметры:
//  UID - Строка, Неопределено - uid контрагента из тела счёта.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты, Неопределено - найденная карточка (не группа, без пометки удаления).
//
Функция КонтрагентПоGUIDСсылки(UID)

	Если Не ЭтоUUID(UID) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(UID)));
	Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ЭтоГруппа, ПометкаУдаления");
	Если Реквизиты.ЭтоГруппа Или Реквизиты.ПометкаУдаления Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

Функция ДатаИзСтроки(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) < 10 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Текст = СтрЗаменить(Лев(СокрЛП(Значение), 19), " ", "T");
	Если СтрДлина(Текст) = 10 Тогда
		Текст = Текст + "T00:00:00";
	ИначеЕсли СтрДлина(Текст) = 16 Тогда
		Текст = Текст + ":00";
	КонецЕсли;
	// Дата портала без пересчёта часового пояса: в 1С записывается локальная дата счёта.
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ЭтоUUID(Значение)

	Возврат ТипЗнч(Значение) = Тип("Строка") И СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(СокрЛП(Значение));

КонецФункции

Функция ЭтоЧисло(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СтрЗаменить(Значение, ".", ""));

КонецФункции

Функция ЭтоИстина(Значение)

	Возврат Значение = Истина Или Значение = 1;

КонецФункции

Функция ЧислоИлиНеопределено(Значение)

	Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция СтрокаИлиНеопределено(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(Значение)) Тогда
		Возврат НРег(СокрЛП(Значение));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ТекстОписания(ОписаниеОшибки)

	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Возврат Строка(ОписаниеОшибки);
	КонецЕсли;
	Возврат "Дата счёта попадает в закрытый период";

КонецФункции

Функция ПолеОтчёта(Отчёт, ИмяПоля)

	Для Каждого Часть Из СтрРазделить(Отчёт, Символы.ПС) Цикл
		Если СтрНачинаетсяС(Часть, ИмяПоля + "=") Тогда
			Возврат Сред(Часть, СтрДлина(ИмяПоля) + 2);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция НовыйРезультат()

	Возврат Новый Структура("Ожидание, Ошибки, Действие, СнимокДо, НомерУчета", Ложь, Новый Массив, "", "", "");

КонецФункции

Функция Отчёт(Успех, Действие, Состояние)

	Возврат "ok=" + Формат(Успех, "ЧН=0; ЧГ=") + Символы.ПС + "action=" + Действие + Символы.ПС + "state=" + Состояние;

КонецФункции

Функция ЗафиксироватьFailed(Контекст, Ошибки, Действие)

	ТелоFailed = KFK_ИсходящиеСтатусыСервер.СобратьТелоСтатусаТовара(Контекст.ВнешнийID, Контекст.ВнешнийUID, Ошибки);
	ОтчётFailed = KFK_ИсходящиеСтатусыСервер.ЗафиксироватьFailedСТерминалом(
		Контекст.КодКонтура, Контекст.ИдентификаторСообщения, Контекст.КлючKafka, ТелоFailed, Ложь);

	Возврат "ok=0" + Символы.ПС
		+ "action=" + Действие + Символы.ПС
		+ "state=failed" + Символы.ПС
		+ "detail=" + СтрЗаменить(ОтчётFailed, Символы.ПС, ";");

КонецФункции

// Строки исходящего счёта в порядке products[].
//
// Параметры:
//  Ссылка - ДокументСсылка.СчетНаОплатуПокупателю - счёт.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, UIDТовара, Количество, Цена, Сумма, СуммаНДС, СтавкаНДС.
//
Функция СтрокиИсходящегоСчета(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Строки.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Строки.Номенклатура.KFK_ВнешнийUID, """") КАК UIDТовара,
	|	Строки.Количество КАК Количество,
	|	Строки.Цена КАК Цена,
	|	Строки.Сумма КАК Сумма,
	|	Строки.СуммаНДС КАК СуммаНДС,
	|	Строки.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строки.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Пишет {id, uid} объекта по внешним ключам: KFK_ВнешнийID / KFK_ВнешнийUID, иначе GUID ссылки (design, решение 6).
//
// Параметры:
//  Запись - ЗаписьJSON - открытая запись тела.
//  Ссылка - СправочникСсылка.Контрагенты, СправочникСсылка.ДоговорыКонтрагентов - объект с внешними ключами.
//
Процедура ЗаписатьВнешниеКлючи(Запись, Ссылка)

	Ключи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "KFK_ВнешнийID, KFK_ВнешнийUID");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("id");
	Запись.ЗаписатьЗначение(?(ЗначениеЗаполнено(Ключи.KFK_ВнешнийID), Ключи.KFK_ВнешнийID, Неопределено));
	Запись.ЗаписатьИмяСвойства("uid");
	UID = СокрЛП(Ключи.KFK_ВнешнийUID);
	Если Не ЗначениеЗаполнено(UID) Тогда
		UID = Строка(Ссылка.УникальныйИдентификатор());
	КонецЕсли;
	Запись.ЗаписатьЗначение(UID);
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

// Процент НДС портала по ставке строки (обратный поиск в KFK_СтавкиНДСПортала).
// Без НДС - Неопределено (null). Ставки нет в таблице - исключение REFERENCE_NOT_FOUND.
//
// Параметры:
//  КодКонтура - ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  Ставка - ставка НДС строки счёта.
//  Путь - Строка - путь строки в теле, products[i].
//
// Возвращаемое значение:
//  Число, Неопределено - процент НДС портала или null.
//
Функция ПроцентНДСИсходящий(КодКонтура, Ставка, Путь)

	Если Не ЗначениеЗаполнено(Ставка) Или Ставка = Перечисления.СтавкиНДС.БезНДС Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ставки.ПроцентНДС КАК ПроцентНДС
	|ИЗ
	|	РегистрСведений.KFK_СтавкиНДСПортала КАК Ставки
	|ГДЕ
	|	Ставки.КодКонтура = &КодКонтура
	|	И Ставки.СтавкаНДС = &Ставка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПроцентНДС УБЫВ";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("Ставка", Ставка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПроцентНДС;
	КонецЕсли;

	ВызватьИсключение "REFERENCE_NOT_FOUND|" + Путь + ".vat_percent|Ставка " + Строка(Ставка)
		+ " не найдена в таблице ставок НДС портала";

КонецФункции

#КонецОбласти
