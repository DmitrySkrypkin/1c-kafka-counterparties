#Область ПрограммныйИнтерфейс

// Ставит один логический Started процесса. Повтор возвращает уже записанный UUID.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id процесса.
//  КлючKafka - Строка - ключ сообщения статуса.
//  Payload - Строка - тело статусного сообщения.
//
// Возвращаемое значение:
//  Структура - поля исходящего статуса и признак ЭтоДубль.
//
Функция ПоставитьStarted(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload, ДатаЗаписи = Неопределено) Экспорт
	
	Возврат ПоставитьСтатус(КодКонтура, ИдентификаторСообщения, 10, КлючKafka, Payload, ДатаЗаписи);
	
КонецФункции

// Ставит один логический конечный статус процесса. Повтор возвращает уже записанный UUID.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id процесса.
//  КлючKafka - Строка - ключ сообщения статуса.
//  Payload - Строка - тело статусного сообщения.
//
// Возвращаемое значение:
//  Структура - поля исходящего статуса и признак ЭтоДубль.
//
Функция ПоставитьТерминальный(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload, ДатаЗаписи = Неопределено) Экспорт
	
	Возврат ПоставитьСтатус(КодКонтура, ИдентификаторСообщения, 20, КлючKafka, Payload, ДатаЗаписи);
	
КонецФункции

// Очищает Payload отправленных статусов старше границы. Строку Outbox не удаляет.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  Граница - Дата - записи с ДатаЗаписи строго раньше границы очищаются.
//
// Возвращаемое значение:
//  Число - сколько записей очищено.
//
Функция ОчиститьУстаревшийPayload(КодКонтура, Граница) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Статусы.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	Статусы.НомерПоследовательности КАК НомерПоследовательности
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСтатусы КАК Статусы
	|ГДЕ
	|	Статусы.КодКонтура = &КодКонтура
	|	И Статусы.ДатаЗаписи < &Граница
	|	И Статусы.СостояниеДоставки = &Отправлен";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("Отправлен", Перечисления.KFK_СостоянияДоставки.sent);
	
	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = МенеджерЗаписиСтатуса(
			ЗначениеКонтура, Выборка.ИдентификаторСообщения, Выборка.НомерПоследовательности);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			Продолжить;
		КонецЕсли;
		Если МенеджерЗаписи.СостояниеДоставки <> Перечисления.KFK_СостоянияДоставки.sent Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(МенеджерЗаписи.Payload) Тогда
			Продолжить;
		КонецЕсли;
		МенеджерЗаписи.Payload = "";
		МенеджерЗаписи.Записать();
		Количество = Количество + 1;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

// Возвращает исходящий статус процесса. Если записи нет, возвращает Неопределено.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id процесса.
//  НомерПоследовательности - Число - 10 для Started, 20 для конечного статуса.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля исходящего статуса.
//
Функция ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, НомерПоследовательности) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьКлюч(ИдентификаторСообщения, НомерПоследовательности);
	МенеджерЗаписи = МенеджерЗаписиСтатуса(ЗначениеКонтура, ИдентификаторСообщения, НомерПоследовательности);
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОписаниеСтатуса(МенеджерЗаписи, Ложь);
	
КонецФункции

// Компактный отчет статуса для внешних проверок.
//
// Возвращаемое значение:
//  Строка - found=0|1;uuid=...;delivery=pending|sent|failed|missing
//
Функция ОтчетСтатусаСтрокой(КодКонтура, ИдентификаторСообщения, НомерПоследовательности) Экспорт
	
	Статус = ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, НомерПоследовательности);
	Если Статус = Неопределено Тогда
		Возврат "found=0" + Символы.ПС
			+ "uuid=" + Символы.ПС
			+ "delivery=missing";
	КонецЕсли;
	
	Возврат "found=1" + Символы.ПС
		+ "uuid=" + Статус.ИдентификаторСтатуса + Символы.ПС
		+ "delivery=" + ИмяДоставки(Статус.СостояниеДоставки);
	
КонецФункции

// Удаляет исходящие статусы процесса (для тестовой очистки).
//
Процедура УдалитьСтатусыПроцесса(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьКлюч(ИдентификаторСообщения, 10);
	Для Каждого Номер Из СтрРазделить("10,20", ",") Цикл
		МенеджерЗаписи = МенеджерЗаписиСтатуса(ЗначениеКонтура, ИдентификаторСообщения, Число(Номер));
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Удаляет только terminal Outbox (sequence 20). Started сохраняется для replay.
//
Процедура УдалитьТерминальныйСтатус(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьКлюч(ИдентификаторСообщения, 20);
	МенеджерЗаписи = МенеджерЗаписиСтатуса(ЗначениеКонтура, ИдентификаторСообщения, 20);
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();
	КонецЕсли;
	
КонецПроцедуры

// После регистрации процесса ставит Started в Outbox и переводит процесс в started_pending.
// Body-валидация до подтверждённой публикации не допускается.
//
// Возвращаемое значение:
//  Строка - prepared=1|0;state=...;status_uuid=...;delivery=...;duplicate=...
//
Функция ПодготовитьStarted(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload) Экспорт
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
	КонецЕсли;
	
	ИмяСостояния = ИмяСостоянияПроцесса(Процесс.Состояние);
	Если ИмяСостояния = "received" Тогда
		Переход = KFK_ПроцессыОбменаСервер.ИзменитьСостояние(КодКонтура, ИдентификаторСообщения, "started_pending");
		Если СтрНайти(Переход, "changed=1") = 0 Тогда
			ВызватьИсключение "Не удалось перевести процесс в started_pending";
		КонецЕсли;
		ИмяСостояния = "started_pending";
	ИначеЕсли ИмяСостояния <> "started_pending"
		И ИмяСостояния <> "started_sent"
		И ИмяСостояния <> "processing"
		И ИмяСостояния <> "waiting_retry"
		И ИмяСостояния <> "completed"
		И ИмяСостояния <> "failed" Тогда
		ВызватьИсключение "Недопустимое состояние для Started: " + ИмяСостояния;
	КонецЕсли;
	
	Статус = ПоставитьStarted(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload);
	Доставка = ИмяДоставки(Статус.СостояниеДоставки);
	
	Возврат "prepared=1" + Символы.ПС
		+ "state=" + ИмяСостояния + Символы.ПС
		+ "status_uuid=" + Статус.ИдентификаторСтатуса + Символы.ПС
		+ "delivery=" + Доставка + Символы.ПС
		+ "duplicate=" + ?(Статус.ЭтоДубль, "1", "0");
	
КонецФункции

// Подтверждает публикацию Started в Kafka: Outbox → sent, процесс → started_sent, этап started.
//
// Возвращаемое значение:
//  Строка - confirmed=1|0;state=...;delivery=...;reason=...
//
Функция ПодтвердитьДоставкуStarted(КодКонтура, ИдентификаторСообщения, ИдентификаторКорреляции = "", Топик = "contragents.exchange", Раздел = 0, Смещение = 0, ДатаЗаписи = Неопределено) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьКлюч(ИдентификаторСообщения, 10);
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ИсходящиеСтатусы");
		ЭлементБлокировки.УстановитьЗначение("КодКонтура", ЗначениеКонтура);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
		ЭлементБлокировки.УстановитьЗначение("НомерПоследовательности", 10);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = МенеджерЗаписиСтатуса(ЗначениеКонтура, ИдентификаторСообщения, 10);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Started не найден в Outbox: " + ИдентификаторСообщения;
		КонецЕсли;
		
		Если МенеджерЗаписи.СостояниеДоставки <> Перечисления.KFK_СостоянияДоставки.sent Тогда
			МенеджерЗаписи.СостояниеДоставки = Перечисления.KFK_СостоянияДоставки.sent;
			МенеджерЗаписи.ДатаЗаписи = МоментЗаписи(ДатаЗаписи);
			МенеджерЗаписи.Записать();
		ИначеЕсли ЗначениеЗаполнено(ДатаЗаписи) Тогда
			МенеджерЗаписи.ДатаЗаписи = ДатаЗаписи;
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	ИмяСостояния = ИмяСостоянияПроцесса(Процесс.Состояние);
	Если ИмяСостояния = "started_pending" Тогда
		Переход = KFK_ПроцессыОбменаСервер.ИзменитьСостояние(КодКонтура, ИдентификаторСообщения, "started_sent");
		Если СтрНайти(Переход, "changed=1") = 0 Тогда
			ВызватьИсключение "Не удалось перевести процесс в started_sent";
		КонецЕсли;
		ИмяСостояния = "started_sent";
		Корреляция = ?(ЗначениеЗаполнено(ИдентификаторКорреляции), ИдентификаторКорреляции, Процесс.ИдентификаторКорреляции);
		KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
			КодКонтура,
			"started",
			"business",
			ИдентификаторСообщения,
			Корреляция,
			Топик,
			Раздел,
			Смещение,
			0,
			0,
			"started_sent");
	КонецЕсли;
	
	Возврат "confirmed=1" + Символы.ПС
		+ "state=" + ИмяСостояния + Символы.ПС
		+ "delivery=sent" + Символы.ПС
		+ "reason=ok";
	
КонецФункции

// Фиксирует transport-ошибку публикации Started без перехода к body-валидации.
// Процесс остаётся в started_pending, Outbox — pending с тем же UUID.
//
// Возвращаемое значение:
//  Строка - blocked=1;state=...;delivery=...;category=transport
//
Функция ЗафиксироватьСбойДоставкиStarted(КодКонтура, ИдентификаторСообщения, РезультатОшибки = "kafka_unavailable", ИдентификаторКорреляции = "", Топик = "contragents.exchange", Раздел = 0, Смещение = 0) Экспорт
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
	КонецЕсли;
	
	ИмяСостояния = ИмяСостоянияПроцесса(Процесс.Состояние);
	Если ИмяСостояния <> "started_pending" Тогда
		ВызватьИсключение "Сбой доставки Started допустим только в started_pending";
	КонецЕсли;
	
	Статус = ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, 10);
	Если Статус = Неопределено Тогда
		ВызватьИсключение "Started не найден в Outbox: " + ИдентификаторСообщения;
	КонецЕсли;
	
	ТекстРезультата = Лев(СокрЛП(РезультатОшибки), 150);
	Корреляция = ?(ЗначениеЗаполнено(ИдентификаторКорреляции), ИдентификаторКорреляции, Процесс.ИдентификаторКорреляции);
	KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
		КодКонтура,
		"error",
		"transport",
		ИдентификаторСообщения,
		Корреляция,
		Топик,
		Раздел,
		Смещение,
		0,
		0,
		ТекстРезультата);
	
	Возврат "blocked=1" + Символы.ПС
		+ "state=" + ИмяСостояния + Символы.ПС
		+ "delivery=" + ИмяДоставки(Статус.СостояниеДоставки) + Символы.ПС
		+ "category=transport";
	
КонецФункции

// True только после подтверждённой публикации Started (состояние started_sent и далее по бизнесу).
//
// Возвращаемое значение:
//  Строка - allowed=1|0;state=...
//
Функция РазрешенаВалидацияТела(КодКонтура, ИдентификаторСообщения) Экспорт
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		Возврат "allowed=0" + Символы.ПС + "state=missing";
	КонецЕсли;
	
	ИмяСостояния = ИмяСостоянияПроцесса(Процесс.Состояние);
	Разрешено = ИмяСостояния = "started_sent"
		Или ИмяСостояния = "processing"
		Или ИмяСостояния = "waiting_retry";
	
	Возврат "allowed=" + ?(Разрешено, "1", "0") + Символы.ПС
		+ "state=" + ИмяСостояния;
	
КонецФункции

// После подтверждённого Started ставит terminal Failed (цепочка Started → Failed).
// Полная транзакция Failed с бизнес-откатом — задача 4.4; здесь только статусный контур.
//
// Возвращаемое значение:
//  Строка - failed=1;state=failed;started_uuid=...;terminal_uuid=...
//
Функция ПоставитьFailedПослеStarted(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload) Экспорт
	
	Возврат ЗафиксироватьFailedСТерминалом(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload, Ложь);
	
КонецФункции

// Completed Outbox и бизнес-запись (аудит снимка) в одной транзакции.
// При ИскусственнаяОшибкаПослеБизнеса=Истина после аудита вызывается исключение — откатывается всё.
//
// Возвращаемое значение:
//  Строка - completed=1;state=completed;audit_id=...;terminal_uuid=...
//
Функция ЗафиксироватьCompletedСБизнесЗаписью(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload, СнимокДоДляАудита, ИскусственнаяОшибкаПослеБизнеса = Ложь) Экспорт
	
	ПроверитьГотовностьКТерминалу(КодКонтура, ИдентификаторСообщения);
	Если Не ЗначениеЗаполнено(СнимокДоДляАудита) Тогда
		ВызватьИсключение "Не заполнен снимок для аудита";
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ОбеспечитьProcessing(КодКонтура, ИдентификаторСообщения);
		Аудит = KFK_СлужебныеЖурналыСервер.ЗаписатьАудит(КодКонтура, ИдентификаторСообщения, СнимокДоДляАудита);
		Если ИскусственнаяОшибкаПослеБизнеса Тогда
			ВызватьИсключение "artificial_error_after_business";
		КонецЕсли;
		
		Терминальный = ПоставитьТерминальный(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload);
		Переход = KFK_ПроцессыОбменаСервер.ИзменитьСостояние(КодКонтура, ИдентификаторСообщения, "completed");
		Если СтрНайти(Переход, "changed=1") = 0 Тогда
			ВызватьИсключение "Не удалось перевести процесс в completed";
		КонецЕсли;
		
		Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
		KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
			КодКонтура,
			"completed",
			"business",
			ИдентификаторСообщения,
			Процесс.ИдентификаторКорреляции,
			"contragents.exchange",
			0,
			0,
			0,
			0,
			"completed");
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат "completed=1" + Символы.ПС
		+ "state=completed" + Символы.ПС
		+ "audit_id=" + Аудит.ИдентификаторЗаписи + Символы.ПС
		+ "terminal_uuid=" + Терминальный.ИдентификаторСтатуса;
	
КонецФункции

// Failed Outbox и terminal state процесса в одной транзакции.
// При ИскусственнаяОшибкаПослеСтатуса=Истина после Outbox вызывается исключение — откатывается всё.
//
// Возвращаемое значение:
//  Строка - failed=1;state=failed;terminal_uuid=...;started_uuid=...
//
// Публикует ожидающие Outbox: сначала sequence 10, затем 20 только при sent Started.
// Повтор использует тот же UUID записи. При СимулироватьУспех=Ложь Started не подтверждается.
//
// Возвращаемое значение:
//  Строка - started_published=N;terminal_published=N;terminal_skipped=N;transport_fail=N
//
// Собирает заголовки статусного сообщения: новый UUID, исходный correlation-id,
// timestamp-ms (13 цифр), version и sender контура.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  ТипСтатуса - Строка - started, completed либо failed.
//  ИдентификаторКорреляции - Строка - исходный correlation-id.
//  ИдентификаторСтатуса - Строка - готовый UUID; пустой — генерируется новый.
//
// Возвращаемое значение:
//  Строка - JSON-объект заголовков.
//
// Тело Started/Completed: обязательный id контрагента и опциональный uid.
//
// Возвращаемое значение:
//  Строка - JSON тела статуса.
//
Функция СобратьТелоStartedИлиCompleted(ВнешнийIDКонтрагента, ВнешнийUIDКонтрагента = "") Экспорт
	
	Если ТипЗнч(ВнешнийIDКонтрагента) <> Тип("Число") Или ВнешнийIDКонтрагента < 1 Тогда
		ВызватьИсключение "id контрагента должен быть положительным числом";
	КонецЕсли;
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("id");
	Запись.ЗаписатьЗначение(ВнешнийIDКонтрагента);
	Если ЗначениеЗаполнено(ВнешнийUIDКонтрагента) Тогда
		Запись.ЗаписатьИмяСвойства("uid");
		Запись.ЗаписатьЗначение(ВнешнийUIDКонтрагента);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Тело Failed: id, опциональный uid и непустой messages[].
// СообщенияОшибок - массив структур с полями Код, Путь, Сообщение либо строк "code|path|message".
//
Функция СобратьТелоFailed(ВнешнийIDКонтрагента, СообщенияОшибок, ВнешнийUIDКонтрагента = "") Экспорт
	
	Если ТипЗнч(ВнешнийIDКонтрагента) <> Тип("Число") Или ВнешнийIDКонтрагента < 1 Тогда
		ВызватьИсключение "id контрагента должен быть положительным числом";
	КонецЕсли;
	Если ТипЗнч(СообщенияОшибок) <> Тип("Массив") Или СообщенияОшибок.Количество() = 0 Тогда
		ВызватьИсключение "messages[] должен быть непустым";
	КонецЕсли;
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("id");
	Запись.ЗаписатьЗначение(ВнешнийIDКонтрагента);
	Если ЗначениеЗаполнено(ВнешнийUIDКонтрагента) Тогда
		Запись.ЗаписатьИмяСвойства("uid");
		Запись.ЗаписатьЗначение(ВнешнийUIDКонтрагента);
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("messages");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого Элемент Из СообщенияОшибок Цикл
		Код = "";
		Путь = "";
		Текст = "";
		Если ТипЗнч(Элемент) = Тип("Структура") Тогда
			Элемент.Свойство("Код", Код);
			Элемент.Свойство("Путь", Путь);
			Элемент.Свойство("Сообщение", Текст);
		Иначе
			Части = СтрРазделить(Строка(Элемент), "|");
			Если Части.Количество() < 3 Тогда
				ВызватьИсключение "Элемент messages должен быть code|path|message";
			КонецЕсли;
			Код = Части[0];
			Путь = Части[1];
			Текст = Части[2];
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Код) Или Не ЗначениеЗаполнено(Путь) Или Не ЗначениеЗаполнено(Текст) Тогда
			ВызватьИсключение "messages[] требует непустые code, path и message";
		КонецЕсли;
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("code");
		Запись.ЗаписатьЗначение(Код);
		Запись.ЗаписатьИмяСвойства("path");
		Запись.ЗаписатьЗначение(Путь);
		Запись.ЗаписатьИмяСвойства("message");
		Запись.ЗаписатьЗначение(Текст);
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Строковый отчёт тела Failed для внешних проверок без передачи массива через COM.
//
Функция СобратьТелоFailedСтрокой(ВнешнийIDКонтрагента, СообщенияЧерезПайп, ВнешнийUIDКонтрагента = "") Экспорт
	
	МассивСообщений = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СообщенияЧерезПайп, ";") Цикл
		Если ЗначениеЗаполнено(Часть) Тогда
			МассивСообщений.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СобратьТелоFailed(ВнешнийIDКонтрагента, МассивСообщений, ВнешнийUIDКонтрагента);
	
КонецФункции

Функция СобратьЗаголовкиСтатуса(КодКонтура, ТипСтатуса, ИдентификаторКорреляции, ИдентификаторСтатуса = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторКорреляции) Тогда
		ВызватьИсключение "Не заполнен correlation-id";
	КонецЕсли;
	
	ТипСообщения = ТипСтатусногоСообщения(ТипСтатуса);
	Идентичность = KFK_НастройкиКонтуровСервер.ИдентичностьКонтура(КодКонтура);
	Идентификатор = ?(ЗначениеЗаполнено(ИдентификаторСтатуса), ИдентификаторСтатуса, Строка(Новый УникальныйИдентификатор()));
	// Платформенные мс считаются от 0001-01-01; Unix epoch = 62135596800000.
	Метка = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - 62135596800000, "ЧГ=");
	Если СтрДлина(Метка) <> 13 Тогда
		ВызватьИсключение "Некорректный timestamp-ms: " + Метка;
	КонецЕсли;
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("sender");
	Запись.ЗаписатьЗначение(Идентичность.Отправитель);
	Запись.ЗаписатьИмяСвойства("correlation-id");
	Запись.ЗаписатьЗначение(ИдентификаторКорреляции);
	Запись.ЗаписатьИмяСвойства("timestamp-ms");
	Запись.ЗаписатьЗначение(Метка);
	Запись.ЗаписатьИмяСвойства("id");
	Запись.ЗаписатьЗначение(Идентификатор);
	Запись.ЗаписатьИмяСвойства("type");
	Запись.ЗаписатьЗначение(ТипСообщения);
	Запись.ЗаписатьИмяСвойства("version");
	Запись.ЗаписатьЗначение("1.0.0");
	Запись.ЗаписатьКонецОбъекта();
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Публикует ожидающие Outbox: сначала sequence 10, затем 20 только при sent Started.
// Повтор использует тот же UUID записи.
// СимулироватьУспех=Истина без РеальнаяОтправка — логическое подтверждение (COM/verification).
// РеальнаяОтправка=Истина — KFK_Интеграция.Опубликовать в ТопикСтатусов контура.
//
Функция ОпубликоватьОжидающие(КодКонтура, Лимит = 100, СимулироватьУспех = Истина, РеальнаяОтправка = Ложь) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Если Лимит < 1 Тогда
		ВызватьИсключение "Лимит должен быть положительным";
	КонецЕсли;
	
	ОпубликованоStarted = 0;
	ОпубликованоTerminal = 0;
	ПропущеноTerminal = 0;
	СбоиТранспорта = 0;
	
	ПараметрыКонтура = Неопределено;
	Если РеальнаяОтправка Тогда
		ПараметрыКонтура = ПараметрыРеальнойПубликацииСтатусов(КодКонтура);
	КонецЕсли;
	
	ВыборкаStarted = ВыборкаОжидающих(ЗначениеКонтура, 10, Лимит);
	Пока ВыборкаStarted.Следующий() Цикл
		
		ИдентификаторСтатусаДо = ВыборкаStarted.ИдентификаторСтатуса;
		ИдентификаторСообщения = ВыборкаStarted.ИдентификаторСообщения;
		
		Если РеальнаяОтправка Тогда
			
			РезультатОтправки = ОпубликоватьСтатусВKafka(
				КодКонтура,
				ИдентификаторСообщения,
				10,
				"started",
				ПараметрыКонтура);
			Если Не РезультатОтправки.Успех Тогда
				ЗафиксироватьСбойДоставкиStarted(
					КодКонтура,
					ИдентификаторСообщения,
					РезультатОтправки.Ошибка,
					"",
					ПараметрыКонтура.ТопикСтатусов);
				СбоиТранспорта = СбоиТранспорта + 1;
				Продолжить;
			КонецЕсли;
			
			ПодтвердитьДоставкуStarted(
				КодКонтура,
				ИдентификаторСообщения,
				"",
				ПараметрыКонтура.ТопикСтатусов,
				РезультатОтправки.Раздел,
				РезультатОтправки.Смещение);
			
		ИначеЕсли Не СимулироватьУспех Тогда
			
			ЗафиксироватьСбойДоставкиStarted(
				КодКонтура,
				ИдентификаторСообщения,
				"kafka_unavailable");
			СбоиТранспорта = СбоиТранспорта + 1;
			Продолжить;
			
		Иначе
			
			ПодтвердитьДоставкуStarted(КодКонтура, ИдентификаторСообщения);
			
		КонецЕсли;
		
		СтатусПосле = ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, 10);
		Если СтатусПосле = Неопределено Или СтатусПосле.ИдентификаторСтатуса <> ИдентификаторСтатусаДо Тогда
			ВызватьИсключение "UUID Started изменился при публикации";
		КонецЕсли;
		ОпубликованоStarted = ОпубликованоStarted + 1;
		
	КонецЦикла;
	
	ВыборкаTerminal = ВыборкаОжидающих(ЗначениеКонтура, 20, Лимит);
	Пока ВыборкаTerminal.Следующий() Цикл
		
		ИдентификаторСообщения = ВыборкаTerminal.ИдентификаторСообщения;
		Started = ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, 10);
		Если Started = Неопределено Или Started.СостояниеДоставки <> Перечисления.KFK_СостоянияДоставки.sent Тогда
			ПропущеноTerminal = ПропущеноTerminal + 1;
			Продолжить;
		КонецЕсли;
		
		Если РеальнаяОтправка Тогда
			
			ТипСтатуса = ТипТерминальногоСтатуса(КодКонтура, ИдентификаторСообщения);
			РезультатОтправки = ОпубликоватьСтатусВKafka(
				КодКонтура,
				ИдентификаторСообщения,
				20,
				ТипСтатуса,
				ПараметрыКонтура);
			Если Не РезультатОтправки.Успех Тогда
				СбоиТранспорта = СбоиТранспорта + 1;
				Продолжить;
			КонецЕсли;
			
		ИначеЕсли Не СимулироватьУспех Тогда
			
			СбоиТранспорта = СбоиТранспорта + 1;
			Продолжить;
			
		КонецЕсли;
		
		ИдентификаторДо = ВыборкаTerminal.ИдентификаторСтатуса;
		ПодтвердитьДоставкуСтатуса(ЗначениеКонтура, ИдентификаторСообщения, 20);
		СтатусПосле = ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, 20);
		Если СтатусПосле = Неопределено Или СтатусПосле.ИдентификаторСтатуса <> ИдентификаторДо Тогда
			ВызватьИсключение "UUID terminal изменился при публикации";
		КонецЕсли;
		ОпубликованоTerminal = ОпубликованоTerminal + 1;
		
	КонецЦикла;
	
	Возврат "started_published=" + Формат(ОпубликованоStarted, "ЧН=0; ЧГ=") + Символы.ПС
		+ "terminal_published=" + Формат(ОпубликованоTerminal, "ЧН=0; ЧГ=") + Символы.ПС
		+ "terminal_skipped=" + Формат(ПропущеноTerminal, "ЧН=0; ЧГ=") + Символы.ПС
		+ "transport_fail=" + Формат(СбоиТранспорта, "ЧН=0; ЧГ=");
	
КонецФункции

Функция ЗафиксироватьFailedСТерминалом(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload, ИскусственнаяОшибкаПослеСтатуса = Ложь) Экспорт
	
	Started = ПроверитьГотовностьКТерминалу(КодКонтура, ИдентификаторСообщения);
	
	НачатьТранзакцию();
	Попытка
		
		ОбеспечитьProcessing(КодКонтура, ИдентификаторСообщения);
		Терминальный = ПоставитьТерминальный(КодКонтура, ИдентификаторСообщения, КлючKafka, Payload);
		Если ИскусственнаяОшибкаПослеСтатуса Тогда
			ВызватьИсключение "artificial_error_after_status";
		КонецЕсли;
		
		Переход = KFK_ПроцессыОбменаСервер.ИзменитьСостояние(КодКонтура, ИдентификаторСообщения, "failed");
		Если СтрНайти(Переход, "changed=1") = 0 Тогда
			ВызватьИсключение "Не удалось перевести процесс в failed";
		КонецЕсли;
		
		Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
		KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
			КодКонтура,
			"failed",
			"business",
			ИдентификаторСообщения,
			Процесс.ИдентификаторКорреляции,
			"contragents.exchange",
			0,
			0,
			0,
			0,
			"failed");
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат "failed=1" + Символы.ПС
		+ "state=failed" + Символы.ПС
		+ "started_uuid=" + Started.ИдентификаторСтатуса + Символы.ПС
		+ "terminal_uuid=" + Терминальный.ИдентификаторСтатуса;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоставитьСтатус(КодКонтура, ИдентификаторСообщения, НомерПоследовательности, КлючKafka, Payload, ДатаЗаписи = Неопределено)
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьКлюч(ИдентификаторСообщения, НомерПоследовательности);
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ИсходящиеСтатусы");
		ЭлементБлокировки.УстановитьЗначение("КодКонтура", ЗначениеКонтура);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
		ЭлементБлокировки.УстановитьЗначение("НомерПоследовательности", НомерПоследовательности);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = МенеджерЗаписиСтатуса(ЗначениеКонтура, ИдентификаторСообщения, НомерПоследовательности);
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			Результат = ОписаниеСтатуса(МенеджерЗаписи, Истина);
		Иначе
			Процесс = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
			Процесс.Прочитать();
			Если Не Процесс.Выбран() Тогда
				ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
			КонецЕсли;
			
			ИдентификаторСтатуса = Строка(Новый УникальныйИдентификатор());
			МенеджерЗаписи.КодКонтура = ЗначениеКонтура;
			МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
			МенеджерЗаписи.НомерПоследовательности = НомерПоследовательности;
			МенеджерЗаписи.ИдентификаторСтатуса = ИдентификаторСтатуса;
			МенеджерЗаписи.КлючKafka = КлючKafka;
			МенеджерЗаписи.Payload = Payload;
			МенеджерЗаписи.СостояниеДоставки = Перечисления.KFK_СостоянияДоставки.pending;
			МенеджерЗаписи.ДатаЗаписи = МоментЗаписи(ДатаЗаписи);
			МенеджерЗаписи.Записать();
			
			Если НомерПоследовательности = 10 Тогда
				Процесс.ИдентификаторСтатусаStarted = ИдентификаторСтатуса;
			Иначе
				Процесс.ИдентификаторСтатусаTerminal = ИдентификаторСтатуса;
			КонецЕсли;
			Процесс.Записать();
			Результат = ОписаниеСтатуса(МенеджерЗаписи, Ложь);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция МенеджерЗаписиСтатуса(КодКонтура, ИдентификаторСообщения, НомерПоследовательности)
	
	МенеджерЗаписи = РегистрыСведений.KFK_ИсходящиеСтатусы.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
	МенеджерЗаписи.НомерПоследовательности = НомерПоследовательности;
	Возврат МенеджерЗаписи;
	
КонецФункции

Функция МенеджерЗаписиПроцесса(КодКонтура, ИдентификаторСообщения)
	
	МенеджерЗаписи = РегистрыСведений.KFK_ПроцессыОбмена.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
	Возврат МенеджерЗаписи;
	
КонецФункции

Функция ОписаниеСтатуса(МенеджерЗаписи, ЭтоДубль)
	
	Результат = Новый Структура;
	Результат.Вставить("ЭтоДубль", ЭтоДубль);
	Результат.Вставить("ИдентификаторСообщения", МенеджерЗаписи.ИдентификаторСообщения);
	Результат.Вставить("НомерПоследовательности", МенеджерЗаписи.НомерПоследовательности);
	Результат.Вставить("ИдентификаторСтатуса", МенеджерЗаписи.ИдентификаторСтатуса);
	Результат.Вставить("КлючKafka", МенеджерЗаписи.КлючKafka);
	Результат.Вставить("Payload", МенеджерЗаписи.Payload);
	Результат.Вставить("СостояниеДоставки", МенеджерЗаписи.СостояниеДоставки);
	Результат.Вставить("ДатаЗаписи", МенеджерЗаписи.ДатаЗаписи);
	Возврат Результат;
	
КонецФункции

Функция МоментЗаписи(ДатаЗаписи)
	
	Если ДатаЗаписи = Неопределено Или Не ЗначениеЗаполнено(ДатаЗаписи) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;
	
	Возврат ДатаЗаписи;
	
КонецФункции

Процедура ПроверитьКлюч(ИдентификаторСообщения, НомерПоследовательности)
	
	Если Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ВызватьИсключение "Не заполнен идентификатор сообщения";
	КонецЕсли;
	Если НомерПоследовательности <> 10 И НомерПоследовательности <> 20 Тогда
		ВызватьИсключение "Недопустимый номер последовательности: " + Строка(НомерПоследовательности);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗначениеКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

Функция ТипСтатусногоСообщения(ТипСтатуса)
	
	Имя = НРег(СокрЛП(Строка(ТипСтатуса)));
	Если Имя = "started" Или Имя = "contragent_exchange_started" Тогда
		Возврат "contragent_exchange_started";
	ИначеЕсли Имя = "completed" Или Имя = "contragent_exchange_completed" Тогда
		Возврат "contragent_exchange_completed";
	ИначеЕсли Имя = "failed" Или Имя = "contragent_exchange_failed" Тогда
		Возврат "contragent_exchange_failed";
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный тип статуса: " + Строка(ТипСтатуса);
	
КонецФункции

Функция ВыборкаОжидающих(КодКонтура, НомерПоследовательности, Лимит)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + "
	|	Статусы.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	Статусы.ИдентификаторСтатуса КАК ИдентификаторСтатуса,
	|	Статусы.НомерПоследовательности КАК НомерПоследовательности
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСтатусы КАК Статусы
	|ГДЕ
	|	Статусы.КодКонтура = &КодКонтура
	|	И Статусы.НомерПоследовательности = &НомерПоследовательности
	|	И Статусы.СостояниеДоставки = &Ожидает
	|
	|УПОРЯДОЧИТЬ ПО
	|	Статусы.ИдентификаторСообщения";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("НомерПоследовательности", НомерПоследовательности);
	Запрос.УстановитьПараметр("Ожидает", Перечисления.KFK_СостоянияДоставки.pending);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ПодтвердитьДоставкуСтатуса(КодКонтура, ИдентификаторСообщения, НомерПоследовательности)
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ИсходящиеСтатусы");
		ЭлементБлокировки.УстановитьЗначение("КодКонтура", КодКонтура);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
		ЭлементБлокировки.УстановитьЗначение("НомерПоследовательности", НомерПоследовательности);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = МенеджерЗаписиСтатуса(КодКонтура, ИдентификаторСообщения, НомерПоследовательности);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Статус не найден в Outbox";
		КонецЕсли;
		Если МенеджерЗаписи.СостояниеДоставки <> Перечисления.KFK_СостоянияДоставки.sent Тогда
			МенеджерЗаписи.СостояниеДоставки = Перечисления.KFK_СостоянияДоставки.sent;
			МенеджерЗаписи.ДатаЗаписи = ТекущаяДатаСеанса();
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ПроверитьГотовностьКТерминалу(КодКонтура, ИдентификаторСообщения)
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
	КонецЕсли;
	
	ИмяСостояния = ИмяСостоянияПроцесса(Процесс.Состояние);
	Если ИмяСостояния <> "started_sent" И ИмяСостояния <> "processing" Тогда
		ВызватьИсключение "Terminal требует started_sent или processing, сейчас: " + ИмяСостояния;
	КонецЕсли;
	
	Started = ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, 10);
	Если Started = Неопределено Или Started.СостояниеДоставки <> Перечисления.KFK_СостоянияДоставки.sent Тогда
		ВызватьИсключение "Terminal до подтверждённого Started запрещён";
	КонецЕсли;
	
	Возврат Started;
	
КонецФункции

Процедура ОбеспечитьProcessing(КодКонтура, ИдентификаторСообщения)
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если ИмяСостоянияПроцесса(Процесс.Состояние) = "started_sent" Тогда
		Переход = KFK_ПроцессыОбменаСервер.ИзменитьСостояние(КодКонтура, ИдентификаторСообщения, "processing");
		Если СтрНайти(Переход, "changed=1") = 0 Тогда
			ВызватьИсключение "Не удалось перевести процесс в processing";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ИмяСостоянияПроцесса(Состояние)
	
	Если Состояние = Перечисления.KFK_СостоянияПроцесса.received Тогда
		Возврат "received";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.started_pending Тогда
		Возврат "started_pending";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.started_sent Тогда
		Возврат "started_sent";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.processing Тогда
		Возврат "processing";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.waiting_retry Тогда
		Возврат "waiting_retry";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.completed Тогда
		Возврат "completed";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.failed Тогда
		Возврат "failed";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПараметрыРеальнойПубликацииСтатусов(КодКонтура)
	
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	ТопикСтатусов = СокрЛП(Строка(Настройки.ТопикСтатусов));
	Если Не ЗначениеЗаполнено(ТопикСтатусов) Тогда
		ТопикСтатусов = "contragents.exchange";
	КонецЕсли;
	
	Брокер = ПервыйАктивныйБрокер();
	Если Не ЗначениеЗаполнено(Брокер) Тогда
		ВызватьИсключение "Нет активного элемента справочника KFK_Брокеры для публикации статусов";
	КонецЕсли;
	
	Параметры = Новый Соответствие;
	ПарольВКаталоге = ПарольБрокераИзКаталога(Брокер);
	Если Не ЗначениеЗаполнено(ПарольВКаталоге) Тогда
		ПарольОкружения = KFK_СекретыОкруженияСервер.ПарольKafkaДляПодключения();
		Если ЗначениеЗаполнено(ПарольОкружения) Тогда
			Параметры.Вставить("sasl.password", ПарольОкружения);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ТопикСтатусов", ТопикСтатусов);
	Результат.Вставить("Брокер", Брокер);
	Результат.Вставить("Параметры", Параметры);
	Возврат Результат;
	
КонецФункции

Функция ПервыйАктивныйБрокер()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	KFK_Брокеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.KFK_Брокеры КАК KFK_Брокеры
	|ГДЕ
	|	KFK_Брокеры.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	KFK_Брокеры.Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.KFK_Брокеры.ПустаяСсылка();
	
КонецФункции

Функция ПарольБрокераИзКаталога(Брокер)
	
	Для Каждого Параметр Из Брокер.ПараметрыПодключения Цикл
		Если НРег(СокрЛП(Параметр.Ключ)) = "sasl.password" И ЗначениеЗаполнено(Параметр.Значение) Тогда
			Возврат СокрЛП(Строка(Параметр.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ОпубликоватьСтатусВKafka(КодКонтура, ИдентификаторСообщения, НомерПоследовательности, ТипСтатуса, ПараметрыКонтура)
	
	Результат = Новый Структура("Успех, Ошибка, Раздел, Смещение", Ложь, "", 0, 0);
	
	Статус = ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, НомерПоследовательности);
	Если Статус = Неопределено Тогда
		Результат.Ошибка = "status_missing";
		Возврат Результат;
	КонецЕсли;
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		Результат.Ошибка = "process_missing";
		Возврат Результат;
	КонецЕсли;
	
	Корреляция = Процесс.ИдентификаторКорреляции;
	Если Не ЗначениеЗаполнено(Корреляция) Тогда
		Корреляция = ИдентификаторСообщения;
	КонецЕсли;
	
	ЗаголовкиJSON = СобратьЗаголовкиСтатуса(
		КодКонтура,
		ТипСтатуса,
		Корреляция,
		Статус.ИдентификаторСтатуса);
	ЗаголовкиСтрокой = ЗаголовкиJSONВСтрокуПубликации(ЗаголовкиJSON);
	
	ПараметрыОтправки = Новый Структура;
	ПараметрыОтправки.Вставить("Топики", KFK_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыКонтура.ТопикСтатусов));
	ПараметрыОтправки.Вставить("Брокеры", KFK_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыКонтура.Брокер));
	ПараметрыОтправки.Вставить("Параметры", ПараметрыКонтура.Параметры);
	ПараметрыОтправки.Вставить("Синхронно", Истина);
	ПараметрыОтправки.Вставить("Партиция", 0);
	ПараметрыОтправки.Вставить("Ключ", Строка(Статус.КлючKafka));
	ПараметрыОтправки.Вставить("Заголовки", ЗаголовкиСтрокой);
	ПараметрыОтправки.Вставить("КаталогЛогов", "");
	ПараметрыОтправки.Вставить("КоличествоСообщений", 1);
	
	Попытка
		KFK_Интеграция.Опубликовать(Неопределено, Строка(Статус.Payload), ПараметрыОтправки);
		Результат.Успех = Истина;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.Ошибка = Лев(СтрЗаменить(ТекстОшибки, Символы.ПС, " "), 150);
		Если Не ЗначениеЗаполнено(Результат.Ошибка) Тогда
			Результат.Ошибка = "kafka_unavailable";
		КонецЕсли;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаголовкиJSONВСтрокуПубликации(ЗаголовкиJSON)
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ЗаголовкиJSON, , Истина);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Заголовки статуса должны быть JSON-объектом";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого Пара Из Данные Цикл
		Части.Добавить(Строка(Пара.Ключ) + "," + Строка(Пара.Значение));
	КонецЦикла;
	
	Возврат СтрСоединить(Части, ";");
	
КонецФункции

Функция ТипТерминальногоСтатуса(КодКонтура, ИдентификаторСообщения)
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс <> Неопределено Тогда
		ИмяСостояния = ИмяСостоянияПроцесса(Процесс.Состояние);
		Если ИмяСостояния = "failed" Тогда
			Возврат "failed";
		ИначеЕсли ИмяСостояния = "completed" Тогда
			Возврат "completed";
		КонецЕсли;
	КонецЕсли;
	
	Статус = ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, 20);
	Если Статус <> Неопределено И СтрНайти(НРег(Строка(Статус.Payload)), """messages""") > 0 Тогда
		Возврат "failed";
	КонецЕсли;
	
	Возврат "completed";
	
КонецФункции

Функция ИмяДоставки(СостояниеДоставки)
	
	Если СостояниеДоставки = Перечисления.KFK_СостоянияДоставки.pending Тогда
		Возврат "pending";
	ИначеЕсли СостояниеДоставки = Перечисления.KFK_СостоянияДоставки.sent Тогда
		Возврат "sent";
