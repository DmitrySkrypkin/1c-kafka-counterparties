////////////////////////////////////////////////////////////////////////////////
// Программное добавление полей внешних идентификаторов на типовые формы.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Добавляет группу «Внешние идентификаторы» и поля KFK_ВнешнийID / KFK_ВнешнийUID
// на форму элемента справочника. Идемпотентно.
//
Процедура ДобавитьНаФормуЭлемента(Форма) Экспорт

	Если Форма.Элементы.Найти("KFK_ГруппаВнешниеИдентификаторы") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЕстьID = ЕстьРеквизитФормыОбъекта(Форма, "KFK_ВнешнийID");
	ЕстьUID = ЕстьРеквизитФормыОбъекта(Форма, "KFK_ВнешнийUID");
	Если Не ЕстьID И Не ЕстьUID Тогда
		Возврат;
	КонецЕсли;

	Родитель = Неопределено;
	ПередЭлементом = Неопределено;
	ОпределитьМестоПослеДополнительныхРеквизитов(Форма, Родитель, ПередЭлементом);

	КонтекстГруппы = KFK_РедакторФорм.НовыйКонтекстЭлемента(Форма, Родитель, ПередЭлементом);
	Группа = KFK_РедакторФорм.НоваяГруппаОбычная(КонтекстГруппы, "KFK_ГруппаВнешниеИдентификаторы",
		НСтр("ru = 'Внешние идентификаторы'"));
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = Истина;
	Попытка
		Группа.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	Исключение
		// Режим совместимости конфигурации может не отдавать свертывание.
	КонецПопытки;
	Попытка
		Группа.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	Исключение
		// Свойство может отличаться в зависимости от версии платформы.
	КонецПопытки;
	Попытка
		Группа.ОтображатьОтступСлева = Ложь;
	Исключение
		// Свойство может отсутствовать в режиме совместимости.
	КонецПопытки;
	// Свернута / Collapsed в ряде режимов совместимости у ГруппаФормы нет —
	// начальное состояние не принудительно, группа остаётся свертываемой.

	КонтекстПоля = KFK_РедакторФорм.НовыйКонтекстЭлемента(Форма, Группа);

	Если ЕстьID И Форма.Элементы.Найти("KFK_ВнешнийID") = Неопределено Тогда
		СвойстваID = Новый Структура;
		СвойстваID.Вставить("Заголовок", НСтр("ru = 'Код на сайте'"));
		КонтекстПоля.Свойства = СвойстваID;
		KFK_РедакторФорм.НовоеПолеФормыРеквизитОбъекта(КонтекстПоля, "KFK_ВнешнийID");
	КонецЕсли;

	Если ЕстьUID И Форма.Элементы.Найти("KFK_ВнешнийUID") = Неопределено Тогда
		СвойстваUID = Новый Структура;
		СвойстваUID.Вставить("Заголовок", НСтр("ru = 'Внешний UID'"));
		КонтекстПоля.Свойства = СвойстваUID;
		KFK_РедакторФорм.НовоеПолеФормыРеквизитОбъекта(КонтекстПоля, "KFK_ВнешнийUID");
	КонецЕсли;

КонецПроцедуры

// Добавляет колонку KFK_ВнешнийID («Код на сайте») в таблицу динамического списка.
// Колонку KFK_ВнешнийUID в список не выводит — UID достаточно на форме элемента.
// При необходимости включает поле в текст запроса списка. Идемпотентно.
//
Процедура ДобавитьНаФормуСписка(Форма) Экспорт

	ТаблицаСписка = НайтиТаблицуСписка(Форма);
	Если ТаблицаСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИменаПолей = Новый Массив;
	Если ЕстьРеквизитМетаданныхСписка(Форма, "KFK_ВнешнийID") Тогда
		ИменаПолей.Добавить("KFK_ВнешнийID");
	КонецЕсли;
	Если ИменаПолей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОбеспечитьПоляВЗапросеСписка(Форма, ИменаПолей);

	ПередЭлементом = Неопределено;
	ЭлементНаименование = Форма.Элементы.Найти("Наименование");
	Если ЭлементНаименование <> Неопределено
		И ЭлементНаименование.Родитель = ТаблицаСписка Тогда
		ПередЭлементом = СледующийПодчиненный(ТаблицаСписка, ЭлементНаименование);
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("KFK_ВнешнийID", НСтр("ru = 'Код на сайте'"));

	Для Каждого ИмяПоля Из ИменаПолей Цикл

		Если Форма.Элементы.Найти(ИмяПоля) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЕстьПолеДинамическогоСписка(Форма, ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;

		СвойстваПоля = Новый Структура;
		СвойстваПоля.Вставить("ПутьКДанным", "Список." + ИмяПоля);
		СвойстваПоля.Вставить("Вид", ВидПоляФормы.ПолеНадписи);
		СвойстваПоля.Вставить("Заголовок", Заголовки[ИмяПоля]);
		КонтекстПоля = KFK_РедакторФорм.НовыйКонтекстЭлемента(Форма, ТаблицаСписка, ПередЭлементом, СвойстваПоля);
		KFK_РедакторФорм.НовоеПолеФормы(КонтекстПоля, ИмяПоля);
		ПередЭлементом = СледующийПодчиненный(ТаблицаСписка, Форма.Элементы[ИмяПоля]);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьРеквизитФормыОбъекта(Форма, ИмяРеквизита)

	Попытка
		РеквизитыОбъекта = Форма.ПолучитьРеквизиты("Объект");
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Для Каждого ОписаниеРеквизита Из РеквизитыОбъекта Цикл
		Если ОписаниеРеквизита.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьПолеДинамическогоСписка(Форма, ИмяРеквизита)

	Попытка
		Для Каждого ОписаниеРеквизита Из Форма.ПолучитьРеквизиты("Список") Цикл
			Если ОписаниеРеквизита.Имя = ИмяРеквизита Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

Функция ЕстьРеквизитМетаданныхСписка(Форма, ИмяРеквизита)

	Попытка
		ОсновнаяТаблица = Форма.Список.ОсновнаяТаблица;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ОсновнаяТаблица) Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбъектМетаданных = ОбъектМетаданныхПоИмениТаблицы(ОсновнаяТаблица);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;

КонецФункции

Процедура ОбеспечитьПоляВЗапросеСписка(Форма, ИменаПолей)

	Недостающие = Новый Массив;
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если Не ЕстьПолеДинамическогоСписка(Форма, ИмяПоля) Тогда
			Недостающие.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Если Недостающие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Список = Форма.Список;
	ТекстЗапроса = "";
	Попытка
		ТекстЗапроса = Список.ТекстЗапроса;
	Исключение
		ТекстЗапроса = "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Псевдоним = ПсевдонимОсновнойТаблицыЗапроса(ТекстЗапроса, Список.ОсновнаяТаблица);
	Если Не ЗначениеЗаполнено(Псевдоним) Тогда
		Возврат;
	КонецЕсли;

	ФрагментыВставки = Новый Массив;
	Для Каждого ИмяПоля Из Недостающие Цикл
		Если ПолеУжеЕстьВТекстеЗапроса(ТекстЗапроса, ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ФрагментыВставки.Добавить(СтрШаблон("%1.%2 КАК %2", Псевдоним, ИмяПоля));
	КонецЦикла;

	Если ФрагментыВставки.Количество() = 0 Тогда
		// Поля в тексте есть, но список ещё не в режиме произвольного запроса.
		Список.ПроизвольныйЗапрос = Истина;
		Список.ТекстЗапроса = ТекстЗапроса;
		Возврат;
	КонецЕсли;

	Вставка = СтрСоединить(ФрагментыВставки, "," + Символы.ПС + Символы.Таб) + ",";
	НовыйТекст = ВставитьПоляПослеВыбрать(ТекстЗапроса, Вставка);
	Если Не ЗначениеЗаполнено(НовыйТекст) Тогда
		Возврат;
	КонецЕсли;

	Список.ПроизвольныйЗапрос = Истина;
	Список.ТекстЗапроса = НовыйТекст;

КонецПроцедуры

Функция ПолеУжеЕстьВТекстеЗапроса(ТекстЗапроса, ИмяПоля)

	Если СтрНайти(ТекстЗапроса, " КАК " + ИмяПоля) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ТекстЗапроса, "." + ИмяПоля + " ") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ТекстЗапроса, "." + ИмяПоля + ",") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ТекстЗапроса, "." + ИмяПоля + Символы.ПС) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ВставитьПоляПослеВыбрать(ТекстЗапроса, ФрагментВставки)

	Верхний = ВРег(ТекстЗапроса);
	// Динамический список выводит результат последнего запроса пакета
	// (предыдущие обычно помещают данные во временные таблицы).
	НачалоЗапроса = НачалоПоследнегоЗапросаПакета(ТекстЗапроса);
	Позиция = СтрНайти(Верхний, "ВЫБРАТЬ", НаправлениеПоиска.СНачала, НачалоЗапроса);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПозицияВставки = Позиция + СтрДлина("ВЫБРАТЬ");
	Пока ПозицияВставки <= СтрДлина(ТекстЗапроса) Цикл
		Символ = Сред(ТекстЗапроса, ПозицияВставки, 1);
		Если Символ = " " Или Символ = Символы.ПС Или Символ = Символы.ВК Или Символ = Символы.Таб Тогда
			ПозицияВставки = ПозицияВставки + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Лев(ТекстЗапроса, ПозицияВставки - 1)
		+ Символы.ПС + Символы.Таб + ФрагментВставки + Символы.ПС + Символы.Таб
		+ Сред(ТекстЗапроса, ПозицияВставки);

КонецФункции

Функция НачалоПоследнегоЗапросаПакета(ТекстЗапроса)

	Начало = 1;
	Позиция = СтрНайти(ТекстЗапроса, ";");
	Пока Позиция > 0 Цикл
		// Завершающая «;» без следующего запроса не начинает новую часть пакета.
		Если ЗначениеЗаполнено(СокрЛП(Сред(ТекстЗапроса, Позиция + 1))) Тогда
			Начало = Позиция + 1;
		КонецЕсли;
		Позиция = СтрНайти(ТекстЗапроса, ";", НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;

	Возврат Начало;

КонецФункции

Функция ПсевдонимОсновнойТаблицыЗапроса(ТекстЗапроса, ОсновнаяТаблица)

	ИмяТаблицыЗапроса = ИмяТаблицыДляЯзыкаЗапросов(ОсновнаяТаблица);
	Если Не ЗначениеЗаполнено(ИмяТаблицыЗапроса) Тогда
		Возврат "";
	КонецЕсли;

	Маркер = ВРег(ИмяТаблицыЗапроса) + " КАК ";
	Верхний = ВРег(ТекстЗапроса);
	Позиция = СтрНайти(Верхний, Маркер);
	Если Позиция = 0 Тогда
		// Часто псевдоним = имя без точки: СправочникКонтрагенты
		Части = СтрРазделить(ИмяТаблицыЗапроса, ".");
		Если Части.Количество() = 2 Тогда
			Кандидат = Части[0] + Части[1];
			Если СтрНайти(ТекстЗапроса, Кандидат + ".") > 0 Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	НачалоПсевдонима = Позиция + СтрДлина(Маркер);
	КонецПсевдонима = НачалоПсевдонима;
	Пока КонецПсевдонима <= СтрДлина(ТекстЗапроса) Цикл
		Символ = Сред(ТекстЗапроса, КонецПсевдонима, 1);
		Если ЭтоСимволИдентификатора(Символ) Тогда
			КонецПсевдонима = КонецПсевдонима + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Сред(ТекстЗапроса, НачалоПсевдонима, КонецПсевдонима - НачалоПсевдонима);

КонецФункции

Функция ИмяТаблицыДляЯзыкаЗапросов(ОсновнаяТаблица)

	Если Не ЗначениеЗаполнено(ОсновнаяТаблица) Тогда
		Возврат "";
	КонецЕсли;

	Части = СтрРазделить(ОсновнаяТаблица, ".");
	Если Части.Количество() < 2 Тогда
		Возврат ОсновнаяТаблица;
	КонецЕсли;

	Вид = ВРег(Части[0]);
	Имя = Части[1];
	Если Вид = "CATALOG" Или Вид = "СПРАВОЧНИК" Или Вид = ВРег("Справочник") Тогда
		Возврат "Справочник." + Имя;
	ИначеЕсли Вид = "DOCUMENT" Или Вид = "ДОКУМЕНТ" Или Вид = ВРег("Документ") Тогда
		Возврат "Документ." + Имя;
	КонецЕсли;

	Возврат ОсновнаяТаблица;

КонецФункции

Функция ОбъектМетаданныхПоИмениТаблицы(ОсновнаяТаблица)

	Части = СтрРазделить(ОсновнаяТаблица, ".");
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ВидМетаданных = ВРег(Части[0]);
	ИмяОбъекта = Части[1];

	Если ВидМетаданных = "CATALOG"
		Или ВидМетаданных = "СПРАВОЧНИК"
		Или ВидМетаданных = ВРег("Справочник") Тогда
		Возврат Метаданные.Справочники.Найти(ИмяОбъекта);
	ИначеЕсли ВидМетаданных = "DOCUMENT"
		Или ВидМетаданных = "ДОКУМЕНТ"
		Или ВидМетаданных = ВРег("Документ") Тогда
		Возврат Метаданные.Документы.Найти(ИмяОбъекта);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЭтоСимволИдентификатора(Символ)

	Если Символ = "_" Тогда
		Возврат Истина;
	КонецЕсли;

	Код = КодСимвола(Символ);
	// 0-9, A-Z, a-z, А-Я, а-я, Ё/ё
	Возврат (Код >= 48 И Код <= 57)
		Или (Код >= 65 И Код <= 90)
		Или (Код >= 97 И Код <= 122)
		Или (Код >= 1040 И Код <= 1103)
		Или Код = 1025 Или Код = 1105;

КонецФункции

Функция НайтиТаблицуСписка(Форма)

	ЭлементСписок = Форма.Элементы.Найти("Список");
	Если ЭлементСписок <> Неопределено И ТипЗнч(ЭлементСписок) = Тип("ТаблицаФормы") Тогда
		Возврат ЭлементСписок;
	КонецЕсли;

	Для Каждого Элемент Из Форма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
			Попытка
				Если Элемент.ПутьКДанным = "Список" Тогда
					Возврат Элемент;
				КонецЕсли;
			Исключение
				// Нет свойства ПутьКДанным — пропускаем.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Место: в блоке сворачиваемых групп, сразу после «Дополнительные реквизиты».
// ПередЭлементом = следующий сосед после этой группы (или Неопределено = в конец родителя).
//
Процедура ОпределитьМестоПослеДополнительныхРеквизитов(Форма, Родитель, ПередЭлементом)

	Родитель = Форма;
	ПередЭлементом = Неопределено;

	ГруппаДопРеквизиты = Форма.Элементы.Найти("ГруппаДополнительныеРеквизиты");
	Если ГруппаДопРеквизиты <> Неопределено Тогда
		Родитель = ГруппаДопРеквизиты.Родитель;
		ПередЭлементом = СледующийПодчиненный(Родитель, ГруппаДопРеквизиты);
		Возврат;
	КонецЕсли;

	// Запасной вариант: последняя сворачиваемая группа на форме.
	ПоследняяСворачиваемая = Неопределено;
	НайтиПоследнююСворачиваемуюГруппу(Форма, ПоследняяСворачиваемая);
	Если ПоследняяСворачиваемая <> Неопределено Тогда
		Родитель = ПоследняяСворачиваемая.Родитель;
		ПередЭлементом = СледующийПодчиненный(Родитель, ПоследняяСворачиваемая);
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура НайтиПоследнююСворачиваемуюГруппу(РодительПоиска, НайденнаяГруппа)

	Попытка
		Коллекция = РодительПоиска.ПодчиненныеЭлементы;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого Элемент Из Коллекция Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			Попытка
				Если Элемент.Поведение = ПоведениеОбычнойГруппы.Свертываемая Тогда
					НайденнаяГруппа = Элемент;
				КонецЕсли;
			Исключение
				// Нет свойства Поведение.
			КонецПопытки;
			НайтиПоследнююСворачиваемуюГруппу(Элемент, НайденнаяГруппа);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СледующийПодчиненный(Родитель, ЭлементБаза)

	Найден = Ложь;
	Для Каждого Подчиненный Из Родитель.ПодчиненныеЭлементы Цикл
		Если Найден Тогда
			Возврат Подчиненный;
		КонецЕсли;
		Если Подчиненный = ЭлементБаза Тогда
			Найден = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
