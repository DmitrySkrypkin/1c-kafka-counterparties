#Область ПрограммныйИнтерфейс

// Создаёт процесс по ключу контура и message id.
// Повторный вызов с тем же ключом новую запись не создаёт и существующую не меняет.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id, 36 символов.
//  ХешPayload - Строка - SHA-256 сырого payload.
//  СыройPayload - Строка - сырое тело. Хранится до отдельной очистки.
//  ИдентификаторКорреляции - Строка - correlation-id.
//  ВнешнийIDКонтрагента - Число - портальный id контрагента.
//  ВнешнийUIDКонтрагента - Строка - uid контрагента.
//  ДатаЗаписи - Дата, Неопределено - момент регистрации; пустое значение заменяется текущей датой сеанса.
//
// Возвращаемое значение:
//  Структура - поля процесса и признак ЭтоДубль.
//
Функция ЗарегистрироватьПроцесс(КодКонтура, ИдентификаторСообщения, ХешPayload, СыройPayload = "", ИдентификаторКорреляции = "", ВнешнийIDКонтрагента = 0, ВнешнийUIDКонтрагента = "", ДатаЗаписи = Неопределено) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьПроцесс(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			Результат = ОписаниеПроцесса(МенеджерЗаписи, Истина);
		Иначе
			МенеджерЗаписи.КодКонтура = ЗначениеКонтура;
			МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
			МенеджерЗаписи.ИдентификаторКорреляции = ИдентификаторКорреляции;
			МенеджерЗаписи.ВнешнийIDКонтрагента = ВнешнийIDКонтрагента;
			МенеджерЗаписи.ВнешнийUIDКонтрагента = ВнешнийUIDКонтрагента;
			МенеджерЗаписи.ХешPayload = ХешPayload;
			МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияПроцесса.received;
			МенеджерЗаписи.НомерПопытки = 0;
			МенеджерЗаписи.ДатаСледующейПопытки = Дата(1, 1, 1);
			МенеджерЗаписи.Диагностика = "";
			МенеджерЗаписи.СыройPayload = СыройPayload;
			МенеджерЗаписи.ИдентификаторСтатусаStarted = "";
			МенеджерЗаписи.ИдентификаторСтатусаTerminal = "";
			МенеджерЗаписи.ВладелецОбработки = "";
			МенеджерЗаписи.АрендаДо = Дата(1, 1, 1);
			МенеджерЗаписи.ДатаЗаписи = МоментЗаписи(ДатаЗаписи);
			МенеджерЗаписи.Записать();
			Результат = ОписаниеПроцесса(МенеджерЗаписи, Ложь);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Идемпотентная приёмка по message id: новый процесс, транспортный дубль или карантин при другом SHA-256.
// Не создаёт вторую цепочку статусов и не меняет исходный процесс при mismatch.
//
// Возвращаемое значение:
//  Строка - action=new|duplicate|quarantine;state=...;started_uuid=...;terminal_uuid=...;hash_match=0|1
//
// Watchdog: зависшие processing с истёкшей арендой возвращает в waiting_retry.
// Активную аренду не трогает. Владелец очищается, следующая попытка — через baseDelay.
//
// Возвращаемое значение:
//  Строка - recovered=N;skipped_active=N
//
Функция ВернутьЗависшиеВRetry(КодКонтура, МоментПроверки = Неопределено) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Сейчас = ?(ЗначениеЗаполнено(МоментПроверки), МоментПроверки, ТекущаяДатаСеанса());
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(ЗначениеКонтура);
	Задержка = Настройки.БазоваяЗадержкаСекунд;
	Если Задержка < 1 Тогда
		Задержка = 60;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Процессы.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	Процессы.ВладелецОбработки КАК ВладелецОбработки,
	|	Процессы.АрендаДо КАК АрендаДо
	|ИЗ
	|	РегистрСведений.KFK_ПроцессыОбмена КАК Процессы
	|ГДЕ
	|	Процессы.КодКонтура = &КодКонтура
	|	И Процессы.Состояние = &Processing";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Запрос.УстановитьПараметр("Processing", Перечисления.KFK_СостоянияПроцесса.processing);
	
	Восстановлено = 0;
	ПропущеноАктивных = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		АрендаАктивна = ЗначениеЗаполнено(Выборка.ВладелецОбработки)
			И Выборка.АрендаДо > Сейчас;
		Если АрендаАктивна Тогда
			ПропущеноАктивных = ПропущеноАктивных + 1;
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			
			ЗаблокироватьПроцесс(ЗначениеКонтура, Выборка.ИдентификаторСообщения);
			МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, Выборка.ИдентификаторСообщения);
			МенеджерЗаписи.Прочитать();
			Если Не МенеджерЗаписи.Выбран()
				Или МенеджерЗаписи.Состояние <> Перечисления.KFK_СостоянияПроцесса.processing Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			АрендаАктивнаПосле = ЗначениеЗаполнено(МенеджерЗаписи.ВладелецОбработки)
				И МенеджерЗаписи.АрендаДо > Сейчас;
			Если АрендаАктивнаПосле Тогда
				ПропущеноАктивных = ПропущеноАктивных + 1;
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			МенеджерЗаписи.ВладелецОбработки = "";
			МенеджерЗаписи.АрендаДо = Дата(1, 1, 1);
			МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияПроцесса.waiting_retry;
			МенеджерЗаписи.ДатаСледующейПопытки = Сейчас + Задержка;
			МенеджерЗаписи.Диагностика = "watchdog_lease_expired";
			МенеджерЗаписи.Записать();
			Восстановлено = Восстановлено + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат "recovered=" + Формат(Восстановлено, "ЧН=0; ЧГ=") + Символы.ПС
		+ "skipped_active=" + Формат(ПропущеноАктивных, "ЧН=0; ЧГ=");
	
КонецФункции

Функция ПринятьПовторнуюДоставку(КодКонтура, ИдентификаторСообщения, ХешPayload, СыройPayload = "", ИдентификаторКорреляции = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ХешPayload) Тогда
		ВызватьИсключение "Не заполнен хеш payload";
	КонецЕсли;
	
	Существующий = ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Существующий = Неопределено Тогда
		ЗарегистрироватьПроцесс(КодКонтура, ИдентификаторСообщения, ХешPayload, СыройPayload, ИдентификаторКорреляции);
		Процесс = ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
		Возврат ОтчетДоставки("new", Процесс, Истина);
	КонецЕсли;
	
	Если Существующий.ХешPayload = ХешPayload Тогда
		Возврат ОтчетДоставки("duplicate", Существующий, Истина);
	КонецЕсли;
	
	Корреляция = ?(ЗначениеЗаполнено(ИдентификаторКорреляции), ИдентификаторКорреляции, Существующий.ИдентификаторКорреляции);
	KFK_СлужебныеЖурналыСервер.ЗаписатьКарантин(
		КодКонтура,
		"payload-mismatch",
		ИдентификаторСообщения,
		Корреляция,
		"sha256 differs from registered process");
	
	Возврат ОтчетДоставки("quarantine", Существующий, Ложь);
	
КонецФункции

// Захватывает владельца процесса. Повтор тем же владельцем продлевает аренду; чужой активный владелец отклоняется.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  ИдентификаторСообщения - Строка - message id.
//  ВладелецОбработки - Строка - уникальный ключ воркера/сеанса.
//  СрокАрендыСекунд - Число - длительность аренды.
//
// Возвращаемое значение:
//  Строка - acquired=1|0;owner=...;reason=...
//
Функция ЗахватитьВладельца(КодКонтура, ИдентификаторСообщения, ВладелецОбработки, СрокАрендыСекунд = 300) Экспорт
	
	Если Не ЗначениеЗаполнено(ВладелецОбработки) Тогда
		ВызватьИсключение "Не заполнен владелец обработки";
	КонецЕсли;
	Если СрокАрендыСекунд < 1 Тогда
		ВызватьИсключение "Срок аренды должен быть положительным";
	КонецЕсли;
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьПроцесс(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
		КонецЕсли;
		
		Сейчас = ТекущаяДатаСеанса();
		АктивныйЧужой = ЗначениеЗаполнено(МенеджерЗаписи.ВладелецОбработки)
			И МенеджерЗаписи.ВладелецОбработки <> ВладелецОбработки
			И МенеджерЗаписи.АрендаДо > Сейчас;
		Если АктивныйЧужой Тогда
			Результат = "acquired=0" + Символы.ПС
				+ "owner=" + МенеджерЗаписи.ВладелецОбработки + Символы.ПС
				+ "reason=busy";
		Иначе
			МенеджерЗаписи.ВладелецОбработки = ВладелецОбработки;
			МенеджерЗаписи.АрендаДо = Сейчас + СрокАрендыСекунд;
			МенеджерЗаписи.Записать();
			Результат = "acquired=1" + Символы.ПС
				+ "owner=" + ВладелецОбработки + Символы.ПС
				+ "reason=ok";
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// True, если переход из текущего состояния в целевое разрешён таблицей жизненного цикла.
//
Функция ДопустимПереход(ТекущееСостояние, НовоеСостояние) Экспорт
	
	Текущее = ЗначениеСостояния(ТекущееСостояние);
	Новое = ЗначениеСостояния(НовоеСостояние);
	Если Текущее = Новое Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Текущее = Перечисления.KFK_СостоянияПроцесса.received Тогда
		Возврат Новое = Перечисления.KFK_СостоянияПроцесса.started_pending;
	ИначеЕсли Текущее = Перечисления.KFK_СостоянияПроцесса.started_pending Тогда
		Возврат Новое = Перечисления.KFK_СостоянияПроцесса.started_sent;
	ИначеЕсли Текущее = Перечисления.KFK_СостоянияПроцесса.started_sent Тогда
		Возврат Новое = Перечисления.KFK_СостоянияПроцесса.processing
			Или Новое = Перечисления.KFK_СостоянияПроцесса.waiting_retry;
	ИначеЕсли Текущее = Перечисления.KFK_СостоянияПроцесса.processing Тогда
		Возврат Новое = Перечисления.KFK_СостоянияПроцесса.waiting_retry
			Или Новое = Перечисления.KFK_СостоянияПроцесса.completed
			Или Новое = Перечисления.KFK_СостоянияПроцесса.failed;
	ИначеЕсли Текущее = Перечисления.KFK_СостоянияПроцесса.waiting_retry Тогда
		Возврат Новое = Перечисления.KFK_СостоянияПроцесса.processing
			Или Новое = Перечисления.KFK_СостоянияПроцесса.failed;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Меняет состояние процесса по таблице допустимых переходов под управляемой блокировкой.
//
// Возвращаемое значение:
//  Строка - changed=1|0;from=...;to=...;reason=...
//
Функция ИзменитьСостояние(КодКонтура, ИдентификаторСообщения, НовоеСостояние) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	Целевое = ЗначениеСостояния(НовоеСостояние);
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьПроцесс(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
		КонецЕсли;
		
		ТекущееИмя = ИмяСостояния(МенеджерЗаписи.Состояние);
		ЦелевоеИмя = ИмяСостояния(Целевое);
		Если Не ДопустимПереход(МенеджерЗаписи.Состояние, Целевое) Тогда
			Результат = "changed=0" + Символы.ПС
				+ "from=" + ТекущееИмя + Символы.ПС
				+ "to=" + ЦелевоеИмя + Символы.ПС
				+ "reason=forbidden";
		Иначе
			МенеджерЗаписи.Состояние = Целевое;
			МенеджерЗаписи.Записать();
			Результат = "changed=1" + Символы.ПС
				+ "from=" + ТекущееИмя + Символы.ПС
				+ "to=" + ЦелевоеИмя + Символы.ПС
				+ "reason=ok";
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Классификация ошибки: retryable (техника / отсутствующая голова) или terminal (валидация/ссылки/дубликат).
//
// Параметры:
//  КодОшибки - Строка - каталог ТЗ либо технический ярлык (kafka_unavailable, timeout, ...);
//  Категория - Строка - transport|business (опционально, уточняет технику).
//
// Возвращаемое значение:
//  Строка - retryable=0|1;terminal=0|1;kind=...
//
Функция КлассифицироватьОшибку(КодОшибки, Категория = "") Экспорт
	
	Код = ВРег(СокрЛП(Строка(КодОшибки)));
	Кат = НРег(СокрЛП(Строка(Категория)));
	
	Если Код = "REQUIRED_FIELD_MISSING"
		Или Код = "INVALID_FORMAT"
		Или Код = "UNSUPPORTED_VERSION"
		Или Код = "REFERENCE_NOT_FOUND"
		Или Код = "DUPLICATE_CONFLICT"
		Или Код = "HEAD_CONTRAGENT_NOT_FOUND" Тогда
		Возврат "retryable=0" + Символы.ПС
			+ "terminal=1" + Символы.ПС
			+ "kind=validation";
	КонецЕсли;
	
	Если Код = "HEAD_MISSING" Тогда
		Возврат "retryable=1" + Символы.ПС
			+ "terminal=0" + Символы.ПС
			+ "kind=head";
	КонецЕсли;
	
	Если Кат = "transport"
		Или Код = "INTERNAL_ERROR"
		Или Код = "KAFKA_UNAVAILABLE"
		Или Код = "TIMEOUT"
		Или Код = "LOCK_CONFLICT"
		Или Код = "DB_UNAVAILABLE" Тогда
		Возврат "retryable=1" + Символы.ПС
			+ "terminal=0" + Символы.ПС
			+ "kind=technical";
	КонецЕсли;
	
	Возврат "retryable=1" + Символы.ПС
		+ "terminal=0" + Символы.ПС
		+ "kind=technical";
	
КонецФункции

// Задержка после завершённой попытки: 1 → baseDelay, 2 → baseDelay×2, иначе -1 (исчерпано).
//
Функция РассчитатьЗадержкуПовтора(НомерЗавершеннойПопытки, БазоваяЗадержкаСекунд = 60) Экспорт
	
	Если БазоваяЗадержкаСекунд < 1 Тогда
		ВызватьИсключение "БазоваяЗадержкаСекунд должна быть положительной";
	КонецЕсли;
	Если НомерЗавершеннойПопытки = 1 Тогда
		Возврат БазоваяЗадержкаСекунд;
	ИначеЕсли НомерЗавершеннойПопытки = 2 Тогда
		Возврат БазоваяЗадержкаСекунд * 2;
	КонецЕсли;
	
	Возврат -1;
	
КонецФункции

// Начинает попытку обработки: started_sent|waiting_retry → processing, НомерПопытки++ (макс 3).
//
Функция НачатьПопыткуОбработки(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	МаксПопыток = 3;
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьПроцесс(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
		КонецЕсли;
		
		Текущее = МенеджерЗаписи.Состояние;
		Если Текущее <> Перечисления.KFK_СостоянияПроцесса.started_sent
			И Текущее <> Перечисления.KFK_СостоянияПроцесса.waiting_retry Тогда
			Результат = "ok=0" + Символы.ПС
				+ "reason=bad_state" + Символы.ПС
				+ "state=" + ИмяСостояния(Текущее) + Символы.ПС
				+ "attempt=" + Формат(МенеджерЗаписи.НомерПопытки, "ЧН=0; ЧГ=");
		ИначеЕсли МенеджерЗаписи.НомерПопытки >= МаксПопыток Тогда
			Результат = "ok=0" + Символы.ПС
				+ "reason=exhausted" + Символы.ПС
				+ "state=" + ИмяСостояния(Текущее) + Символы.ПС
				+ "attempt=" + Формат(МенеджерЗаписи.НомерПопытки, "ЧН=0; ЧГ=");
		Иначе
			МенеджерЗаписи.НомерПопытки = МенеджерЗаписи.НомерПопытки + 1;
			МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияПроцесса.processing;
			МенеджерЗаписи.ДатаСледующейПопытки = Дата(1, 1, 1);
			МенеджерЗаписи.Записать();
			Результат = "ok=1" + Символы.ПС
				+ "reason=ok" + Символы.ПС
				+ "state=processing" + Символы.ПС
				+ "attempt=" + Формат(МенеджерЗаписи.НомерПопытки, "ЧН=0; ЧГ=");
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Планирует повтор после retryable-ошибки: processing → waiting_retry с baseDelay / baseDelay×2.
// После 3-й попытки возвращает exhausted=1 без смены состояния (терминал — задача 6.7).
//
Функция ЗапланироватьПовтор(КодКонтура, ИдентификаторСообщения, Диагностика = "") Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	БазоваяЗадержка = Настройки.БазоваяЗадержкаСекунд;
	Если БазоваяЗадержка < 1 Тогда
		БазоваяЗадержка = 60;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьПроцесс(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
		КонецЕсли;
		
		Если МенеджерЗаписи.Состояние <> Перечисления.KFK_СостоянияПроцесса.processing Тогда
			Результат = "ok=0" + Символы.ПС
				+ "exhausted=0" + Символы.ПС
				+ "reason=bad_state" + Символы.ПС
				+ "attempt=" + Формат(МенеджерЗаписи.НомерПопытки, "ЧН=0; ЧГ=") + Символы.ПС
				+ "delay=-1" + Символы.ПС
				+ "next_at=";
		Иначе
			Задержка = РассчитатьЗадержкуПовтора(МенеджерЗаписи.НомерПопытки, БазоваяЗадержка);
			Если Задержка < 0 Тогда
				Результат = "ok=0" + Символы.ПС
					+ "exhausted=1" + Символы.ПС
					+ "reason=exhausted" + Символы.ПС
					+ "attempt=" + Формат(МенеджерЗаписи.НомерПопытки, "ЧН=0; ЧГ=") + Символы.ПС
					+ "delay=-1" + Символы.ПС
					+ "next_at=";
			Иначе
				Сейчас = ТекущаяДатаСеанса();
				Следующая = Сейчас + Задержка;
				МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияПроцесса.waiting_retry;
				МенеджерЗаписи.ДатаСледующейПопытки = Следующая;
				МенеджерЗаписи.ВладелецОбработки = "";
				МенеджерЗаписи.АрендаДо = Дата(1, 1, 1);
				Если ЗначениеЗаполнено(Диагностика) Тогда
					МенеджерЗаписи.Диагностика = Диагностика;
				КонецЕсли;
				МенеджерЗаписи.Записать();
				Результат = "ok=1" + Символы.ПС
					+ "exhausted=0" + Символы.ПС
					+ "reason=ok" + Символы.ПС
					+ "attempt=" + Формат(МенеджерЗаписи.НомерПопытки, "ЧН=0; ЧГ=") + Символы.ПС
					+ "delay=" + Формат(Задержка, "ЧН=0; ЧГ=") + Символы.ПС
					+ "next_at=" + Формат(Следующая, "ДФ=yyyyMMddHHmmss") + Символы.ПС
					+ "now=" + Формат(Сейчас, "ДФ=yyyyMMddHHmmss");
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Терминал после исчерпания 3 попыток: голова → HEAD_CONTRAGENT_NOT_FOUND, техника → INTERNAL_ERROR.
// Требует уже опубликованный Started; создаёт ровно один Failed Outbox и состояние failed.
//
// Параметры:
//  ВидИсчерпания - Строка - head|technical;
//  ВнешнийIDКонтрагента - Число - id для тела Failed;
//  КлючKafka, ИдентификаторКорреляции - для Outbox.
//
Функция ЗавершитьПослеИсчерпанияПопыток(КодКонтура, ИдентификаторСообщения, ВидИсчерпания, ВнешнийIDКонтрагента, КлючKafka, ИдентификаторКорреляции, ВнешнийUIDКонтрагента = "") Экспорт
	
	Вид = НРег(СокрЛП(Строка(ВидИсчерпания)));
	Если Вид = "head" Тогда
		КодОшибки = "HEAD_CONTRAGENT_NOT_FOUND";
		Путь = "head_contragent";
		Текст = "Головной контрагент не найден после исчерпания попыток";
	ИначеЕсли Вид = "technical" Тогда
		КодОшибки = "INTERNAL_ERROR";
		Путь = "null";
		Текст = "Технический сбой после исчерпания попыток";
	Иначе
		ВызватьИсключение "ВидИсчерпания: head или technical";
	КонецЕсли;
	
	Процесс = ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		ВызватьИсключение "Процесс не найден";
	КонецЕсли;
	Если Процесс.НомерПопытки < 3 Тогда
		ВызватьИсключение "Попытки ещё не исчерпаны: " + Формат(Процесс.НомерПопытки, "ЧН=0; ЧГ=");
	КонецЕсли;
	
	СообщениеОшибки = КодОшибки + "|" + Путь + "|" + Текст;
	Тело = KFK_ИсходящиеСтатусыСервер.СобратьТелоFailedСтрокой(
		ВнешнийIDКонтрагента,
		СообщениеОшибки,
		ВнешнийUIDКонтрагента);
	
	Отчет = KFK_ИсходящиеСтатусыСервер.ЗафиксироватьFailedСТерминалом(
		КодКонтура,
		ИдентификаторСообщения,
		КлючKafka,
		Тело,
		Ложь);
	
	Возврат "ok=1" + Символы.ПС
		+ "code=" + КодОшибки + Символы.ПС
		+ "path=" + Путь + Символы.ПС
		+ "attempt=" + Формат(Процесс.НомерПопытки, "ЧН=0; ЧГ=") + Символы.ПС
		+ "started_uuid=" + Строка(Процесс.ИдентификаторСтатусаStarted) + Символы.ПС
		+ Отчет;
	
КонецФункции

// Процесс в failed не выбирается планировщиком на новую автоматическую попытку.
//
Функция ДоступенДляАвтоПовтора(КодКонтура, ИдентификаторСообщения) Экспорт
	
	Процесс = ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		Возврат "available=0" + Символы.ПС + "reason=missing" + Символы.ПС + "state=";
	КонецЕсли;
	
	Имя = ИмяСостояния(Процесс.Состояние);
	Если Имя = "failed" Или Имя = "completed" Тогда
		Возврат "available=0" + Символы.ПС
			+ "reason=terminal" + Символы.ПС
			+ "state=" + Имя;
	КонецЕсли;
	
	Если Имя = "waiting_retry" Тогда
		Сейчас = ТекущаяДатаСеанса();
		Если ЗначениеЗаполнено(Процесс.ДатаСледующейПопытки) И Процесс.ДатаСледующейПопытки > Сейчас Тогда
			Возврат "available=0" + Символы.ПС
				+ "reason=delay" + Символы.ПС
				+ "state=" + Имя;
		КонецЕсли;
		Возврат "available=1" + Символы.ПС
			+ "reason=ready" + Символы.ПС
			+ "state=" + Имя;
	КонецЕсли;
	
	Если Имя = "started_sent" Тогда
		Возврат "available=1" + Символы.ПС
			+ "reason=ready" + Символы.ПС
			+ "state=" + Имя;
	КонецЕсли;
	
	Возврат "available=0" + Символы.ПС
		+ "reason=busy_or_other" + Символы.ПС
		+ "state=" + Имя;
	
КонецФункции

// Снимает владельца, если аренда принадлежит указанному воркеру.
//
Функция ОсвободитьВладельца(КодКонтура, ИдентификаторСообщения, ВладелецОбработки) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьПроцесс(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
		КонецЕсли;
		
		Если МенеджерЗаписи.ВладелецОбработки <> ВладелецОбработки Тогда
			Результат = "released=0" + Символы.ПС + "reason=foreign-owner";
		Иначе
			МенеджерЗаписи.ВладелецОбработки = "";
			МенеджерЗаписи.АрендаДо = Дата(1, 1, 1);
			МенеджерЗаписи.Записать();
			Результат = "released=1" + Символы.ПС + "reason=ok";
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Возвращает процесс по ключу. Если записи нет, возвращает Неопределено.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля процесса.
//
Функция ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОписаниеПроцесса(МенеджерЗаписи, Ложь);
	
КонецФункции

// Удаляет сырой payload и объёмную диагностику. Ключ, хеш и состояние остаются.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id.
//
Процедура ОчиститьСыройPayload(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
	КонецЕсли;
	
	МенеджерЗаписи.СыройPayload = "";
	МенеджерЗаписи.Диагностика = "";
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Очищает сырой payload терминальных процессов старше границы. Строку tombstone не удаляет.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  Граница - Дата - записи с ДатаЗаписи строго раньше границы очищаются.
//
// Возвращаемое значение:
//  Число - сколько процессов очищено.
//
Функция ОчиститьУстаревшийСыройPayload(КодКонтура, Граница) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Процессы.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.KFK_ПроцессыОбмена КАК Процессы
	|ГДЕ
	|	Процессы.КодКонтура = &КодКонтура
	|	И Процессы.ДатаЗаписи < &Граница
	|	И Процессы.Состояние В (&Терминальные)";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Запрос.УстановитьПараметр("Граница", Граница);
	Терминальные = Новый Массив;
	Терминальные.Добавить(Перечисления.KFK_СостоянияПроцесса.completed);
	Терминальные.Добавить(Перечисления.KFK_СостоянияПроцесса.failed);
	Запрос.УстановитьПараметр("Терминальные", Терминальные);
	
	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, Выборка.ИдентификаторСообщения);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(МенеджерЗаписи.СыройPayload)
			И Не ЗначениеЗаполнено(МенеджерЗаписи.Диагностика) Тогда
			Продолжить;
		КонецЕсли;
		ОчиститьСыройPayload(ЗначениеКонтура, Выборка.ИдентификаторСообщения);
		Количество = Количество + 1;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

// Удаляет запись процесса (verification / административная очистка).
//
Процедура УдалитьПроцесс(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи.Удалить();
	
КонецПроцедуры

// Явный admin-replay: снимает terminal failed, возвращает в started_sent, попытки = 0.
// Outbox terminal (seq 20) удаляется; Started (seq 10) сохраняется.
//
Функция СброситьFailedДляReplay(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ПроверитьИдентификаторСообщения(ИдентификаторСообщения);
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьПроцесс(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи = МенеджерЗаписиПроцесса(ЗначениеКонтура, ИдентификаторСообщения);
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			ВызватьИсключение "Процесс не найден: " + ИдентификаторСообщения;
		КонецЕсли;
		
		Если МенеджерЗаписи.Состояние <> Перечисления.KFK_СостоянияПроцесса.failed Тогда
			Результат = "ok=0" + Символы.ПС
				+ "error=NOT_FAILED" + Символы.ПС
				+ "state=" + ИмяСостояния(МенеджерЗаписи.Состояние);
		Иначе
			МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияПроцесса.started_sent;
			МенеджерЗаписи.НомерПопытки = 0;
			МенеджерЗаписи.ДатаСледующейПопытки = Дата(1, 1, 1);
			МенеджерЗаписи.ИдентификаторСтатусаTerminal = "";
			МенеджерЗаписи.Диагностика = "";
			МенеджерЗаписи.ВладелецОбработки = "";
			МенеджерЗаписи.АрендаДо = Дата(1, 1, 1);
			МенеджерЗаписи.Записать();
			
			KFK_ИсходящиеСтатусыСервер.УдалитьТерминальныйСтатус(КодКонтура, ИдентификаторСообщения);
			
			Результат = "ok=1" + Символы.ПС
				+ "state=started_sent" + Символы.ПС
				+ "attempt=0" + Символы.ПС
				+ "same_id=1";
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтчетДоставки(Действие, Процесс, ХешСовпадает)
	
	Started = "";
	Terminal = "";
	Если Процесс <> Неопределено Тогда
		СтатусStarted = KFK_ИсходящиеСтатусыСервер.ПрочитатьСтатус(Процесс.КодКонтура, Процесс.ИдентификаторСообщения, 10);
		Если СтатусStarted <> Неопределено Тогда
			Started = СтатусStarted.ИдентификаторСтатуса;
		КонецЕсли;
		СтатусTerminal = KFK_ИсходящиеСтатусыСервер.ПрочитатьСтатус(Процесс.КодКонтура, Процесс.ИдентификаторСообщения, 20);
		Если СтатусTerminal <> Неопределено Тогда
			Terminal = СтатусTerminal.ИдентификаторСтатуса;
		КонецЕсли;
	КонецЕсли;
	
	ИмяСостояния = "";
	Если Процесс <> Неопределено Тогда
		ИмяСостояния = ИмяСостояния(Процесс.Состояние);
	КонецЕсли;
	
	Возврат "action=" + Действие + Символы.ПС
		+ "state=" + ИмяСостояния + Символы.ПС
		+ "started_uuid=" + Started + Символы.ПС
		+ "terminal_uuid=" + Terminal + Символы.ПС
		+ "hash_match=" + ?(ХешСовпадает, "1", "0");
	
КонецФункции

Функция МенеджерЗаписиПроцесса(КодКонтура, ИдентификаторСообщения)
	
	МенеджерЗаписи = РегистрыСведений.KFK_ПроцессыОбмена.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
	Возврат МенеджерЗаписи;
	
КонецФункции

Функция ОписаниеПроцесса(МенеджерЗаписи, ЭтоДубль)
	
	Результат = Новый Структура;
	Результат.Вставить("ЭтоДубль", ЭтоДубль);
	Результат.Вставить("КодКонтура", МенеджерЗаписи.КодКонтура);
	Результат.Вставить("ИдентификаторСообщения", МенеджерЗаписи.ИдентификаторСообщения);
	Результат.Вставить("ИдентификаторКорреляции", МенеджерЗаписи.ИдентификаторКорреляции);
	Результат.Вставить("ВнешнийIDКонтрагента", МенеджерЗаписи.ВнешнийIDКонтрагента);
	Результат.Вставить("ВнешнийUIDКонтрагента", МенеджерЗаписи.ВнешнийUIDКонтрагента);
	Результат.Вставить("ХешPayload", МенеджерЗаписи.ХешPayload);
	Результат.Вставить("Состояние", МенеджерЗаписи.Состояние);
	Результат.Вставить("НомерПопытки", МенеджерЗаписи.НомерПопытки);
	Результат.Вставить("ДатаСледующейПопытки", МенеджерЗаписи.ДатаСледующейПопытки);
	Результат.Вставить("СыройPayload", МенеджерЗаписи.СыройPayload);
	Результат.Вставить("Диагностика", МенеджерЗаписи.Диагностика);
	Результат.Вставить("ИдентификаторСтатусаStarted", МенеджерЗаписи.ИдентификаторСтатусаStarted);
	Результат.Вставить("ИдентификаторСтатусаTerminal", МенеджерЗаписи.ИдентификаторСтатусаTerminal);
	Результат.Вставить("ВладелецОбработки", МенеджерЗаписи.ВладелецОбработки);
	Результат.Вставить("АрендаДо", МенеджерЗаписи.АрендаДо);
	Результат.Вставить("ДатаЗаписи", МенеджерЗаписи.ДатаЗаписи);
	Возврат Результат;
	
КонецФункции

Функция МоментЗаписи(ДатаЗаписи)
	
	Если ДатаЗаписи = Неопределено Или Не ЗначениеЗаполнено(ДатаЗаписи) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;
	
	Возврат ДатаЗаписи;
	
КонецФункции

Процедура ЗаблокироватьПроцесс(КодКонтура, ИдентификаторСообщения)
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ПроцессыОбмена");
	ЭлементБлокировки.УстановитьЗначение("КодКонтура", КодКонтура);
	ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция ЗначениеСостояния(Состояние)
	
	Если ТипЗнч(Состояние) = Тип("ПеречислениеСсылка.KFK_СостоянияПроцесса") Тогда
		Если Не ЗначениеЗаполнено(Состояние) Тогда
			ВызватьИсключение "Неизвестное состояние процесса";
		КонецЕсли;
		Возврат Состояние;
	КонецЕсли;
	
	Имя = НРег(СокрЛП(Строка(Состояние)));
	Если Имя = "received" Тогда
		Возврат Перечисления.KFK_СостоянияПроцесса.received;
	ИначеЕсли Имя = "started_pending" Тогда
		Возврат Перечисления.KFK_СостоянияПроцесса.started_pending;
	ИначеЕсли Имя = "started_sent" Тогда
		Возврат Перечисления.KFK_СостоянияПроцесса.started_sent;
	ИначеЕсли Имя = "processing" Тогда
		Возврат Перечисления.KFK_СостоянияПроцесса.processing;
	ИначеЕсли Имя = "waiting_retry" Тогда
		Возврат Перечисления.KFK_СостоянияПроцесса.waiting_retry;
	ИначеЕсли Имя = "completed" Тогда
		Возврат Перечисления.KFK_СостоянияПроцесса.completed;
	ИначеЕсли Имя = "failed" Тогда
		Возврат Перечисления.KFK_СостоянияПроцесса.failed;
	КонецЕсли;
	
	ВызватьИсключение "Неизвестное состояние процесса: " + Строка(Состояние);
	
КонецФункции

Функция ИмяСостояния(Состояние)
	
	Если Состояние = Перечисления.KFK_СостоянияПроцесса.received Тогда
		Возврат "received";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.started_pending Тогда
		Возврат "started_pending";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.started_sent Тогда
		Возврат "started_sent";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.processing Тогда
		Возврат "processing";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.waiting_retry Тогда
		Возврат "waiting_retry";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.completed Тогда
		Возврат "completed";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияПроцесса.failed Тогда
		Возврат "failed";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ПроверитьИдентификаторСообщения(ИдентификаторСообщения)
	
	Если Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ВызватьИсключение "Не заполнен идентификатор сообщения";
	КонецЕсли;
	
КонецПроцедуры

Функция ЗначениеКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

#КонецОбласти
