#Область ПрограммныйИнтерфейс

// RF-правила type_entity, ИНН/reg_number, КПП и ОГРН (РегистрационныйНомер).
// Физлицо с null tax fields допускается. Неизвестный type_entity — INVALID_FORMAT.
//
// Возвращаемое значение:
//  Строка - ok=1|0;count=N;errors=code|path|message;...
//
Функция ПроверитьТипИРегистрациюРФ(ТелоJSON) Экспорт
	
	Разбор = KFK_СнимокКонтрагентаСервер.РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		Возврат "ok=0" + Символы.ПС
			+ "count=1" + Символы.ПС
			+ "errors=INVALID_FORMAT|body|body not a JSON object";
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Ошибки = Новый Массив;
	
	ТипЛица = ЗначениеПоля(Данные, "type_entity");
	Если ТипЛица = Неопределено Или ТипЛица = Null Тогда
		Возврат "ok=1" + Символы.ПС
			+ "count=0" + Символы.ПС
			+ "errors=";
	КонецЕсли;
	Если ТипЗнч(ТипЛица) <> Тип("Строка") Или Не ЭтоДопустимыйТипЛицаРФ(ТипЛица) Тогда
		ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "type_entity", "Недопустимый type_entity");
		Возврат ОтчетОшибок(Ошибки);
	КонецЕсли;
	
	РегНомер = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "reg_number"));
	КПП = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "kpp"));
	ОГРН = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "ogrn"));
	
	Если ТипЛица = "legal" Тогда
		ПроверитьОбязательныйИНН(Ошибки, РегНомер, Истина);
		ПроверитьОбязательныйКПП(Ошибки, КПП);
		ПроверитьОпциональныйОГРН(Ошибки, ОГРН, Истина);
	ИначеЕсли ТипЛица = "sole_proprietor" Тогда
		ПроверитьОбязательныйИНН(Ошибки, РегНомер, Ложь);
		Если ЗначениеЗаполнено(КПП) Тогда
			ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "kpp", "У ИП КПП должен быть пустым");
		КонецЕсли;
		ПроверитьОпциональныйОГРН(Ошибки, ОГРН, Ложь);
	ИначеЕсли ТипЛица = "physical_person" Тогда
		Если ЗначениеЗаполнено(РегНомер) Тогда
			ПроверитьОбязательныйИНН(Ошибки, РегНомер, Ложь);
		КонецЕсли;
		Если ЗначениеЗаполнено(КПП) Тогда
			ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "kpp", "У физлица КПП должен быть пустым");
		КонецЕсли;
		Если ЗначениеЗаполнено(ОГРН) Тогда
			ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "ogrn", "У физлица ОГРН должен быть пустым");
		КонецЕсли;
	ИначеЕсли ТипЛица = "legal_outside" Тогда
		// Иностранное юрлицо: российские ИНН/КПП/ОГРН не обязательны.
		Если ЗначениеЗаполнено(РегНомер) И Не ТолькоЦифры(РегНомер) Тогда
			ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "reg_number", "reg_number должен содержать цифры");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОтчетОшибок(Ошибки);
	
КонецФункции

// Заполняет основные поля карточки РФ из JSON снимка и записывает элемент.
// Не трогает контакты, счета и договоры (задачи 7.3–7.5).
//
// Параметры:
//  ТелоJSON - Строка - body снимка;
//  КодЭлемента - Строка - код справочника для create/update теста.
//
// Возвращаемое значение:
//  Строка - ok=1;ref=...;name=...;inn=...;kpp=...;provider=0|1;client=0|1;transporter=0|1;other=0|1;separate=0|1;comment=...
//
Функция ПрименитьОсновныеПоля(ТелоJSON, КодЭлемента) Экспорт
	
	Если Не ЗначениеЗаполнено(КодЭлемента) Тогда
		ВызватьИсключение "КодЭлемента обязателен";
	КонецЕсли;
	
	Разбор = KFK_СнимокКонтрагентаСервер.РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		ВызватьИсключение "Тело снимка не разобрано";
	КонецЕсли;
	
	ПроверкаРФ = ПроверитьТипИРегистрациюРФ(ТелоJSON);
	Если СтрНачинаетсяС(ПроверкаРФ, "ok=0") Тогда
		ВызватьИсключение "RF validation failed: " + ПроверкаРФ;
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Имя = СокрЛП(Строка(ЗначениеПоля(Данные, "name")));
	Если Не ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Поле name обязательно для записи";
	КонецЕсли;
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(КодЭлемента);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
		Объект.Код = КодЭлемента;
	КонецЕсли;
	
	ЗаполнитьОсновныеПоляОбъекта(Объект, Данные);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат ОтчетКарточки(Объект.Ссылка);
	
КонецФункции

// Читает фактические значения основных полей карточки по коду (для verification).
//
Функция ПрочитатьОсновныеПоля(КодЭлемента) Экспорт
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(КодЭлемента);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "ok=0" + Символы.ПС + "error=not_found";
	КонецЕсли;
	
	Возврат ОтчетКарточки(Ссылка);
	
КонецФункции

// Удаляет тестовую карточку по коду.
//
Функция УдалитьТестовуюКарточку(КодЭлемента) Экспорт
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(КодЭлемента);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "deleted=0";
	КонецЕсли;
	
	УдалитьТестовыеДоговорыРФ(КодЭлемента);
	УдалитьТестовыеБанковскиеСчетаРФ(КодЭлемента);
	
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Удалить();
	Возврат "deleted=1";
	
КонецФункции

// Полная синхронизация emails/phones/addresses снимка в контактную информацию РФ.
// Управляемые виды: EmailКонтрагенты, ТелефонКонтрагента, Факт/Юр/Почтовый адрес.
// Пустая или null-коллекция очищает соответствующий вид. Прочие виды КИ не трогает.
//
Функция СинхронизироватьКонтактыРФ(ТелоJSON, КодЭлемента) Экспорт
	
	Если Не ЗначениеЗаполнено(КодЭлемента) Тогда
		ВызватьИсключение "КодЭлемента обязателен";
	КонецЕсли;
	
	Разбор = KFK_СнимокКонтрагентаСервер.РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		ВызватьИсключение "Тело снимка не разобрано";
	КонецЕсли;
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(КодЭлемента);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Карточка не найдена: " + КодЭлемента;
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Объект = Ссылка.ПолучитьОбъект();
	ОчиститьУправляемыеКонтакты(Объект);
	ДобавитьЗначенияКонтакта(Объект, НормализоватьСтроковыйМассивКонтакта(Данные.Получить("emails")), "EmailКонтрагенты");
	ДобавитьЗначенияКонтакта(Объект, НормализоватьСтроковыйМассивКонтакта(Данные.Получить("phones")), "ТелефонКонтрагента");
	ДобавитьАдресаКонтакта(Объект, Данные.Получить("addresses"));
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат ОтчетКонтактов(Объект.Ссылка);
	
КонецФункции

// Читает управляемые контакты карточки (для verification).
//
Функция ПрочитатьКонтактыРФ(КодЭлемента) Экспорт
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(КодЭлемента);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "ok=0" + Символы.ПС + "error=not_found";
	КонецЕсли;
	
	Возврат ОтчетКонтактов(Ссылка);
	
КонецФункции

// Upsert банковских счетов по внешнему id. is_default → ОсновнойБанковскийСчет.
// Удаление отсутствующих — только через ПрименитьСнимокРФ.
//
Функция СинхронизироватьБанковскиеСчетаРФ(ТелоJSON, КодКонтрагента) Экспорт
	
	Если Не ЗначениеЗаполнено(КодКонтрагента) Тогда
		ВызватьИсключение "КодКонтрагента обязателен";
	КонецЕсли;
	
	Разбор = KFK_СнимокКонтрагентаСервер.РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		ВызватьИсключение "Тело снимка не разобрано";
	КонецЕсли;
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		ВызватьИсключение "Карточка не найдена: " + КодКонтрагента;
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Счета = Данные.Получить("bank_accounts");
	Если Счета = Неопределено Или Счета = Null Тогда
		Счета = Новый Массив;
	КонецЕсли;
	Если ТипЗнч(Счета) <> Тип("Массив") Тогда
		ВызватьИсключение "bank_accounts должен быть массивом";
	КонецЕсли;
	
	Создано = 0;
	Обновлено = 0;
	ОсновнойСчет = Неопределено;
	Идентификаторы = Новый Массив;
	
	Для Каждого Элемент Из Счета Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ВнешнийID = Элемент.Получить("id");
		Если ТипЗнч(ВнешнийID) <> Тип("Число") Или ВнешнийID < 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = ЗаписатьБанковскийСчетРФ(Владелец, Элемент);
		Если Результат.Создан Тогда
			Создано = Создано + 1;
		Иначе
			Обновлено = Обновлено + 1;
		КонецЕсли;
		Идентификаторы.Добавить(Формат(ВнешнийID, "ЧН=0; ЧГ="));
		Если БулевоИзJSON(Элемент.Получить("is_default")) Тогда
			ОсновнойСчет = Результат.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОсновнойСчет) Тогда
		Карточка = Владелец.ПолучитьОбъект();
		Карточка.ОсновнойБанковскийСчет = ОсновнойСчет;
		Карточка.ОбменДанными.Загрузка = Истина;
		Карточка.Записать();
		Владелец = Карточка.Ссылка;
	КонецЕсли;
	
	Возврат "ok=1" + Символы.ПС
		+ "created=" + Формат(Создано, "ЧН=0; ЧГ=") + Символы.ПС
		+ "updated=" + Формат(Обновлено, "ЧН=0; ЧГ=") + Символы.ПС
		+ "count=" + Формат(Идентификаторы.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "ids=" + СтрСоединить(Идентификаторы, ",") + Символы.ПС
		+ "default=" + ?(ЗначениеЗаполнено(ОсновнойСчет), Формат(ОсновнойСчет.KFK_ВнешнийID, "ЧН=0; ЧГ="), "0") + Символы.ПС
		+ "owner_default=" + ?(ЗначениеЗаполнено(Владелец.ОсновнойБанковскийСчет), Формат(Владелец.ОсновнойБанковскийСчет.KFK_ВнешнийID, "ЧН=0; ЧГ="), "0");
	
КонецФункции

// Читает счета владельца с внешними id (для verification).
//
Функция ПрочитатьБанковскиеСчетаРФ(КодКонтрагента) Экспорт
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "ok=0" + Символы.ПС + "error=not_found";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.KFK_ВнешнийID КАК ВнешнийID,
	|	БанковскиеСчета.НомерСчета КАК НомерСчета,
	|	БанковскиеСчета.Наименование КАК Наименование
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец
	|	И БанковскиеСчета.KFK_ВнешнийID > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВнешнийID";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Идентификаторы = Новый Массив;
	Номера = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Идентификаторы.Добавить(Формат(Выборка.ВнешнийID, "ЧН=0; ЧГ="));
		Номера.Добавить(СокрЛП(Строка(Выборка.НомерСчета)));
	КонецЦикла;
	
	Возврат "ok=1" + Символы.ПС
		+ "count=" + Формат(Идентификаторы.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "ids=" + СтрСоединить(Идентификаторы, ",") + Символы.ПС
		+ "numbers=" + СтрСоединить(Номера, ",") + Символы.ПС
		+ "default=" + ?(ЗначениеЗаполнено(Владелец.ОсновнойБанковскийСчет), Формат(Владелец.ОсновнойБанковскийСчет.KFK_ВнешнийID, "ЧН=0; ЧГ="), "0");
	
КонецФункции

// Удаляет тестовые счета владельца с внешними id (verification cleanup).
//
Функция УдалитьТестовыеБанковскиеСчетаРФ(КодКонтрагента) Экспорт
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "deleted=0";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Карточка = Владелец.ПолучитьОбъект();
	Если ЗначениеЗаполнено(Карточка.ОсновнойБанковскийСчет) Тогда
		Карточка.ОсновнойБанковскийСчет = Справочники.БанковскиеСчета.ПустаяСсылка();
		Карточка.ОбменДанными.Загрузка = Истина;
		Карточка.Записать();
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Удалено = 0;
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
		Удалено = Удалено + 1;
	КонецЦикла;
	
	Возврат "deleted=" + Формат(Удалено, "ЧН=0; ЧГ=");
	
КонецФункции

// Upsert договоров по id/uid. organization.uid → ссылка Организации, код KFK_ВнешнийID = organization.id.
// type realization→СПокупателем, purchase→СПоставщиком.
//
Функция СинхронизироватьДоговорыРФ(ТелоJSON, КодКонтрагента) Экспорт
	
	Если Не ЗначениеЗаполнено(КодКонтрагента) Тогда
		ВызватьИсключение "КодКонтрагента обязателен";
	КонецЕсли;
	
	Разбор = KFK_СнимокКонтрагентаСервер.РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		ВызватьИсключение "Тело снимка не разобрано";
	КонецЕсли;
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		ВызватьИсключение "Карточка не найдена: " + КодКонтрагента;
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Договоры = Данные.Получить("contracts");
	Если Договоры = Неопределено Или Договоры = Null Тогда
		Договоры = Новый Массив;
	КонецЕсли;
	Если ТипЗнч(Договоры) <> Тип("Массив") Тогда
		ВызватьИсключение "contracts должен быть массивом";
	КонецЕсли;
	
	Создано = 0;
	Обновлено = 0;
	Ошибки = Новый Массив;
	Идентификаторы = Новый Массив;
	Индекс = 0;
	
	Для Каждого Элемент Из Договоры Цикл
		Путь = "contracts[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]";
		Индекс = Индекс + 1;
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Результат = ЗаписатьДоговорРФ(Владелец, Элемент, Путь);
			Если Результат.Создан Тогда
				Создано = Создано + 1;
			Иначе
				Обновлено = Обновлено + 1;
			КонецЕсли;
			Идентификаторы.Добавить(Формат(Результат.ВнешнийID, "ЧН=0; ЧГ="));
		Исключение
			Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		Возврат "ok=0" + Символы.ПС
			+ "created=" + Формат(Создано, "ЧН=0; ЧГ=") + Символы.ПС
			+ "updated=" + Формат(Обновлено, "ЧН=0; ЧГ=") + Символы.ПС
			+ "errors=" + СтрСоединить(Ошибки, ";");
	КонецЕсли;
	
	Возврат "ok=1" + Символы.ПС
		+ "created=" + Формат(Создано, "ЧН=0; ЧГ=") + Символы.ПС
		+ "updated=" + Формат(Обновлено, "ЧН=0; ЧГ=") + Символы.ПС
		+ "count=" + Формат(Идентификаторы.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "ids=" + СтрСоединить(Идентификаторы, ",");
	
КонецФункции

// Разрешает организацию договора: uid → ссылка, KFK_ВнешнийID должен совпасть с id.
//
Функция РазрешитьОрганизациюДоговораРФ(ОргИд, ОргУид) Экспорт
	
	Если Не ЗначениеЗаполнено(ОргУид) Тогда
		Возврат "ok=0" + Символы.ПС + "code=REQUIRED_FIELD_MISSING" + Символы.ПС + "path=organization.uid";
	КонецЕсли;
	
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Строка(ОргУид));
	Исключение
		Возврат "ok=0" + Символы.ПС + "code=INVALID_FORMAT" + Символы.ПС + "path=organization.uid";
	КонецПопытки;
	
	Ссылка = Справочники.Организации.ПолучитьСсылку(Идентификатор);
	Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат "ok=0" + Символы.ПС + "code=REFERENCE_NOT_FOUND" + Символы.ПС + "path=organization.uid";
	КонецЕсли;
	
	НастроенныйКод = Ссылка.KFK_ВнешнийID;
	Если ТипЗнч(ОргИд) <> Тип("Число") Или НастроенныйКод <> ОргИд Тогда
		Возврат "ok=0" + Символы.ПС + "code=DUPLICATE_CONFLICT" + Символы.ПС + "path=organization"
			+ Символы.ПС + "configured=" + Формат(НастроенныйКод, "ЧН=0; ЧГ=")
			+ Символы.ПС + "incoming=" + Формат(ОргИд, "ЧН=0; ЧГ=");
	КонецЕсли;
	
	Возврат "ok=1" + Символы.ПС
		+ "ref=" + Строка(Ссылка.УникальныйИдентификатор()) + Символы.ПС
		+ "code=" + Формат(НастроенныйКод, "ЧН=0; ЧГ=");
	
КонецФункции

// Привязывает тестовый внешний код организации (verification).
//
Функция ПривязатьВнешнийКодОрганизацииРФ(УидОрганизации, ВнешнийID) Экспорт
	
	Идентификатор = Новый УникальныйИдентификатор(Строка(УидОрганизации));
	Ссылка = Справочники.Организации.ПолучитьСсылку(Идентификатор);
	Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат "ok=0" + Символы.ПС + "error=not_found";
	КонецЕсли;
	
	Объект = Ссылка.ПолучитьОбъект();
	Объект.KFK_ВнешнийID = ВнешнийID;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат "ok=1" + Символы.ПС + "code=" + Формат(ВнешнийID, "ЧН=0; ЧГ=");
	
КонецФункции

Функция УдалитьТестовыеДоговорыРФ(КодКонтрагента) Экспорт
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "deleted=0";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Удалено = 0;
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
		Удалено = Удалено + 1;
	КонецЦикла;
	
	Возврат "deleted=" + Формат(Удалено, "ЧН=0; ЧГ=");
	
КонецФункции

// Привязывает головного контрагента из head_contragent.
// null/отсутствие — голова на себя; ссылка без карточки в ИБ — retryable без записи.
//
Функция ПрименитьГоловуРФ(ТелоJSON, КодЭлемента) Экспорт
	
	Если Не ЗначениеЗаполнено(КодЭлемента) Тогда
		ВызватьИсключение "КодЭлемента обязателен";
	КонецЕсли;
	
	Разбор = KFK_СнимокКонтрагентаСервер.РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		ВызватьИсключение "Тело снимка не разобрано";
	КонецЕсли;
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(КодЭлемента);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Карточка не найдена: " + КодЭлемента;
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Голова = Данные.Получить("head_contragent");
	Если Голова = Неопределено Или Голова = Null Тогда
		// При Загрузка типовой ПередЗаписью не ставит голову на себя — добираем явно.
		Объект = Ссылка.ПолучитьОбъект();
		Если Не ЗначениеЗаполнено(Объект.ГоловнойКонтрагент) Тогда
			Объект.ГоловнойКонтрагент = Объект.Ссылка;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
		КонецЕсли;
		Возврат "ok=1" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "head_ref=" + Строка(Ссылка.УникальныйИдентификатор()) + Символы.ПС
			+ "applied=1" + Символы.ПС
			+ "separate=0";
	КонецЕсли;
	Если ТипЗнч(Голова) <> Тип("Соответствие") Тогда
		Возврат "ok=0" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "error=INVALID_FORMAT" + Символы.ПС
			+ "path=head_contragent" + Символы.ПС
			+ "applied=0";
	КонецЕсли;
	
	Разрешение = KFK_ИдентичностьКонтрагентаСервер.РазрешитьГолову(Голова.Получить("id"), Голова.Получить("uid"));
	Если СтрНачинаетсяС(Разрешение, "ok=0") Тогда
		Возврат "ok=0" + Символы.ПС
			+ "present=" + ИзвлечьПолеОтчета(Разрешение, "present") + Символы.ПС
			+ "retryable=" + ИзвлечьПолеОтчета(Разрешение, "retryable") + Символы.ПС
			+ "error=" + ИзвлечьПолеОтчета(Разрешение, "error") + Символы.ПС
			+ "path=head_contragent" + Символы.ПС
			+ "applied=0";
	КонецЕсли;
	
	Если ИзвлечьПолеОтчета(Разрешение, "present") <> "1" Тогда
		Возврат "ok=1" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "head_ref=" + Символы.ПС
			+ "applied=0";
	КонецЕсли;
	
	СсылкаГоловы = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ИзвлечьПолеОтчета(Разрешение, "ref")));
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ГоловнойКонтрагент = СсылкаГоловы;
	Объект.ОбособленноеПодразделение = Истина;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат "ok=1" + Символы.ПС
		+ "present=1" + Символы.ПС
		+ "retryable=0" + Символы.ПС
		+ "head_ref=" + Строка(СсылкаГоловы.УникальныйИдентификатор()) + Символы.ПС
		+ "applied=1" + Символы.ПС
		+ "separate=1";
	
КонецФункции

// Полный снимок РФ: карточка + контакты + счета + договоры в одной транзакции.
// Отсутствующие у владельца счета/договоры удаляются (включая ручные без внешних ключей).
// ИскусственныйЗапретУдаления / ИскусственнаяОшибкаПослеЗаписи — только для verification отката.
//
Функция ПрименитьСнимокРФ(ТелоJSON, КодЭлемента, ИскусственныйЗапретУдаления = Ложь, ИскусственнаяОшибкаПослеЗаписи = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(КодЭлемента) Тогда
		ВызватьИсключение "КодЭлемента обязателен";
	КонецЕсли;
	
	Разбор = KFK_СнимокКонтрагентаСервер.РазобратьТелоВDTO(ТелоJSON);
	Если СтрНачинаетсяС(Разбор, "ok=0") Тогда
		Возврат "ok=0" + Символы.ПС
			+ "error=INVALID_FORMAT" + Символы.ПС
			+ "path=" + Символы.ПС
			+ "rolled_back=0";
	КонецЕсли;
	
	ПроверкаРФ = ПроверитьТипИРегистрациюРФ(ТелоJSON);
	Если СтрНачинаетсяС(ПроверкаРФ, "ok=0") Тогда
		Возврат "ok=0" + Символы.ПС
			+ "error=validation" + Символы.ПС
			+ "detail=" + СтрЗаменить(ПроверкаРФ, Символы.ПС, ";") + Символы.ПС
			+ "rolled_back=0";
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Голова = Данные.Получить("head_contragent");
	Если ТипЗнч(Голова) = Тип("Соответствие") Тогда
		РазрешениеГоловы = KFK_ИдентичностьКонтрагентаСервер.РазрешитьГолову(Голова.Получить("id"), Голова.Получить("uid"));
		Если СтрНачинаетсяС(РазрешениеГоловы, "ok=0") Тогда
			Возврат "ok=0" + Символы.ПС
				+ "error=" + ?(ЗначениеЗаполнено(ИзвлечьПолеОтчета(РазрешениеГоловы, "error")), ИзвлечьПолеОтчета(РазрешениеГоловы, "error"), "HEAD_MISSING") + Символы.ПС
				+ "path=head_contragent" + Символы.ПС
				+ "retryable=" + ИзвлечьПолеОтчета(РазрешениеГоловы, "retryable") + Символы.ПС
				+ "rolled_back=0" + Символы.ПС
				+ "applied=0";
		КонецЕсли;
	Иначе
		РазрешениеГоловы = "";
	КонецЕсли;
	
	УдаленоСчетов = 0;
	УдаленоДоговоров = 0;
	
	НачатьТранзакцию();
	Попытка
		
		ПрименитьОсновныеПоля(ТелоJSON, КодЭлемента);
		СинхронизироватьКонтактыРФ(ТелоJSON, КодЭлемента);
		
		Владелец = Справочники.Контрагенты.НайтиПоКоду(КодЭлемента);
		УдаленоСчетов = УдалитьОтсутствующиеБанковскиеСчетаРФ(Владелец, Данные.Получить("bank_accounts"), ИскусственныйЗапретУдаления);
		ОтчетСчетов = СинхронизироватьБанковскиеСчетаРФ(ТелоJSON, КодЭлемента);
		Если СтрНачинаетсяС(ОтчетСчетов, "ok=0") Тогда
			ВызватьИсключение ТекстИсключенияПоОтчетуДетей(ОтчетСчетов, "bank_accounts");
		КонецЕсли;
		
		УдаленоДоговоров = УдалитьОтсутствующиеДоговорыРФ(Владелец, Данные.Получить("contracts"), ИскусственныйЗапретУдаления);
		ОтчетДоговоров = СинхронизироватьДоговорыРФ(ТелоJSON, КодЭлемента);
		Если СтрНачинаетсяС(ОтчетДоговоров, "ok=0") Тогда
			ВызватьИсключение ТекстИсключенияПоОтчетуДетей(ОтчетДоговоров, "contracts");
		КонецЕсли;
		
		НужнаГолова = (ТипЗнч(Голова) <> Тип("Соответствие"))
			Или ИзвлечьПолеОтчета(РазрешениеГоловы, "present") = "1";
		Если НужнаГолова Тогда
			ПрименитьГоловуРФ(ТелоJSON, КодЭлемента);
		КонецЕсли;
		
		Если ИскусственнаяОшибкаПослеЗаписи Тогда
			ВызватьИсключение "KFK_TEST_ROLLBACK";
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		РазборОшибки = РазобратьОшибкуДетейИзТекста(Текст);
		
		Возврат "ok=0" + Символы.ПС
			+ "error=" + РазборОшибки.Код + Символы.ПС
			+ "path=" + РазборОшибки.Путь + Символы.ПС
			+ "detail=" + СтрЗаменить(Текст, Символы.ПС, " ") + Символы.ПС
			+ "rolled_back=1" + Символы.ПС
			+ "applied=0";
		
	КонецПопытки;
	
	СчетаПосле = ПрочитатьБанковскиеСчетаРФ(КодЭлемента);
	ДоговорыПосле = ПрочитатьДоговорыРФ(КодЭлемента);
	
	Возврат "ok=1" + Символы.ПС
		+ "applied=1" + Символы.ПС
		+ "rolled_back=0" + Символы.ПС
		+ "banks_deleted=" + Формат(УдаленоСчетов, "ЧН=0; ЧГ=") + Символы.ПС
		+ "banks_count=" + ИзвлечьПолеОтчета(СчетаПосле, "count") + Символы.ПС
		+ "banks_ids=" + ИзвлечьПолеОтчета(СчетаПосле, "ids") + Символы.ПС
		+ "contracts_deleted=" + Формат(УдаленоДоговоров, "ЧН=0; ЧГ=") + Символы.ПС
		+ "contracts_count=" + ИзвлечьПолеОтчета(ДоговорыПосле, "count") + Символы.ПС
		+ "contracts_ids=" + ИзвлечьПолеОтчета(ДоговорыПосле, "ids");
	
КонецФункции

// Создаёт банковский счёт владельца без внешнего id (ручная строка для verification удаления).
//
Функция СоздатьРучнойБанковскийСчетРФ(КодКонтрагента, Номер) Экспорт
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		ВызватьИсключение "Карточка не найдена: " + КодКонтрагента;
	КонецЕсли;
	
	Элемент = Новый Соответствие;
	Элемент.Вставить("id", 777000001);
	Элемент.Вставить("number", Номер);
	Элемент.Вставить("name", Номер);
	Элемент.Вставить("bic", "");
	Элемент.Вставить("is_default", Ложь);
	Результат = ЗаписатьБанковскийСчетРФ(Владелец, Элемент);
	
	Объект = Результат.Ссылка.ПолучитьОбъект();
	Объект.KFK_ВнешнийID = 0;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат "ok=1" + Символы.ПС
		+ "ref=" + Строка(Объект.Ссылка.УникальныйИдентификатор()) + Символы.ПС
		+ "manual=1";
	
КонецФункции

// Читает все счета владельца, включая без внешнего id.
//
Функция ПрочитатьВсеБанковскиеСчетаРФ(КодКонтрагента) Экспорт
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "ok=0" + Символы.ПС + "error=not_found";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.KFK_ВнешнийID КАК ВнешнийID,
	|	БанковскиеСчета.НомерСчета КАК НомерСчета
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВнешнийID,
	|	НомерСчета";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Идентификаторы = Новый Массив;
	Номера = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Идентификаторы.Добавить(Формат(Выборка.ВнешнийID, "ЧН=0; ЧГ="));
		Номера.Добавить(СокрЛП(Строка(Выборка.НомерСчета)));
	КонецЦикла;
	
	Возврат "ok=1" + Символы.ПС
		+ "count=" + Формат(Идентификаторы.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "ids=" + СтрСоединить(Идентификаторы, ",") + Символы.ПС
		+ "numbers=" + СтрСоединить(Номера, ",");
	
КонецФункции

Функция ПрочитатьДоговорыРФ(КодКонтрагента) Экспорт
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "ok=0" + Символы.ПС + "error=not_found";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.KFK_ВнешнийID КАК ВнешнийID
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВнешнийID";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Идентификаторы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Идентификаторы.Добавить(Формат(Выборка.ВнешнийID, "ЧН=0; ЧГ="));
	КонецЦикла;
	
	Возврат "ok=1" + Символы.ПС
		+ "count=" + Формат(Идентификаторы.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "ids=" + СтрСоединить(Идентификаторы, ",");
	
КонецФункции

// Сериализует карточку и детей для аудита разрушительных изменений.
//
Функция СериализоватьСостояниеРФ(КодЭлемента) Экспорт
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(КодЭлемента);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "{}";
	КонецЕсли;
	
	Состояние = Новый Структура;
	Состояние.Вставить("code", КодЭлемента);
	Состояние.Вставить("name", Строка(Ссылка.НаименованиеПолное));
	Состояние.Вставить("name_short", Строка(Ссылка.Наименование));
	Состояние.Вставить("bank_accounts", СериализоватьБанковскиеСчетаРФ(Ссылка));
	Состояние.Вставить("contracts", СериализоватьДоговорыРФ(Ссылка));
	
	Возврат KFK_ОбщегоНазначения.ЗначениеВJSON(Состояние);
	
КонецФункции

// Применяет снимок и пишет аудит before/after в KFK_АудитСнимков (поле СнимокДо = JSON {before,after}).
//
Функция ПрименитьСнимокРФСАудитом(ТелоJSON, КодЭлемента, ИдентификаторСообщения) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ВызватьИсключение "ИдентификаторСообщения обязателен";
	КонецЕсли;
	
	СнимокДо = СериализоватьСостояниеРФ(КодЭлемента);
	Отчет = ПрименитьСнимокРФ(ТелоJSON, КодЭлемента, Ложь, Ложь);
	Если СтрНачинаетсяС(Отчет, "ok=0") Тогда
		Возврат Отчет + Символы.ПС + "audit_id=" + Символы.ПС + "audited=0";
	КонецЕсли;
	
	СнимокПосле = СериализоватьСостояниеРФ(КодЭлемента);
	ПакетАудита = Новый Структура("before, after",
		KFK_ОбщегоНазначения.JSONВЗначение(СнимокДо, , Истина),
		KFK_ОбщегоНазначения.JSONВЗначение(СнимокПосле, , Истина));
	ТекстАудита = KFK_ОбщегоНазначения.ЗначениеВJSON(ПакетАудита);
	
	Аудит = KFK_СлужебныеЖурналыСервер.ЗаписатьАудит("RF", ИдентификаторСообщения, ТекстАудита);
	
	Возврат Отчет + Символы.ПС
		+ "audit_id=" + Аудит.ИдентификаторЗаписи + Символы.ПС
		+ "audited=1" + Символы.ПС
		+ "before_contracts=" + Формат(КоличествоДетейВСостоянии(СнимокДо, "contracts"), "ЧН=0; ЧГ=") + Символы.ПС
		+ "after_contracts=" + Формат(КоличествоДетейВСостоянии(СнимокПосле, "contracts"), "ЧН=0; ЧГ=");
	
КонецФункции

// Восстанавливает договор из before-части аудита по внешнему id.
//
Функция ВосстановитьДоговорИзАудитаРФ(ИдентификаторАудита, ВнешнийIDДоговора, КодКонтрагента) Экспорт
	
	Запись = KFK_СлужебныеЖурналыСервер.ПрочитатьАудит(ИдентификаторАудита);
	Если Запись = Неопределено Тогда
		Возврат "ok=0" + Символы.ПС + "error=AUDIT_NOT_FOUND";
	КонецЕсли;
	
	Пакет = KFK_ОбщегоНазначения.JSONВЗначение(Запись.СнимокДо, , Истина);
	Если ТипЗнч(Пакет) <> Тип("Соответствие") Тогда
		Возврат "ok=0" + Символы.ПС + "error=INVALID_AUDIT";
	КонецЕсли;
	
	До = Пакет.Получить("before");
	Если ТипЗнч(До) <> Тип("Соответствие") Тогда
		Возврат "ok=0" + Символы.ПС + "error=INVALID_AUDIT_BEFORE";
	КонецЕсли;
	
	Договоры = До.Получить("contracts");
	Если ТипЗнч(Договоры) <> Тип("Массив") Тогда
		Возврат "ok=0" + Символы.ПС + "error=NO_CONTRACTS";
	КонецЕсли;
	
	ИскомыйID = Число(ВнешнийIDДоговора);
	Найденный = Неопределено;
	Для Каждого Элемент Из Договоры Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ИдЭлемента = Элемент.Получить("id");
		Если ТипЗнч(ИдЭлемента) = Тип("Число") И ИдЭлемента = ИскомыйID Тогда
			Найденный = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Найденный = Неопределено Тогда
		Возврат "ok=0" + Символы.ПС + "error=CONTRACT_NOT_IN_AUDIT";
	КонецЕсли;
	
	Владелец = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагента);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "ok=0" + Символы.ПС + "error=OWNER_NOT_FOUND";
	КонецЕсли;
	
	Результат = ЗаписатьДоговорРФ(Владелец, Найденный, "audit.contracts");
	
	Возврат "ok=1" + Символы.ПС
		+ "restored=1" + Символы.ПС
		+ "created=" + ?(Результат.Создан, "1", "0") + Символы.ПС
		+ "id=" + Формат(Результат.ВнешнийID, "ЧН=0; ЧГ=");
	
КонецФункции

Функция УдалитьТестовыйАудитРФ(ИдентификаторАудита) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторАудита) Тогда
		Возврат "deleted=0";
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.KFK_АудитСнимков.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗаписи = ИдентификаторАудита;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат "deleted=0";
	КонецЕсли;
	
	МенеджерЗаписи.Удалить();
	Возврат "deleted=1";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииСнимка

Функция УдалитьОтсутствующиеБанковскиеСчетаРФ(Владелец, СчетаСнимка, ИскусственныйЗапретУдаления)
	
	Желаемые = Новый Соответствие;
	Если ТипЗнч(СчетаСнимка) = Тип("Массив") Тогда
		Для Каждого Элемент Из СчетаСнимка Цикл
			Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			ВнешнийID = Элемент.Получить("id");
			Если ТипЗнч(ВнешнийID) = Тип("Число") И ВнешнийID > 0 Тогда
				Желаемые.Вставить(ВнешнийID, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК Ссылка,
	|	БанковскиеСчета.KFK_ВнешнийID КАК ВнешнийID
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	
	КУдалению = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВнешнийID > 0 И Желаемые.Получить(Выборка.ВнешнийID) = Истина Тогда
			Продолжить;
		КонецЕсли;
		КУдалению.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если КУдалению.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ИскусственныйЗапретУдаления Тогда
		ВызватьИсключение "DELETE_FORBIDDEN|bank_accounts|artificial";
	КонецЕсли;
	
	Карточка = Владелец.ПолучитьОбъект();
	НужнаЗаписьКарточки = Ложь;
	Для Каждого СсылкаСчета Из КУдалению Цикл
		Если Карточка.ОсновнойБанковскийСчет = СсылкаСчета Тогда
			Карточка.ОсновнойБанковскийСчет = Справочники.БанковскиеСчета.ПустаяСсылка();
			НужнаЗаписьКарточки = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НужнаЗаписьКарточки Тогда
		Карточка.ОбменДанными.Загрузка = Истина;
		Карточка.Записать();
	КонецЕсли;
	
	Удалено = 0;
	Для Каждого СсылкаСчета Из КУдалению Цикл
		ПроверитьВозможностьУдаленияРФ(СсылкаСчета, "bank_accounts", Владелец);
		Объект = СсылкаСчета.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
		Удалено = Удалено + 1;
	КонецЦикла;
	
	Возврат Удалено;
	
КонецФункции

Функция УдалитьОтсутствующиеДоговорыРФ(Владелец, ДоговорыСнимка, ИскусственныйЗапретУдаления)
	
	ЖелаемыеID = Новый Соответствие;
	ЖелаемыеUID = Новый Соответствие;
	Если ТипЗнч(ДоговорыСнимка) = Тип("Массив") Тогда
		Для Каждого Элемент Из ДоговорыСнимка Цикл
			Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			ВнешнийID = Элемент.Получить("id");
			Если ТипЗнч(ВнешнийID) = Тип("Число") И ВнешнийID > 0 Тогда
				ЖелаемыеID.Вставить(ВнешнийID, Истина);
			КонецЕсли;
			ВнешнийUID = Элемент.Получить("uid");
			Если ВнешнийUID <> Неопределено И ВнешнийUID <> Null И ЗначениеЗаполнено(СокрЛП(Строка(ВнешнийUID))) Тогда
				ЖелаемыеUID.Вставить(ВРег(СокрЛП(Строка(ВнешнийUID))), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	ДоговорыКонтрагентов.KFK_ВнешнийID КАК ВнешнийID,
	|	ДоговорыКонтрагентов.KFK_ВнешнийUID КАК ВнешнийUID
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	
	КУдалению = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ЕстьВСнимке = Ложь;
		Если Выборка.ВнешнийID > 0 И ЖелаемыеID.Получить(Выборка.ВнешнийID) = Истина Тогда
			ЕстьВСнимке = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ВнешнийUID) И ЖелаемыеUID.Получить(ВРег(СокрЛП(Строка(Выборка.ВнешнийUID)))) = Истина Тогда
			ЕстьВСнимке = Истина;
		КонецЕсли;
		Если Не ЕстьВСнимке Тогда
			КУдалению.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если КУдалению.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ИскусственныйЗапретУдаления Тогда
		ВызватьИсключение "DELETE_FORBIDDEN|contracts|artificial";
	КонецЕсли;
	
	Удалено = 0;
	Для Каждого СсылкаДоговора Из КУдалению Цикл
		ПроверитьВозможностьУдаленияРФ(СсылкаДоговора, "contracts", Владелец);
		Объект = СсылкаДоговора.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
		Удалено = Удалено + 1;
	КонецЦикла;
	
	Возврат Удалено;
	
КонецФункции

Процедура ПроверитьВозможностьУдаленияРФ(Ссылка, ПутьКоллекции, Владелец)
	
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(Ссылка);
	ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок);
	
	Для Каждого СтрокаСсылки Из ТаблицаСсылок Цикл
		Если СтрокаСсылки.Данные = Ссылка Тогда
			Продолжить;
		КонецЕсли;
		// Ссылки с карточки владельца (ОсновнойБанковскийСчет и т.п.) снимаются до удаления.
		Если ЗначениеЗаполнено(Владелец) И СтрокаСсылки.Данные = Владелец Тогда
			Продолжить;
		КонецЕсли;
		ВызватьИсключение "DELETE_FORBIDDEN|" + ПутьКоллекции + "|" + Строка(СтрокаСсылки.Данные);
	КонецЦикла;
	
КонецПроцедуры

Функция СериализоватьБанковскиеСчетаРФ(Владелец)
	
	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.KFK_ВнешнийID КАК ВнешнийID,
	|	БанковскиеСчета.НомерСчета КАК НомерСчета,
	|	БанковскиеСчета.Наименование КАК Наименование
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВнешнийID";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id", Выборка.ВнешнийID);
		Элемент.Вставить("number", Строка(Выборка.НомерСчета));
		Элемент.Вставить("name", Строка(Выборка.Наименование));
		Элемент.Вставить("bic", "");
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СериализоватьДоговорыРФ(Владелец)
	
	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.KFK_ВнешнийID КАК ВнешнийID,
	|	ДоговорыКонтрагентов.KFK_ВнешнийUID КАК ВнешнийUID,
	|	ДоговорыКонтрагентов.Номер КАК Номер,
	|	ДоговорыКонтрагентов.Наименование КАК Наименование,
	|	ДоговорыКонтрагентов.Дата КАК Дата,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ДоговорыКонтрагентов.Организация КАК Организация
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВнешнийID";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТипДоговора = "";
		КодВида = XMLСтрока(Выборка.ВидДоговора);
		Если КодВида = "СПокупателем" Тогда
			ТипДоговора = "realization";
		ИначеЕсли КодВида = "СПоставщиком" Тогда
			ТипДоговора = "purchase";
		КонецЕсли;
		
		Орг = Новый Структура;
		Если ЗначениеЗаполнено(Выборка.Организация) Тогда
			Орг.Вставить("id", Выборка.Организация.KFK_ВнешнийID);
			Орг.Вставить("uid", Строка(Выборка.Организация.УникальныйИдентификатор()));
		Иначе
			Орг.Вставить("id", 0);
			Орг.Вставить("uid", "");
		КонецЕсли;
		
		Элемент = Новый Структура;
		Элемент.Вставить("id", Выборка.ВнешнийID);
		Элемент.Вставить("uid", Строка(Выборка.ВнешнийUID));
		Элемент.Вставить("number", Строка(Выборка.Номер));
		Элемент.Вставить("name", Строка(Выборка.Наименование));
		Элемент.Вставить("date", Формат(Выборка.Дата, "ДФ=дд.ММ.гггг ЧЧ:мм:сс"));
		Элемент.Вставить("type", ТипДоговора);
		Элемент.Вставить("organization", Орг);
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КоличествоДетейВСостоянии(ТекстJSON, ИмяКоллекции)
	
	Если Не ЗначениеЗаполнено(ТекстJSON) Или ТекстJSON = "{}" Тогда
		Возврат 0;
	КонецЕсли;
	
	Данные = KFK_ОбщегоНазначения.JSONВЗначение(ТекстJSON, , Истина);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат 0;
	КонецЕсли;
	
	Коллекция = Данные.Получить(ИмяКоллекции);
	Если ТипЗнч(Коллекция) <> Тип("Массив") Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Коллекция.Количество();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьОсновныеПоляОбъекта(Объект, Данные)
	
	Имя = СокрЛП(Строка(ЗначениеПоля(Данные, "name")));
	ИмяКраткое = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "name_short"));
	Если ЗначениеЗаполнено(ИмяКраткое) Тогда
		Объект.Наименование = ИмяКраткое;
		Объект.НаименованиеПолное = Имя;
	Иначе
		Объект.Наименование = Имя;
		Объект.НаименованиеПолное = Имя;
	КонецЕсли;
	
	РегНомер = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "reg_number"));
	Если РегНомер <> Неопределено Тогда
		Объект.ИНН = РегНомер;
	КонецЕсли;
	
	КПП = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "kpp"));
	Если КПП <> Неопределено Тогда
		Объект.КПП = КПП;
	КонецЕсли;
	
	ДопИнфо = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "additional_information"));
	Если ДопИнфо <> Неопределено Тогда
		Объект.Комментарий = ДопИнфо;
	КонецЕсли;
	
	Отдельное = ЗначениеПоля(Данные, "is_separate");
	Если Отдельное <> Неопределено И Отдельное <> Null Тогда
		Объект.ОбособленноеПодразделение = БулевоИзJSON(Отдельное);
	КонецЕсли;
	
	Объект.KFK_Поставщик = БулевоИзJSON(ЗначениеПоля(Данные, "is_provider"));
	Объект.KFK_Покупатель = БулевоИзJSON(ЗначениеПоля(Данные, "is_client"));
	Объект.KFK_Перевозчик = БулевоИзJSON(ЗначениеПоля(Данные, "is_transporter"));
	Объект.KFK_ПрочиеОтношения = БулевоИзJSON(ЗначениеПоля(Данные, "is_other_relationship"));
	
	ВнешнийID = ЗначениеПоля(Данные, "id");
	Если ТипЗнч(ВнешнийID) = Тип("Число") И ВнешнийID > 0 Тогда
		Объект.KFK_ВнешнийID = ВнешнийID;
	КонецЕсли;
	
	ВнешнийUID = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "uid"));
	Если ЗначениеЗаполнено(ВнешнийUID) Тогда
		Объект.KFK_ВнешнийUID = ВнешнийUID;
	КонецЕсли;
	
	ПрименитьТипЛицаРФ(Объект, ЗначениеПоля(Данные, "type_entity"));
	
	ОГРН = НормализоватьNullableСтроку(ЗначениеПоля(Данные, "ogrn"));
	Если ОГРН <> Неопределено Тогда
		Объект.РегистрационныйНомер = ОГРН;
	КонецЕсли;
	
	Страна = ЗначениеПоля(Данные, "country");
	Если ТипЗнч(Страна) = Тип("Соответствие") Тогда
		ИмяСтраны = НормализоватьNullableСтроку(Страна.Получить("name"));
		Если ЗначениеЗаполнено(ИмяСтраны) Тогда
			СсылкаСтраны = Справочники.СтраныМира.НайтиПоНаименованию(ИмяСтраны, Истина);
			Если ЗначениеЗаполнено(СсылкаСтраны) Тогда
				Объект.СтранаРегистрации = СсылкаСтраны;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрименитьТипЛицаРФ(Объект, ТипЛица)
	
	Если ТипЛица = Неопределено Или ТипЛица = Null Или Не ЗначениеЗаполнено(Строка(ТипЛица)) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЛица = "legal" Или ТипЛица = "legal_outside" Тогда
		Объект.ЮридическоеФизическоеЛицо = ЗначениеЮрФизЛица("ЮридическоеЛицо");
		Объект.ИндивидуальныйПредприниматель = Ложь;
	ИначеЕсли ТипЛица = "physical_person" Тогда
		Объект.ЮридическоеФизическоеЛицо = ЗначениеЮрФизЛица("ФизическоеЛицо");
		Объект.ИндивидуальныйПредприниматель = Ложь;
	ИначеЕсли ТипЛица = "sole_proprietor" Тогда
		Объект.ЮридическоеФизическоеЛицо = ЗначениеЮрФизЛица("ФизическоеЛицо");
		Объект.ИндивидуальныйПредприниматель = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗначениеЮрФизЛица(ИмяЗначения)
	
	Возврат XMLЗначение(Тип("ПеречислениеСсылка.ЮридическоеФизическоеЛицо"), ИмяЗначения);
	
КонецФункции

Функция ОтчетКарточки(Ссылка)
	
	ТипЛица = "";
	КодТипа = XMLСтрока(Ссылка.ЮридическоеФизическоеЛицо);
	Если КодТипа = "ЮридическоеЛицо" Тогда
		ТипЛица = "legal";
	ИначеЕсли КодТипа = "ФизическоеЛицо" Тогда
		Если Ссылка.ИндивидуальныйПредприниматель Тогда
			ТипЛица = "sole_proprietor";
		Иначе
			ТипЛица = "physical_person";
		КонецЕсли;
	КонецЕсли;
	
	Возврат "ok=1" + Символы.ПС
		+ "ref=" + Строка(Ссылка.УникальныйИдентификатор()) + Символы.ПС
		+ "name=" + Строка(Ссылка.Наименование) + Символы.ПС
		+ "name_full=" + Строка(Ссылка.НаименованиеПолное) + Символы.ПС
		+ "inn=" + Строка(Ссылка.ИНН) + Символы.ПС
		+ "kpp=" + Строка(Ссылка.КПП) + Символы.ПС
		+ "ogrn=" + Строка(Ссылка.РегистрационныйНомер) + Символы.ПС
		+ "type_entity=" + ТипЛица + Символы.ПС
		+ "provider=" + ?(Ссылка.KFK_Поставщик, "1", "0") + Символы.ПС
		+ "client=" + ?(Ссылка.KFK_Покупатель, "1", "0") + Символы.ПС
		+ "transporter=" + ?(Ссылка.KFK_Перевозчик, "1", "0") + Символы.ПС
		+ "other=" + ?(Ссылка.KFK_ПрочиеОтношения, "1", "0") + Символы.ПС
		+ "separate=" + ?(Ссылка.ОбособленноеПодразделение, "1", "0") + Символы.ПС
		+ "comment=" + Строка(Ссылка.Комментарий) + Символы.ПС
		+ "country=" + Строка(Ссылка.СтранаРегистрации) + Символы.ПС
		+ "ext_id=" + Формат(Ссылка.KFK_ВнешнийID, "ЧН=0; ЧГ=") + Символы.ПС
		+ "ext_uid=" + Строка(Ссылка.KFK_ВнешнийUID);
	
КонецФункции

Функция ЭтоДопустимыйТипЛицаРФ(Значение)
	
	Возврат Значение = "legal"
		Или Значение = "physical_person"
		Или Значение = "legal_outside"
		Или Значение = "sole_proprietor";
	
КонецФункции

Процедура ПроверитьОбязательныйИНН(Ошибки, РегНомер, ЭтоЮридическоеЛицо)
	
	Если Не ЗначениеЗаполнено(РегНомер) Тогда
		ДобавитьОшибку(Ошибки, "REQUIRED_FIELD_MISSING", "reg_number", "reg_number обязателен");
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если Не РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(РегНомер, ЭтоЮридическоеЛицо, ТекстОшибки) Тогда
		ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "reg_number", ?(ЗначениеЗаполнено(ТекстОшибки), ТекстОшибки, "Некорректный ИНН"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьОбязательныйКПП(Ошибки, КПП)
	
	Если Не ЗначениеЗаполнено(КПП) Тогда
		ДобавитьОшибку(Ошибки, "REQUIRED_FIELD_MISSING", "kpp", "kpp обязателен для legal");
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если Не РегламентированныеДанныеКлиентСервер.КППСоответствуетТребованиям(КПП, ТекстОшибки) Тогда
		ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "kpp", ?(ЗначениеЗаполнено(ТекстОшибки), ТекстОшибки, "Некорректный КПП"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьОпциональныйОГРН(Ошибки, ОГРН, ЭтоЮридическоеЛицо)
	
	Если Не ЗначениеЗаполнено(ОГРН) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если Не РегламентированныеДанныеКлиентСервер.ОГРНСоответствуетТребованиям(ОГРН, ЭтоЮридическоеЛицо, ТекстОшибки) Тогда
		ДобавитьОшибку(Ошибки, "INVALID_FORMAT", "ogrn", ?(ЗначениеЗаполнено(ТекстОшибки), ТекстОшибки, "Некорректный ОГРН"));
	КонецЕсли;
	
КонецПроцедуры

Функция ТолькоЦифры(Значение)
	
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрДлина(Значение) > 0;
	
КонецФункции

Процедура ДобавитьОшибку(Ошибки, Код, Путь, Сообщение)
	
	Текст = СтрЗаменить(СтрЗаменить(Строка(Сообщение), Символы.ПС, " "), ";", ",");
	Ошибки.Добавить(KFK_СнимокКонтрагентаСервер.НормализоватьКодОшибки(Код) + "|" + Путь + "|" + Текст);
	
КонецПроцедуры

Функция ОтчетОшибок(Ошибки)
	
	Если Ошибки.Количество() = 0 Тогда
		Возврат "ok=1" + Символы.ПС
			+ "count=0" + Символы.ПС
			+ "errors=";
	КонецЕсли;
	
	Возврат "ok=0" + Символы.ПС
		+ "count=" + Формат(Ошибки.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "errors=" + СтрСоединить(Ошибки, ";");
	
КонецФункции

Функция ЗначениеПоля(Данные, ИмяПоля)
	
	Возврат Данные.Получить(ИмяПоля);
	
КонецФункции

Функция НормализоватьNullableСтроку(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

Функция БулевоИзJSON(Значение)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция УправляемыеВидыКонтактовРФ()
	
	Результат = Новый Массив;
	Результат.Добавить(УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("EmailКонтрагенты"));
	Результат.Добавить(УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ТелефонКонтрагента"));
	Результат.Добавить(УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ФактАдресКонтрагента"));
	Результат.Добавить(УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ЮрАдресКонтрагента"));
	Результат.Добавить(УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ПочтовыйАдресКонтрагента"));
	Возврат Результат;
	
КонецФункции

Процедура ОчиститьУправляемыеКонтакты(Объект)
	
	Виды = УправляемыеВидыКонтактовРФ();
	Индекс = Объект.КонтактнаяИнформация.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаКИ = Объект.КонтактнаяИнформация[Индекс];
		Если Виды.Найти(СтрокаКИ.Вид) <> Неопределено Тогда
			Объект.КонтактнаяИнформация.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

Функция НормализоватьСтроковыйМассивКонтакта(Значение)
	
	Результат = Новый Массив;
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Элемент Из Значение Цикл
		Если Элемент = Неопределено Или Элемент = Null Тогда
			Продолжить;
		КонецЕсли;
		Текст = СокрЛП(Строка(Элемент));
		Если ЗначениеЗаполнено(Текст) Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьЗначенияКонтакта(Объект, Значения, ИмяВида)
	
	Если Значения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Вид = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени(ИмяВида);
	Первый = Истина;
	Для Каждого Значение Из Значения Цикл
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Объект, Значение, Вид, , Первый);
		Первый = Ложь;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьАдресаКонтакта(Объект, Адреса)
	
	Если Адреса = Неопределено Или Адреса = Null Или ТипЗнч(Адреса) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеВидов = Новый Соответствие;
	СоответствиеВидов.Вставить("actual", "ФактАдресКонтрагента");
	СоответствиеВидов.Вставить("legal", "ЮрАдресКонтрагента");
	СоответствиеВидов.Вставить("postal", "ПочтовыйАдресКонтрагента");
	
	УжеЗамещён = Новый Соответствие;
	Для Каждого Элемент Из Адреса Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ТипАдреса = СокрЛП(Строка(Элемент.Получить("type")));
		ИмяВида = СоответствиеВидов.Получить(ТипАдреса);
		Если Не ЗначениеЗаполнено(ИмяВида) Тогда
			Продолжить;
		КонецЕсли;
		Представление = СокрЛП(Строка(Элемент.Получить("address")));
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Продолжить;
		КонецЕсли;
		Вид = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени(ИмяВида);
		Замещать = (УжеЗамещён.Получить(ИмяВида) <> Истина);
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Объект, Представление, Вид, , Замещать);
		УжеЗамещён.Вставить(ИмяВида, Истина);
	КонецЦикла;
	
КонецПроцедуры

Функция ОтчетКонтактов(Ссылка)
	
	Почты = ПредставленияВида(Ссылка, "EmailКонтрагенты");
	Телефоны = ПредставленияВида(Ссылка, "ТелефонКонтрагента");
	Факт = ПредставленияВида(Ссылка, "ФактАдресКонтрагента");
	Юр = ПредставленияВида(Ссылка, "ЮрАдресКонтрагента");
	Почтовый = ПредставленияВида(Ссылка, "ПочтовыйАдресКонтрагента");
	
	Возврат "ok=1" + Символы.ПС
		+ "emails=" + Формат(Почты.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "phones=" + Формат(Телефоны.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "actual=" + Формат(Факт.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "legal=" + Формат(Юр.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "postal=" + Формат(Почтовый.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "emails_csv=" + СтрСоединить(Почты, ",") + Символы.ПС
		+ "phones_csv=" + СтрСоединить(Телефоны, ",") + Символы.ПС
		+ "actual_csv=" + СтрСоединить(Факт, "|") + Символы.ПС
		+ "legal_csv=" + СтрСоединить(Юр, "|") + Символы.ПС
		+ "postal_csv=" + СтрСоединить(Почтовый, "|");
	
КонецФункции

Функция ПредставленияВида(Ссылка, ИмяВида)
	
	Результат = Новый Массив;
	Вид = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени(ИмяВида);
	Для Каждого СтрокаКИ Из Ссылка.КонтактнаяИнформация Цикл
		Если СтрокаКИ.Вид = Вид И ЗначениеЗаполнено(СтрокаКИ.Представление) Тогда
			Результат.Добавить(СокрЛП(СтрокаКИ.Представление));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьБанковскийСчетРФ(Владелец, Элемент)
	
	ВнешнийID = Элемент.Получить("id");
	Ссылка = НайтиБанковскийСчетПоВнешнемуID(ВнешнийID);
	ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
	Если ЭтоНовый Тогда
		Объект = Справочники.БанковскиеСчета.СоздатьЭлемент();
		Объект.Владелец = Владелец;
		Объект.KFK_ВнешнийID = ВнешнийID;
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Владелец = Владелец;
	КонецЕсли;
	
	Номер = НормализоватьNullableСтроку(Элемент.Получить("number"));
	Если Номер <> Неопределено Тогда
		Объект.НомерСчета = Номер;
	КонецЕсли;
	
	ИмяСчета = НормализоватьNullableСтроку(Элемент.Получить("name"));
	Если ЗначениеЗаполнено(ИмяСчета) Тогда
		Объект.Наименование = ИмяСчета;
	ИначеЕсли ЗначениеЗаполнено(Объект.НомерСчета) Тогда
		Объект.Наименование = Объект.НомерСчета;
	Иначе
		Объект.Наименование = "Счет " + Формат(ВнешнийID, "ЧН=0; ЧГ=");
	КонецЕсли;
	
	БИК = НормализоватьNullableСтроку(Элемент.Получить("bic"));
	Если ЗначениеЗаполнено(БИК) Тогда
		Банк = Справочники.Банки.НайтиПоКоду(БИК);
		Если ЗначениеЗаполнено(Банк) Тогда
			Объект.Банк = Банк;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВалютаДенежныхСредств) Тогда
		Объект.ВалютаДенежныхСредств = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Код) Тогда
		Объект.УстановитьНовыйКод();
	КонецЕсли;
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Результат = Новый Структура("Создан, Ссылка", ЭтоНовый, Объект.Ссылка);
	Возврат Результат;
	
КонецФункции

Функция НайтиБанковскийСчетПоВнешнемуID(ВнешнийID)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БанковскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.KFK_ВнешнийID = &ВнешнийID";
	Запрос.УстановитьПараметр("ВнешнийID", ВнешнийID);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	
КонецФункции

Функция ЗаписатьДоговорРФ(Владелец, Элемент, Путь)
	
	ОрганизацияДанные = Элемент.Получить("organization");
	Если ТипЗнч(ОрганизацияДанные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "REFERENCE_NOT_FOUND|" + Путь + ".organization|organization обязателен";
	КонецЕсли;
	
	Разрешение = РазрешитьОрганизациюДоговораРФ(ОрганизацияДанные.Получить("id"), ОрганизацияДанные.Получить("uid"));
	Если СтрНачинаетсяС(Разрешение, "ok=0") Тогда
		Код = ИзвлечьПолеОтчета(Разрешение, "code");
		ПутьОрг = ИзвлечьПолеОтчета(Разрешение, "path");
		Если Не ЗначениеЗаполнено(ПутьОрг) Тогда
			ПутьОрг = Путь + ".organization";
		ИначеЕсли Не СтрНачинаетсяС(ПутьОрг, "contracts") Тогда
			ПутьОрг = Путь + "." + ПутьОрг;
		КонецЕсли;
		ВызватьИсключение Код + "|" + ПутьОрг + "|organization resolve failed";
	КонецЕсли;
	
	Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(ИзвлечьПолеОтчета(Разрешение, "ref")));
	
	ВнешнийID = Элемент.Получить("id");
	ВнешнийUID = НормализоватьNullableСтроку(Элемент.Получить("uid"));
	Ссылка = НайтиДоговорПоВнешнимКлючам(ВнешнийID, ВнешнийUID);
	ЭтоНовый = Не ЗначениеЗаполнено(Ссылка);
	Если ЭтоНовый Тогда
		Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Объект.Владелец = Владелец;
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Владелец = Владелец;
	КонецЕсли;
	
	Если ТипЗнч(ВнешнийID) = Тип("Число") И ВнешнийID > 0 Тогда
		Объект.KFK_ВнешнийID = ВнешнийID;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВнешнийUID) Тогда
		Объект.KFK_ВнешнийUID = ВнешнийUID;
	КонецЕсли;
	
	Объект.Организация = Организация;
	
	ТипДоговора = СокрЛП(Строка(Элемент.Получить("type")));
	Если ТипДоговора = "realization" Тогда
		Объект.ВидДоговора = XMLЗначение(Тип("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"), "СПокупателем");
	ИначеЕсли ТипДоговора = "purchase" Тогда
		Объект.ВидДоговора = XMLЗначение(Тип("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"), "СПоставщиком");
	ИначеЕсли ЗначениеЗаполнено(ТипДоговора) Тогда
		ВызватьИсключение "INVALID_FORMAT|" + Путь + ".type|Недопустимый type";
	КонецЕсли;
	
	Номер = НормализоватьNullableСтроку(Элемент.Получить("number"));
	Если Номер <> Неопределено Тогда
		Объект.Номер = Номер;
	КонецЕсли;
	
	Имя = НормализоватьNullableСтроку(Элемент.Получить("name"));
	Если ЗначениеЗаполнено(Имя) Тогда
		Объект.Наименование = Имя;
	ИначеЕсли ЗначениеЗаполнено(Объект.Номер) Тогда
		Объект.Наименование = Объект.Номер;
	Иначе
		Объект.Наименование = "Договор " + Формат(Объект.KFK_ВнешнийID, "ЧН=0; ЧГ=");
	КонецЕсли;
	
	ДатаСтрока = НормализоватьNullableСтроку(Элемент.Получить("date"));
	Если ЗначениеЗаполнено(ДатаСтрока) Тогда
		Объект.Дата = ДатаИзСтрокиСнимка(ДатаСтрока);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВалютаВзаиморасчетов) Тогда
		Объект.ВалютаВзаиморасчетов = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Код) Тогда
		Объект.УстановитьНовыйКод();
	КонецЕсли;
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат Новый Структура("Создан, ВнешнийID, Ссылка", ЭтоНовый, Объект.KFK_ВнешнийID, Объект.Ссылка);
	
КонецФункции

Функция НайтиДоговорПоВнешнимКлючам(ВнешнийID, ВнешнийUID)
	
	Если ТипЗнч(ВнешнийID) = Тип("Число") И ВнешнийID > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.KFK_ВнешнийID = &ВнешнийID";
		Запрос.УстановитьПараметр("ВнешнийID", ВнешнийID);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВнешнийUID) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.KFK_ВнешнийUID = &ВнешнийUID";
		Запрос.УстановитьПараметр("ВнешнийUID", ВнешнийUID);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
КонецФункции

Функция ДатаИзСтрокиСнимка(Значение)
	
	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) >= 10 Тогда
		День = Число(Сред(Текст, 1, 2));
		Месяц = Число(Сред(Текст, 4, 2));
		Год = Число(Сред(Текст, 7, 4));
		Возврат Дата(Год, Месяц, День);
	КонецЕсли;
	
	Возврат Дата(1, 1, 1);
	
КонецФункции

Функция ИзвлечьПолеОтчета(Отчет, ИмяПоля)
	
	Префикс = ИмяПоля + "=";
	Для Каждого СтрокаОтчета Из СтрРазделить(Отчет, Символы.ПС, Ложь) Цикл
		Если СтрНачинаетсяС(СтрокаОтчета, Префикс) Тогда
			Возврат Сред(СтрокаОтчета, СтрДлина(Префикс) + 1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Собирает исключение из отчёта детей: предпочитает errors= с бизнес-кодом
// (REFERENCE_NOT_FOUND|…), иначе INTERNAL_ERROR|<контекст>|<сжатый отчёт>.
Функция ТекстИсключенияПоОтчетуДетей(Отчет, Контекст)
	
	Ошибки = СокрЛП(ИзвлечьПолеОтчета(Отчет, "errors"));
	Если ЗначениеЗаполнено(Ошибки) Тогда
		Возврат Ошибки;
	КонецЕсли;
	
	Возврат "INTERNAL_ERROR|" + Контекст + "|" + СтрЗаменить(Отчет, Символы.ПС, ";");
	
КонецФункции

// Разбирает текст исключения вида КОД|путь|деталь или ищет известный код в произвольном тексте.
Функция РазобратьОшибкуДетейИзТекста(Текст)
	
	Результат = Новый Структура("Код, Путь", "INTERNAL_ERROR", "children");
	Текст = СокрЛП(Строка(Текст));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Части = СтрРазделить(Текст, "|", Ложь);
	Если Части.Количество() >= 2 Тогда
		КодКандидат = ВРег(СокрЛП(Части[0]));
		Если КодКандидат = "REFERENCE_NOT_FOUND"
			Или КодКандидат = "DUPLICATE_CONFLICT"
			Или КодКандидат = "VALIDATION_ERROR"
			Или КодКандидат = "DELETE_FORBIDDEN"
			Или КодКандидат = "HEAD_MISSING"
			Или КодКандидат = "INTERNAL_ERROR" Тогда
			Результат.Код = КодКандидат;
			Результат.Путь = СокрЛП(Части[1]);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Известные = СтрРазделить(
		"REFERENCE_NOT_FOUND,DUPLICATE_CONFLICT,VALIDATION_ERROR,DELETE_FORBIDDEN,HEAD_MISSING",
		",",
		Ложь);
	Для Каждого Код Из Известные Цикл
		Если СтрНайти(ВРег(Текст), Код) > 0 Тогда
			Результат.Код = Код;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
