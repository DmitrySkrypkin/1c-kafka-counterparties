#Область ПрограммныйИнтерфейс

// Поиск контрагента по внешнему id и uid; пара reg_number+kpp (ИНН+КПП) — запасной поиск,
// только если id и uid ничего не нашли. Результаты сравниваются без записи бизнес-данных.
//
// Параметры:
//  ВнешнийID - Число, Неопределено - body id портала;
//  ВнешнийUID - Строка, Неопределено - body uid;
//  РегНомер - Строка, Неопределено - body reg_number (ИНН);
//  КПП - Строка, Неопределено - body kpp.
//
// Возвращаемое значение:
//  Строка - result=create|update|bind|conflict;matched_by=...;ref=...;error=...;counts=...
//
Функция РазрешитьКонтрагента(ВнешнийID = Неопределено, ВнешнийUID = Неопределено, РегНомер = Неопределено, КПП = Неопределено) Экспорт
	
	НайденныеПоID = НайтиПоВнешнемуID(ВнешнийID);
	НайденныеПоUID = НайтиПоВнешнемуUID(ВнешнийUID);

	Если НайденныеПоID.Количество() > 1 Или НайденныеПоUID.Количество() > 1 Тогда
		Возврат ОтчетРазрешения("conflict", "", "", "DUPLICATE_CONFLICT",
			НайденныеПоID, НайденныеПоUID, Новый Массив);
	КонецЕсли;

	Кандидаты = Новый Соответствие;
	ДобавитьКандидата(Кандидаты, НайденныеПоID, "id");
	ДобавитьКандидата(Кандидаты, НайденныеПоUID, "uid");

	// Регистрационные данные — только запасной поиск: дубли по ним не мешают карточке, уже найденной по id/uid.
	НайденныеПоРег = Новый Массив;
	Если Кандидаты.Количество() = 0 Тогда
		НайденныеПоРег = НайтиПоРегНомеруИКПП(РегНомер, КПП);
		Если НайденныеПоРег.Количество() > 1 Тогда
			Возврат ОтчетРазрешения("conflict", "", "", "DUPLICATE_CONFLICT",
				НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
		КонецЕсли;
		ДобавитьКандидата(Кандидаты, НайденныеПоРег, "reg");
	КонецЕсли;
	
	Если Кандидаты.Количество() > 1 Тогда
		Возврат ОтчетРазрешения("conflict", "", "", "DUPLICATE_CONFLICT",
			НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	КонецЕсли;
	
	Если Кандидаты.Количество() = 0 Тогда
		Возврат ОтчетРазрешения("create", "", "", "",
			НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	КонецЕсли;
	
	Ссылка = Неопределено;
	Источники = "";
	Для Каждого Пара Из Кандидаты Цикл
		Ссылка = Пара.Ключ;
		Источники = Пара.Значение;
	КонецЦикла;
	
	ЕстьВнешнийКлюч = НайденныеПоID.Количество() > 0 Или НайденныеПоUID.Количество() > 0;
	Если ЕстьВнешнийКлюч Тогда
		Возврат ОтчетРазрешения("update", Источники, Строка(Ссылка.УникальныйИдентификатор()), "",
			НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	КонецЕсли;
	
	Возврат ОтчетРазрешения("bind", Источники, Строка(Ссылка.УникальныйИдентификатор()), "",
		НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	
КонецФункции

// Тестовая запись карточки с внешними ключами и ИНН/КПП. Только для verification.
//
Функция ЗаписатьТестовуюКарточку(Код, Наименование, ВнешнийID, ВнешнийUID, РегНомер, КПП) Экспорт
	
	Если ЗначениеЗаполнено(Код) Тогда
		Ссылка = Справочники.Контрагенты.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Объект = Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.Контрагенты.СоздатьЭлемент();
			Объект.Код = Код;
		КонецЕсли;
	Иначе
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
		Объект.УстановитьНовыйКод();
	КонецЕсли;
	
	Объект.Наименование = Наименование;
	Объект.KFK_ВнешнийID = ?(ВнешнийID = Неопределено, 0, ВнешнийID);
	Объект.KFK_ВнешнийUID = ?(ВнешнийUID = Неопределено, "", Строка(ВнешнийUID));
	Объект.ИНН = ?(РегНомер = Неопределено, "", Строка(РегНомер));
	Объект.КПП = ?(КПП = Неопределено, "", Строка(КПП));
	Объект.ДополнительныеСвойства.Вставить("KFK_ЗаписьОбменом", Истина);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат "ref=" + Строка(Объект.Ссылка.УникальныйИдентификатор()) + Символы.ПС
		+ "code=" + Объект.Код;
	
КонецФункции

// Удаление тестовой карточки по коду.
//
Функция УдалитьТестовуюКарточку(Код) Экспорт
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(Код);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "deleted=0";
	КонецЕсли;
	
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Удалить();
	Возврат "deleted=1";
	
КонецФункции

// Разрешение head_contragent по внешним id/uid без создания заглушки.
// Отсутствие головы — retryable (терминальный код выставляет планировщик после исчерпания попыток).
//
// Параметры:
//  ВнешнийID - Число, Неопределено;
//  ВнешнийUID - Строка, Неопределено.
//
// Возвращаемое значение:
//  Строка - ok=1|0;present=0|1;ref=...;error=...;retryable=0|1;matched_by=...
//
Функция РазрешитьГолову(ВнешнийID = Неопределено, ВнешнийUID = Неопределено) Экспорт
	
	ЕстьID = ВнешнийID <> Неопределено И ВнешнийID <> Null И ТипЗнч(ВнешнийID) = Тип("Число") И ВнешнийID > 0;
	ЕстьUID = ВнешнийUID <> Неопределено И ВнешнийUID <> Null И ЗначениеЗаполнено(СокрЛП(Строка(ВнешнийUID)));
	Если Не ЕстьID И Не ЕстьUID Тогда
		Возврат "ok=1" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "ref=" + Символы.ПС
			+ "error=" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "matched_by=";
	КонецЕсли;
	
	НайденныеПоID = НайтиПоВнешнемуID(?(ЕстьID, ВнешнийID, Неопределено));
	НайденныеПоUID = НайтиПоВнешнемуUID(?(ЕстьUID, ВнешнийUID, Неопределено));
	
	Если НайденныеПоID.Количество() > 1 Или НайденныеПоUID.Количество() > 1 Тогда
		Возврат "ok=0" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "ref=" + Символы.ПС
			+ "error=DUPLICATE_CONFLICT" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "matched_by=";
	КонецЕсли;
	
	Кандидаты = Новый Соответствие;
	ДобавитьКандидата(Кандидаты, НайденныеПоID, "id");
	ДобавитьКандидата(Кандидаты, НайденныеПоUID, "uid");
	
	Если Кандидаты.Количество() > 1 Тогда
		Возврат "ok=0" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "ref=" + Символы.ПС
			+ "error=DUPLICATE_CONFLICT" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "matched_by=";
	КонецЕсли;
	
	Если Кандидаты.Количество() = 0 Тогда
		Возврат "ok=0" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "ref=" + Символы.ПС
			+ "error=" + Символы.ПС
			+ "retryable=1" + Символы.ПС
			+ "matched_by=";
	КонецЕсли;
	
	Ссылка = Неопределено;
	Источники = "";
	Для Каждого Пара Из Кандидаты Цикл
		Ссылка = Пара.Ключ;
		Источники = Пара.Значение;
	КонецЦикла;
	
	Возврат "ok=1" + Символы.ПС
		+ "present=1" + Символы.ПС
		+ "ref=" + Строка(Ссылка.УникальныйИдентификатор()) + Символы.ПС
		+ "error=" + Символы.ПС
		+ "retryable=0" + Символы.ПС
		+ "matched_by=" + Источники;
	
КонецФункции

// Создание или привязка внешних ключей под управляемой блокировкой.
// Повторный create с тем же id/uid после успешной привязки даёт update, не вторую карточку.
//
// Параметры:
//  ВнешнийID, ВнешнийUID, РегНомер, КПП - ключи снимка;
//  КодНовойКарточки - код элемента при result=create; пустой — автонумерация УстановитьНовыйКод.
//
Функция ПривязатьВнешниеКлючи(ВнешнийID, ВнешнийUID, РегНомер, КПП, КодНовойКарточки = "") Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьКлючиИдентичности();
		РазрешениеСтрока = РазрешитьКонтрагента(ВнешнийID, ВнешнийUID, РегНомер, КПП);
		Разрешение = РазобратьОтчетРазрешения(РазрешениеСтрока);
		
		Если Разрешение.Результат = "conflict" Тогда
			ЗафиксироватьТранзакцию();
			Возврат "ok=0" + Символы.ПС
				+ "action=conflict" + Символы.ПС
				+ "error=DUPLICATE_CONFLICT" + Символы.ПС
				+ "ref=" + Разрешение.СсылкаСтрокой + Символы.ПС
				+ "written=0";
		КонецЕсли;
		
		Если Разрешение.Результат = "create" Тогда
			ИмяКарточки = ?(ЗначениеЗаполнено(КодНовойКарточки), "KFK " + КодНовойКарточки, "KFK");
			Запись = ЗаписатьТестовуюКарточку(
				КодНовойКарточки,
				ИмяКарточки,
				ВнешнийID,
				ВнешнийUID,
				РегНомер,
				КПП);
			СсылкаСтрокой = ЗначениеПоляОтчета(Запись, "ref");
			КодЗаписи = ЗначениеПоляОтчета(Запись, "code");
			ЗафиксироватьТранзакцию();
			Возврат "ok=1" + Символы.ПС
				+ "action=create" + Символы.ПС
				+ "error=" + Символы.ПС
				+ "ref=" + СсылкаСтрокой + Символы.ПС
				+ "code=" + КодЗаписи + Символы.ПС
				+ "written=1";
		КонецЕсли;
		
		Если Разрешение.Результат = "bind" Или Разрешение.Результат = "update" Тогда
			Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Разрешение.СсылкаСтрокой));
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				ВызватьИсключение "Не найдена карточка " + Разрешение.СсылкаСтрокой;
			КонецЕсли;
			Если ВнешнийID <> Неопределено И ВнешнийID <> Null И ВнешнийID > 0 Тогда
				Объект.KFK_ВнешнийID = ВнешнийID;
			КонецЕсли;
			Если ВнешнийUID <> Неопределено И ВнешнийUID <> Null И ЗначениеЗаполнено(Строка(ВнешнийUID)) Тогда
				Объект.KFK_ВнешнийUID = СокрЛП(Строка(ВнешнийUID));
			КонецЕсли;
			Объект.ДополнительныеСвойства.Вставить("KFK_ЗаписьОбменом", Истина);
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
			ЗафиксироватьТранзакцию();
			Возврат "ok=1" + Символы.ПС
				+ "action=" + Разрешение.Результат + Символы.ПС
				+ "error=" + Символы.ПС
				+ "ref=" + Разрешение.СсылкаСтрокой + Символы.ПС
				+ "written=1";
		КонецЕсли;
		
		ВызватьИсключение "Неизвестный результат разрешения: " + Разрешение.Результат;

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Разовое заполнение uid портала у старых контрагентов РФ перед запуском (вопрос Q13, решение заказчика 20.11.2026).
// Старые карточки портал получил из 1С РФ, поэтому uid портала равен GUID ссылки карточки.
// Записывает только KFK_ВнешнийUID = GUID ссылки у карточек с пустым KFK_ВнешнийUID (не группы, без пометки удаления).
// Карточку, чей GUID уже записан в KFK_ВнешнийUID другой карточки, пропускает как конфликт.
// Повторный вызов продолжает с ещё не заполненных карточек. Только для РФ: в КЗ GUID карточек не равен uid портала.
//
// Параметры:
//  ТолькоПроверка - Булево - Истина: ничего не записывать, только посчитать.
//  Лимит - Число - сколько карточек обработать за вызов; 0 - все.
//
// Возвращаемое значение:
//  Строка - filled=N;conflict=N;errors=N;left=N;conflicts=<GUID через запятую, до 50>;error_refs=<GUID, до 50>
//   filled - записано (в режиме проверки - будет записано); left - карточек без uid после вызова.
//
Функция ЗаполнитьВнешнийUIDПоGUID(ТолькоПроверка = Истина, Лимит = 0) Экспорт

	// Занятые uid читаются заранее: их немного, а GUID строкой в запросе не получить.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.KFK_ВнешнийUID КАК KFK_ВнешнийUID
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.KFK_ВнешнийUID <> """"";
	Занятые = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Занятые.Вставить(НРег(СокрЛП(Выборка.KFK_ВнешнийUID)), Истина);
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ" + ?(Лимит > 0, " ПЕРВЫЕ " + Формат(Лимит, "ЧГ="), "") + "
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.KFK_ВнешнийUID = """"
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И НЕ Контрагенты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.Ссылка";

	Заполнено = 0;
	Конфликтов = 0;
	Ошибок = 0;
	СписокКонфликтов = Новый Массив;
	СписокОшибок = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		UID = НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Если Занятые.Получить(UID) <> Неопределено Тогда
			Конфликтов = Конфликтов + 1;
			Если СписокКонфликтов.Количество() < 50 Тогда
				СписокКонфликтов.Добавить(UID);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Не ТолькоПроверка Тогда
			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Объект.KFK_ВнешнийUID = UID;
				// Меняется только ключ обмена из расширения: бизнес-обработчики записи не нужны,
				// а регистрация в планах обмена разослала бы изменение всех карточек в другие базы.
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
				Объект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
				Объект.Записать();
			Исключение
				// Карточка может быть занята пользователем: остальные заполняются, эта - при повторном вызове.
				Ошибок = Ошибок + 1;
				Если СписокОшибок.Количество() < 50 Тогда
					СписокОшибок.Добавить(UID);
				КонецЕсли;
				ЗаписьЖурналаРегистрации("Kafka.Identity.FillUID", УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.Контрагенты, Выборка.Ссылка,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		Занятые.Вставить(UID, Истина);
		Заполнено = Заполнено + 1;
	КонецЦикла;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.KFK_ВнешнийUID = """"
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И НЕ Контрагенты.ПометкаУдаления";
	Осталось = Запрос.Выполнить().Выгрузить()[0].Количество;

	Возврат "filled=" + Формат(Заполнено, "ЧН=0; ЧГ=")
		+ ";conflict=" + Формат(Конфликтов, "ЧН=0; ЧГ=")
		+ ";errors=" + Формат(Ошибок, "ЧН=0; ЧГ=")
		+ ";left=" + Формат(Осталось, "ЧН=0; ЧГ=")
		+ ";conflicts=" + СтрСоединить(СписокКонфликтов, ",")
		+ ";error_refs=" + СтрСоединить(СписокОшибок, ",");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПоВнешнемуID(ВнешнийID)
	
	Результат = Новый Массив;
	Если ВнешнийID = Неопределено Или ВнешнийID = Null Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ВнешнийID) <> Тип("Число") Или ВнешнийID < 1 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
