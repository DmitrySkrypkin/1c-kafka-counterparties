#Область ПрограммныйИнтерфейс

// Независимый поиск контрагента по внешнему id, uid и паре reg_number+kpp (ИНН+КПП).
// Результаты сравниваются без записи бизнес-данных.
//
// Параметры:
//  ВнешнийID - Число, Неопределено - body id портала;
//  ВнешнийUID - Строка, Неопределено - body uid;
//  РегНомер - Строка, Неопределено - body reg_number (ИНН);
//  КПП - Строка, Неопределено - body kpp.
//
// Возвращаемое значение:
//  Строка - result=create|update|bind|conflict;matched_by=...;ref=...;error=...;counts=...
//
Функция РазрешитьКонтрагента(ВнешнийID = Неопределено, ВнешнийUID = Неопределено, РегНомер = Неопределено, КПП = Неопределено) Экспорт
	
	НайденныеПоID = НайтиПоВнешнемуID(ВнешнийID);
	НайденныеПоUID = НайтиПоВнешнемуUID(ВнешнийUID);
	НайденныеПоРег = НайтиПоРегНомеруИКПП(РегНомер, КПП);
	
	Если НайденныеПоID.Количество() > 1
		Или НайденныеПоUID.Количество() > 1
		Или НайденныеПоРег.Количество() > 1 Тогда
		Возврат ОтчетРазрешения("conflict", "", "", "DUPLICATE_CONFLICT",
			НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	КонецЕсли;
	
	Кандидаты = Новый Соответствие;
	ДобавитьКандидата(Кандидаты, НайденныеПоID, "id");
	ДобавитьКандидата(Кандидаты, НайденныеПоUID, "uid");
	ДобавитьКандидата(Кандидаты, НайденныеПоРег, "reg");
	
	Если Кандидаты.Количество() > 1 Тогда
		Возврат ОтчетРазрешения("conflict", "", "", "DUPLICATE_CONFLICT",
			НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	КонецЕсли;
	
	Если Кандидаты.Количество() = 0 Тогда
		Возврат ОтчетРазрешения("create", "", "", "",
			НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	КонецЕсли;
	
	Ссылка = Неопределено;
	Источники = "";
	Для Каждого Пара Из Кандидаты Цикл
		Ссылка = Пара.Ключ;
		Источники = Пара.Значение;
	КонецЦикла;
	
	ЕстьВнешнийКлюч = НайденныеПоID.Количество() > 0 Или НайденныеПоUID.Количество() > 0;
	Если ЕстьВнешнийКлюч Тогда
		Возврат ОтчетРазрешения("update", Источники, Строка(Ссылка.УникальныйИдентификатор()), "",
			НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	КонецЕсли;
	
	Возврат ОтчетРазрешения("bind", Источники, Строка(Ссылка.УникальныйИдентификатор()), "",
		НайденныеПоID, НайденныеПоUID, НайденныеПоРег);
	
КонецФункции

// Тестовая запись карточки с внешними ключами и ИНН/КПП. Только для verification.
//
Функция ЗаписатьТестовуюКарточку(Код, Наименование, ВнешнийID, ВнешнийUID, РегНомер, КПП) Экспорт
	
	Если Не ЗначениеЗаполнено(Код) Тогда
		ВызватьИсключение "Код тестовой карточки обязателен";
	КонецЕсли;
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(Код);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
		Объект.Код = Код;
	КонецЕсли;
	
	Объект.Наименование = Наименование;
	Объект.KFK_ВнешнийID = ?(ВнешнийID = Неопределено, 0, ВнешнийID);
	Объект.KFK_ВнешнийUID = ?(ВнешнийUID = Неопределено, "", Строка(ВнешнийUID));
	Объект.ИНН = ?(РегНомер = Неопределено, "", Строка(РегНомер));
	Объект.КПП = ?(КПП = Неопределено, "", Строка(КПП));
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат "ref=" + Строка(Объект.Ссылка.УникальныйИдентификатор()) + Символы.ПС
		+ "code=" + Код;
	
КонецФункции

// Удаление тестовой карточки по коду.
//
Функция УдалитьТестовуюКарточку(Код) Экспорт
	
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(Код);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "deleted=0";
	КонецЕсли;
	
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Удалить();
	Возврат "deleted=1";
	
КонецФункции

// Разрешение head_contragent по внешним id/uid без создания заглушки.
// Отсутствие головы — retryable (терминальный код выставляет планировщик после исчерпания попыток).
//
// Параметры:
//  ВнешнийID - Число, Неопределено;
//  ВнешнийUID - Строка, Неопределено.
//
// Возвращаемое значение:
//  Строка - ok=1|0;present=0|1;ref=...;error=...;retryable=0|1;matched_by=...
//
Функция РазрешитьГолову(ВнешнийID = Неопределено, ВнешнийUID = Неопределено) Экспорт
	
	ЕстьID = ВнешнийID <> Неопределено И ВнешнийID <> Null И ТипЗнч(ВнешнийID) = Тип("Число") И ВнешнийID > 0;
	ЕстьUID = ВнешнийUID <> Неопределено И ВнешнийUID <> Null И ЗначениеЗаполнено(СокрЛП(Строка(ВнешнийUID)));
	Если Не ЕстьID И Не ЕстьUID Тогда
		Возврат "ok=1" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "ref=" + Символы.ПС
			+ "error=" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "matched_by=";
	КонецЕсли;
	
	НайденныеПоID = НайтиПоВнешнемуID(?(ЕстьID, ВнешнийID, Неопределено));
	НайденныеПоUID = НайтиПоВнешнемуUID(?(ЕстьUID, ВнешнийUID, Неопределено));
	
	Если НайденныеПоID.Количество() > 1 Или НайденныеПоUID.Количество() > 1 Тогда
		Возврат "ok=0" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "ref=" + Символы.ПС
			+ "error=DUPLICATE_CONFLICT" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "matched_by=";
	КонецЕсли;
	
	Кандидаты = Новый Соответствие;
	ДобавитьКандидата(Кандидаты, НайденныеПоID, "id");
	ДобавитьКандидата(Кандидаты, НайденныеПоUID, "uid");
	
	Если Кандидаты.Количество() > 1 Тогда
		Возврат "ok=0" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "ref=" + Символы.ПС
			+ "error=DUPLICATE_CONFLICT" + Символы.ПС
			+ "retryable=0" + Символы.ПС
			+ "matched_by=";
	КонецЕсли;
	
	Если Кандидаты.Количество() = 0 Тогда
		Возврат "ok=0" + Символы.ПС
			+ "present=0" + Символы.ПС
			+ "ref=" + Символы.ПС
			+ "error=" + Символы.ПС
			+ "retryable=1" + Символы.ПС
			+ "matched_by=";
	КонецЕсли;
	
	Ссылка = Неопределено;
	Источники = "";
	Для Каждого Пара Из Кандидаты Цикл
		Ссылка = Пара.Ключ;
		Источники = Пара.Значение;
	КонецЦикла;
	
	Возврат "ok=1" + Символы.ПС
		+ "present=1" + Символы.ПС
		+ "ref=" + Строка(Ссылка.УникальныйИдентификатор()) + Символы.ПС
		+ "error=" + Символы.ПС
		+ "retryable=0" + Символы.ПС
		+ "matched_by=" + Источники;
	
КонецФункции

// Создание или привязка внешних ключей под управляемой блокировкой.
// Повторный create с тем же id/uid после успешной привязки даёт update, не вторую карточку.
//
// Параметры:
//  ВнешнийID, ВнешнийUID, РегНомер, КПП - ключи снимка;
//  КодНовойКарточки - код элемента при result=create (обязателен для создания).
//
Функция ПривязатьВнешниеКлючи(ВнешнийID, ВнешнийUID, РегНомер, КПП, КодНовойКарточки = "") Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьКлючиИдентичности();
		РазрешениеСтрока = РазрешитьКонтрагента(ВнешнийID, ВнешнийUID, РегНомер, КПП);
		Разрешение = РазобратьОтчетРазрешения(РазрешениеСтрока);
		
		Если Разрешение.Результат = "conflict" Тогда
			ЗафиксироватьТранзакцию();
			Возврат "ok=0" + Символы.ПС
				+ "action=conflict" + Символы.ПС
				+ "error=DUPLICATE_CONFLICT" + Символы.ПС
				+ "ref=" + Разрешение.СсылкаСтрокой + Символы.ПС
				+ "written=0";
		КонецЕсли;
		
		Если Разрешение.Результат = "create" Тогда
			Если Не ЗначениеЗаполнено(КодНовойКарточки) Тогда
				ВызватьИсключение "Для create нужен КодНовойКарточки";
			КонецЕсли;
			Запись = ЗаписатьТестовуюКарточку(
				КодНовойКарточки,
				"KFK " + КодНовойКарточки,
				ВнешнийID,
				ВнешнийUID,
				РегНомер,
				КПП);
			СсылкаСтрокой = ЗначениеПоляОтчета(Запись, "ref");
			ЗафиксироватьТранзакцию();
			Возврат "ok=1" + Символы.ПС
				+ "action=create" + Символы.ПС
				+ "error=" + Символы.ПС
				+ "ref=" + СсылкаСтрокой + Символы.ПС
				+ "written=1";
		КонецЕсли;
		
		Если Разрешение.Результат = "bind" Или Разрешение.Результат = "update" Тогда
			Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Разрешение.СсылкаСтрокой));
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				ВызватьИсключение "Не найдена карточка " + Разрешение.СсылкаСтрокой;
			КонецЕсли;
			Если ВнешнийID <> Неопределено И ВнешнийID <> Null И ВнешнийID > 0 Тогда
				Объект.KFK_ВнешнийID = ВнешнийID;
			КонецЕсли;
			Если ВнешнийUID <> Неопределено И ВнешнийUID <> Null И ЗначениеЗаполнено(Строка(ВнешнийUID)) Тогда
				Объект.KFK_ВнешнийUID = СокрЛП(Строка(ВнешнийUID));
			КонецЕсли;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
			ЗафиксироватьТранзакцию();
			Возврат "ok=1" + Символы.ПС
				+ "action=" + Разрешение.Результат + Символы.ПС
				+ "error=" + Символы.ПС
				+ "ref=" + Разрешение.СсылкаСтрокой + Символы.ПС
				+ "written=1";
		КонецЕсли;
		
		ВызватьИсключение "Неизвестный результат разрешения: " + Разрешение.Результат;
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПоВнешнемуID(ВнешнийID)
	
	Результат = Новый Массив;
	Если ВнешнийID = Неопределено Или ВнешнийID = Null Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ВнешнийID) <> Тип("Число") Или ВнешнийID < 1 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.KFK_ВнешнийID = &ВнешнийID
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И НЕ Контрагенты.ЭтоГруппа";
	Запрос.УстановитьПараметр("ВнешнийID", ВнешнийID);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиПоВнешнемуUID(ВнешнийUID)
	
	Результат = Новый Массив;
	Если ВнешнийUID = Неопределено Или ВнешнийUID = Null Или Не ЗначениеЗаполнено(Строка(ВнешнийUID)) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.KFK_ВнешнийUID = &ВнешнийUID
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И НЕ Контрагенты.ЭтоГруппа";
	Запрос.УстановитьПараметр("ВнешнийUID", СокрЛП(Строка(ВнешнийUID)));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиПоРегНомеруИКПП(РегНомер, КПП)
	
	Результат = Новый Массив;
	Если РегНомер = Неопределено Или РегНомер = Null Или Не ЗначениеЗаполнено(СокрЛП(Строка(РегНомер))) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИНН = СокрЛП(Строка(РегНомер));
	ЗначениеКПП = "";
	Если КПП <> Неопределено И КПП <> Null Тогда
		ЗначениеКПП = СокрЛП(Строка(КПП));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ЗначениеКПП) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.КПП = &КПП
		|	И НЕ Контрагенты.ПометкаУдаления
		|	И НЕ Контрагенты.ЭтоГруппа";
		Запрос.УстановитьПараметр("КПП", ЗначениеКПП);
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И (Контрагенты.КПП = """" ИЛИ Контрагенты.КПП ЕСТЬ NULL)
		|	И НЕ Контрагенты.ПометкаУдаления
		|	И НЕ Контрагенты.ЭтоГруппа";
	КонецЕсли;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКандидата(Кандидаты, Найденные, ИмяИсточника)
	
	Если Найденные.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Найденные[0];
	Текущие = Кандидаты.Получить(Ссылка);
	Если Текущие = Неопределено Тогда
		Кандидаты.Вставить(Ссылка, ИмяИсточника);
	ИначеЕсли СтрНайти("," + Текущие + ",", "," + ИмяИсточника + ",") = 0 Тогда
		Кандидаты.Вставить(Ссылка, Текущие + "," + ИмяИсточника);
	КонецЕсли;
	
КонецПроцедуры

Функция ОтчетРазрешения(Результат, Источники, СсылкаСтрокой, КодОшибки, ПоID, ПоUID, ПоРег)
	
	Возврат "result=" + Результат + Символы.ПС
		+ "matched_by=" + Источники + Символы.ПС
		+ "ref=" + СсылкаСтрокой + Символы.ПС
		+ "error=" + КодОшибки + Символы.ПС
		+ "count_id=" + Формат(ПоID.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "count_uid=" + Формат(ПоUID.Количество(), "ЧН=0; ЧГ=") + Символы.ПС
		+ "count_reg=" + Формат(ПоРег.Количество(), "ЧН=0; ЧГ=");
	
КонецФункции

Процедура ЗаблокироватьКлючиИдентичности()
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.Контрагенты");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
КонецПроцедуры

Функция РазобратьОтчетРазрешения(Отчет)
	
	Результат = Новый Структура("Результат, СсылкаСтрокой, Ошибка", "", "", "");
	Для Каждого СтрокаОтчета Из СтрРазделить(Строка(Отчет), Символы.ПС, Ложь) Цикл
		Индекс = СтрНайти(СтрокаОтчета, "=");
		Если Индекс < 2 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Лев(СтрокаОтчета, Индекс - 1);
		Значение = Сред(СтрокаОтчета, Индекс + 1);
		Если Ключ = "result" Тогда
			Результат.Результат = Значение;
		ИначеЕсли Ключ = "ref" Тогда
			Результат.СсылкаСтрокой = Значение;
		ИначеЕсли Ключ = "error" Тогда
			Результат.Ошибка = Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеПоляОтчета(Отчет, ИмяПоля)
	
	Префикс = ИмяПоля + "=";
	Для Каждого СтрокаОтчета Из СтрРазделить(Строка(Отчет), Символы.ПС, Ложь) Цикл
		Если СтрНачинаетсяС(СтрокаОтчета, Префикс) Тогда
			Возврат Сред(СтрокаОтчета, СтрДлина(Префикс) + 1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

