Функция НайтиКонсьюмерПоИдентификатору(Идентификатор)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Консьюмеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.KFK_Консьюмеры КАК Консьюмеры
	|ГДЕ
	|	Консьюмеры.Идентификатор = &Идентификатор
	|	И Консьюмеры.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.KFK_Консьюмеры.ПустаяСсылка();
	
КонецФункции

