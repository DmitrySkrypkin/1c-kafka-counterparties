	Если Не ЗначениеЗаполнено(ГруппаПотребителя) Тогда
		Возврат Справочники.KFK_Консьюмеры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат НайтиКонсьюмерПоИдентификатору(ГруппаПотребителя);
	
КонецФункции

Функция ВыборкаОжидающихСнимков(КодКонтура, Лимит)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=") + "
	|	Снимки.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСнимки КАК Снимки
	|ГДЕ
	|	Снимки.КодКонтура = &КодКонтура
	|	И (
	|		(Снимки.Состояние = ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияИсходящегоСнимка.pending)
	|			И Снимки.НеРаньше <= &Сейчас)
	|		ИЛИ (Снимки.Состояние = ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияИсходящегоСнимка.sending)
	|			И Снимки.АрендаДо < &Сейчас)
	|	)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Снимки.ДатаЗаписи,
	|	Снимки.ИдентификаторСообщения";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция ЕстьНезавершённыйСнимокКонтрагента(КодКонтура, Контрагент, ИсключитьИдентификаторСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Снимки.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСнимки КАК Снимки
	|ГДЕ
	|	Снимки.КодКонтура = &КодКонтура
	|	И Снимки.Контрагент = &Контрагент
	|	И Снимки.ИдентификаторСообщения <> &Исключить
	|	И Снимки.Состояние В (
	|		ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияИсходящегоСнимка.pending),
	|		ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияИсходящегоСнимка.sending),
	|		ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияИсходящегоСнимка.sent),
	|		ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияИсходящегоСнимка.started))";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Исключить", ИсключитьИдентификаторСообщения);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция НовыйВладелецАрендыСнимка()
	
	Возврат Лев("outbox-" + Строка(Новый УникальныйИдентификатор), 64);
	
КонецФункции

Функция СрокАрендыСнимкаСекунд(Настройки)
	
	Срок = 300;
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Настройки.Свойство("СрокАрендыИсходящегоСнимкаСекунд", Значение)
			И ТипЗнч(Значение) = Тип("Число")
			И Значение >= 1 Тогда
			Срок = Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Срок;
	
КонецФункции

Функция ЛимитЛокальныхСбоевСнимка(Настройки)
	
	Лимит = 5;
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Настройки.Свойство("МаксимумПопытокИсходящегоСнимка", Значение)
			И ТипЗнч(Значение) = Тип("Число")
			И Значение > Лимит Тогда
			Лимит = Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Лимит;
	
КонецФункции

Процедура ОчиститьАрендуСнимка(МенеджерЗаписи)
	
	МенеджерЗаписи.ВладелецОбработки = "";
	МенеджерЗаписи.АрендаДо = Дата(1, 1, 1);
	
КонецПроцедуры

Процедура ЗафиксироватьЛокальныйСбойСнимка(КодКонтура, ИдентификаторСообщения, Настройки, ТекстОшибки)
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ИсходящиеСнимки");
		ЭлементБлокировки.УстановитьЗначение("КодКонтура", КодКонтура);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КодКонтура = КодКонтура;
		МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			ИмяСостояния = ИмяСостоянияИсходящегоСнимка(МенеджерЗаписи.Состояние);
			Если ИмяСостояния = "pending" Или ИмяСостояния = "sending" Тогда
				НомерПопытки = МенеджерЗаписи.НомерПопытки + 1;
				МенеджерЗаписи.НомерПопытки = НомерПопытки;
				МенеджерЗаписи.Диагностика = Лев(СтрЗаменить(Строка(ТекстОшибки), Символы.ПС, " "), 500);
				ОчиститьАрендуСнимка(МенеджерЗаписи);
				
				Если НомерПопытки >= ЛимитЛокальныхСбоевСнимка(Настройки) Тогда
					МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.failed;
				Иначе
					МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.pending;
					МенеджерЗаписи.НеРаньше = ТекущаяДатаСеанса()
						+ РассчитатьЗадержкуПовтораПубликации(
							НомерПопытки,
							Настройки.БазоваяЗадержкаСекунд,
							Настройки.МаксимальнаяЗадержкаСекунд);
				КонецЕсли;
				
				МенеджерЗаписи.Записать();
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		// Локальный сбой учёта не должен ронять пачку повторно.
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьОжидающийСнимок(КодКонтура, ИдентификаторСообщения, Настройки, ПараметрыПубликации)
	
	ВладелецАренды = НовыйВладелецАрендыСнимка();
	СрокАренды = СрокАрендыСнимкаСекунд(Настройки);
	ТелоJSON = "";
	КлючКарточки = "";
	ИдентификаторКорреляции = "";
	НужнаПубликация = Ложь;
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ИсходящиеСнимки");
		ЭлементБлокировки.УстановитьЗначение("КодКонтура", КодКонтура);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КодКонтура = КодКонтура;
		МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
		МенеджерЗаписи.Прочитать();
		
		Сейчас = ТекущаяДатаСеанса();
		МожноВзятьPending = МенеджерЗаписи.Выбран()
			И МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.pending
			И МенеджерЗаписи.НеРаньше <= Сейчас;
		МожноЗабратьПросроченныйSending = МенеджерЗаписи.Выбран()
			И МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.sending
			И МенеджерЗаписи.АрендаДо < Сейчас;
		
		Если МожноВзятьPending Или МожноЗабратьПросроченныйSending Тогда
			Контрагент = МенеджерЗаписи.Контрагент;
			Если Не ЗначениеЗаполнено(Контрагент)
				Или ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ПометкаУдаления") = Истина
				Или Не ОбщегоНазначения.СсылкаСуществует(Контрагент) Тогда
				
				МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.failed;
				МенеджерЗаписи.Диагностика = "card_missing";
				ОчиститьАрендуСнимка(МенеджерЗаписи);
				МенеджерЗаписи.Записать();
			Иначе
				ОбеспечитьВнешниеUIDДетей(Контрагент);
				
				ОшибкаСбора = "";
				Попытка
					ТелоJSON = KFK_АдаптерКонтрагентовРФСервер.СобратьИсходящийСнимок(Контрагент);
				Исключение
					ОшибкаСбора = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
				
				Если ЗначениеЗаполнено(ОшибкаСбора) Тогда
					МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.failed;
					МенеджерЗаписи.Диагностика = Лев(СтрЗаменить(ОшибкаСбора, Символы.ПС, " "), 500);
					ОчиститьАрендуСнимка(МенеджерЗаписи);
					МенеджерЗаписи.Записать();
				Иначе
					КлючКарточки = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "KFK_ВнешнийUID")));
					ИдентификаторКорреляции = МенеджерЗаписи.ИдентификаторКорреляции;
					МенеджерЗаписи.Payload = ТелоJSON;
					МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.sending;
					МенеджерЗаписи.ВладелецОбработки = ВладелецАренды;
					МенеджерЗаписи.АрендаДо = Сейчас + СрокАренды;
					МенеджерЗаписи.Записать();
					НужнаПубликация = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Не НужнаПубликация Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОтправки = ОпубликоватьСнимокВKafka(
		КодКонтура,
		ИдентификаторСообщения,
		ИдентификаторКорреляции,
		КлючКарточки,
		ТелоJSON,
		Настройки,
		ПараметрыПубликации);
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ИсходящиеСнимки");
		ЭлементБлокировки.УстановитьЗначение("КодКонтура", КодКонтура);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КодКонтура = КодКонтура;
		МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран()
			И МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.sending
			И МенеджерЗаписи.ВладелецОбработки = ВладелецАренды Тогда
			
			Если РезультатОтправки.Успех Тогда
				МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.sent;
				МенеджерЗаписи.Диагностика = "";
				ОчиститьАрендуСнимка(МенеджерЗаписи);
				МенеджерЗаписи.Записать();
			Иначе
				НомерПопытки = МенеджерЗаписи.НомерПопытки + 1;
				МенеджерЗаписи.НомерПопытки = НомерПопытки;
				МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.pending;
				МенеджерЗаписи.НеРаньше = ТекущаяДатаСеанса()
					+ РассчитатьЗадержкуПовтораПубликации(
						НомерПопытки,
						Настройки.БазоваяЗадержкаСекунд,
						Настройки.МаксимальнаяЗадержкаСекунд);
				МенеджерЗаписи.Диагностика = Лев(СтрЗаменить(Строка(РезультатОтправки.Ошибка), Символы.ПС, " "), 500);
				ОчиститьАрендуСнимка(МенеджерЗаписи);
				МенеджерЗаписи.Записать();
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбеспечитьВнешниеUIDДетей(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец
	|	И НЕ БанковскиеСчета.ПометкаУдаления
	|	И (БанковскиеСчета.KFK_ВнешнийUID = """"
	|		ИЛИ БанковскиеСчета.KFK_ВнешнийUID ЕСТЬ NULL)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|	И НЕ ДоговорыКонтрагентов.ЭтоГруппа
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И (ДоговорыКонтрагентов.KFK_ВнешнийUID = """"
	|		ИЛИ ДоговорыКонтрагентов.KFK_ВнешнийUID ЕСТЬ NULL)";
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если ЗначениеЗаполнено(Объект.KFK_ВнешнийUID) Тогда
			Продолжить;
		КонецЕсли;
		Объект.KFK_ВнешнийUID = Строка(Объект.Ссылка.УникальныйИдентификатор());
		Объект.ДополнительныеСвойства.Вставить("KFK_ЗаписьОбменом", Истина);
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрыРеальнойПубликацииСнимков(КодКонтура, Настройки)
	
	Топик = СокрЛП(Строка(Настройки.ТопикВходящий));
	Если Не ЗначениеЗаполнено(Топик) Тогда
		Топик = "contragents";
	КонецЕсли;
	
	Брокер = ПервыйАктивныйБрокер();
	Если Не ЗначениеЗаполнено(Брокер) Тогда
		ВызватьИсключение "Нет активного элемента справочника KFK_Брокеры для публикации исходящих снимков";
	КонецЕсли;
	
	Параметры = Новый Соответствие;
	ПарольВКаталоге = ПарольБрокераИзКаталога(Брокер);
	Если Не ЗначениеЗаполнено(ПарольВКаталоге) Тогда
		ПарольОкружения = KFK_СекретыОкруженияСервер.ПарольKafkaДляПодключения();
		Если ЗначениеЗаполнено(ПарольОкружения) Тогда
			Параметры.Вставить("sasl.password", ПарольОкружения);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Топик", Топик);
	Результат.Вставить("Брокер", Брокер);
	Результат.Вставить("Параметры", Параметры);
	Результат.Вставить("КодОрганизации", КодОрганизацииКонтура(КодКонтура));
	Возврат Результат;
	
КонецФункции

Функция ПервыйАктивныйБрокер()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	KFK_Брокеры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.KFK_Брокеры КАК KFK_Брокеры
	|ГДЕ
	|	KFK_Брокеры.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	KFK_Брокеры.Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.KFK_Брокеры.ПустаяСсылка();
	
КонецФункции

Функция ПарольБрокераИзКаталога(Брокер)
	
	Для Каждого Параметр Из Брокер.ПараметрыПодключения Цикл
		Если НРег(СокрЛП(Параметр.Ключ)) = "sasl.password" И ЗначениеЗаполнено(Параметр.Значение) Тогда
			Возврат СокрЛП(Строка(Параметр.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция КодОрганизацииКонтура(КодКонтура)
	
	KFK_МаршрутизацияОрганизацийСервер.ОбеспечитьНачальныеЗаписи();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Маршруты.КодОрганизации КАК КодОрганизации
	|ИЗ
	|	РегистрСведений.KFK_МаршрутизацияОрганизаций КАК Маршруты
	|ГДЕ
	|	Маршруты.КодКонтура = &КодКонтура
	|	И Маршруты.Активен
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодОрганизации";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КодОрганизации;
	КонецЕсли;
	
	Если КодКонтура = Перечисления.KFK_КодыКонтуров.KZ Тогда
		Возврат 5;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

Функция ОпубликоватьСнимокВKafka(КодКонтура, ИдентификаторСообщения, ИдентификаторКорреляции, КлючКарточки, ТелоJSON, Настройки, ПараметрыПубликации)
	
	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	
	Если Не ЗначениеЗаполнено(КлючКарточки) Тогда
		Результат.Ошибка = "card_uid_missing";
		Возврат Результат;
	КонецЕсли;
	
	ЗаголовкиСтрокой = СобратьЗаголовкиИсходящегоСнимка(
		КодКонтура,
		ИдентификаторСообщения,
		ИдентификаторКорреляции,
		Настройки,
		ПараметрыПубликации.КодОрганизации);
	
	ПараметрыОтправки = Новый Структура;
	ПараметрыОтправки.Вставить("Топики", KFK_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыПубликации.Топик));
	ПараметрыОтправки.Вставить("Брокеры", KFK_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыПубликации.Брокер));
	ПараметрыОтправки.Вставить("Параметры", ПараметрыПубликации.Параметры);
	ПараметрыОтправки.Вставить("Синхронно", Истина);
	ПараметрыОтправки.Вставить("Партиция", 0);
	ПараметрыОтправки.Вставить("Ключ", КлючКарточки);
	ПараметрыОтправки.Вставить("Заголовки", ЗаголовкиСтрокой);
	ПараметрыОтправки.Вставить("КаталогЛогов", "");
	ПараметрыОтправки.Вставить("КоличествоСообщений", 1);
	
	Попытка
		KFK_Интеграция.Опубликовать(Неопределено, Строка(ТелоJSON), ПараметрыОтправки);
		Результат.Успех = Истина;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.Ошибка = Лев(СтрЗаменить(ТекстОшибки, Символы.ПС, " "), 150);
		Если Не ЗначениеЗаполнено(Результат.Ошибка) Тогда
			Результат.Ошибка = "kafka_unavailable";
		КонецЕсли;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция СобратьЗаголовкиИсходящегоСнимка(КодКонтура, ИдентификаторСообщения, ИдентификаторКорреляции, Настройки, КодОрганизации)
	
	Идентичность = KFK_НастройкиКонтуровСервер.ИдентичностьКонтура(КодКонтура);
	Версия = СокрЛП(Строка(Настройки.ВерсияИсходящегоКонтракта));
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Версия = "1.1.0";
	КонецЕсли;
	
	МеткаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - 62135596800000;
	Метка = Формат(Цел(МеткаМс / 1000), "ЧГ=");
	Если СтрДлина(Метка) <> 10 Тогда
		ВызватьИсключение "Некорректный timestamp-ms: " + Метка;
	КонецЕсли;
	
	Части = Новый Массив;
	Части.Добавить("sender," + Идентичность.Отправитель);
	Части.Добавить("correlation-id," + ИдентификаторКорреляции);
	Части.Добавить("timestamp-ms," + Метка);
	Части.Добавить("id," + ИдентификаторСообщения);
	Части.Добавить("type,contragent_created");
	Части.Добавить("version," + Версия);
	Части.Добавить("organization-id," + Формат(КодОрганизации, "ЧН=0; ЧГ="));
	
	Возврат СтрСоединить(Части, ";");
	
КонецФункции

Функция РассчитатьЗадержкуПовтораПубликации(НомерПопытки, БазоваяЗадержкаСекунд, МаксимальнаяЗадержкаСекунд)
	
	База = БазоваяЗадержкаСекунд;
	Если ТипЗнч(База) <> Тип("Число") Или База < 1 Тогда
		База = 60;
	КонецЕсли;
	
	Максимум = МаксимальнаяЗадержкаСекунд;
	Если ТипЗнч(Максимум) <> Тип("Число") Или Максимум < 1 Тогда
		Максимум = 120;
	КонецЕсли;
	
	Степень = НомерПопытки - 1;
	Если Степень < 0 Тогда
		Степень = 0;
	КонецЕсли;
	
	Задержка = База * Pow(2, Степень);
	Если Задержка > Максимум Тогда
		Возврат Максимум;
	КонецЕсли;
	
	Возврат Задержка;
	
КонецФункции

#КонецОбласти
