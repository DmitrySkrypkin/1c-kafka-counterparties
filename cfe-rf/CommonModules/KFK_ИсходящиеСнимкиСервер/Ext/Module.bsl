#Область ПрограммныйИнтерфейс

// Обработчик подписки ПередЗаписью для СправочникОбъект.Контрагенты.
// Для новой карточки (не группы), записанной не обменом, всегда задаёт новый uid и обнуляет id.
// Регистрация Outbox - только при включённом исходящем обмене контура RF.
//
// Параметры:
//  Источник - СправочникОбъект.Контрагенты - записываемый контрагент.
//  Отказ - Булево - признак отказа от записи.
//
Процедура ПередЗаписьюКонтрагента(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеЗаписьОбменом = Неопределено;
	Если Источник.ДополнительныеСвойства.Свойство("KFK_ЗаписьОбменом", ЗначениеЗаписьОбменом)
		И ЗначениеЗаписьОбменом Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНового = Источник.ПолучитьСсылкуНового();
	Если Не ЗначениеЗаполнено(СсылкаНового) Тогда
		СсылкаНового = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Источник.УстановитьСсылкуНового(СсылкаНового);
	КонецЕсли;
	
	Источник.KFK_ВнешнийUID = Строка(СсылкаНового.УникальныйИдентификатор());
	Источник.KFK_ВнешнийID = 0;
	
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтураПоставки());
	Если Настройки.ИсходящийОбменВключен Тогда
		Источник.ДополнительныеСвойства.Вставить("KFK_РегистрироватьИсходящий", Истина);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик подписки ПередЗаписью для СправочникОбъект.БанковскиеСчета.
// Для нового счёта, записанного не обменом, всегда задаёт новый uid и обнуляет id (без Outbox).
//
Процедура ПередЗаписьюБанковскогоСчета(Источник, Отказ) Экспорт
	
	СброситьВнешниеКлючиНовогоОбъекта(Источник, Отказ, Справочники.БанковскиеСчета);
	
КонецПроцедуры

// Обработчик подписки ПередЗаписью для СправочникОбъект.ДоговорыКонтрагентов.
// Для нового договора, записанного не обменом, всегда задаёт новый uid и обнуляет id (без Outbox).
//
Процедура ПередЗаписьюДоговораКонтрагента(Источник, Отказ) Экспорт
	
	СброситьВнешниеКлючиНовогоОбъекта(Источник, Отказ, Справочники.ДоговорыКонтрагентов);
	
КонецПроцедуры

// Обработчик подписки ПриЗаписи для СправочникОбъект.Контрагенты.
// По пометке ПередЗаписью создаёт одну запись KFK_ИсходящиеСнимки (pending) в той же транзакции.
//
// Параметры:
//  Источник - СправочникОбъект.Контрагенты - записанный контрагент.
//
Процедура ПриЗаписиКонтрагента(Источник) Экспорт
	
	РегистрироватьИсходящий = Неопределено;
	Если Не Источник.ДополнительныеСвойства.Свойство("KFK_РегистрироватьИсходящий", РегистрироватьИсходящий)
		Или Не РегистрироватьИсходящий Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтураПоставки());
	МоментЗаписи = ТекущаяДатаСеанса();
	
	МенеджерЗаписи = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтураПоставки();
	МенеджерЗаписи.ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи.Контрагент = Источник.Ссылка;
	МенеджерЗаписи.ИдентификаторКорреляции = Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.pending;
	МенеджерЗаписи.НеРаньше = МоментЗаписи + Настройки.ЗадержкаОтправкиСекунд;
	МенеджерЗаписи.НомерПопытки = 0;
	МенеджерЗаписи.Payload = "";
	МенеджерЗаписи.СообщенияПортала = "";
	МенеджерЗаписи.Диагностика = "";
	МенеджерЗаписи.ИсходнаяЗапись = "";
	МенеджерЗаписи.ДатаЗаписи = МоментЗаписи;
	МенеджерЗаписи.ВладелецОбработки = "";
	МенеджерЗаписи.АрендаДо = Дата(1, 1, 1);
	
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МенеджерЗаписи.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
	// Сброс пометки: в КЗ/РФ платформа может повторно вызвать ПриЗаписи в рамках одной записи.
	Источник.ДополнительныеСвойства.Вставить("KFK_РегистрироватьИсходящий", Ложь);
	
КонецПроцедуры

// Точка входа регламентного задания публикации исходящих снимков.
// Выбирает pending / просроченные sending, собирает тело 1.1.0 и публикует в ТопикВходящий вне транзакции.
//
Процедура ВыполнитьПубликациюОжидающих() Экспорт
	
	КодКонтура = КодКонтураПоставки();
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	Если Не Настройки.ИсходящийОбменВключен Тогда
		Возврат;
	КонецЕсли;
	
	Лимит = Настройки.РазмерПачки;
	Если ТипЗнч(Лимит) <> Тип("Число") Или Лимит < 1 Тогда
		Лимит = 100;
	КонецЕсли;
	
	ПараметрыПубликации = ПараметрыРеальнойПубликацииСнимков(КодКонтура, Настройки);
	Выборка = ВыборкаОжидающихСнимков(КодКонтура, Лимит);
	
	Пока Выборка.Следующий() Цикл
		Попытка
			ОбработатьОжидающийСнимок(КодКонтура, Выборка.ИдентификаторСообщения, Настройки, ПараметрыПубликации);
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗафиксироватьЛокальныйСбойСнимка(КодКонтура, Выборка.ИдентификаторСообщения, Настройки, ТекстОшибки);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Принимает статус портала (corp) по исходящему снимку: поглощающие терминалы pending|sent|started|sending → completed|failed.
// Неизвестный correlation-id, чужой sender и повтор/более старый статус - без изменения данных (идемпотентно).
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур поставки.
//  КартаЗаголовков - Соответствие - заголовки Kafka (sender, type, correlation-id, id).
//  ТелоСтрокой - Строка - JSON тела; для failed может содержать messages[].
//  Топик - Строка - топик статусов.
//  Раздел - Число - partition.
//  Смещение - Число - offset.
//
// Возвращаемое значение:
//  Строка - отчёт action=applied|noop|skip;state=...;reason=...
//
Функция ОбработатьСтатусПортала(КодКонтура, КартаЗаголовков, ТелоСтрокой, Топик, Раздел, Смещение) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Отправитель = НРег(СокрЛП(Строка(ЗначениеЗаголовка(КартаЗаголовков, "sender"))));
	ИдентификаторСообщения = СокрЛП(Строка(ЗначениеЗаголовка(КартаЗаголовков, "id")));
	ИдентификаторКорреляции = СокрЛП(Строка(ЗначениеЗаголовка(КартаЗаголовков, "correlation-id")));
	ТипСтатуса = НормализоватьТипСтатусаПортала(ЗначениеЗаголовка(КартаЗаголовков, "type"));
	ТопикСтрокой = ?(ЗначениеЗаполнено(Топик), Строка(Топик), "contragents.exchange");
	РазделЧисло = Число(Раздел);
	СмещениеЧисло = Число(Смещение);
	
	Если Отправитель <> "corp" Тогда
		Причина = ?(ЗначениеЗаполнено(Отправитель), Отправитель, "non_corp");
		Если ЗначениеЗаполнено(ИдентификаторСообщения) И ЗначениеЗаполнено(ИдентификаторКорреляции) Тогда
			KFK_ЖурналЭтаповСервер.ЗаписатьПропускКонтура(
				ЗначениеКонтура,
				ИдентификаторСообщения,
				ИдентификаторКорреляции,
				ТопикСтрокой,
				РазделЧисло,
				СмещениеЧисло,
				Причина);
		КонецЕсли;
		Возврат ОтчётСтатусаПортала("skip", "", Причина);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипСтатуса) Тогда
		Если ЗначениеЗаполнено(ИдентификаторСообщения) И ЗначениеЗаполнено(ИдентификаторКорреляции) Тогда
			KFK_ЖурналЭтаповСервер.ЗаписатьПропускКонтура(
				ЗначениеКонтура,
				ИдентификаторСообщения,
				ИдентификаторКорреляции,
				ТопикСтрокой,
				РазделЧисло,
				СмещениеЧисло,
				"unknown_status_type");
		КонецЕсли;
		Возврат ОтчётСтатусаПортала("skip", "", "unknown_status_type");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторКорреляции) Тогда
		Если ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
			KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
				ЗначениеКонтура,
				"filtered_out",
				"business",
				ИдентификаторСообщения,
				"-",
				ТопикСтрокой,
				РазделЧисло,
				СмещениеЧисло,
				0,
				0,
				"missing_correlation_id");
		КонецЕсли;
		Возврат ОтчётСтатусаПортала("skip", "", "missing_correlation_id");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ИдентификаторСообщения = ИдентификаторКорреляции;
	КонецЕсли;
	
	КлючСнимка = НайтиКлючИсходящегоСнимкаПоКорреляции(ЗначениеКонтура, ИдентификаторКорреляции);
	Если Не ЗначениеЗаполнено(КлючСнимка.ИдентификаторСообщения) Тогда
		KFK_ЖурналЭтаповСервер.ЗаписатьПропускКонтура(
			ЗначениеКонтура,
			ИдентификаторСообщения,
			ИдентификаторКорреляции,
			ТопикСтрокой,
			РазделЧисло,
			СмещениеЧисло,
			"unknown_correlation_id");
		Возврат ОтчётСтатусаПортала("skip", "", "unknown_correlation_id");
	КонецЕсли;
	
	Действие = "";
	ИмяТекущего = "";
	ИмяЦелевого = "";
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ИсходящиеСнимки");
		ЭлементБлокировки.УстановитьЗначение("КодКонтура", ЗначениеКонтура);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", КлючСнимка.ИдентификаторСообщения);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КодКонтура = ЗначениеКонтура;
		МенеджерЗаписи.ИдентификаторСообщения = КлючСнимка.ИдентификаторСообщения;
		МенеджерЗаписи.Прочитать();
		
		Если Не МенеджерЗаписи.Выбран() Тогда
			Действие = "skip_unknown";
		Иначе
			ТекущееСостояние = МенеджерЗаписи.Состояние;
			ИмяТекущего = ИмяСостоянияИсходящегоСнимка(ТекущееСостояние);
			ЦелевоеСостояние = СостояниеПоТипуСтатусаПортала(ТипСтатуса);
			ИмяЦелевого = ИмяСостоянияИсходящегоСнимка(ЦелевоеСостояние);
			
			Если Не ДопустимПереходСтатусаПортала(ИмяТекущего, ИмяЦелевого) Тогда
				Действие = "noop";
			Иначе
				МенеджерЗаписи.Состояние = ЦелевоеСостояние;
				Если ИмяЦелевого = "failed" Тогда
					МенеджерЗаписи.СообщенияПортала = ИзвлечьСообщенияПорталаИзТела(ТелоСтрокой);
				КонецЕсли;
				МенеджерЗаписи.Записать();
				
				KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
					ЗначениеКонтура,
					ИмяЦелевого,
					"business",
					ИдентификаторСообщения,
					ИдентификаторКорреляции,
					ТопикСтрокой,
					РазделЧисло,
					СмещениеЧисло,
					0,
					0,
					"portal_status:" + ИмяЦелевого);
				Действие = "applied";
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Действие = "skip_unknown" Тогда
		KFK_ЖурналЭтаповСервер.ЗаписатьПропускКонтура(
			ЗначениеКонтура,
			ИдентификаторСообщения,
			ИдентификаторКорреляции,
			ТопикСтрокой,
			РазделЧисло,
			СмещениеЧисло,
			"unknown_correlation_id");
		Возврат ОтчётСтатусаПортала("skip", "", "unknown_correlation_id");
	КонецЕсли;
	
	Если Действие = "noop" Тогда
		KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
			ЗначениеКонтура,
			"filtered_out",
			"business",
			ИдентификаторСообщения,
			ИдентификаторКорреляции,
			ТопикСтрокой,
			РазделЧисло,
			СмещениеЧисло,
			0,
			0,
			"stale_or_repeat:" + ИмяТекущего + "->" + ИмяЦелевого);
		Возврат ОтчётСтатусаПортала("noop", ИмяТекущего, "stale_or_repeat");
	КонецЕсли;
	
	Возврат ОтчётСтатусаПортала("applied", ИмяЦелевого, "");
	
КонецФункции

// COM/verification: те же правила, что ОбработатьСтатусПортала, но заголовки передаются строками.
//
Функция ОбработатьСтатусПорталаИзСтрок(КодКонтура, Отправитель, ТипСтатуса, ИдентификаторКорреляции, ИдентификаторСообщения, ТелоСтрокой, Топик = "contragents.exchange", Раздел = 0, Смещение = 0) Экспорт
	
	Карта = Новый Соответствие;
	Карта.Вставить("sender", Отправитель);
	Карта.Вставить("type", ТипСтатуса);
	Карта.Вставить("correlation-id", ИдентификаторКорреляции);
	Карта.Вставить("id", ИдентификаторСообщения);
	Возврат ОбработатьСтатусПортала(КодКонтура, Карта, ТелоСтрокой, Топик, Раздел, Смещение);
	
КонецФункции

// Создаёт при отсутствии элемент KFK_Консьюмеры на ТопикСтатусов с группой ГруппаПотребителяСтатусовПортала.
// Расписание и брокер копируются с основного консьюмера контура при наличии.
//
// Возвращаемое значение:
//  Строка - created=0|1;group=...;topic=...;name=...
//
Функция ОбеспечитьКонсьюмерСтатусовПортала() Экспорт
	
	КодКонтура = КодКонтураПоставки();
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	Группа = СокрЛП(Строка(Настройки.ГруппаПотребителяСтатусовПортала));
	Топик = СокрЛП(Строка(Настройки.ТопикСтатусов));
	Если Не ЗначениеЗаполнено(Группа) Тогда
		ВызватьИсключение "Не заполнена ГруппаПотребителяСтатусовПортала";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Топик) Тогда
		Топик = "contragents.exchange";
	КонецЕсли;
	
	Существующий = НайтиКонсьюмерПоИдентификатору(Группа);
	Если ЗначениеЗаполнено(Существующий) Тогда
		Возврат "created=0" + Символы.ПС
			+ "group=" + Группа + Символы.ПС
			+ "topic=" + Топик + Символы.ПС
			+ "name=" + Строка(Существующий);
	КонецЕсли;
	
	Брокер = Неопределено;
	РасписаниеХранилище = Неопределено;
	Таймаут = 500;
	Основной = НайтиОсновнойКонсьюмерКонтура(Настройки.ГруппаПотребителя);
	Если ЗначениеЗаполнено(Основной) Тогда
		Брокер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основной, "Брокер");
		Таймаут = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основной, "ТаймаутОжиданияСообщений");
		ОбъектОсновного = Основной.ПолучитьОбъект();
		РасписаниеХранилище = ОбъектОсновного.РасписаниеЗадания;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Брокер) Тогда
		Брокер = ПервыйАктивныйБрокер();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Брокер) Тогда
		ВызватьИсключение "Нет активного брокера для консьюмера статусов портала";
	КонецЕсли;
	
	ИмяКонтура = ?(КодКонтура = Перечисления.KFK_КодыКонтуров.KZ, "KZ", "RF");
	Элемент = Справочники.KFK_Консьюмеры.СоздатьЭлемент();
	Элемент.Наименование = ИмяКонтура + " exchange statuses (dev)";
	Элемент.Идентификатор = Группа;
	Элемент.Брокер = Брокер;
	Элемент.Активен = Истина;
	Элемент.ТаймаутОжиданияСообщений = ?(ТипЗнч(Таймаут) = Тип("Число") И Таймаут > 0, Таймаут, 500);
	Элемент.ПолучатьСообщенияДвоичнымиДанными = Ложь;
	Если РасписаниеХранилище <> Неопределено Тогда
		Элемент.РасписаниеЗадания = РасписаниеХранилище;
	Иначе
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораДней = 1;
		Расписание.ПериодПовтораВТечениеДня = 30;
		Элемент.РасписаниеЗадания = Новый ХранилищеЗначения(Расписание);
	КонецЕсли;
	
	СтрокаТопика = Элемент.Топики.Добавить();
	СтрокаТопика.Топик = Топик;
	
	ПараметрКоммита = Элемент.ПараметрыКонсьюмера.Добавить();
	ПараметрКоммита.Ключ = "enable.auto.commit";
	ПараметрКоммита.Значение = "false";
	ПараметрСброса = Элемент.ПараметрыКонсьюмера.Добавить();
	ПараметрСброса.Ключ = "auto.offset.reset";
	ПараметрСброса.Значение = "earliest";
	
	Элемент.Записать();
	
	Возврат "created=1" + Символы.ПС
		+ "group=" + Группа + Символы.ПС
		+ "topic=" + Топик + Символы.ПС
		+ "name=" + Элемент.Наименование;
	
КонецФункции

// Повторная отправка исходящего снимка: новая pending-запись; исходная переводится в superseded.
// Доступна для failed и для pending с ошибкой транспорта (непустая Диагностика).
// Тело собирается заново при публикации; Payload исходной записи не копируется.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур записи.
//  ИдентификаторСообщения - Строка - message id исходной записи Outbox.
//
// Возвращаемое значение:
//  Строка - отчёт ok=0|1;new_message_id=...;new_correlation_id=...;source=...;error=...
//
Функция ПовторитьОтправку(КодКонтура, ИдентификаторСообщения) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ИсходныйID = СокрЛП(Строка(ИдентификаторСообщения));
	Если Не ЗначениеЗаполнено(ИсходныйID) Тогда
		Возврат "ok=0" + Символы.ПС + "error=EMPTY_MESSAGE_ID";
	КонецЕсли;
	
	Отчёт = "";
	НовыйID = "";
	НоваяКорреляция = "";
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.KFK_ИсходящиеСнимки");
		ЭлементБлокировки.УстановитьЗначение("КодКонтура", ЗначениеКонтура);
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИсходныйID);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		МенеджерИсходной = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
		МенеджерИсходной.КодКонтура = ЗначениеКонтура;
		МенеджерИсходной.ИдентификаторСообщения = ИсходныйID;
		МенеджерИсходной.Прочитать();
		Если Не МенеджерИсходной.Выбран() Тогда
			Отчёт = "ok=0" + Символы.ПС + "error=NOT_FOUND" + Символы.ПС + "source=" + ИсходныйID;
		Иначе
			ИмяСостояния = ИмяСостоянияИсходящегоСнимка(МенеджерИсходной.Состояние);
			ЕстьОшибкаТранспорта = ЗначениеЗаполнено(СокрЛП(Строка(МенеджерИсходной.Диагностика)));
			Если ИмяСостояния <> "failed"
				И Не (ИмяСостояния = "pending" И ЕстьОшибкаТранспорта) Тогда
				Отчёт = "ok=0" + Символы.ПС
					+ "error=NOT_RETRYABLE" + Символы.ПС
					+ "state=" + ИмяСостояния + Символы.ПС
					+ "source=" + ИсходныйID;
			ИначеЕсли Не ЗначениеЗаполнено(МенеджерИсходной.Контрагент) Тогда
				Отчёт = "ok=0" + Символы.ПС
					+ "error=CARD_MISSING" + Символы.ПС
					+ "source=" + ИсходныйID;
			ИначеЕсли ЕстьНезавершённыйСнимокКонтрагента(ЗначениеКонтура, МенеджерИсходной.Контрагент, ИсходныйID) Тогда
				Отчёт = "ok=0" + Символы.ПС
					+ "error=UNFINISHED_EXISTS" + Символы.ПС
					+ "source=" + ИсходныйID;
			Иначе
				Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(ЗначениеКонтура);
				МоментЗаписи = ТекущаяДатаСеанса();
				НовыйID = Строка(Новый УникальныйИдентификатор);
				НоваяКорреляция = Строка(Новый УникальныйИдентификатор);
				
				МенеджерНовой = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
				МенеджерНовой.КодКонтура = ЗначениеКонтура;
				МенеджерНовой.ИдентификаторСообщения = НовыйID;
				МенеджерНовой.Контрагент = МенеджерИсходной.Контрагент;
				МенеджерНовой.ИдентификаторКорреляции = НоваяКорреляция;
				МенеджерНовой.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.pending;
				МенеджерНовой.НеРаньше = МоментЗаписи + Настройки.ЗадержкаОтправкиСекунд;
				МенеджерНовой.НомерПопытки = 0;
				МенеджерНовой.Payload = "";
				МенеджерНовой.СообщенияПортала = "";
				МенеджерНовой.Диагностика = "";
				МенеджерНовой.ИсходнаяЗапись = ИсходныйID;
				МенеджерНовой.ДатаЗаписи = МоментЗаписи;
				МенеджерНовой.ВладелецОбработки = "";
				МенеджерНовой.АрендаДо = Дата(1, 1, 1);
				
				МенеджерИсходной.Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.superseded;
				МенеджерИсходной.Диагностика = "superseded_by:" + НовыйID;
				МенеджерИсходной.ВладелецОбработки = "";
				МенеджерИсходной.АрендаДо = Дата(1, 1, 1);
				
				УстановитьПривилегированныйРежим(Истина);
				Попытка
					МенеджерНовой.Записать();
					МенеджерИсходной.Записать();
					УстановитьПривилегированныйРежим(Ложь);
				Исключение
					УстановитьПривилегированныйРежим(Ложь);
					ВызватьИсключение;
				КонецПопытки;
				
				Отчёт = "ok=1" + Символы.ПС
					+ "new_message_id=" + НовыйID + Символы.ПС
					+ "new_correlation_id=" + НоваяКорреляция + Символы.ПС
					+ "source=" + ИсходныйID + Символы.ПС
					+ "state=pending";
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Отчёт;
	
КонецФункции

// Очищает Payload и СообщенияПортала у записей KFK_ИсходящиеСнимки старше границы.
// Ключи, состояние и компактные поля сохраняются.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур.
//  Граница - Дата - записи с ДатаЗаписи строго раньше границы очищаются.
//
// Возвращаемое значение:
//  Число - количество очищенных записей.
//
Функция ОчиститьУстаревшийPayload(КодКонтура, Граница) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Снимки.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСнимки КАК Снимки
	|ГДЕ
	|	Снимки.КодКонтура = &КодКонтура
	|	И Снимки.ДатаЗаписи < &Граница";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Запрос.УстановитьПараметр("Граница", Граница);
	
	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КодКонтура = ЗначениеКонтура;
		МенеджерЗаписи.ИдентификаторСообщения = Выборка.ИдентификаторСообщения;
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			Продолжить;
		КонецЕсли;
		Если МенеджерЗаписи.ДатаЗаписи >= Граница Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(МенеджерЗаписи.Payload)
			И Не ЗначениеЗаполнено(МенеджерЗаписи.СообщенияПортала) Тогда
			Продолжить;
		КонецЕсли;
		
		МенеджерЗаписи.Payload = "";
		МенеджерЗаписи.СообщенияПортала = "";
		МенеджерЗаписи.Записать();
		Количество = Количество + 1;
		
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КодКонтураПоставки()
	
	Возврат Перечисления.KFK_КодыКонтуров.RF;
	
КонецФункции

Функция ЗначениеКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

Процедура СброситьВнешниеКлючиНовогоОбъекта(Источник, Отказ, МенеджерСправочника)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	// Группы иерархических справочников (ДоговорыКонтрагентов) не несут внешних ключей элемента.
	Если Источник.Метаданные().Иерархический И Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеЗаписьОбменом = Неопределено;
	Если Источник.ДополнительныеСвойства.Свойство("KFK_ЗаписьОбменом", ЗначениеЗаписьОбменом)
		И ЗначениеЗаписьОбменом Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНового = Источник.ПолучитьСсылкуНового();
	Если Не ЗначениеЗаполнено(СсылкаНового) Тогда
		СсылкаНового = МенеджерСправочника.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Источник.УстановитьСсылкуНового(СсылкаНового);
	КонецЕсли;
	
	Источник.KFK_ВнешнийUID = Строка(СсылкаНового.УникальныйИдентификатор());
	Источник.KFK_ВнешнийID = 0;
	
КонецПроцедуры

Функция ЗначениеЗаголовка(КартаЗаголовков, ИмяСвойства)
	
	Если ТипЗнч(КартаЗаголовков) = Тип("Соответствие") Тогда
		Возврат КартаЗаголовков.Получить(ИмяСвойства);
	КонецЕсли;
	
	Если ТипЗнч(КартаЗаголовков) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если КартаЗаголовков.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НормализоватьТипСтатусаПортала(ТипСтатуса)
	
	Имя = НРег(СокрЛП(Строка(ТипСтатуса)));
	Если Имя = "started" Или Имя = "contragent_exchange_started" Тогда
		Возврат "started";
	ИначеЕсли Имя = "completed" Или Имя = "contragent_exchange_completed" Тогда
		Возврат "completed";
	ИначеЕсли Имя = "failed" Или Имя = "contragent_exchange_failed" Тогда
		Возврат "failed";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СостояниеПоТипуСтатусаПортала(ТипСтатуса)
	
	Если ТипСтатуса = "started" Тогда
		Возврат Перечисления.KFK_СостоянияИсходящегоСнимка.started;
	ИначеЕсли ТипСтатуса = "completed" Тогда
		Возврат Перечисления.KFK_СостоянияИсходящегоСнимка.completed;
	ИначеЕсли ТипСтатуса = "failed" Тогда
		Возврат Перечисления.KFK_СостоянияИсходящегоСнимка.failed;
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный тип статуса портала: " + Строка(ТипСтатуса);
	
КонецФункции

Функция ИмяСостоянияИсходящегоСнимка(Состояние)
	
	Если Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.pending Тогда
		Возврат "pending";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.sending Тогда
		Возврат "sending";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.sent Тогда
		Возврат "sent";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.started Тогда
		Возврат "started";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.completed Тогда
		Возврат "completed";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.failed Тогда
		Возврат "failed";
	ИначеЕсли Состояние = Перечисления.KFK_СостоянияИсходящегоСнимка.superseded Тогда
		Возврат "superseded";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ДопустимПереходСтатусаПортала(ИмяТекущего, ИмяЦелевого)
	
	Если ИмяЦелевого = "started" Тогда
		Возврат ИмяТекущего = "pending" Или ИмяТекущего = "sent";
	КонецЕсли;
	
	Если ИмяЦелевого = "completed" Или ИмяЦелевого = "failed" Тогда
		Возврат ИмяТекущего = "pending"
			Или ИмяТекущего = "sent"
			Или ИмяТекущего = "started"
			Или ИмяТекущего = "sending";
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция НайтиКлючИсходящегоСнимкаПоКорреляции(КодКонтура, ИдентификаторКорреляции)
	
	Результат = Новый Структура("ИдентификаторСообщения", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Снимки.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСнимки КАК Снимки
	|ГДЕ
	|	Снимки.КодКонтура = &КодКонтура
	|	И (Снимки.ИдентификаторКорреляции = &Ключ
	|		ИЛИ Снимки.ИдентификаторСообщения = &Ключ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Снимки.ДатаЗаписи УБЫВ";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("Ключ", ИдентификаторКорреляции);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ИдентификаторСообщения = Выборка.ИдентификаторСообщения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьСообщенияПорталаИзТела(ТелоСтрокой)
	
	Если Не ЗначениеЗаполнено(ТелоСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Значение = KFK_ОбщегоНазначения.JSONВЗначение(Строка(ТелоСтрокой), , Ложь);
	Исключение
		Возврат Лев(Строка(ТелоСтрокой), 2000);
	КонецПопытки;
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Сообщения = Неопределено;
		Если Значение.Свойство("messages", Сообщения) Тогда
			Возврат KFK_ОбщегоНазначения.ЗначениеВJSON(Сообщения);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Сообщения = Значение.Получить("messages");
		Если Сообщения <> Неопределено Тогда
			Возврат KFK_ОбщегоНазначения.ЗначениеВJSON(Сообщения);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Лев(Строка(ТелоСтрокой), 2000);
	
КонецФункции

Функция ОтчётСтатусаПортала(Действие, Состояние, Причина)
	
	Возврат "action=" + Действие + Символы.ПС
		+ "state=" + Состояние + Символы.ПС
		+ "reason=" + Причина;
	
