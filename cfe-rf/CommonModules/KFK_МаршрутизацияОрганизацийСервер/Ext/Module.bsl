#Область ПрограммныйИнтерфейс

// Возвращает соответствие кода организации контуру.
// Если записей 1 и 5 ещё нет, создаёт их активными и не меняет уже существующие.
//
// Параметры:
//  КодОрганизации - Число - значение заголовка organization-id.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля КодОрганизации, КодКонтура, ИмяКонтура, Активен.
//                            Неопределено, если записи нет.
//
Функция ПрочитатьСоответствие(КодОрганизации) Экспорт
	
	ОбеспечитьНачальныеЗаписи();
	Возврат ПрочитатьЗапись(КодОрганизации);
	
КонецФункции

// Записывает или заменяет соответствие кода организации контуру.
// Тот же вызов принимает ручное изменение и будущее заполнение из топика организаций.
//
// Параметры:
//  КодОрганизации - Число - значение заголовка organization-id.
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  Активен - Булево - Ложь выключает код без удаления записи.
//
Процедура ЗаписатьСоответствие(КодОрганизации, КодКонтура, Активен = Истина) Экспорт
	
	ОбеспечитьНачальныеЗаписи();
	ЗаписатьЗапись(КодОрганизации, ЗначениеКодаКонтура(КодКонтура), Активен);
	
КонецПроцедуры

// Создаёт активные записи 1 (RF) и 5 (KZ), если таких кодов ещё нет.
// Выключенную запись повторный вызов не включает.
//
Процедура ОбеспечитьНачальныеЗаписи() Экспорт
	
	ОбеспечитьЗаписьЕслиОтсутствует(1, Перечисления.KFK_КодыКонтуров.RF);
	ОбеспечитьЗаписьЕслиОтсутствует(5, Перечисления.KFK_КодыКонтуров.KZ);
	
КонецПроцедуры

// Решает, принимает ли контур сообщение с заголовком organization-id.
// Пустой заголовок принимается как широковещание. Чужой, неизвестный и неактивный код не принимается.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - контур потребителя, RF или KZ.
//  ЗначениеЗаголовка - Строка - текст organization-id. Пустая строка означает, что заголовка нет.
//
// Возвращаемое значение:
//  Структура - Принять, Широковещание, Причина.
//              Причина: broadcast, accepted, foreign, unknown, inactive.
//
Функция РешениеМаршрута(КодКонтура, ЗначениеЗаголовка) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ТекстЗаголовка = СокрЛП(Строка(ЗначениеЗаголовка));
	
	Если Не ЗначениеЗаполнено(ТекстЗаголовка) Тогда
		Возврат ОписаниеРешения(Истина, Истина, "broadcast");
	КонецЕсли;
	
	Если Не ЭтоЦелоеНеотрицательное(ТекстЗаголовка) Тогда
		Возврат ОписаниеРешения(Ложь, Ложь, "unknown");
	КонецЕсли;
	
	Запись = ПрочитатьСоответствие(Число(ТекстЗаголовка));
	Если Запись = Неопределено Тогда
		Возврат ОписаниеРешения(Ложь, Ложь, "unknown");
	КонецЕсли;
	Если Не Запись.Активен Тогда
		Возврат ОписаниеРешения(Ложь, Ложь, "inactive");
	КонецЕсли;
	Если Запись.КодКонтура <> ЗначениеКонтура Тогда
		Возврат ОписаниеРешения(Ложь, Ложь, "foreign");
	КонецЕсли;
	
	Возврат ОписаниеРешения(Истина, Ложь, "accepted");
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбеспечитьЗаписьЕслиОтсутствует(КодОрганизации, КодКонтура)
	
	Если ПрочитатьЗапись(КодОрганизации) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьЗапись(КодОрганизации, КодКонтура, Истина);
	
КонецПроцедуры

Функция ПрочитатьЗапись(КодОрганизации)
	
	МенеджерЗаписи = РегистрыСведений.KFK_МаршрутизацияОрганизаций.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодОрганизации = КодОрганизации;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодОрганизации", МенеджерЗаписи.КодОрганизации);
	Результат.Вставить("КодКонтура", МенеджерЗаписи.КодКонтура);
	Результат.Вставить("ИмяКонтура", ИмяКонтура(МенеджерЗаписи.КодКонтура));
	Результат.Вставить("Активен", МенеджерЗаписи.Активен);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьЗапись(КодОрганизации, КодКонтура, Активен)
	
	НаборЗаписей = РегистрыСведений.KFK_МаршрутизацияОрганизаций.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КодОрганизации.Установить(КодОрганизации);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.КодОрганизации = КодОрганизации;
	НоваяЗапись.КодКонтура = КодКонтура;
	НоваяЗапись.Активен = Активен;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ЗначениеКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

Функция ОписаниеРешения(Принять, Широковещание, Причина)
	
	Результат = Новый Структура;
	Результат.Вставить("Принять", Принять);
	Результат.Вставить("Широковещание", Широковещание);
	Результат.Вставить("Причина", Причина);
	Возврат Результат;
	
КонецФункции

Функция ЭтоЦелоеНеотрицательное(Текст)
	
	Длина = СтрДлина(Текст);
	Если Длина = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Длина > 1 И Лев(Текст, 1) = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерСимвола = 1 По Длина Цикл
		Символ = Сред(Текст, НомерСимвола, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ИмяКонтура(КодКонтура)
	
	Если КодКонтура = Перечисления.KFK_КодыКонтуров.RF Тогда
		Возврат "RF";
	ИначеЕсли КодКонтура = Перечисления.KFK_КодыКонтуров.KZ Тогда
		Возврат "KZ";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

#КонецОбласти
