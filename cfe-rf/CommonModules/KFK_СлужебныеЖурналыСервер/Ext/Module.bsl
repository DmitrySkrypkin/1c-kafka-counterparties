#Область СлужебныеПроцедурыИФункции

Функция УдалитьКарантинСтарше(КодКонтура, Граница)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Карантин.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.KFK_Карантин КАК Карантин
	|ГДЕ
	|	Карантин.КодКонтура = &КодКонтура
	|	И Карантин.ДатаЗаписи < &Граница";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("Граница", Граница);
	
	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.KFK_Карантин.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗаписи = Выборка.ИдентификаторЗаписи;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

Функция КоличествоЗаписейРегистраПоСообщению(ИмяТаблицы, КодКонтура, ИдентификаторСообщения)
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	" + ИмяТаблицы + " КАК Данные
	|ГДЕ
	|	Данные.КодКонтура = &КодКонтура
	|	И Данные.ИдентификаторСообщения = &ИдентификаторСообщения";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция УдалитьАудитСтарше(КодКонтура, Граница)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Аудит.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.KFK_АудитСнимков КАК Аудит
	|ГДЕ
	|	Аудит.КодКонтура = &КодКонтура
	|	И Аудит.ДатаЗаписи < &Граница";
	Запрос.УстановитьПараметр("КодКонтура", КодКонтура);
	Запрос.УстановитьПараметр("Граница", Граница);
	
	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.KFK_АудитСнимков.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗаписи = Выборка.ИдентификаторЗаписи;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

Функция МоментЗаписи(ДатаЗаписи)
	
	Если ЗначениеЗаполнено(ДатаЗаписи) Тогда
		Возврат ДатаЗаписи;
	КонецЕсли;
	
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

Функция ОписаниеЗаписи(ИдентификаторЗаписи, КодКонтура, ДатаЗаписи)
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗаписи", ИдентификаторЗаписи);
	Результат.Вставить("КодКонтура", КодКонтура);
	Результат.Вставить("ДатаЗаписи", ДатаЗаписи);
	Возврат Результат;
	
КонецФункции

Функция ЗначениеКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

Функция ИдентификаторПригоден(Значение)
	
	Текст = СокрЛП(Строка(Значение));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(Текст) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Возврат Строка(Новый УникальныйИдентификатор(Текст)) <> "";
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

#КонецОбласти
