#Область ПрограммныйИнтерфейс

// Записывает технический карантин. Возвращает идентификатор созданной записи.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  Причина - Строка - краткая причина карантина.
//  ИдентификаторСообщения - Строка - message id, если его удалось прочитать.
//  ИдентификаторКорреляции - Строка - correlation-id, если его удалось прочитать.
//  Диагностика - Строка - текст без секретов.
//  ДатаЗаписи - Дата, Неопределено - момент записи; пустое значение заменяется текущей датой сеанса.
//
// Возвращаемое значение:
//  Структура - идентификатор записи, контур и дата.
//
Функция ЗаписатьКарантин(КодКонтура, Причина, ИдентификаторСообщения = "", ИдентификаторКорреляции = "", Диагностика = "", ДатаЗаписи = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Причина) Тогда
		ВызватьИсключение "Не заполнена причина карантина";
	КонецЕсли;
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Момент = МоментЗаписи(ДатаЗаписи);
	ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор());
	
	МенеджерЗаписи = РегистрыСведений.KFK_Карантин.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗаписи = ИдентификаторЗаписи;
	МенеджерЗаписи.КодКонтура = ЗначениеКонтура;
	МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
	МенеджерЗаписи.ИдентификаторКорреляции = ИдентификаторКорреляции;
	МенеджерЗаписи.Причина = Причина;
	МенеджерЗаписи.Диагностика = Диагностика;
	МенеджерЗаписи.ДатаЗаписи = Момент;
	МенеджерЗаписи.Записать();
	
	Возврат ОписаниеЗаписи(ИдентификаторЗаписи, ЗначениеКонтура, Момент);
	
КонецФункции

// Записывает предыдущий снимок для восстановления. Возвращает идентификатор записи.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - message id процесса.
//  СнимокДо - Строка - сериализованный предыдущий снимок.
//  ДатаЗаписи - Дата, Неопределено - момент записи; пустое значение заменяется текущей датой сеанса.
//
// Возвращаемое значение:
//  Структура - идентификатор записи, контур и дата.
//
// Число записей аудита по message id (для проверки отката транзакции).
//
// Возвращаемое значение:
//  Строка - count=N
//
Функция КоличествоАудитаСообщения(КодКонтура, ИдентификаторСообщения) Экспорт
	
	Возврат "count=" + Формат(КоличествоЗаписейРегистраПоСообщению(
		"РегистрСведений.KFK_АудитСнимков", КодКонтура, ИдентификаторСообщения), "ЧН=0; ЧГ=");
	
КонецФункции

// Число записей карантина по message id.
//
Функция КоличествоКарантинаСообщения(КодКонтура, ИдентификаторСообщения) Экспорт
	
	Возврат "count=" + Формат(КоличествоЗаписейРегистраПоСообщению(
		"РегистрСведений.KFK_Карантин", КодКонтура, ИдентификаторСообщения), "ЧН=0; ЧГ=");
	
КонецФункции

Функция ЗаписатьАудит(КодКонтура, ИдентификаторСообщения, СнимокДо, ДатаЗаписи = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		ВызватьИсключение "Не заполнен идентификатор сообщения";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СнимокДо) Тогда
		ВызватьИсключение "Не заполнен предыдущий снимок";
	КонецЕсли;
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Момент = МоментЗаписи(ДатаЗаписи);
	ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор());
	
	МенеджерЗаписи = РегистрыСведений.KFK_АудитСнимков.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗаписи = ИдентификаторЗаписи;
	МенеджерЗаписи.КодКонтура = ЗначениеКонтура;
	МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
	МенеджерЗаписи.СнимокДо = СнимокДо;
	МенеджерЗаписи.ДатаЗаписи = Момент;
	МенеджерЗаписи.Записать();
	
	Возврат ОписаниеЗаписи(ИдентификаторЗаписи, ЗначениеКонтура, Момент);
	
КонецФункции

// Удаляет карантин и аудит контура старше срока хранения аудита.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//
// Возвращаемое значение:
//  Структура - числа удаленных записей карантина и аудита.
//
Функция ОчиститьУстаревшие(КодКонтура) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(ЗначениеКонтура);
	Граница = ТекущаяДатаСеанса() - Настройки.СрокХраненияАудитаДней * 86400;
	
	Результат = Новый Структура;
	Результат.Вставить("УдаленоКарантина", УдалитьКарантинСтарше(ЗначениеКонтура, Граница));
	Результат.Вставить("УдаленоАудита", УдалитьАудитСтарше(ЗначениеКонтура, Граница));
	Возврат Результат;
	
КонецФункции

// Регламентная очистка raw Inbox, отправленного Outbox payload, сырого payload
// терминальных процессов, карантина и аудита по срокам retention контура.
// Tombstone процессов (ключ, хеш, состояние) не удаляется.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//
// Возвращаемое значение:
//  Структура - счетчики очистки: inbox, outbox, process_payload, quarantine, audit.
//
Функция ВыполнитьРегламентнуюОчистку(КодКонтура) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(ЗначениеКонтура);
	Сейчас = ТекущаяДатаСеанса();
	
	ГраницаВходящих = Сейчас - Настройки.СрокХраненияВходящихДней * 86400;
	ГраницаИсходящих = Сейчас - Настройки.СрокХраненияИсходящихДней * 86400;
	
	Журналы = ОчиститьУстаревшие(ЗначениеКонтура);
	
	Результат = Новый Структура;
	Результат.Вставить("inbox", KFK_ВходящиеСообщенияСервер.ОчиститьУстаревшие(ЗначениеКонтура, ГраницаВходящих));
	Результат.Вставить("outbox", KFK_ИсходящиеСтатусыСервер.ОчиститьУстаревшийPayload(ЗначениеКонтура, ГраницаИсходящих));
	Результат.Вставить("outbound_snapshots", KFK_ИсходящиеСнимкиСервер.ОчиститьУстаревшийPayload(ЗначениеКонтура, ГраницаИсходящих));
	Результат.Вставить("process_payload", KFK_ПроцессыОбменаСервер.ОчиститьУстаревшийСыройPayload(ЗначениеКонтура, ГраницаВходящих));
	Результат.Вставить("quarantine", Журналы.УдаленоКарантина);
	Результат.Вставить("audit", Журналы.УдаленоАудита);
	Результат.Вставить("УдаленоКарантина", Журналы.УдаленоКарантина);
	Результат.Вставить("УдаленоАудита", Журналы.УдаленоАудита);
	Возврат Результат;
	
КонецФункции

// Возвращает краткую диагностику, если message id или correlation-id непригодны.
// Пустая строка означает, что оба идентификатора пригодны (непустой UUID).
//
// Параметры:
//  ИдентификаторСообщения - Строка - header id.
//  ИдентификаторКорреляции - Строка - header correlation-id.
//
// Возвращаемое значение:
//  Строка - перечень проблем через ";", либо пустая строка.
//
Функция ДиагностикаБракованногоКонверта(ИдентификаторСообщения, ИдентификаторКорреляции) Экспорт
	
	Части = Новый Массив;
	Если Не ИдентификаторПригоден(ИдентификаторСообщения) Тогда
		Если ЗначениеЗаполнено(СокрЛП(Строка(ИдентификаторСообщения))) Тогда
			Части.Добавить("invalid-message-id");
		Иначе
			Части.Добавить("missing-message-id");
		КонецЕсли;
	КонецЕсли;
	Если Не ИдентификаторПригоден(ИдентификаторКорреляции) Тогда
		Если ЗначениеЗаполнено(СокрЛП(Строка(ИдентификаторКорреляции))) Тогда
			Части.Добавить("invalid-correlation-id");
		Иначе
			Части.Добавить("missing-correlation-id");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ";");
	
КонецФункции

// Кладёт бракованный envelope в карантин и пишет transport-ошибку в журнал этапов.
// Inbox, процесс и исходящий статус не создаются. Payload и секреты сюда не передаются.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ИдентификаторСообщения - Строка - извлечённый message id, может быть пустым.
//  ИдентификаторКорреляции - Строка - извлечённый correlation-id, может быть пустым.
//  Топик - Строка - имя топика.
//  Раздел - Число - partition.
//  Смещение - Число - offset.
//  Диагностика - Строка - итог ДиагностикаБракованногоКонверта; пустое значение вычисляется заново.
//
// Возвращаемое значение:
//  Структура - ИдентификаторЗаписи карантина, КодКонтура, ДатаЗаписи, Диагностика.
//
Функция ПоместитьБракованныйКонверт(КодКонтура, ИдентификаторСообщения = "", ИдентификаторКорреляции = "", Топик = "", Раздел = 0, Смещение = 0, Диагностика = "") Экспорт
	
	ТекстДиагностики = Диагностика;
	Если Не ЗначениеЗаполнено(ТекстДиагностики) Тогда
		ТекстДиагностики = ДиагностикаБракованногоКонверта(ИдентификаторСообщения, ИдентификаторКорреляции);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстДиагностики) Тогда
		ВызватьИсключение "Конверт не бракованный: идентификаторы пригодны";
	КонецЕсли;
	
	Карантин = ЗаписатьКарантин(
		КодКонтура,
		"broken-envelope",
		СокрЛП(Строка(ИдентификаторСообщения)),
		СокрЛП(Строка(ИдентификаторКорреляции)),
		ТекстДиагностики);
	
	KFK_ЖурналЭтаповСервер.ЗаписатьЭтап(
		КодКонтура,
		"error",
		"transport",
		СокрЛП(Строка(ИдентификаторСообщения)),
		СокрЛП(Строка(ИдентификаторКорреляции)),
		Топик,
		Раздел,
		Смещение,
		0,
		0,
		"broken-envelope");
	
	Карантин.Вставить("Диагностика", ТекстДиагностики);
	Возврат Карантин;
	
КонецФункции

// Возвращает запись карантина. Если записи нет, возвращает Неопределено.
//
// Параметры:
//  ИдентификаторЗаписи - Строка - ключ записи карантина.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля записи.
//
Функция ПрочитатьКарантин(ИдентификаторЗаписи) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.KFK_Карантин.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗаписи = ИдентификаторЗаписи;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = ОписаниеЗаписи(МенеджерЗаписи.ИдентификаторЗаписи, МенеджерЗаписи.КодКонтура, МенеджерЗаписи.ДатаЗаписи);
	Результат.Вставить("Причина", МенеджерЗаписи.Причина);
	Результат.Вставить("Диагностика", МенеджерЗаписи.Диагностика);
	Возврат Результат;
	
КонецФункции

// Возвращает запись аудита. Если записи нет, возвращает Неопределено.
//
// Параметры:
//  ИдентификаторЗаписи - Строка - ключ записи аудита.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля записи.
//
Функция ПрочитатьАудит(ИдентификаторЗаписи) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.KFK_АудитСнимков.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗаписи = ИдентификаторЗаписи;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = ОписаниеЗаписи(МенеджерЗаписи.ИдентификаторЗаписи, МенеджерЗаписи.КодКонтура, МенеджерЗаписи.ДатаЗаписи);
	Результат.Вставить("СнимокДо", МенеджерЗаписи.СнимокДо);
	Возврат Результат;
	
КонецФункции

