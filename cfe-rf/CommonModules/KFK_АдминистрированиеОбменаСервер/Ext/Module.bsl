#Область ПрограммныйИнтерфейс

// Режим: ordinary|service|diagnostic. Пустой — по ролям текущего пользователя.
// ordinary — отказ; service — метаданные без полного payload; diagnostic — полный payload.
//
Функция ПросмотретьInbox(ГруппаПотребителя, Топик, Раздел, Смещение, РежимПросмотра = "") Экспорт
	
	Режим = НормализоватьРежимПросмотра(РежимПросмотра);
	Если Режим = "ordinary" Тогда
		Возврат ОтчетОтказа("inbox");
	КонецЕсли;
	
	Запись = KFK_ВходящиеСообщенияСервер.ПрочитатьВходящее(ГруппаПотребителя, Топик, Раздел, Смещение);
	Если Запись = Неопределено Тогда
		Возврат "ok=0" + Символы.ПС + "error=NOT_FOUND" + Символы.ПС + "scope=inbox";
	КонецЕсли;
	
	ПолныйPayload = (Режим = "diagnostic");
	Тело = Строка(Запись.Тело);
	Заголовки = МаскироватьСекретыВТексте(Строка(Запись.Заголовки));
	
	Возврат "ok=1" + Символы.ПС
		+ "scope=inbox" + Символы.ПС
		+ "mode=" + Режим + Символы.ПС
		+ "topic=" + Строка(Запись.Топик) + Символы.ПС
		+ "partition=" + Формат(Запись.Раздел, "ЧН=0; ЧГ=") + Символы.ПС
		+ "offset=" + Формат(Запись.Смещение, "ЧН=0; ЧГ=") + Символы.ПС
		+ "key=" + Строка(Запись.КлючСообщения) + Символы.ПС
		+ "headers=" + ?(ПолныйPayload, Заголовки, Кратко(Заголовки, 120)) + Символы.ПС
		+ "payload_present=" + ?(ЗначениеЗаполнено(Тело), "1", "0") + Символы.ПС
		+ "payload_len=" + Формат(СтрДлина(Тело), "ЧН=0; ЧГ=") + Символы.ПС
		+ "payload=" + ?(ПолныйPayload, МаскироватьСекретыВТексте(Тело), "<redacted>");
	
КонецФункции

Функция ПросмотретьПроцесс(КодКонтура, ИдентификаторСообщения, РежимПросмотра = "") Экспорт
	
	Режим = НормализоватьРежимПросмотра(РежимПросмотра);
	Если Режим = "ordinary" Тогда
		Возврат ОтчетОтказа("process");
	КонецЕсли;
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		Возврат "ok=0" + Символы.ПС + "error=NOT_FOUND" + Символы.ПС + "scope=process";
	КонецЕсли;
	
	ПолныйPayload = (Режим = "diagnostic");
	Тело = Строка(Процесс.СыройPayload);
	
	Возврат "ok=1" + Символы.ПС
		+ "scope=process" + Символы.ПС
		+ "mode=" + Режим + Символы.ПС
		+ "message_id=" + Строка(Процесс.ИдентификаторСообщения) + Символы.ПС
		+ "correlation_id=" + Строка(Процесс.ИдентификаторКорреляции) + Символы.ПС
		+ "state=" + Строка(Процесс.Состояние) + Символы.ПС
		+ "attempt=" + Формат(Процесс.НомерПопытки, "ЧН=0; ЧГ=") + Символы.ПС
		+ "hash=" + Строка(Процесс.ХешPayload) + Символы.ПС
		+ "payload_present=" + ?(ЗначениеЗаполнено(Тело), "1", "0") + Символы.ПС
		+ "payload_len=" + Формат(СтрДлина(Тело), "ЧН=0; ЧГ=") + Символы.ПС
		+ "payload=" + ?(ПолныйPayload, МаскироватьСекретыВТексте(Тело), "<redacted>");
	
КонецФункции

Функция ПросмотретьOutbox(КодКонтура, ИдентификаторСообщения, НомерПоследовательности, РежимПросмотра = "") Экспорт
	
	Режим = НормализоватьРежимПросмотра(РежимПросмотра);
	Если Режим = "ordinary" Тогда
		Возврат ОтчетОтказа("outbox");
	КонецЕсли;
	
	Статус = KFK_ИсходящиеСтатусыСервер.ПрочитатьСтатус(КодКонтура, ИдентификаторСообщения, НомерПоследовательности);
	Если Статус = Неопределено Тогда
		Возврат "ok=0" + Символы.ПС + "error=NOT_FOUND" + Символы.ПС + "scope=outbox";
	КонецЕсли;
	
	ПолныйPayload = (Режим = "diagnostic");
	Тело = Строка(Статус.Payload);
	
	Возврат "ok=1" + Символы.ПС
		+ "scope=outbox" + Символы.ПС
		+ "mode=" + Режим + Символы.ПС
		+ "message_id=" + Строка(Статус.ИдентификаторСообщения) + Символы.ПС
		+ "seq=" + Формат(Статус.НомерПоследовательности, "ЧН=0; ЧГ=") + Символы.ПС
		+ "uuid=" + Строка(Статус.ИдентификаторСтатуса) + Символы.ПС
		+ "delivery=" + Строка(Статус.СостояниеДоставки) + Символы.ПС
		+ "key=" + Строка(Статус.КлючKafka) + Символы.ПС
		+ "payload_present=" + ?(ЗначениеЗаполнено(Тело), "1", "0") + Символы.ПС
		+ "payload_len=" + Формат(СтрДлина(Тело), "ЧН=0; ЧГ=") + Символы.ПС
		+ "payload=" + ?(ПолныйPayload, МаскироватьСекретыВТексте(Тело), "<redacted>");
	
КонецФункции

// Явный replay failed-записи.
// НовыйMessageID пустой — тот же id (сброс terminal).
// НовыйMessageID заполнен — нужен ПодтвердитьНовыйПроцесс=Истина, иначе warning.
//
Функция ПовторитьFailed(КодКонтура, ИдентификаторСообщения, НовыйMessageID = "", ПодтвердитьНовыйПроцесс = Ложь) Экспорт
	
	Процесс = KFK_ПроцессыОбменаСервер.ПрочитатьПроцесс(КодКонтура, ИдентификаторСообщения);
	Если Процесс = Неопределено Тогда
		Возврат "ok=0" + Символы.ПС + "error=NOT_FOUND";
	КонецЕсли;
	
	Доступность = KFK_ПроцессыОбменаСервер.ДоступенДляАвтоПовтора(КодКонтура, ИдентификаторСообщения);
	Если СтрНайти(Доступность, "state=failed") = 0 Тогда
		Возврат "ok=0" + Символы.ПС
			+ "error=NOT_FAILED" + Символы.ПС
			+ "detail=" + СтрЗаменить(Доступность, Символы.ПС, ";");
	КонецЕсли;
	
	НовыйID = СокрЛП(Строка(НовыйMessageID));
	Если Не ЗначениеЗаполнено(НовыйID) Тогда
		Возврат KFK_ПроцессыОбменаСервер.СброситьFailedДляReplay(КодКонтура, ИдентификаторСообщения);
	КонецЕсли;
	
	Если Не ПодтвердитьНовыйПроцесс Тогда
		Возврат "ok=0" + Символы.ПС
			+ "error=NEED_CONFIRM_NEW_MESSAGE_ID" + Символы.ПС
			+ "warning=1" + Символы.ПС
			+ "new_message_id=" + НовыйID + Символы.ПС
			+ "detail=Новый message id создаёт отдельную бизнес-операцию";
	КонецЕсли;
	
	Регистрация = KFK_ПроцессыОбменаСервер.ЗарегистрироватьПроцесс(
		КодКонтура,
		НовыйID,
		Процесс.ХешPayload,
		Процесс.СыройPayload,
		Процесс.ИдентификаторКорреляции,
		Процесс.ВнешнийIDКонтрагента,
		Процесс.ВнешнийUIDКонтрагента);
	
	Возврат "ok=1" + Символы.ПС
		+ "same_id=0" + Символы.ПС
		+ "new_process=1" + Символы.ПС
		+ "new_message_id=" + НовыйID + Символы.ПС
		+ "duplicate=" + ?(Регистрация.ЭтоДубль, "1", "0") + Символы.ПС
		+ "warning=confirmed_new_business_operation";
	
КонецФункции

// Метрики глубины/возраста Inbox/Outbox, retry и failed + срабатывание порогов профиля.
//
Функция СобратьМетрикиКонтура(КодКонтура) Экспорт
	
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	Если КодКонтура = "RF" Или КодКонтура = Перечисления.KFK_КодыКонтуров.RF Тогда
		ЗначениеКонтура = Перечисления.KFK_КодыКонтуров.RF;
	Иначе
		ЗначениеКонтура = Перечисления.KFK_КодыКонтуров.KZ;
	КонецЕсли;
	Сейчас = ТекущаяДатаСеанса();
	
	InboxГлубина = 0;
	InboxВозрастМинут = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	МИНИМУМ(Входящие.ДатаЗаписи) КАК МинДата
	|ИЗ
	|	РегистрСведений.KFK_ВходящиеСообщения КАК Входящие
	|ГДЕ
	|	Входящие.КодКонтура = &КодКонтура";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		InboxГлубина = Выборка.Количество;
		Если ЗначениеЗаполнено(Выборка.МинДата) Тогда
			InboxВозрастМинут = Цел((Сейчас - Выборка.МинДата) / 60);
		КонецЕсли;
	КонецЕсли;
	
	OutboxГлубина = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.KFK_ИсходящиеСтатусы КАК Исходящие
	|ГДЕ
	|	Исходящие.КодКонтура = &КодКонтура
	|	И Исходящие.СостояниеДоставки = ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияДоставки.pending)";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		OutboxГлубина = Выборка.Количество;
	КонецЕсли;
	
	// Возраст Outbox: по процессам waiting_retry / started_pending без даты в самом Outbox.
	OutboxВозрастМинут = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МИНИМУМ(Процессы.ДатаСледующейПопытки) КАК МинДата
	|ИЗ
	|	РегистрСведений.KFK_ПроцессыОбмена КАК Процессы
	|ГДЕ
	|	Процессы.КодКонтура = &КодКонтура
	|	И Процессы.Состояние = ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияПроцесса.waiting_retry)
	|	И Процессы.ДатаСледующейПопытки > ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.МинДата) Тогда
		// Для порога возраста используем, насколько давно retry «просрочен» относительно now-baseDelay proxy:
		// если ДатаСледующейПопытки в прошлом — возраст = now - date.
		Если Выборка.МинДата < Сейчас Тогда
			OutboxВозрастМинут = Цел((Сейчас - Выборка.МинДата) / 60);
		КонецЕсли;
	КонецЕсли;
	
	RetryCount = 0;
	FailedCount = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Процессы.Состояние КАК Состояние,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.KFK_ПроцессыОбмена КАК Процессы
	|ГДЕ
	|	Процессы.КодКонтура = &КодКонтура
	|	И (Процессы.Состояние = ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияПроцесса.waiting_retry)
	|		ИЛИ Процессы.Состояние = ЗНАЧЕНИЕ(Перечисление.KFK_СостоянияПроцесса.failed))
	|
	|СГРУППИРОВАТЬ ПО
	|	Процессы.Состояние";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Состояние = Перечисления.KFK_СостоянияПроцесса.waiting_retry Тогда
			RetryCount = Выборка.Количество;
		ИначеЕсли Выборка.Состояние = Перечисления.KFK_СостоянияПроцесса.failed Тогда
			FailedCount = Выборка.Количество;
		КонецЕсли;
	КонецЦикла;
	
	ПорогLag = Настройки.ПорогОтставания;
	ПорогВозраста = Настройки.ПорогВозрастаМинут;
	КритВозраст = Настройки.КритическийПорогМинут;
	
	Предупреждение = (InboxГлубина > ПорогLag)
		Или (OutboxГлубина > ПорогLag)
		Или (InboxВозрастМинут > ПорогВозраста)
		Или (OutboxВозрастМинут > ПорогВозраста);
	Критический = (FailedCount > 0 И InboxГлубина > 0 И InboxВозрастМинут > КритВозраст)
		Или (OutboxВозрастМинут > КритВозраст);
	
	ЗадержкаПолученияМс = ПоследняяЗадержкаПолученияДоStarted(ЗначениеКонтура);
	
	Возврат "ok=1" + Символы.ПС
		+ "inbox_depth=" + Формат(InboxГлубина, "ЧН=0; ЧГ=") + Символы.ПС
		+ "inbox_age_min=" + Формат(InboxВозрастМинут, "ЧН=0; ЧГ=") + Символы.ПС
		+ "outbox_depth=" + Формат(OutboxГлубина, "ЧН=0; ЧГ=") + Символы.ПС
		+ "outbox_age_min=" + Формат(OutboxВозрастМинут, "ЧН=0; ЧГ=") + Символы.ПС
		+ "retry_count=" + Формат(RetryCount, "ЧН=0; ЧГ=") + Символы.ПС
		+ "failed_count=" + Формат(FailedCount, "ЧН=0; ЧГ=") + Символы.ПС
		+ "receive_started_latency_ms=" + Формат(ЗадержкаПолученияМс, "ЧН=0; ЧГ=") + Символы.ПС
		+ "threshold_lag=" + Формат(ПорогLag, "ЧН=0; ЧГ=") + Символы.ПС
		+ "threshold_age_min=" + Формат(ПорогВозраста, "ЧН=0; ЧГ=") + Символы.ПС
		+ "threshold_critical_min=" + Формат(КритВозраст, "ЧН=0; ЧГ=") + Символы.ПС
		+ "alert_warn=" + ?(Предупреждение, "1", "0") + Символы.ПС
		+ "alert_critical=" + ?(Критический, "1", "0");
	
КонецФункции

// Прогоняет тот же путь receive→routing→Started без Sleep и возвращает фактическую latency.
// Формального SLA нет: latency_ms — наблюдаемое значение, не порог договора.
//
// Возвращаемое значение:
//  Строка - ok=1;started=1;latency_ms=N;forced_sleep=0;base_delay_sec=...;...
//
Функция ИзмеритьЗадержкуПолученияДоStarted(КодКонтура, ИдентификаторСообщения, ИдентификаторКорреляции, ХешPayload, СыройPayload, КлючKafka = "latency-key", Топик = "contragents", Раздел = 0, Смещение = 0) Экспорт
	
	Настройки = KFK_НастройкиКонтуровСервер.ПрочитатьНастройки(КодКонтура);
	БазоваяЗадержка = Настройки.БазоваяЗадержкаСекунд;
	Если БазоваяЗадержка < 1 Тогда
		БазоваяЗадержка = 60;
	КонецЕсли;
	
	Отчёт = KFK_КонсьюмерЖизненныйЦиклСервер.ВыполнитьRoutingИStartedВТомЖеЦикле(
		КодКонтура,
		ИдентификаторСообщения,
		ИдентификаторКорреляции,
		ХешPayload,
		СыройPayload,
		КлючKafka,
		Топик,
		Раздел,
		Смещение);
	
	Возврат Отчёт + Символы.ПС
		+ "base_delay_sec=" + Формат(БазоваяЗадержка, "ЧН=0; ЧГ=") + Символы.ПС
		+ "sla_declared=0";
	
КонецФункции

// Для verification: явный режим без проверки ролей сеанса.
//
Функция ПроверитьРежимыПросмотраПроцесса(КодКонтура, ИдентификаторСообщения) Экспорт
	
	Обычный = ПросмотретьПроцесс(КодКонтура, ИдентификаторСообщения, "ordinary");
	Сервис = ПросмотретьПроцесс(КодКонтура, ИдентификаторСообщения, "service");
	Диагн = ПросмотретьПроцесс(КодКонтура, ИдентификаторСообщения, "diagnostic");
	
	PayloadДиагн = ИзвлечьПоле(Диагн, "payload");
	ЕстьТелоДиагн = "0";
	Если PayloadДиагн <> "<redacted>" И ЗначениеЗаполнено(PayloadДиагн) Тогда
		ЕстьТелоДиагн = "1";
	КонецЕсли;
	
	Возврат "ordinary_ok=" + ?(СтрНачинаетсяС(Обычный, "ok=0"), "0", "1") + Символы.ПС
		+ "ordinary_denied=" + ?(СтрНайти(Обычный, "DENIED") > 0, "1", "0") + Символы.ПС
		+ "service_ok=" + ?(СтрНачинаетсяС(Сервис, "ok=1"), "1", "0") + Символы.ПС
		+ "service_payload=" + ИзвлечьПоле(Сервис, "payload") + Символы.ПС
		+ "diagnostic_ok=" + ?(СтрНачинаетсяС(Диагн, "ok=1"), "1", "0") + Символы.ПС
		+ "diagnostic_payload_len=" + ИзвлечьПоле(Диагн, "payload_len") + Символы.ПС
		+ "diagnostic_has_body=" + ЕстьТелоДиагн;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализоватьРежимПросмотра(РежимПросмотра)
	
	Текст = НРег(СокрЛП(Строка(РежимПросмотра)));
	Если Текст = "ordinary" Или Текст = "service" Или Текст = "diagnostic" Тогда
		Возврат Текст;
	КонецЕсли;
	
	Если РольДоступна("KFK_ДиагностикаОбмена") Тогда
		Возврат "diagnostic";
	КонецЕсли;
	Если РольДоступна("KFK_СервисОбмена") Тогда
		Возврат "service";
	КонецЕсли;
	
	Возврат "ordinary";
	
КонецФункции

Функция ОтчетОтказа(Область)
	
	Возврат "ok=0" + Символы.ПС
		+ "error=DENIED" + Символы.ПС
		+ "scope=" + Область + Символы.ПС
		+ "mode=ordinary";
	
КонецФункции

Функция МаскироватьСекретыВТексте(Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "password=", "password=***");
	Результат = СтрЗаменить(Результат, "Password=", "Password=***");
	Результат = СтрЗаменить(Результат, """password"":", """password"":""***""");
	Результат = СтрЗаменить(Результат, "sasl.password=", "sasl.password=***");
	Возврат Результат;
	
КонецФункции

Функция Кратко(Текст, МаксДлина)
	
	Если СтрДлина(Текст) <= МаксДлина Тогда
		Возврат Текст;
	КонецЕсли;
	
	Возврат Лев(Текст, МаксДлина) + "...";
	
КонецФункции

Функция ИзвлечьПоле(Отчет, ИмяПоля)
	
	Префикс = ИмяПоля + "=";
	Для Каждого СтрокаОтчета Из СтрРазделить(Отчет, Символы.ПС, Ложь) Цикл
		Если СтрНачинаетсяС(СтрокаОтчета, Префикс) Тогда
			Возврат Сред(СтрокаОтчета, СтрДлина(Префикс) + 1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПоследняяЗадержкаПолученияДоStarted(ЗначениеКонтура)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Журнал.ДлительностьМс КАК ДлительностьМс
	|ИЗ
	|	РегистрСведений.KFK_ЖурналЭтапов КАК Журнал
	|ГДЕ
	|	Журнал.КодКонтура = &КодКонтура
	|	И Журнал.Этап = ЗНАЧЕНИЕ(Перечисление.KFK_ЭтапыОбмена.received)
	|	И Журнал.Результат = &Результат
	|
	|УПОРЯДОЧИТЬ ПО
	|	Журнал.ДатаЗаписи УБЫВ";
	Запрос.УстановитьПараметр("КодКонтура", ЗначениеКонтура);
	Запрос.УстановитьПараметр("Результат", "same_cycle_started");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДлительностьМс;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

