#Область ПрограммныйИнтерфейс

// Возвращает несекретные настройки контура.
// Если записи ещё нет, создаёт стартовый профиль dev и не меняет уже существующую.
// Пароли, ключи и сертификаты в настройку не входят.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//
// Возвращаемое значение:
//  Структура - поля настройки контура.
//
Функция ПрочитатьНастройки(КодКонтура) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ОбеспечитьЗаписьЕслиОтсутствует(ЗначениеКонтура);
	Возврат ПрочитатьЗапись(ЗначениеКонтура);
	
КонецФункции

// Возвращает независимые consumer group и sender контура из настроек.
// Пустые значения отклоняются: подписка и исходящие статусы без них недопустимы.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//
// Возвращаемое значение:
//  Структура - поля КодКонтура, ГруппаПотребителя, Отправитель.
//
Функция ИдентичностьКонтура(КодКонтура) Экспорт
	
	Настройки = ПрочитатьНастройки(КодКонтура);
	
	Если Не ЗначениеЗаполнено(Настройки.ГруппаПотребителя) Тогда
		ВызватьИсключение "Не заполнена группа потребителя контура: " + Строка(Настройки.КодКонтура);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Настройки.Отправитель) Тогда
		ВызватьИсключение "Не заполнен отправитель контура: " + Строка(Настройки.КодКонтура);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодКонтура", Настройки.КодКонтура);
	Результат.Вставить("ГруппаПотребителя", Настройки.ГруппаПотребителя);
	Результат.Вставить("Отправитель", Настройки.Отправитель);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбеспечитьЗаписьЕслиОтсутствует(КодКонтура)
	
	МенеджерЗаписи = РегистрыСведений.KFK_НастройкиКонтуров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	Профиль = СтартовыйПрофиль(КодКонтура);
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.Отправитель = Профиль.Отправитель;
	МенеджерЗаписи.ТопикВходящий = Профиль.ТопикВходящий;
	МенеджерЗаписи.ТопикСтатусов = Профиль.ТопикСтатусов;
	МенеджерЗаписи.ГруппаПотребителя = Профиль.ГруппаПотребителя;
	МенеджерЗаписи.КоличествоВоркеров = Профиль.КоличествоВоркеров;
	МенеджерЗаписи.ОжидаемоеЧислоРазделов = Профиль.ОжидаемоеЧислоРазделов;
	МенеджерЗаписи.ДопустимыеВерсии = Профиль.ДопустимыеВерсии;
	МенеджерЗаписи.БазоваяЗадержкаСекунд = Профиль.БазоваяЗадержкаСекунд;
	МенеджерЗаписи.МаксимальнаяЗадержкаСекунд = Профиль.МаксимальнаяЗадержкаСекунд;
	МенеджерЗаписи.РазмерПачки = Профиль.РазмерПачки;
	МенеджерЗаписи.АдресПодключения = Профиль.АдресПодключения;
	МенеджерЗаписи.СрокХраненияВходящихДней = Профиль.СрокХраненияВходящихДней;
	МенеджерЗаписи.СрокХраненияИсходящихДней = Профиль.СрокХраненияИсходящихДней;
	МенеджерЗаписи.СрокХраненияАудитаДней = Профиль.СрокХраненияАудитаДней;
	МенеджерЗаписи.ПорогОтставания = Профиль.ПорогОтставания;
	МенеджерЗаписи.ПорогВозрастаМинут = Профиль.ПорогВозрастаМинут;
	МенеджерЗаписи.КритическийПорогМинут = Профиль.КритическийПорогМинут;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Функция ПрочитатьЗапись(КодКонтура)
	
	МенеджерЗаписи = РегистрыСведений.KFK_НастройкиКонтуров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.Прочитать();
	
	Результат = Новый Структура;
	Результат.Вставить("КодКонтура", КодКонтура);
	Результат.Вставить("Отправитель", МенеджерЗаписи.Отправитель);
	Результат.Вставить("ТопикВходящий", МенеджерЗаписи.ТопикВходящий);
	Результат.Вставить("ТопикСтатусов", МенеджерЗаписи.ТопикСтатусов);
	Результат.Вставить("ГруппаПотребителя", МенеджерЗаписи.ГруппаПотребителя);
	Результат.Вставить("КоличествоВоркеров", МенеджерЗаписи.КоличествоВоркеров);
	Результат.Вставить("ОжидаемоеЧислоРазделов", МенеджерЗаписи.ОжидаемоеЧислоРазделов);
	Результат.Вставить("ДопустимыеВерсии", МенеджерЗаписи.ДопустимыеВерсии);
	Результат.Вставить("БазоваяЗадержкаСекунд", МенеджерЗаписи.БазоваяЗадержкаСекунд);
	Результат.Вставить("МаксимальнаяЗадержкаСекунд", МенеджерЗаписи.МаксимальнаяЗадержкаСекунд);
	Результат.Вставить("РазмерПачки", МенеджерЗаписи.РазмерПачки);
	Результат.Вставить("АдресПодключения", МенеджерЗаписи.АдресПодключения);
	Результат.Вставить("СрокХраненияВходящихДней", МенеджерЗаписи.СрокХраненияВходящихДней);
	Результат.Вставить("СрокХраненияИсходящихДней", МенеджерЗаписи.СрокХраненияИсходящихДней);
	Результат.Вставить("СрокХраненияАудитаДней", МенеджерЗаписи.СрокХраненияАудитаДней);
	Результат.Вставить("ПорогОтставания", МенеджерЗаписи.ПорогОтставания);
	Результат.Вставить("ПорогВозрастаМинут", МенеджерЗаписи.ПорогВозрастаМинут);
	Результат.Вставить("КритическийПорогМинут", МенеджерЗаписи.КритическийПорогМинут);
	
	Возврат Результат;
	
КонецФункции

Функция СтартовыйПрофиль(КодКонтура)
	
	Профиль = Новый Структура;
	Профиль.Вставить("ТопикВходящий", "contragents");
	Профиль.Вставить("ТопикСтатусов", "contragents.exchange");
	Профиль.Вставить("КоличествоВоркеров", 1);
	Профиль.Вставить("ОжидаемоеЧислоРазделов", 1);
	Профиль.Вставить("ДопустимыеВерсии", "1.0.*");
	Профиль.Вставить("БазоваяЗадержкаСекунд", 60);
	Профиль.Вставить("МаксимальнаяЗадержкаСекунд", 120);
	Профиль.Вставить("РазмерПачки", 100);
	Профиль.Вставить("АдресПодключения", "");
	Профиль.Вставить("СрокХраненияВходящихДней", 30);
	Профиль.Вставить("СрокХраненияИсходящихДней", 30);
	Профиль.Вставить("СрокХраненияАудитаДней", 90);
	Профиль.Вставить("ПорогОтставания", 100);
	Профиль.Вставить("ПорогВозрастаМинут", 10);
	Профиль.Вставить("КритическийПорогМинут", 15);
	
	Если КодКонтура = Перечисления.KFK_КодыКонтуров.RF Тогда
		Профиль.Вставить("Отправитель", "1c-rf");
		Профиль.Вставить("ГруппаПотребителя", "dev.1c.bp.rf");
	ИначеЕсли КодКонтура = Перечисления.KFK_КодыКонтуров.KZ Тогда
		Профиль.Вставить("Отправитель", "1c-kz");
		Профиль.Вставить("ГруппаПотребителя", "dev.1c.bp.kz");
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
	Возврат Профиль;
	
КонецФункции

Функция ЗначениеКодаКонтура(КодКонтура)
	
	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

#КонецОбласти
