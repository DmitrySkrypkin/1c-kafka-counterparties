Функция СтартовыйПрофиль(КодКонтура)
	
	Профиль = Новый Структура;
	Профиль.Вставить("ТопикВходящий", "contragents");
	Профиль.Вставить("ТопикСтатусов", "contragents.exchange");
	Профиль.Вставить("КоличествоВоркеров", 1);
	Профиль.Вставить("ОжидаемоеЧислоРазделов", 1);
	Профиль.Вставить("ДопустимыеВерсии", "1.0.*;1.1.*");
	Профиль.Вставить("БазоваяЗадержкаСекунд", 60);
	Профиль.Вставить("МаксимальнаяЗадержкаСекунд", 120);
	Профиль.Вставить("РазмерПачки", 100);
	Профиль.Вставить("АдресПодключения", "");
	Профиль.Вставить("СрокХраненияВходящихДней", 30);
	Профиль.Вставить("СрокХраненияИсходящихДней", 30);
	Профиль.Вставить("СрокХраненияАудитаДней", 90);
	Профиль.Вставить("ПорогОтставания", 100);
	Профиль.Вставить("ПорогВозрастаМинут", 10);
	Профиль.Вставить("КритическийПорогМинут", 15);
	Профиль.Вставить("ИсходящийОбменВключен", Ложь);
	Профиль.Вставить("ЗадержкаОтправкиСекунд", 300);
	Профиль.Вставить("ВерсияИсходящегоКонтракта", "1.1.0");
	Профиль.Вставить("СрокАрендыИсходящегоСнимкаСекунд", 300);
	Профиль.Вставить("МаксимумПопытокИсходящегоСнимка", 5);
	
	Если КодКонтура = Перечисления.KFK_КодыКонтуров.RF Тогда
		Профиль.Вставить("Отправитель", "1c-rf");
		Профиль.Вставить("ГруппаПотребителя", "dev.1c.bp.rf");
		Профиль.Вставить("ГруппаПотребителяСтатусовПортала", "dev.1c.bp.rf.exchange");
	ИначеЕсли КодКонтура = Перечисления.KFK_КодыКонтуров.KZ Тогда
		Профиль.Вставить("Отправитель", "1c-kz");
		Профиль.Вставить("ГруппаПотребителя", "dev.1c.bp.kz");
		Профиль.Вставить("ГруппаПотребителяСтатусовПортала", "dev.1c.bp.kz.exchange");
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
	Возврат Профиль;
	
КонецФункции

Процедура ОбеспечитьЗаписьВидаЕслиОтсутствует(КодКонтура, ВидОбъекта)

	МенеджерЗаписи = РегистрыСведений.KFK_НастройкиОбъектовОбмена.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.ВидОбъекта = ВидОбъекта;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	Профиль = СтартовыйПрофильВида(КодКонтура, ВидОбъекта);
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.ВидОбъекта = ВидОбъекта;
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Профиль);

	// Чтение настроек вызывается и из подписок на запись объектов у пользователей без права записи настроек.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МенеджерЗаписи.Записать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция СтартовыйПрофильВида(КодКонтура, ВидОбъекта)

	Профиль = Новый Структура;
	Профиль.Вставить("ОкноОжиданияСсылокМинут", 30);

	Если ВидОбъекта = Перечисления.KFK_ВидыОбъектовОбмена.Контрагент Тогда
		Настройки = ПрочитатьНастройки(КодКонтура);
		Профиль.Вставить("ТопикОсновной", Настройки.ТопикВходящий);
		Профиль.Вставить("ТопикОтвета", Настройки.ТопикСтатусов);
		Профиль.Вставить("ВходящийОбменВключен", Истина);
		Профиль.Вставить("ИсходящийОбменВключен", Настройки.ИсходящийОбменВключен);
		Профиль.Вставить("ЗадержкаОтправкиСекунд", Настройки.ЗадержкаОтправкиСекунд);
		Профиль.Вставить("ВерсияИсходящегоКонтракта", Настройки.ВерсияИсходящегоКонтракта);
		Профиль.Вставить("ДопустимыеВерсии", Настройки.ДопустимыеВерсии);
		Возврат Профиль;
	КонецЕсли;

	Профиль.Вставить("ВходящийОбменВключен", Ложь);
	Профиль.Вставить("ИсходящийОбменВключен", Ложь);
	Профиль.Вставить("ЗадержкаОтправкиСекунд", 300);
	Профиль.Вставить("ВерсияИсходящегоКонтракта", "1.0.0");
	Профиль.Вставить("ДопустимыеВерсии", "1.0.*");

	Если ВидОбъекта = Перечисления.KFK_ВидыОбъектовОбмена.Номенклатура Тогда
		Профиль.Вставить("ТопикОсновной", "products");
		Профиль.Вставить("ТопикОтвета", "products.exchange");
	ИначеЕсли ВидОбъекта = Перечисления.KFK_ВидыОбъектовОбмена.СчетНаОплатуПокупателю Тогда
		Профиль.Вставить("ТопикОсновной", "invoices");
		Профиль.Вставить("ТопикОтвета", "invoices.exchange");
	Иначе
		ВызватьИсключение "Неизвестный вид объекта обмена: " + Строка(ВидОбъекта);
	КонецЕсли;

	Возврат Профиль;

КонецФункции

Функция ПрефиксТипаВида(ВидОбъекта)
	
	Если ВидОбъекта = Перечисления.KFK_ВидыОбъектовОбмена.Номенклатура Тогда
		Возврат "product";
	ИначеЕсли ВидОбъекта = Перечисления.KFK_ВидыОбъектовОбмена.СчетНаОплатуПокупателю Тогда
		Возврат "invoice";
	КонецЕсли;
	
	// Пустой вид - процессы и записи, созданные до появления видов: все они относятся к контрагентам.
	Возврат "contragent";
	
КонецФункции

Функция ПрежниеИменаТипов()
	
	Префиксы = СтрРазделить("contragent,product,invoice", ",");
	События = СтрРазделить("created,updated,soft_delete,exchange_started,exchange_completed,exchange_failed", ",");
	
	Карта = Новый Соответствие;
	Для Каждого Префикс Из Префиксы Цикл
		Для Каждого Событие Из События Цикл
			Карта.Вставить(Префикс + "_" + Событие, Префикс + "." + Событие);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Карта;
	
КонецФункции

Процедура ДобавитьТопикВКарту(Карта, Топик, НастройкиВида, ЭтоТопикОтвета)

	ИмяТопика = НРег(СокрЛП(Строка(Топик)));
	Если Не ЗначениеЗаполнено(ИмяТопика) Тогда
		Возврат;
	КонецЕсли;

	Карта.Вставить(ИмяТопика, НовоеОписаниеТопика(
		НастройкиВида.ВидОбъекта,
		ЭтоТопикОтвета,
		НастройкиВида.ВходящийОбменВключен,
		НастройкиВида.ДопустимыеВерсии));

КонецПроцедуры

Функция НовоеОписаниеТопика(ВидОбъекта, ЭтоТопикОтвета, ВходящийОбменВключен, ДопустимыеВерсии)

	Описание = Новый Структура;
	Описание.Вставить("ВидОбъекта", ВидОбъекта);
	Описание.Вставить("ЭтоТопикОтвета", ЭтоТопикОтвета);
	Описание.Вставить("ВходящийОбменВключен", ВходящийОбменВключен);
	Описание.Вставить("ДопустимыеВерсии", ДопустимыеВерсии);
	Возврат Описание;

КонецФункции

Функция ПрочитатьЗаписьВида(КодКонтура, ВидОбъекта)

	МенеджерЗаписи = РегистрыСведений.KFK_НастройкиОбъектовОбмена.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.ВидОбъекта = ВидОбъекта;
	МенеджерЗаписи.Прочитать();

	Результат = Новый Структура;
	Результат.Вставить("КодКонтура", КодКонтура);
	Результат.Вставить("ВидОбъекта", ВидОбъекта);
	Результат.Вставить("ТопикОсновной", СокрЛП(МенеджерЗаписи.ТопикОсновной));
	Результат.Вставить("ТопикОтвета", СокрЛП(МенеджерЗаписи.ТопикОтвета));
	Результат.Вставить("ВходящийОбменВключен", МенеджерЗаписи.ВходящийОбменВключен);
	Результат.Вставить("ИсходящийОбменВключен", МенеджерЗаписи.ИсходящийОбменВключен);
	Результат.Вставить("ЗадержкаОтправкиСекунд", МенеджерЗаписи.ЗадержкаОтправкиСекунд);
	Результат.Вставить("ВерсияИсходящегоКонтракта", МенеджерЗаписи.ВерсияИсходящегоКонтракта);
	Результат.Вставить("ДопустимыеВерсии", МенеджерЗаписи.ДопустимыеВерсии);
	Результат.Вставить("ОкноОжиданияСсылокМинут", МенеджерЗаписи.ОкноОжиданияСсылокМинут);

	Возврат Результат;

КонецФункции

Функция ЗначениеКодаКонтура(КодКонтура)

	Если ТипЗнч(КодКонтура) = Тип("ПеречислениеСсылка.KFK_КодыКонтуров") Тогда
		Если Не ЗначениеЗаполнено(КодКонтура) Тогда
			ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
		КонецЕсли;
		Возврат КодКонтура;
	КонецЕсли;
	
	Если КодКонтура = "RF" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.RF;
	ИначеЕсли КодКонтура = "KZ" Тогда
		Возврат Перечисления.KFK_КодыКонтуров.KZ;
	Иначе
		ВызватьИсключение "Неизвестный код контура: " + Строка(КодКонтура);
	КонецЕсли;
	
КонецФункции

#КонецОбласти
