#Область ПрограммныйИнтерфейс

// Возвращает несекретные настройки контура.
// Если записи ещё нет, создаёт стартовый профиль dev и не меняет уже существующую.
// Пароли, ключи и сертификаты в настройку не входят.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//
// Возвращаемое значение:
//  Структура - поля настройки контура.
//
Функция ПрочитатьНастройки(КодКонтура) Экспорт
	
	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	ОбеспечитьЗаписьЕслиОтсутствует(ЗначениеКонтура);
	ОбеспечитьПоляИсходящегоОбмена(ЗначениеКонтура);
	Возврат ПрочитатьЗапись(ЗначениеКонтура);
	
КонецФункции

// Возвращает независимые consumer group и sender контура из настроек.
// Пустые значения отклоняются: подписка и исходящие статусы без них недопустимы.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//
// Возвращаемое значение:
//  Структура - поля КодКонтура, ГруппаПотребителя, Отправитель.
//
Функция ИдентичностьКонтура(КодКонтура) Экспорт
	
	Настройки = ПрочитатьНастройки(КодКонтура);
	
	Если Не ЗначениеЗаполнено(Настройки.ГруппаПотребителя) Тогда
		ВызватьИсключение "Не заполнена группа потребителя контура: " + Строка(Настройки.КодКонтура);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Настройки.Отправитель) Тогда
		ВызватьИсключение "Не заполнен отправитель контура: " + Строка(Настройки.КодКонтура);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодКонтура", Настройки.КодКонтура);
	Результат.Вставить("ГруппаПотребителя", Настройки.ГруппаПотребителя);
	Результат.Вставить("Отправитель", Настройки.Отправитель);
	
	Возврат Результат;
	
КонецФункции

// group.id: если топики содержат ТопикСтатусов и не содержат ТопикВходящий — ГруппаПотребителяСтатусовПортала, иначе основная группа.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF или KZ.
//  Топики - Массив - имена топиков консьюмера.
//
// Возвращаемое значение:
//  Строка - Kafka consumer group.id для подписки.
//
Функция ГруппаПотребителяДляПодписки(КодКонтура, Топики) Экспорт
	
	Настройки = ПрочитатьНастройки(КодКонтура);
	Если ЭтоКонсьюмерСтатусовПортала(Топики, Настройки) Тогда
		Группа = СокрЛП(Строка(Настройки.ГруппаПотребителяСтатусовПортала));
		Если Не ЗначениеЗаполнено(Группа) Тогда
			ВызватьИсключение "Не заполнена группа потребителя статусов портала: " + Строка(Настройки.КодКонтура);
		КонецЕсли;
		Возврат Группа;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Настройки.ГруппаПотребителя) Тогда
		ВызватьИсключение "Не заполнена группа потребителя контура: " + Строка(Настройки.КодКонтура);
	КонецЕсли;
	
	Возврат Настройки.ГруппаПотребителя;
	
КонецФункции

// Возвращает настройки вида объекта обмена в контуре.
// Если строки вида ещё нет, создаёт её: для вида Контрагент - из ресурсов KFK_НастройкиКонтуров,
// чтобы прежние включение, задержка и версия исходящего обмена сохранились;
// для остальных видов - стартовые значения с выключенным обменом.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ВидОбъекта - ПеречислениеСсылка.KFK_ВидыОбъектовОбмена - вид объекта обмена.
//
// Возвращаемое значение:
//  Структура - поля КодКонтура, ВидОбъекта, ТопикОсновной, ТопикОтвета, ВходящийОбменВключен,
//   ИсходящийОбменВключен, ЗадержкаОтправкиСекунд, ВерсияИсходящегоКонтракта, ДопустимыеВерсии,
//   ОкноОжиданияСсылокМинут.
//
Функция ПрочитатьНастройкиВида(КодКонтура, ВидОбъекта) Экспорт

	ЗначениеКонтура = ЗначениеКодаКонтура(КодКонтура);
	Если ТипЗнч(ВидОбъекта) <> Тип("ПеречислениеСсылка.KFK_ВидыОбъектовОбмена")
		Или Не ЗначениеЗаполнено(ВидОбъекта) Тогда
		ВызватьИсключение "Неизвестный вид объекта обмена: " + Строка(ВидОбъекта);
	КонецЕсли;

	ОбеспечитьЗаписьВидаЕслиОтсутствует(ЗначениеКонтура, ВидОбъекта);
	Возврат ПрочитатьЗаписьВида(ЗначениеКонтура, ВидОбъекта);

КонецФункции

// Возвращает настройки контура, в которых поля исходящего обмена взяты из настроек вида объекта.
// Общие параметры (отправитель, подключение, пачка, задержки повторов) остаются из KFK_НастройкиКонтуров.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ВидОбъекта - ПеречислениеСсылка.KFK_ВидыОбъектовОбмена - вид объекта обмена.
//
// Возвращаемое значение:
//  Структура - поля ПрочитатьНастройки, где ИсходящийОбменВключен, ЗадержкаОтправкиСекунд,
//   ВерсияИсходящегоКонтракта и ТопикВходящий (топик публикации) - из настроек вида.
//
Функция НастройкиИсходящегоОбмена(КодКонтура, ВидОбъекта) Экспорт

	Настройки = ПрочитатьНастройки(КодКонтура);
	НастройкиВида = ПрочитатьНастройкиВида(КодКонтура, ВидОбъекта);

	Настройки.ИсходящийОбменВключен = НастройкиВида.ИсходящийОбменВключен;
	Настройки.ЗадержкаОтправкиСекунд = НастройкиВида.ЗадержкаОтправкиСекунд;
	Настройки.ВерсияИсходящегоКонтракта = НастройкиВида.ВерсияИсходящегоКонтракта;
	Если ЗначениеЗаполнено(НастройкиВида.ТопикОсновной) Тогда
		Настройки.ТопикВходящий = НастройкиВида.ТопикОсновной;
	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Возвращает карту топиков контура по настройкам видов объектов обмена (design, решение 1).
// Читается один раз при старте подписки: изменение настроек вида применяется после перезапуска консьюмера.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//
// Возвращаемое значение:
//  Соответствие - ключ: имя топика в нижнем регистре; значение: Структура, см. ОписаниеТопика.
//
Функция КартаТопиковКонтура(КодКонтура) Экспорт

	Виды = Новый Массив;
	Виды.Добавить(Перечисления.KFK_ВидыОбъектовОбмена.Контрагент);
	Виды.Добавить(Перечисления.KFK_ВидыОбъектовОбмена.Номенклатура);
	Виды.Добавить(Перечисления.KFK_ВидыОбъектовОбмена.СчетНаОплатуПокупателю);

	Карта = Новый Соответствие;
	Для Каждого Вид Из Виды Цикл
		НастройкиВида = ПрочитатьНастройкиВида(КодКонтура, Вид);
		ДобавитьТопикВКарту(Карта, НастройкиВида.ТопикОсновной, НастройкиВида, Ложь);
		ДобавитьТопикВКарту(Карта, НастройкиВида.ТопикОтвета, НастройкиВида, Истина);
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Возвращает описание топика из карты топиков контура.
// Для топика, которого нет в настройках видов, вид объекта пустой.
//
// Параметры:
//  КартаТопиков - Соответствие - результат КартаТопиковКонтура.
//  Топик - Строка - имя топика сообщения.
//
// Возвращаемое значение:
//  Структура - поля:
//   * ВидОбъекта - ПеречислениеСсылка.KFK_ВидыОбъектовОбмена - пустая ссылка для неизвестного топика.
//   * ЭтоТопикОтвета - Булево - топик статусов вида (`*.exchange`).
//   * ВходящийОбменВключен - Булево - приём сообщений вида включён.
//   * ДопустимыеВерсии - Строка - допустимые версии контракта вида.
//
Функция ОписаниеТопика(КартаТопиков, Топик) Экспорт

	Описание = Неопределено;
	Если ТипЗнч(КартаТопиков) = Тип("Соответствие") Тогда
		Описание = КартаТопиков.Получить(НРег(СокрЛП(Строка(Топик))));
	КонецЕсли;
	Если Описание <> Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	Возврат НовоеОписаниеТопика(Перечисления.KFK_ВидыОбъектовОбмена.ПустаяСсылка(), Ложь, Ложь, "");

КонецФункции

// Возвращает каноническое имя типа сообщения `{entity}.{event}` (design, решение 12).
// Прежнее написание `{entity}_{event}` переводится по явной таблице: замена первого «_» не подходит
// из-за `soft_delete` и `exchange_*`. Неизвестное имя возвращается как есть, в нижнем регистре.
//
// Параметры:
//  ТипСообщения - Строка - значение заголовка type.
//
// Возвращаемое значение:
//  Строка - каноническое имя типа.
//
Функция КаноническийТипСообщения(ТипСообщения) Экспорт
	
	Имя = НРег(СокрЛП(Строка(ТипСообщения)));
	Каноническое = ПрежниеИменаТипов().Получить(Имя);
	Если Каноническое = Неопределено Тогда
		Возврат Имя;
	КонецЕсли;
	
	Возврат Каноническое;
	
КонецФункции

// Возвращает имя типа исходящего сообщения или статуса вида объекта.
// Написание выбирается настройкой контура НовыеИменаТипов: Ложь - прежнее `{entity}_{event}`, Истина - `{entity}.{event}`.
//
// Параметры:
//  КодКонтура - Строка, ПеречислениеСсылка.KFK_КодыКонтуров - RF, KZ либо значение перечисления.
//  ВидОбъекта - ПеречислениеСсылка.KFK_ВидыОбъектовОбмена - вид объекта; пустой означает контрагента.
//  Событие - Строка - created, updated, soft_delete, exchange_started, exchange_completed или exchange_failed.
//
// Возвращаемое значение:
//  Строка - значение заголовка type.
//
Функция ИмяТипаСообщения(КодКонтура, ВидОбъекта, Событие) Экспорт
	
	Префикс = ПрефиксТипаВида(ВидОбъекта);
	Настройки = ПрочитатьНастройки(КодКонтура);
	Если Настройки.НовыеИменаТипов Тогда
		Возврат Префикс + "." + Событие;
	КонецЕсли;
	
	Возврат Префикс + "_" + Событие;
	
КонецФункции

// Возвращает канонические типы объектных сообщений вида, допустимые во входящем конверте.
//
// Параметры:
//  ВидОбъекта - ПеречислениеСсылка.KFK_ВидыОбъектовОбмена - вид объекта; пустой означает контрагента.
//
// Возвращаемое значение:
//  Массив из Строка - канонические имена типов.
//
Функция ТипыСообщенийВида(ВидОбъекта) Экспорт
	
	Префикс = ПрефиксТипаВида(ВидОбъекта);
	Типы = Новый Массив;
	Типы.Добавить(Префикс + ".created");
	Типы.Добавить(Префикс + ".updated");
	Если ВидОбъекта = Перечисления.KFK_ВидыОбъектовОбмена.СчетНаОплатуПокупателю Тогда
		Типы.Добавить(Префикс + ".soft_delete");
	КонецЕсли;
	
	Возврат Типы;
	
КонецФункции

// Возвращает вид объекта обмена по типу ссылки записи Outbox.
//
// Параметры:
//  Объект - СправочникСсылка.Контрагенты, СправочникСсылка.Номенклатура, ДокументСсылка.СчетНаОплатуПокупателю - объект.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.KFK_ВидыОбъектовОбмена - вид; пустая ссылка для другого типа.
//
Функция ВидОбъектаПоЗначению(Объект) Экспорт
	
	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Перечисления.KFK_ВидыОбъектовОбмена.Контрагент;
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат Перечисления.KFK_ВидыОбъектовОбмена.Номенклатура;
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
		Возврат Перечисления.KFK_ВидыОбъектовОбмена.СчетНаОплатуПокупателю;
	КонецЕсли;
	
	Возврат Перечисления.KFK_ВидыОбъектовОбмена.ПустаяСсылка();
	
КонецФункции

// True, если список топиков — только статусный консьюмер (есть ТопикСтатусов, нет ТопикВходящий).
//
Функция ЭтоКонсьюмерСтатусовПортала(Топики, Настройки) Экспорт
	
	ТопикСтатусов = НРег(СокрЛП(Строка(Настройки.ТопикСтатусов)));
	Если Не ЗначениеЗаполнено(ТопикСтатусов) Тогда
		ТопикСтатусов = "contragents.exchange";
	КонецЕсли;
	
	ТопикВходящий = НРег(СокрЛП(Строка(Настройки.ТопикВходящий)));
	Если Не ЗначениеЗаполнено(ТопикВходящий) Тогда
		ТопикВходящий = "contragents";
	КонецЕсли;
	
	ЕстьСтатусов = Ложь;
	ЕстьВходящий = Ложь;
	Если ТипЗнч(Топики) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Топик Из Топики Цикл
		Имя = НРег(СокрЛП(Строка(Топик)));
		Если Имя = ТопикСтатусов Тогда
			ЕстьСтатусов = Истина;
		КонецЕсли;
		Если Имя = ТопикВходящий Тогда
			ЕстьВходящий = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьСтатусов И Не ЕстьВходящий;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбеспечитьПоляИсходящегоОбмена(КодКонтура)
	
	МенеджерЗаписи = РегистрыСведений.KFK_НастройкиКонтуров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	Профиль = СтартовыйПрофиль(КодКонтура);
	Изменён = Ложь;
	Если Не ЗначениеЗаполнено(МенеджерЗаписи.ГруппаПотребителяСтатусовПортала) Тогда
		МенеджерЗаписи.ГруппаПотребителяСтатусовПортала = Профиль.ГруппаПотребителяСтатусовПортала;
		Изменён = Истина;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(МенеджерЗаписи.ВерсияИсходящегоКонтракта) Тогда
		МенеджерЗаписи.ВерсияИсходящегоКонтракта = Профиль.ВерсияИсходящегоКонтракта;
		Изменён = Истина;
	КонецЕсли;
	Если ТипЗнч(МенеджерЗаписи.ЗадержкаОтправкиСекунд) <> Тип("Число")
		Или МенеджерЗаписи.ЗадержкаОтправкиСекунд < 0 Тогда
		МенеджерЗаписи.ЗадержкаОтправкиСекунд = Профиль.ЗадержкаОтправкиСекунд;
		Изменён = Истина;
	КонецЕсли;
	Если МенеджерЗаписи.СрокАрендыИсходящегоСнимкаСекунд < 1 Тогда
		МенеджерЗаписи.СрокАрендыИсходящегоСнимкаСекунд = Профиль.СрокАрендыИсходящегоСнимкаСекунд;
		Изменён = Истина;
	КонецЕсли;
	Если МенеджерЗаписи.МаксимумПопытокИсходящегоСнимка < 1 Тогда
		МенеджерЗаписи.МаксимумПопытокИсходящегоСнимка = Профиль.МаксимумПопытокИсходящегоСнимка;
		Изменён = Истина;
	КонецЕсли;
	Если Изменён Тогда
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбеспечитьЗаписьЕслиОтсутствует(КодКонтура)
	
	МенеджерЗаписи = РегистрыСведений.KFK_НастройкиКонтуров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	Профиль = СтартовыйПрофиль(КодКонтура);
