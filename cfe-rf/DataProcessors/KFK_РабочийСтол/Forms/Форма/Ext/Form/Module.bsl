#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПрименитьОтборСостояния();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборСостоянияПриИзменении(Элемент)
	
	ПрименитьОтборСостояния();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокИсходящихСнимков

&НаКлиенте
Процедура СписокИсходящихСнимковПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.СписокИсходящихСнимков.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОчиститьДеталиИсходящегоНаКлиенте();
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДеталиИсходящегоНаСервере(
		ТекущиеДанные.КодКонтура,
		ТекущиеДанные.ИдентификаторСообщения);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПовторитьОтправку(Команда)
	
	ТекущиеДанные = Элементы.СписокИсходящихСнимков.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите запись исходящего снимка.'"));
		Возврат;
	КонецЕсли;
	
	Результат = ПовторитьОтправкуНаСервере(
		ТекущиеДанные.КодКонтура,
		ТекущиеДанные.ИдентификаторСообщения);
	
	Если СтрНайти(Результат, "ok=1") = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Повторная отправка недоступна:'") + Символы.ПС + Результат);
		Возврат;
	КонецЕсли;
	
	Элементы.СписокИсходящихСнимков.Обновить();
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Создана новая pending-запись'"),
		,
		Результат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОчиститьДеталиИсходящегоНаКлиенте()
	
	ДеталиИдентификаторСообщения = "";
	ДеталиИдентификаторКорреляции = "";
	ДеталиКонтрагент = Неопределено;
	ДеталиСостояние = Неопределено;
	ДеталиНомерПопытки = 0;
	ДеталиДиагностика = "";
	ДеталиPayload = "";
	ДеталиСообщенияПортала = "";
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборСостояния()
	
	ПолеСостояния = Новый ПолеКомпоновкиДанных("Состояние");
	Удаляемые = Новый Массив;
	Для Каждого ЭлементОтбора Из СписокИсходящихСнимков.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементОтбора.ЛевоеЗначение = ПолеСостояния Тогда
			Удаляемые.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементОтбора Из Удаляемые Цикл
		СписокИсходящихСнимков.Отбор.Элементы.Удалить(ЭлементОтбора);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ОтборСостояния) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОтбора = СписокИсходящихСнимков.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = ПолеСостояния;
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ОтборСостояния;
	ЭлементОтбора.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеталиИсходящегоНаСервере(Знач КодКонтура, Знач ИдентификаторСообщения)
	
	МенеджерЗаписи = РегистрыСведений.KFK_ИсходящиеСнимки.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КодКонтура = КодКонтура;
	МенеджерЗаписи.ИдентификаторСообщения = ИдентификаторСообщения;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		ДеталиИдентификаторСообщения = "";
		ДеталиИдентификаторКорреляции = "";
		ДеталиКонтрагент = Неопределено;
		ДеталиСостояние = Неопределено;
		ДеталиНомерПопытки = 0;
		ДеталиДиагностика = "";
		ДеталиPayload = "";
		ДеталиСообщенияПортала = "";
		Возврат;
	КонецЕсли;
	
	ДеталиИдентификаторСообщения = МенеджерЗаписи.ИдентификаторСообщения;
	ДеталиИдентификаторКорреляции = МенеджерЗаписи.ИдентификаторКорреляции;
	ДеталиКонтрагент = МенеджерЗаписи.Контрагент;
	ДеталиСостояние = МенеджерЗаписи.Состояние;
	ДеталиНомерПопытки = МенеджерЗаписи.НомерПопытки;
	ДеталиДиагностика = МенеджерЗаписи.Диагностика;
	ДеталиPayload = МенеджерЗаписи.Payload;
	ДеталиСообщенияПортала = МенеджерЗаписи.СообщенияПортала;
	
КонецПроцедуры

&НаСервере
Функция ПовторитьОтправкуНаСервере(Знач КодКонтура, Знач ИдентификаторСообщения)
	
	Возврат KFK_ИсходящиеСнимкиСервер.ПовторитьОтправку(КодКонтура, ИдентификаторСообщения);
	
КонецФункции

#КонецОбласти
