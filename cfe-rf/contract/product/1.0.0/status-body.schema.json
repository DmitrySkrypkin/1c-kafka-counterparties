{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-exchange/1.0.0/status-body.schema.json",
  "title": "Тело статуса по товару",
  "type": "object",
  "additionalProperties": true,
  "required": [],
  "properties": {
    "id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "uid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "path",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "description": "id и uid передаются, если известны: при ошибке разбора тела uid может отсутствовать."
}
