{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counterparty-exchange/1.0.0/status-headers.schema.json",
  "title": "Заголовки статусов contragent_exchange_*",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "sender",
    "correlation-id",
    "timestamp-ms",
    "id",
    "type",
    "version"
  ],
  "properties": {
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "correlation-id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "timestamp-ms": {
      "type": "string",
      "pattern": "^[0-9]{10}$",
      "description": "Unix time в секундах по ТЗ, ровно 10 цифр. Имя поля timestamp-ms сохранено."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "contragent_exchange_started",
        "contragent_exchange_completed",
        "contragent_exchange_failed"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    }
  }
}
